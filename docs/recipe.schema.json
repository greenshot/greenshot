{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://getgreenshot.org/schemas/recipe.schema.json",
  "title": "CaptureRecipe",
  "description": "Formal written contract and schema for Greenshot DAG-based capture recipes.",
  "type": "object",
  "required": [
    "id",
    "name",
    "nodes",
    "flow"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional URI referencing this schema for editor autocompletion and validation."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$",
      "default": "1.0",
      "description": "Recipe schema and format version (e.g. '1.0')."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the recipe. Matching a built-in ID (e.g. 'recipe_region') overrides that built-in recipe."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name for the recipe."
    },
    "description": {
      "type": "string",
      "description": "Optional description of what this recipe accomplishes."
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this recipe is active and available."
    },
    "triggers": {
      "type": "array",
      "description": "Optional modular triggers attached to this recipe (e.g. Hotkey, ContextMenu, Clipboard).",
      "items": {
        "$ref": "#/definitions/TriggerConfig"
      }
    },
    "nodes": {
      "type": "array",
      "description": "Flow-local modular execution nodes configured with unique IDs and step parameters.",
      "items": {
        "$ref": "#/definitions/RecipeNodeConfig"
      },
      "minItems": 1
    },
    "flow": {
      "$ref": "#/definitions/RecipeFlowConfig",
      "description": "DAG workflow definition configuring entry points, transitions/edges, branch forks, and join merges."
    }
  },
  "definitions": {
    "RecipeFlowConfig": {
      "type": "object",
      "properties": {
        "startNode": {
          "type": "string",
          "description": "The unique node ID of the starting node in the DAG."
        },
        "startNodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Multiple starting node IDs for parallel entry points."
        },
        "transitions": {
          "type": "object",
          "description": "Adjacency mapping from source node ID to target node ID (string) or target node IDs (array of strings).",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "edges": {
          "type": "array",
          "description": "Alternative edge list representation of the DAG transitions.",
          "items": {
            "$ref": "#/definitions/TransitionEdgeConfig"
          }
        }
      }
    },
    "TransitionEdgeConfig": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "description": "Source node ID."
        },
        "to": {
          "type": "string",
          "description": "Target node ID."
        }
      }
    },
    "RecipeNodeConfig": {
      "type": "object",
      "required": [
        "id",
        "stepType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique flow-local identifier for this node (referenced by flow transitions)."
        },
        "stepType": {
          "type": "string",
          "enum": [
            "Source",
            "InteractiveSelection",
            "Border",
            "Effect",
            "TextEffect",
            "ObfuscateText",
            "Drawable",
            "SetVariable",
            "ImmediateFeedback",
            "Processors",
            "Destinations",
            "Notification",
            "Conditional"
          ],
          "description": "The modular step type identifier."
        },
        "name": {
          "type": "string",
          "description": "Optional label for this node (defaults to stepType if omitted)."
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this individual node is enabled in the flow."
        },
        "parameters": {
          "type": "object",
          "description": "Node-specific configuration parameters and expressions.",
          "properties": {
            "SourceType": {
              "type": "string",
              "enum": [
                "Region",
                "Window",
                "ActiveWindow",
                "FullScreen",
                "LastRegion",
                "Clipboard",
                "File",
                "TextOcr"
              ],
              "description": "Used by 'Source' step: The kind of raw pixels to capture."
            },
            "WindowTitle": {
              "type": "string",
              "description": "Used by 'Source' step (Window/ActiveWindow): Substring or exact title of a specific window to target."
            },
            "WindowTitlePattern": {
              "type": "string",
              "description": "Used by 'Source' step (Window/ActiveWindow): Regular expression pattern to match window title."
            },
            "ProcessName": {
              "type": "string",
              "description": "Used by 'Source' step (Window/ActiveWindow): Target process name (e.g. 'notepad', 'Greenshot')."
            },
            "MatchCase": {
              "type": "boolean",
              "default": false,
              "description": "Whether title or regex pattern matching is case-sensitive."
            },
            "CaptureMouseCursor": {
              "type": "boolean",
              "description": "Used by 'Source' step: Explicitly pre-defines mouse capture. If omitted, dynamically evaluates CoreConfig.CaptureMousepointer."
            },
            "DelayMs": {
              "type": "integer",
              "minimum": 0,
              "description": "Used by 'Source' step: Pre-capture delay in milliseconds."
            },
            "SelectionMode": {
              "type": "string",
              "enum": [
                "Region",
                "Window",
                "Text"
              ],
              "description": "Used by 'InteractiveSelection' step: The UI selection overlay mode."
            },
            "AllowWindowSnapping": {
              "type": "boolean",
              "default": true,
              "description": "Used by 'InteractiveSelection' step: Whether to snap selection rect to windows under the cursor."
            },
            "Width": {
              "description": "Border width or resize width (integer or expression string).",
              "oneOf": [
                { "type": "integer" },
                { "type": "string" }
              ]
            },
            "Height": {
              "description": "Resize height (integer or expression string).",
              "oneOf": [
                { "type": "integer" },
                { "type": "string" }
              ]
            },
            "Color": {
              "type": "string",
              "description": "Border, canvas, or effect color (e.g. '#FF0000', 'Blue', 'rgba(255,0,0,128)')."
            },
            "Effect": {
              "type": "string",
              "enum": [
                "Border",
                "DropShadow",
                "TornEdge",
                "Invert",
                "Grayscale",
                "Monochrome",
                "Adjust",
                "Rotate",
                "Resize",
                "ResizeCanvas",
                "ReduceColors",
                "RemoveTransparency",
                "Pixelize",
                "Blur",
                "Highlight",
                "Redact",
                "Blackout",
                "Magnify"
              ],
              "description": "Used by 'Effect' step: The effect type to apply."
            },
            "Drawables": {
              "type": "array",
              "description": "Used by 'Drawable' step: List of drawable elements to place on the capture surface.",
              "items": {
                "$ref": "#/definitions/DrawableElementConfig"
              }
            },
            "VariableName": {
              "type": "string",
              "description": "Used by 'SetVariable' step: Target variable name stored in context.Properties."
            },
            "Value": {
              "description": "Used by 'SetVariable' step: Expression or literal value to assign.",
              "oneOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "boolean" }
              ]
            },
            "Variables": {
              "type": "object",
              "description": "Used by 'SetVariable' step: Key-value dictionary of multiple variables and expressions to assign."
            },
            "DestinationDesignations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Used by 'Destinations' step: Explicit list of destination designations (e.g. ['Clipboard', 'FileNoDialog', 'Editor'])."
            },
            "PlaySound": {
              "type": "boolean",
              "description": "Used by 'ImmediateFeedback' step: Explicitly pre-defines shutter sound."
            }
          },
          "additionalProperties": true
        }
      }
    },
    "DrawableElementConfig": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Rectangle",
            "Ellipse",
            "Line",
            "Arrow",
            "Freehand",
            "Text",
            "Speechbubble",
            "StepLabel",
            "Image",
            "Icon",
            "Cursor",
            "Emoji",
            "Svg",
            "Obfuscate",
            "Blur",
            "Pixelize",
            "Highlight",
            "Magnify",
            "Crop"
          ],
          "description": "The type of drawable element."
        },
        "horizontalAnchor": {
          "type": "string",
          "enum": [
            "Left",
            "Center",
            "Middle",
            "Right"
          ],
          "description": "Horizontal alignment anchor relative to the capture payload surface."
        },
        "verticalAnchor": {
          "type": "string",
          "enum": [
            "Top",
            "Center",
            "Middle",
            "Bottom"
          ],
          "description": "Vertical alignment anchor relative to the capture payload surface."
        },
        "left": {
          "description": "X coordinate or expression (e.g. 20, '${payload.width - 200}', 'center').",
          "oneOf": [{ "type": "integer" }, { "type": "string" }]
        },
        "top": {
          "description": "Y coordinate or expression (e.g. 15, '${payload.height - 50}', 'bottom').",
          "oneOf": [{ "type": "integer" }, { "type": "string" }]
        },
        "width": {
          "description": "Width or expression (e.g. 250, '${payload.width / 2}').",
          "oneOf": [{ "type": "integer" }, { "type": "string" }]
        },
        "height": {
          "description": "Height or expression (e.g. 60, '${payload.height * 0.1}').",
          "oneOf": [{ "type": "integer" }, { "type": "string" }]
        },
        "offsetX": {
          "description": "Horizontal offset applied to anchor/coordinate (e.g. -20).",
          "oneOf": [{ "type": "integer" }, { "type": "string" }]
        },
        "offsetY": {
          "description": "Vertical offset applied to anchor/coordinate (e.g. -15).",
          "oneOf": [{ "type": "integer" }, { "type": "string" }]
        },
        "text": {
          "type": "string",
          "description": "Text content for Text, Speechbubble, or StepLabel (supports string interpolation like 'User: ${user.username} on ${machine.computername} at ${now:yyyy-MM-dd}')."
        },
        "lineColor": {
          "type": "string",
          "description": "Stroke/border/text color."
        },
        "fillColor": {
          "type": "string",
          "description": "Fill/background color."
        },
        "lineThickness": {
          "type": "integer",
          "description": "Line thickness in pixels."
        },
        "fontSize": {
          "type": "number",
          "description": "Font size in points."
        },
        "fontFamily": {
          "type": "string",
          "description": "Font family name."
        },
        "bold": {
          "type": "boolean",
          "description": "Font bold weight."
        },
        "shadow": {
          "type": "boolean",
          "description": "Whether to render a drop shadow for the element."
        },
        "filePath": {
          "type": "string",
          "description": "File path for Image, Icon, Cursor, or Svg drawables."
        },
        "emoji": {
          "type": "string",
          "description": "Emoji character for Emoji drawables (e.g. '⚠️', '🔥', '✅')."
        },
        "points": {
          "type": "string",
          "description": "Coordinates list for Freehand drawable (e.g. '10,10;20,30;50,80')."
        }
      },
      "additionalProperties": true
    },
    "TriggerConfig": {
      "type": "object",
      "required": [
        "triggerType"
      ],
      "properties": {
        "triggerType": {
          "type": "string",
          "enum": [
            "Hotkey",
            "ContextMenu",
            "Systray",
            "Clipboard",
            "Manual",
            "Schedule"
          ],
          "description": "The trigger mechanism type."
        },
        "name": {
          "type": "string",
          "description": "Optional human-readable label for this trigger."
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this trigger is currently active."
        },
        "parameters": {
          "type": "object",
          "properties": {
            "Hotkey": {
              "type": "string",
              "description": "Key combination (e.g. 'Ctrl + Shift + B', 'Alt + PrintScreen'). Required for Hotkey triggers."
            },
            "MenuItemText": {
              "type": "string",
              "description": "Custom label displayed in the systray context menu."
            },
            "Group": {
              "type": "string",
              "default": "Recipes",
              "description": "Submenu group in the systray context menu."
            },
            "Order": {
              "type": "integer",
              "default": 0,
              "description": "Sort order within the menu group."
            },
            "OnImageCopied": {
              "type": "boolean",
              "default": true,
              "description": "For clipboard trigger: whether to trigger automatically when an image is copied to clipboard."
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}

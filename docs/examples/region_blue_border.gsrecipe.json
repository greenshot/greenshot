{
  "version": "1.0",
  "id": "recipe_region_blue_border",
  "name": "Region with Blue Border",
  "description": "Interactive region capture that adds a 2px blue border and opens the editor",
  "triggers": [
    {
      "triggerType": "ContextMenu",
      "name": "Region with Border Menu Item",
      "enabled": true,
      "parameters": {
        "menuItemText": "Region with Blue Border",
        "group": "Recipes"
      }
    },
    {
      "triggerType": "Hotkey",
      "enabled": true,
      "parameters": {
        "hotkey": "Ctrl + Shift + B"
      }
    }
  ],
  "requires": [],
  "nodes": [
    {
      "id": "source",
      "stepType": "Source",
      "enabled": true,
      "parameters": {
        "sourceType": "Region"
      }
    },
    {
      "id": "select",
      "stepType": "InteractiveSelection",
      "enabled": true,
      "parameters": {
        "selectionMode": "Region"
      }
    },
    {
      "id": "border",
      "stepType": "Effect",
      "name": "Add Blue Border",
      "enabled": true,
      "parameters": {
        "effect": "Border",
        "width": 2,
        "color": "#0000FF"
      }
    },
    {
      "id": "feedback",
      "stepType": "ImmediateFeedback",
      "name": "Camera Feedback",
      "enabled": true,
      "parameters": {
        "playSound": true
      }
    },
    {
      "id": "destination",
      "stepType": "Destinations",
      "name": "Open Editor",
      "enabled": true,
      "parameters": {
        "destinationDesignations": [
          "Editor"
        ]
      }
    }
  ],
  "flow": {
    "startNodes": [
      "source"
    ],
    "transitions": {
      "source": [
        "select"
      ],
      "select": [
        "border"
      ],
      "border": [
        "feedback"
      ],
      "feedback": [
        "destination"
      ]
    },
    "conditionalTransitions": []
  },
  "showInContextMenu": true,
  "isBuiltIn": false,
  "isOverridden": false,
  "filePath": "D:\\code\\greenshot\\docs\\examples\\region_blue_border.gsrecipe.json"
}
{
  "$schema": "https://getgreenshot.org/schemas/recipe.schema.json",
  "version": "2.0",
  "id": "qr_codes_showcase",
  "name": "QR Codes Showcase (Payments, Business Cards & Links)",
  "description": "Demonstrates inserting multiple structured QR codes: an EPC SEPA bank transfer QR code for payments, a vCard contact business card, and a dynamic website link with rounded dots styling.",
  "authors": [
    {
      "name": "Robin Krom",
      "github": "Lakritzator"
    }
  ],
  "copyright": "Copyright (c) 2026 Robin Krom",
  "license": "MIT",
  "requires": [
    {
      "id": "Greenshot.Plugin.Zxing",
      "name": "ZXing Barcode & QR Code Extension",
      "minVersion": "1.3.0",
      "url": "https://getgreenshot.org/plugins/zxing"
    }
  ],
  "options": [
    {
      "key": "hotkey",
      "type": "Hotkey",
      "default": "Ctrl + Shift + Q",
      "label": "Hotkey"
    }
  ],
  "triggers": [
    {
      "triggerType": "ContextMenu",
      "name": "QR Codes Showcase Menu Item",
      "parameters": {
        "MenuItemText": "QR Codes Showcase (Payments & Business Cards)",
        "Group": "Recipes"
      }
    },
    {
      "triggerType": "Hotkey",
      "parameters": {
        "Hotkey": "${option.hotkey}"
      }
    }
  ],
  "nodes": [
    {
      "id": "source",
      "stepType": "Source",
      "name": "Capture Screen Area",
      "parameters": {
        "SourceType": "Region"
      }
    },
    {
      "id": "select",
      "stepType": "InteractiveSelection",
      "name": "Interactive Region Selection",
      "parameters": {
        "SelectionMode": "Region"
      }
    },
    {
      "id": "add_qr_annotations",
      "stepType": "Annotation",
      "name": "Stamp QR Codes",
      "parameters": {
        "Annotations": [
          {
            "Type": "QRCode",
            "QrType": "Payment",
            "HorizontalAnchor": "Right",
            "VerticalAnchor": "Bottom",
            "Margin": 20,
            "Size": 150,
            "RoundedDots": true,
            "ForeColor": "#003366",
            "BackColor": "#FFFFFF",
            "EpcName": "Greenshot Community e.V.",
            "EpcIban": "DE89370400440532013000",
            "EpcBic": "COBADEFFXXX",
            "EpcAmount": "15.00",
            "EpcReference": "DONATION-2026",
            "EpcMessage": "Support Greenshot Development"
          },
          {
            "Type": "QRCode",
            "QrType": "BusinessCard",
            "HorizontalAnchor": "Left",
            "VerticalAnchor": "Bottom",
            "Margin": 20,
            "Size": 150,
            "RoundedDots": false,
            "ForeColor": "#1A1A1A",
            "BackColor": "#FAFAFA",
            "VcardFirstName": "Robin",
            "VcardLastName": "Krom",
            "VcardCompany": "Greenshot Project",
            "VcardEmail": "robin@getgreenshot.org",
            "VcardPhone": "+49-123-456789",
            "VcardUrl": "https://getgreenshot.org"
          },
          {
            "Type": "QRCode",
            "QrType": "Link",
            "HorizontalAnchor": "Right",
            "VerticalAnchor": "Top",
            "Margin": 20,
            "Size": 120,
            "RoundedDots": true,
            "ForeColor": "#0078D7",
            "BackColor": "#FFFFFF",
            "Text": "https://getgreenshot.org/docs"
          }
        ]
      }
    },
    {
      "id": "destination",
      "stepType": "Destinations",
      "name": "Open in Greenshot Editor",
      "parameters": {
        "DestinationDesignations": [
          "Editor"
        ]
      }
    }
  ],
  "flow": {
    "startNodes": [
      "source"
    ],
    "transitions": [
      {
        "from": "source",
        "to": "select"
      },
      {
        "from": "select",
        "to": "add_qr_annotations"
      },
      {
        "from": "add_qr_annotations",
        "to": "destination"
      }
    ]
  }
}

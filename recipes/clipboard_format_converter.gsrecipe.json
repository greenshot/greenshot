{
  "$schema": "https://getgreenshot.org/schemas/recipe.schema.json",
  "version": "2.0",
  "id": "clipboard_format_converter",
  "name": "Clipboard Format Converter & Watermark",
  "description": "Automatically detects external image clipboard copies (e.g. DeviceIndependentBitmap, DIBV5, or PNG), applies a subtle timestamped watermark annotation, and re-places clean PNG data onto the clipboard.",
  "authors": [
    {
      "name": "Robin Krom",
      "github": "Lakritzator"
    }
  ],
  "copyright": "Copyright (c) 2026 Robin Krom",
  "license": "MIT",
  "triggers": [
    {
      "triggerType": "Clipboard",
      "name": "Monitor External Image Copies",
      "enabled": true,
      "parameters": {
        "FormatFilter": ""
      }
    }
  ],
  "requires": [],
  "nodes": [
    {
      "id": "annotate_clipboard",
      "stepType": "Annotation",
      "name": "Add Processed Tag",
      "enabled": true,
      "parameters": {
        "Annotations": [
          {
            "Type": "Rectangle",
            "HorizontalAnchor": "Right",
            "VerticalAnchor": "Bottom",
            "Width": 180,
            "Height": 24,
            "OffsetX": -10,
            "OffsetY": -10,
            "FillColor": "rgba(0, 0, 0, 160)",
            "LineColor": "#00AA00",
            "LineThickness": 1,
            "Shadow": true
          },
          {
            "Type": "Text",
            "HorizontalAnchor": "Right",
            "VerticalAnchor": "Bottom",
            "Width": 170,
            "Height": 20,
            "OffsetX": -15,
            "OffsetY": -12,
            "Text": "Greenshot: ${now:HH:mm:ss}",
            "LineColor": "#FFFFFF",
            "FontSize": 9.0,
            "FontFamily": "Segoe UI",
            "Bold": true,
            "Shadow": false
          }
        ]
      }
    },
    {
      "id": "editor_2850",
      "stepType": "Editor",
      "name": "Editor",
      "enabled": true,
      "parameters": {}
    }
  ],
  "flow": {
    "startNodes": [
      "annotate_clipboard"
    ],
    "transitions": [
      {
        "from": "annotate_clipboard",
        "to": "editor_2850"
      }
    ]
  },
  "showInContextMenu": true
}

{
  "$schema": "https://getgreenshot.org/schemas/recipe.schema.json",
  "version": "2.0",
  "id": "external_command_run_tool",
  "name": "Region Snip with Your Own Tool",
  "description": "Interactive region snip that runs a program of your choice on the saved capture, then opens the editor.",
  "authors": [
    {
      "name": "Robin Krom",
      "github": "Lakritzator"
    }
  ],
  "copyright": "Copyright (c) 2026 Robin Krom",
  "license": "MIT",
  "options": [
    {
      "key": "hotkey",
      "type": "Hotkey",
      "default": "Ctrl + Shift + O",
      "label": "Hotkey"
    }
  ],
  "triggers": [
    {
      "triggerType": "Hotkey",
      "parameters": {
        "Hotkey": "${option.hotkey}"
      }
    },
    {
      "triggerType": "ContextMenu",
      "name": "Run Tool and Edit",
      "parameters": {
        "MenuItemText": "Snip & Run My Tool",
        "Group": "Recipes"
      }
    }
  ],
  "nodes": [
    {
      "id": "source",
      "stepType": "Source",
      "parameters": {
        "SourceType": "Region"
      }
    },
    {
      "id": "select",
      "stepType": "InteractiveSelection",
      "parameters": {
        "SelectionMode": "Region"
      }
    },
    {
      "id": "run_tool",
      "stepType": "ExternalCommand",
      "name": "Run Your Tool",
      "parameters": {
        "Program": "cmd.exe",
        "Arguments": "/c echo Captured \"${export.file}\"",
        "Output": "Text",
        "ResultName": "tool"
      }
    },
    {
      "id": "feedback",
      "stepType": "ImmediateFeedback",
      "parameters": {
        "PlaySound": true
      }
    },
    {
      "id": "destination",
      "stepType": "Destinations",
      "name": "Open Editor",
      "parameters": {
        "DestinationDesignations": [
          "Editor"
        ]
      }
    }
  ],
  "flow": {
    "startNodes": [
      "source"
    ],
    "transitions": [
      {
        "from": "source",
        "to": "select"
      },
      {
        "from": "select",
        "to": "run_tool"
      },
      {
        "from": "run_tool",
        "to": "feedback"
      },
      {
        "from": "feedback",
        "to": "destination"
      }
    ]
  }
}

{
  "$schema": "https://getgreenshot.org/schemas/recipe.schema.json",
  "version": "2.0",
  "id": "cli_qr_decode",
  "name": "CLI QR Code & Barcode Extractor",
  "description": "Reads a bitmap file from the command line, decodes any QR codes or barcodes on the image, and outputs the decoded text directly to stdout.",
  "authors": [
    {
      "name": "Robin Krom",
      "github": "Lakritzator"
    }
  ],
  "copyright": "Copyright (c) 2026 Robin Krom",
  "license": "MIT",
  "requires": [
    {
      "id": "Greenshot.Plugin.Zxing",
      "name": "ZXing Barcode Plugin",
      "minVersion": "1.3.0"
    }
  ],
  "triggers": [
    {
      "triggerType": "Commandline",
      "name": "QR Code CLI Trigger",
      "enabled": true,
      "parameters": {
        "Command": "qr",
        "Description": "Scan and decode QR codes from an image file",
        "FireAndForget": false,
        "Stdout": "${Barcode.Text}",
        "Arguments": [
          {
            "name": "file",
            "variable": "Filename",
            "type": "FilePath",
            "description": "Path to the bitmap image containing the QR code",
            "required": true
          }
        ]
      }
    }
  ],
  "nodes": [
    {
      "id": "load_file",
      "stepType": "Source",
      "name": "Load Image File",
      "enabled": true,
      "parameters": {
        "SourceType": "File",
        "Filename": "${Filename}"
      }
    },
    {
      "id": "scan_barcodes",
      "stepType": "BarcodeScan",
      "name": "Scan QR & Barcodes",
      "enabled": true,
      "parameters": {
        "OutputVariable": "Barcode.Text",
        "CopyToClipboard": false
      }
    },
    {
      "id": "print_result",
      "stepType": "Stdout",
      "name": "Print to Console",
      "enabled": true,
      "parameters": {
        "Text": "${Barcode.Text}"
      }
    }
  ],
  "flow": {
    "startNodes": [
      "load_file"
    ],
    "transitions": [
      {
        "from": "load_file",
        "to": "scan_barcodes"
      },
      {
        "from": "scan_barcodes",
        "to": "print_result"
      }
    ]
  }
}

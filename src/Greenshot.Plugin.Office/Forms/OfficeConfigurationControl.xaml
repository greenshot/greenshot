<UserControl x:Class="Greenshot.Plugin.Office.Forms.OfficeConfigurationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
             xmlns:interop="clr-namespace:Greenshot.Plugin.Office.OfficeInterop">
    <UserControl.Resources>
        <wpf:EnumDisplayer Type="{x:Type interop:EmailFormat}" x:Key="emailFormats"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Master: Applications List -->
        <Border Grid.Row="0" Grid.Column="0"
                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}">
            <ListBox ItemsSource="{Binding OfficeApps}"
                     SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="6,4">
                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Detail: Application Settings -->
        <Border Grid.Row="0" Grid.Column="2"
                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ControlBackgroundBrush}"
                Padding="12">
            <Grid>
                <!-- Word Settings -->
                <StackPanel Visibility="{Binding IsWordSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{wpf:Text Office.AppWord}"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                               Margin="0,0,0,10"/>
                    <CheckBox IsChecked="{Binding Config.WordLockAspectRatio}"
                              Content="{wpf:Text Office.WordLockaspect}"/>
                </StackPanel>

                <!-- PowerPoint Settings -->
                <StackPanel Visibility="{Binding IsPowerPointSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{wpf:Text Office.AppPowerpoint}"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                               Margin="0,0,0,10"/>
                    <CheckBox IsChecked="{Binding Config.PowerpointLockAspectRatio}"
                              Content="{wpf:Text Office.PowerpointLockaspect}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{wpf:Text Office.PowerpointSlideLayout}" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Right" Width="220"
                                  ItemsSource="{Binding SlideLayouts}"
                                  SelectedItem="{Binding Config.PowerpointSlideLayout}"/>
                    </Grid>
                </StackPanel>

                <!-- Outlook Settings -->
                <StackPanel Visibility="{Binding IsOutlookSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{wpf:Text Office.AppOutlook}"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{wpf:Text Office.OutlookEmailFormat}" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  HorizontalAlignment="Right" Width="200"
                                  ItemsSource="{Binding Source={StaticResource emailFormats}, Path=DisplayNames}"
                                  SelectedValue="{Binding Config.OutlookEmailFormat, Converter={StaticResource emailFormats}}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{wpf:Text Office.OutlookSubjectPattern}"/>
                        <TextBox Grid.Column="1" Text="{Binding Config.EmailSubjectPattern, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{wpf:Text Office.OutlookEmailto}"/>
                        <TextBox Grid.Column="1" Text="{Binding Config.EmailTo, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{wpf:Text Office.OutlookEmailcc}"/>
                        <TextBox Grid.Column="1" Text="{Binding Config.EmailCC, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{wpf:Text Office.OutlookEmailbcc}"/>
                        <TextBox Grid.Column="1" Text="{Binding Config.EmailBCC, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <CheckBox Margin="0,6,0,0"
                              IsChecked="{Binding Config.OutlookAllowExportInMeetings}"
                              Content="{wpf:Text Office.OutlookAllowmeetings}"/>
                </StackPanel>

                <!-- Excel Settings -->
                <StackPanel Visibility="{Binding IsExcelSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{wpf:Text Office.AppExcel}"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{wpf:Text Office.ExcelInfo}"
                               TextWrapping="Wrap"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                               FontSize="12"/>
                </StackPanel>

                <!-- OneNote Settings -->
                <StackPanel Visibility="{Binding IsOneNoteSelected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{wpf:Text Office.AppOnenote}"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{wpf:Text Office.OnenoteInfo}"
                               TextWrapping="Wrap"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Quicklink -->
        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                  Margin="0,8,0,0"
                  IsChecked="{Binding Config.QuicklinkEnabled}"
                  Content="{wpf:Text Core.QuicklinkEnable}"/>
    </Grid>
</UserControl>

<Window x:Class="Greenshot.Plugin.RapidOcr.Views.RapidOcrDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text RapidOcr.DownloadTitle}"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <DockPanel>
            <wpf:ThemedTitleBar DockPanel.Dock="Top"/>

            <!-- One row of buttons per stage: asking, downloading, ended -->
            <Grid DockPanel.Dock="Bottom" Margin="16,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsAsking, Converter={StaticResource VisibleWhenTrue}}">
                    <Button x:Name="DownloadButton" Content="{wpf:Text RapidOcr.DownloadButton}" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="{Binding IsAsking}" Margin="0,0,6,0" Click="Download_Click"/>
                    <Button Content="{Binding DeclineText}" Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="{Binding IsAsking}" Click="Later_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhenTrue}}">
                    <Button x:Name="InformButton" Content="{wpf:Text RapidOcr.DownloadInform}" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="{Binding IsDownloading}" IsCancel="{Binding IsDownloading}" Margin="0,0,6,0" Click="Inform_Click"/>
                    <Button Content="{wpf:Text Core.Cancel}" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsFinished, Converter={StaticResource VisibleWhenTrue}}">
                    <Button x:Name="CloseButton" Content="{wpf:Text RapidOcr.DownloadClose}" Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="{Binding IsFinished}" IsCancel="{Binding IsFinished}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Margin="16,10,16,14">
                <TextBlock Text="{Binding Question}" TextWrapping="Wrap"
                           Visibility="{Binding IsAsking, Converter={StaticResource VisibleWhenTrue}}"/>

                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock Text="{wpf:Text RapidOcr.DownloadRunning}" TextWrapping="Wrap" Margin="0,0,0,10" wpf:LiveRegion.Mode="Polite"/>
                    <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Value="{Binding Percentage, Mode=OneWay}"
                                 BorderThickness="0"
                                 Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=AccentBrush}"
                                 Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                                 AutomationProperties.Name="{wpf:Text RapidOcr.DownloadTitle}"/>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Margin="12,0,0,0"
                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                        <TextBlock Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                    </DockPanel>
                </StackPanel>

                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" wpf:LiveRegion.Mode="Polite"
                           Visibility="{Binding IsFinished, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

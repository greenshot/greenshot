<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <!-- NativeBuffer: the large OCR buffers live outside the managed heap -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Languages\greenshot*.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The licenses of RapidOCR, the models and ONNX Runtime go with the plug-in, see Licenses\NOTICE.txt -->
    <None Include="Licenses\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapplo.Ini" Version="2.0.16" />
    <PackageReference Include="Dapplo.Ini.Generator" Version="2.0.16" />
    <!-- Only the managed part: onnxruntime.dll and the models are downloaded when the user agrees, see docs/vNext/text-recognition.md -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.32.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Greenshot.Base\Greenshot.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageReference Update="System.Text.Encoding.CodePages" Version="11.0.0">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>

; Greenshot starts with Windows: the Greenshot value in the Run key of the current user, see docs/autostart.md.
; The installer and Active Setup apply it with rundll32.exe advpack.dll,LaunchINFSectionEx, as the user it is meant for.
; %01% is the folder of this file, the folder of Greenshot.exe; """ is a quote in the value.
[Version]
Signature="$Windows NT$"

[DefaultInstall]
AddReg=Autostart.AddReg

[Autostart.AddReg]
HKCU,"Software\Microsoft\Windows\CurrentVersion\Run","Greenshot",0x00000000,"""%01%\Greenshot.exe"""

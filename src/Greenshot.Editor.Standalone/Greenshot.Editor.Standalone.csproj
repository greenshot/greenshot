<Project Sdk="Microsoft.NET.Sdk">
  <!--
    greenshot-editor: the stand-alone editor of Greenshot (docs/vNext/standalone-editor.md). Its own process on .NET 10 with
    Avalonia for the window and the newest ImageSharp for the drawing, so it can run where Greenshot.exe (.NET Framework) can't.
    It edits a GreenshotDocument and talks to a running Greenshot over the named pipe; captures are handed over as .greenshot files.
    ImageSharp 4 / ImageSharp.Drawing 3 need a Six Labors license to build a Release: the key comes from the environment variable
    SIXLABORS_LIC (a repository secret in the workflows) or from a file sixlabors.lic next to this project, which is never committed.
  -->
  <PropertyGroup>
    <!-- Override the net480 / WinForms / WPF defaults of Directory.Build.props -->
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RuntimeIdentifiers></RuntimeIdentifiers>
    <OutputType>WinExe</OutputType>
    <AssemblyName>greenshot-editor</AssemblyName>
    <RootNamespace>Greenshot.Editor.Standalone</RootNamespace>
    <ApplicationIcon>..\Greenshot\icons\applicationIcon\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SixLaborsLicenseKey Condition="'$(SixLaborsLicenseKey)' == '' And '$(SIXLABORS_LIC)' != ''">$(SIXLABORS_LIC)</SixLaborsLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia depends on this package, which sends statistics about every build to Avalonia. Building Greenshot doesn't phone home:
         nothing of the package is used, so its build task never runs. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageReference Include="Dapplo.Ini" Version="2.0.13" />
    <PackageReference Include="Dapplo.Ini.Generator" Version="2.0.13" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Greenshot.Document\Greenshot.Document.csproj" />
    <ProjectReference Include="..\Greenshot.Document.Legacy\Greenshot.Document.Legacy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="Languages\greenshot*.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The emoji font, EmojiDrawing loads it from the folder of this assembly -->
    <ContentWithTargetPath Include="..\Greenshot.ImageSharpDrawing\Twemoji.Mozilla.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Twemoji.Mozilla.ttf</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Greenshot.Editor.Standalone.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The editor runs from the folder Editor below Greenshot.exe: Greenshot starts it from there and only lets it use the pipe
    from there. After a build the editor is copied next to a Greenshot which was built with the same configuration (if there
    is one), so "Editor (stand-alone)" works in a development build. Greenshot itself doesn't build the editor.
  -->
  <PropertyGroup>
    <GreenshotOutputForEditor>..\Greenshot\bin\$(Configuration)\net480\</GreenshotOutputForEditor>
  </PropertyGroup>
  <Target Name="CopyEditorNextToGreenshot" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' And Exists('$(GreenshotOutputForEditor)Greenshot.exe')">
    <ItemGroup>
      <_EditorOutput Include="$(OutDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_EditorOutput)" DestinationFiles="@(_EditorOutput->'$(GreenshotOutputForEditor)Editor\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>

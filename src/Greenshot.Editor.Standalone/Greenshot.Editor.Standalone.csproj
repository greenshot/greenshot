<Project Sdk="Microsoft.NET.Sdk">
  <!--
    greenshot-editor: the stand-alone editor of Greenshot (docs/vNext/standalone-editor.md). Its own process on .NET 10 with
    Avalonia for the window and the newest ImageSharp for the drawing, so it can run where Greenshot.exe (.NET Framework) can't.
    It edits a GreenshotDocument and talks to a running Greenshot over the named pipe; captures are handed over as .greenshot files.
    ImageSharp 4 / ImageSharp.Drawing 3 need a Six Labors license to build a Release: the key comes from the environment variable
    SIXLABORS_LIC (a repository secret in the workflows) or from a file sixlabors.lic next to this project, which is never committed.
  -->
  <PropertyGroup>
    <!-- Override the net480 / WinForms / WPF defaults of Directory.Build.props -->
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- The runtime of this machine: restored with the project, so the editor can be published for it right after a build (below) -->
    <RuntimeIdentifiers>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifiers>
    <OutputType>WinExe</OutputType>
    <AssemblyName>greenshot-editor</AssemblyName>
    <RootNamespace>Greenshot.Editor.Standalone</RootNamespace>
    <ApplicationIcon>..\Greenshot\icons\applicationIcon\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Published for a runtime (dotnet publish -r win-x64) the editor is self-contained: no .NET has to be installed.
      - plain: one greenshot-editor.exe with all .NET code in it, next to it only the two native libraries of Avalonia
        (Skia, HarfBuzz), the language packs and the emoji font. This is what a build puts next to Greenshot (below).
      - -p:EditorOptimized=true: also trimmed to what is used and compiled ahead (ReadyToRun), starts about 4 times faster.
      - -p:EditorAot=true: native code (needs the C++ build tools), the smallest and fastest.
    -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != '' And '$(EditorAot)' != 'true'">true</PublishSingleFile>
    <PublishTrimmed Condition="'$(RuntimeIdentifier)' != '' And '$(EditorOptimized)' == 'true' And '$(EditorAot)' != 'true'">true</PublishTrimmed>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != '' And '$(EditorOptimized)' == 'true' And '$(EditorAot)' != 'true'">true</PublishReadyToRun>
    <PublishAot Condition="'$(EditorAot)' == 'true'">true</PublishAot>
    <IsAotCompatible Condition="'$(EditorAot)' == 'true' Or '$(EditorOptimized)' == 'true'">true</IsAotCompatible>
    <!-- No .pdb of the native libraries and no .xml next to the executable -->
    <DebugType Condition="'$(RuntimeIdentifier)' != '' And '$(EditorAot)' != 'true'">embedded</DebugType>
    <SixLaborsLicenseKey Condition="'$(SixLaborsLicenseKey)' == '' And '$(SIXLABORS_LIC)' != ''">$(SIXLABORS_LIC)</SixLaborsLicenseKey>
    <!-- JSON only through generated code, as in the editor compiled ahead (native AOT): what would need to look at types while running fails, also in the tests -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia depends on this package, which sends statistics about every build to Avalonia. Building Greenshot doesn't phone home:
         nothing of the package is used, so its build task never runs. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageReference Include="Dapplo.Ini" Version="2.0.13" />
    <PackageReference Include="Dapplo.Ini.Generator" Version="2.0.13" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- The .NET runtime and the program file for the runtime of this machine, which the self-contained editor next to Greenshot
       is made of (the target below). A restore fetches them with the other packages, so that publish needs no restore of its own. -->
  <ItemGroup Condition="'$(NETCoreSdkPortableRuntimeIdentifier)' != ''">
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.$(NETCoreSdkPortableRuntimeIdentifier)" Version="[$(BundledNETCoreAppPackageVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.$(NETCoreSdkPortableRuntimeIdentifier)" Version="[$(BundledNETCoreAppPackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Greenshot.Document\Greenshot.Document.csproj" />
    <ProjectReference Include="..\Greenshot.Document.Legacy\Greenshot.Document.Legacy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="Languages\greenshot*.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The emoji font, EmojiDrawing loads it from the folder of this assembly -->
    <ContentWithTargetPath Include="..\Greenshot.ImageSharpDrawing\Twemoji.Mozilla.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Twemoji.Mozilla.ttf</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Greenshot.Editor.Standalone.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The editor runs from the folder Editor below Greenshot.exe: Greenshot starts it from there and only lets it use the pipe
    from there. After a build the editor is published into that folder of a Greenshot which was built with the same
    configuration (if there is one), so "Editor (stand-alone)" works in a development build: self-contained and as a single
    file, a handful of files instead of every DLL of .NET, Avalonia and ImageSharp. Greenshot itself doesn't build the editor.
    -p:EditorNextToGreenshot=false switches it off.
  -->
  <PropertyGroup>
    <GreenshotOutputForEditor>..\Greenshot\bin\$(Configuration)\net480\</GreenshotOutputForEditor>
    <EditorRuntimeForGreenshot>$(NETCoreSdkPortableRuntimeIdentifier)</EditorRuntimeForGreenshot>
  </PropertyGroup>
  <Target Name="PublishEditorNextToGreenshot" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(EditorNextToGreenshot)' != 'false' And '$(RuntimeIdentifier)' == '' And '$(EditorRuntimeForGreenshot)' != '' And Exists('$(GreenshotOutputForEditor)Greenshot.exe')">
    <!-- Emptied first: publishing a single file again into a folder removes the files next to it -->
    <RemoveDir Directories="$(GreenshotOutputForEditor)Editor" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="RuntimeIdentifier=$(EditorRuntimeForGreenshot);Configuration=$(Configuration);PublishDir=$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(GreenshotOutputForEditor)', 'Editor'))" RemoveProperties="TargetFramework" />
  </Target>
</Project>

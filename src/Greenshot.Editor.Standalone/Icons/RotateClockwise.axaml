<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.RotateClockwise: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.RotateClockwise">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Brush="#60C8D6F2" Geometry="M1.5,14.5 H9 V8 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#909FB8E8" Thickness="1" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M10.5,3.5 V14.5 H15.5 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#F0F4FD" />
              <GradientStop Offset="1" Color="#BCCDF4" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#4163E7" Thickness="1" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M2.5,9 C2.5,5 5,3 8.5,3">
          <GeometryDrawing.Pen>
            <Pen Brush="#4163E7" Thickness="1.3" LineJoin="Round" LineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#4163E7" Geometry="M7.8,0.6 L11,3 L7.8,5.4 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#4163E7" Thickness="0.6" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

    <ResourceInclude Source="/Icons/ArrowHeadEnd.axaml" />
    <ResourceInclude Source="/Icons/ArrowHeadBoth.axaml" />
    <ResourceInclude Source="/Icons/HighlightText.axaml" />
    <ResourceInclude Source="/Icons/HighlightArea.axaml" />
    <ResourceInclude Source="/Icons/HighlightGrayscale.axaml" />
    <ResourceInclude Source="/Icons/HighlightMagnify.axaml" />
    <ResourceInclude Source="/Icons/Pixelate.axaml" />
    <ResourceInclude Source="/Icons/Blur.axaml" />
    <ResourceInclude Source="/Icons/AutoCrop.axaml" />
    <ResourceInclude Source="/Icons/CropHorizontal.axaml" />
    <ResourceInclude Source="/Icons/CropVertical.axaml" />
    <ResourceInclude Source="/Icons/ZoomIn.axaml" />
    <ResourceInclude Source="/Icons/ZoomOut.axaml" />
    <ResourceInclude Source="/Icons/ZoomBestFit.axaml" />
    <ResourceInclude Source="/Icons/ZoomActualSize.axaml" />

<!-- Merges all editor icons (one DrawingImage per file, key Icon.<Name>). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="/Icons/Select.axaml" />
    <ResourceInclude Source="/Icons/Rectangle.axaml" />
    <ResourceInclude Source="/Icons/Ellipse.axaml" />
    <ResourceInclude Source="/Icons/Line.axaml" />
    <ResourceInclude Source="/Icons/Arrow.axaml" />
    <ResourceInclude Source="/Icons/Freehand.axaml" />
    <ResourceInclude Source="/Icons/Text.axaml" />
    <ResourceInclude Source="/Icons/SpeechBubble.axaml" />
    <ResourceInclude Source="/Icons/StepLabel.axaml" />
    <ResourceInclude Source="/Icons/Emoji.axaml" />
    <ResourceInclude Source="/Icons/Highlight.axaml" />
    <ResourceInclude Source="/Icons/Obfuscate.axaml" />
    <ResourceInclude Source="/Icons/Crop.axaml" />
    <ResourceInclude Source="/Icons/Effects.axaml" />
    <ResourceInclude Source="/Icons/Resize.axaml" />
    <ResourceInclude Source="/Icons/RotateClockwise.axaml" />
    <ResourceInclude Source="/Icons/RotateCounterClockwise.axaml" />
    <ResourceInclude Source="/Icons/Save.axaml" />
    <ResourceInclude Source="/Icons/CopyImage.axaml" />
    <ResourceInclude Source="/Icons/Print.axaml" />
    <ResourceInclude Source="/Icons/Delete.axaml" />
    <ResourceInclude Source="/Icons/Cut.axaml" />
    <ResourceInclude Source="/Icons/Copy.axaml" />
    <ResourceInclude Source="/Icons/Paste.axaml" />
    <ResourceInclude Source="/Icons/Undo.axaml" />
    <ResourceInclude Source="/Icons/Redo.axaml" />
    <ResourceInclude Source="/Icons/Settings.axaml" />
    <ResourceInclude Source="/Icons/Help.axaml" />
    <ResourceInclude Source="/Icons/Close.axaml" />
    <ResourceInclude Source="/Icons/Confirm.axaml" />
    <ResourceInclude Source="/Icons/Cancel.axaml" />
    <ResourceInclude Source="/Icons/LineColor.axaml" />
    <ResourceInclude Source="/Icons/FillColor.axaml" />
    <ResourceInclude Source="/Icons/Shadow.axaml" />
    <ResourceInclude Source="/Icons/Bold.axaml" />
    <ResourceInclude Source="/Icons/Italic.axaml" />
    <ResourceInclude Source="/Icons/AlignLeft.axaml" />
    <ResourceInclude Source="/Icons/AlignCenter.axaml" />
    <ResourceInclude Source="/Icons/AlignRight.axaml" />
    <ResourceInclude Source="/Icons/AlignTop.axaml" />

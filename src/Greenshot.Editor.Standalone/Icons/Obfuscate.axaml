<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.Obfuscate: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.Obfuscate">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Geometry="M0.5,1.5 H15.5 V14.5 H0.5 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#FEFFFF" />
              <GradientStop Offset="1" Color="#D5E8E8" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#4D6B6B" Thickness="1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M2,3 H14 V13 H2 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#A7CCFF" />
              <GradientStop Offset="1" Color="#E8F6F6" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M2,7.5 C5.6,6.5 8,12 14,10.5 V13 H2 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#3E8A5E" />
              <GradientStop Offset="1" Color="#1E4E3A" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Brush="#A0FFFFFF" Geometry="M8,3 H14 V13 H8 Z" />
        <GeometryDrawing Brush="#30A7CCFF" Geometry="M8,3 H11 V8 H8 Z" />
        <GeometryDrawing Brush="#3080A080" Geometry="M11,8 H14 V13 H11 Z" />
        <GeometryDrawing Geometry="M8,0.5 L8,15.5">
          <GeometryDrawing.Pen>
            <Pen Brush="#3355CF" Thickness="1.4" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

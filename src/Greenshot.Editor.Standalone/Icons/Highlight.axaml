<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.Highlight: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.Highlight">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Brush="#EDED00" Geometry="M0.5,0.5 H13.5 V8.5 H0.5 Z" />
        <GeometryDrawing Geometry="M1.6,5.6 A1.6,1.6 0 1 1 4.8,5.6 A1.6,1.6 0 1 1 1.6,5.6 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#55553A" Thickness="1.1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M4.8,3.6 L4.8,7.4">
          <GeometryDrawing.Pen>
            <Pen Brush="#55553A" Thickness="1.1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M6.6,1.8 L6.6,7.4">
          <GeometryDrawing.Pen>
            <Pen Brush="#55553A" Thickness="1.1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M6.6,5.6 A1.6,1.6 0 1 1 9.8,5.6 A1.6,1.6 0 1 1 6.6,5.6 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#55553A" Thickness="1.1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M12.73,6.73 A1.6,1.6 0 1 1 12.73,4.47">
          <GeometryDrawing.Pen>
            <Pen Brush="#55553A" Thickness="1.1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M7.29,15.11 L16.06,8.13 L13.94,5.47 L5.17,12.45 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Offset="0" Color="#F4F400" />
              <GradientStop Offset="1" Color="#BBBB00" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#6E6E2A" Thickness="0.7" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#4A4A30" Geometry="M4.78,16.13 L7.03,14.78 L5.44,12.78 L3.62,14.67 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#4A4A30" Thickness="0.6" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.BringToFront: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.BringToFront">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Geometry="M0.5,1.5 H6.5 V7.5 H0.5 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#F4F6FA" />
              <GradientStop Offset="1" Color="#D4DAE6" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#6A7A98" Thickness="1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M3,5 H9 V11 H3 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#F4F6FA" />
              <GradientStop Offset="1" Color="#D4DAE6" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#6A7A98" Thickness="1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M5.5,8.5 H11.5 V14.5 H5.5 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#A8C0F8" />
              <GradientStop Offset="1" Color="#4466E0" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#2345AB" Thickness="1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M13.5,15 V4.5">
          <GeometryDrawing.Pen>
            <Pen Brush="#2A8A2A" Thickness="1.6" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#2A8A2A" Geometry="M13.5,2.6 L16,6.4 L11,6.4 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#2A8A2A" Thickness="0.6" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M11,0.75 H16">
          <GeometryDrawing.Pen>
            <Pen Brush="#2A8A2A" Thickness="1.5" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

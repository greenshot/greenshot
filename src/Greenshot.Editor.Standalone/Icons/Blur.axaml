<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.Blur: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.Blur">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Geometry="M2,15 L6.9,1.5 H9.1 L14,15 H11.3 L10.1,11.5 H5.9 L4.7,15 Z M6.6,9.3 H9.4 L8,5.1 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#30707070" Thickness="3.2" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M2,15 L6.9,1.5 H9.1 L14,15 H11.3 L10.1,11.5 H5.9 L4.7,15 Z M6.6,9.3 H9.4 L8,5.1 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#50606060" Thickness="1.6" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#A0505050" Geometry="M2,15 L6.9,1.5 H9.1 L14,15 H11.3 L10.1,11.5 H5.9 L4.7,15 Z M6.6,9.3 H9.4 L8,5.1 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.Copy: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.Copy">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Geometry="M4.5,0.5 H15.5 V9.5 H4.5 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#FEFFFF" />
              <GradientStop Offset="1" Color="#D5E8E8" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#4D6B6B" Thickness="1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M6,2 H14 V8 H6 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#A7CCFF" />
              <GradientStop Offset="1" Color="#E8F6F6" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M6,4.7 C8.4,4.1 10,7.4 14,6.5 V8 H6 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#3E8A5E" />
              <GradientStop Offset="1" Color="#1E4E3A" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0.5,5.5 H11.5 V15.5 H0.5 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#FEFFFF" />
              <GradientStop Offset="1" Color="#D5E8E8" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#4D6B6B" Thickness="1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M2,7 H10 V14 H2 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Offset="0" Color="#F7E27A" />
              <GradientStop Offset="0.6" Color="#CFAD14" />
              <GradientStop Offset="1" Color="#947208" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Brush="#6E4E06" Geometry="M2,11.55 H6.8 V14 H2 Z" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

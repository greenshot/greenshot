    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Geometry="M6.5,2.5 H12.5 L12.3,3.7 H10.5 L8.5,12.3 H10.3 L10.1,13.5 H4.1 L4.3,12.3 H6.1 L8.1,3.7 H6.3 Z">

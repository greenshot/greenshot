<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.Shadow: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.Shadow">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Geometry="M8.5,14.5 L15.5,7.5 V10.5 L11,14.5 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
              <GradientStop Offset="0" Color="#343E4F" />
              <GradientStop Offset="1" Color="#849DC6" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Brush="#FFFFFF" Geometry="M3.3,3.2 A2.2,2.2 0 1 1 7.7,3.2 A2.2,2.2 0 1 1 3.3,3.2 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#4D5C74" Thickness="1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M2.5,7.5 C2.5,6.4 3.4,6 4.4,6 H6.6 C7.6,6 8.5,6.4 8.5,7.5 V10.5 H7.5 V14.5 H3.5 V10.5 H2.5 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="#FFFFFF" />
              <GradientStop Offset="1" Color="#D8D8D8" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#4D5C74" Thickness="1" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

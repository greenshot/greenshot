<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.AlignTop: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.AlignTop">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Geometry="M1,1 H10 V3 H1 Z M1,4 H8 V6 H1 Z M1,7 H10 V9 H1 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#4DFFFFFF" Thickness="1.3" LineJoin="Round" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#454545" Geometry="M1,1 H10 V3 H1 Z M1,4 H8 V6 H1 Z M1,7 H10 V9 H1 Z" />
        <GeometryDrawing Geometry="M11,0.75 H16">
          <GeometryDrawing.Pen>
            <Pen Brush="#2C4EB2" Thickness="1.5" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M13.5,3 V15">
          <GeometryDrawing.Pen>
            <Pen Brush="#2C4EB2" Thickness="1.4" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#2C4EB2" Geometry="M13.5,2.4 L16,5.6 L11,5.6 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#2C4EB2" Thickness="0.6" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

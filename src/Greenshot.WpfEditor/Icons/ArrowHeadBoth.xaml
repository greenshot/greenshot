<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.ArrowHeadBoth: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.ArrowHeadBoth">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Geometry="M0.5,8 L6,2 L6,6 L10,6 L10,2 L15.5,8 L10,14 L10,10 L6,10 L6,14 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="#8CD8FD" />
              <GradientStop Offset="0.45" Color="#3894DF" />
              <GradientStop Offset="1" Color="#186AB5" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen>
            <Pen Brush="#0D5CA7" Thickness="1" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M2.5,7 H13.5">
          <GeometryDrawing.Pen>
            <Pen Brush="#60FFFFFF" Thickness="1" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<!-- Icon.AlignBottom: vector version of the Greenshot editor icon, designed on a 16x16 grid. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="Icon.AlignBottom">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
        <GeometryDrawing Geometry="M1,7 H10 V9 H1 Z M1,10 H8 V12 H1 Z M1,13 H10 V15 H1 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#4DFFFFFF" Thickness="1.3" LineJoin="Round" StartLineCap="Round" EndLineCap="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#454545" Geometry="M1,7 H10 V9 H1 Z M1,10 H8 V12 H1 Z M1,13 H10 V15 H1 Z" />
        <GeometryDrawing Geometry="M11,15.25 H16">
          <GeometryDrawing.Pen>
            <Pen Brush="#2C4EB2" Thickness="1.5" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M13.5,1 V13">
          <GeometryDrawing.Pen>
            <Pen Brush="#2C4EB2" Thickness="1.4" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#2C4EB2" Geometry="M13.5,13.6 L16,10.4 L11,10.4 Z">
          <GeometryDrawing.Pen>
            <Pen Brush="#2C4EB2" Thickness="0.6" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

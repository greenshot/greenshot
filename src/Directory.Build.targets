<Project>
  <UsingTask TaskName="ApplyTokenReplacements" TaskFactory="RoslynCodeTaskFactory" AssemblyName="Microsoft.Build.Tasks.Core">
    <ParameterGroup>
      <InputLines ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Tokens ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputLines ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var output = new List<ITaskItem>();
        foreach (var line in InputLines)
        {
            string text = line.ItemSpec;
            foreach (var token in Tokens)
            {
                string tokenName = token.ItemSpec;
                // Skip if tokenName is null or empty
                if (string.IsNullOrEmpty(tokenName))
                  continue;
                
                string replacementValue = token.GetMetadata("ReplacementValue");
                if (!string.IsNullOrEmpty(replacementValue))
                {
                    string placeholder = "$"+ "{"+tokenName+"}";  // Token-Format wie $(Box13_ClientId)
                    text = text.Replace(placeholder, replacementValue);
                }
            }
            output.Add(new Microsoft.Build.Utilities.TaskItem(text));
        }
        OutputLines = output.ToArray();
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <!--
    A .resx may only contain strings: images, icons and other binary data in a .resx need System.Resources.Extensions (and its
    dependencies) in the output. Embed such a file as a plain EmbeddedResource and load it with EmbeddedResources, see
    "Adding images" in README.md. The WinForms designer writes an Image set in its property grid into the .resx, assign
    images in the code of the form instead (e.g. ApplyImages in ImageEditorForm.cs).
  -->
  <UsingTask TaskName="CheckResxHasOnlyStrings" TaskFactory="RoslynCodeTaskFactory" AssemblyName="Microsoft.Build.Tasks.Core">
    <ParameterGroup>
      <ResxFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        foreach (var resx in ResxFiles)
        {
            string path = resx.GetMetadata("FullPath");
            foreach (var data in XDocument.Load(path).Root.Elements("data"))
            {
                if (data.Attribute("type") != null || data.Attribute("mimetype") != null)
                {
                    Log.LogError(path + " contains binary data (" + (string)data.Attribute("name") + "): embed it as a file and load it with EmbeddedResources, see \"Adding images\" in README.md");
                }
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>
  <Target Name="CheckResxHasOnlyStrings" BeforeTargets="CoreResGen" Condition="'$(MSBuildProjectExtension)' == '.csproj' And '@(EmbeddedResource->WithMetadataValue('Extension', '.resx'))' != ''">
    <CheckResxHasOnlyStrings ResxFiles="@(EmbeddedResource->WithMetadataValue('Extension', '.resx'))" />
  </Target>

  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(ProjectDir)$(ProjectName).Credentials.template')">
    <MSBuildCommunityTasksPath>$(NuGetPackageRoot)msbuildtasks/1.5.0.235/tools/</MSBuildCommunityTasksPath>
  </PropertyGroup>

  <Import Project="$(MSBuildCommunityTasksPath)MSBuild.Community.Tasks.Targets" Condition="Exists('$(ProjectDir)$(ProjectName).Credentials.template')" />

  <Target Name="ProcessTemplates" BeforeTargets="PrepareForBuild" Condition="Exists('$(ProjectDir)$(ProjectName).Credentials.template')">
    <Message Text="Processing: $(ProjectDir)$(ProjectName).Credentials.template" Importance="high"/>

    <ReadLinesFromFile File="$(ProjectDir)$(ProjectName).Credentials.template">
      <Output TaskParameter="Lines" ItemName="TemplateLines" />
    </ReadLinesFromFile>

    <ApplyTokenReplacements InputLines="@(TemplateLines)" Tokens="@(Tokens)">
      <Output TaskParameter="OutputLines" ItemName="ProcessedLines" />
    </ApplyTokenReplacements>

    <WriteLinesToFile
      File="$(ProjectDir)$(ProjectName).Credentials.cs"
      Lines="@(ProcessedLines)"
      Overwrite="true" />
  </Target>
</Project>





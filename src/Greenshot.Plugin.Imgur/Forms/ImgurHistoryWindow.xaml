<Window x:Class="Greenshot.Plugin.Imgur.Forms.ImgurHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Translate imgur.history}"
        Width="640" Height="440"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}"
                       Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                           VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"/>
                <Button Grid.Column="2" Content="✕" Click="CloseButton_Click"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- The uploads, newest first -->
            <ListView x:Name="UploadsList" Grid.Row="1" Margin="14,10,14,10"
                      SelectionMode="Extended"
                      SelectionChanged="UploadsList_SelectionChanged"
                      MouseDoubleClick="UploadsList_MouseDoubleClick"
                      GridViewColumnHeader.Click="UploadsList_HeaderClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{wpf:Translate imgur.history.column_title}" Width="300" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="{wpf:Translate imgur.history.column_hash}" Width="100" DisplayMemberBinding="{Binding Hash}"/>
                        <GridViewColumn Header="{wpf:Translate imgur.history.column_date}" Width="150" DisplayMemberBinding="{Binding Date}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Preview and actions -->
            <Grid Grid.Row="2" Margin="14,0,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="90" Height="90"
                        BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1" CornerRadius="4"
                        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}">
                    <Image x:Name="Thumbnail" Stretch="Uniform" Margin="2"/>
                </Border>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,10,0">
                    <Button x:Name="DeleteButton" Content="{wpf:Translate imgur.history.delete}" Click="DeleteButton_Click" Margin="0,0,8,8"/>
                    <Button x:Name="OpenButton" Content="{wpf:Translate imgur.history.open}" Click="OpenButton_Click" Margin="0,0,8,8"/>
                    <Button x:Name="ClipboardButton" Content="{wpf:Translate imgur.history.copy_to_clipboard}" Click="ClipboardButton_Click" Margin="0,0,8,8"/>
                </WrapPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                    <Button x:Name="ClearHistoryButton" Content="{wpf:Translate imgur.history.clear}" Click="ClearHistoryButton_Click"/>
                    <Button Content="{wpf:Translate imgur.OK}" Click="CloseButton_Click" IsDefault="True" IsCancel="True"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<!-- The earlier anonymous Imgur uploads, to delete them: the Imgur section of Self-Service and the step of the welcome wizard -->
<UserControl x:Class="Greenshot.SelfService.Views.ImgurUploadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
             Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{wpf:Text SelfService.ImgurTitle}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="{wpf:Text SelfService.ImgurSub}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
        </StackPanel>

        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" Content="{wpf:Text SelfService.ImgurDelete}" Click="OnDeleteClicked" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
            <Button x:Name="OpenButton" Content="{wpf:Text SelfService.ImgurOpen}" Click="OnOpenClicked" Margin="0,0,8,0"/>
            <Button Content="{wpf:Text SelfService.ImgurExport}" Click="OnExportClicked" Margin="0,0,8,0"/>
            <Button Content="{wpf:Text SelfService.ImgurForget}" Click="OnForgetClicked"/>
        </WrapPanel>

        <ListView x:Name="UploadsList" ItemsSource="{Binding Uploads}" SelectionMode="Extended" MinHeight="160"
                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnOpenClicked">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{wpf:Text SelfService.ImgurColumnImage}" Width="320">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Thumbnail}" Width="48" Height="48" Stretch="UniformToFill" Margin="0,2,10,2"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Link}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{wpf:Text SelfService.ImgurColumnDate}" Width="140" DisplayMemberBinding="{Binding Date}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>

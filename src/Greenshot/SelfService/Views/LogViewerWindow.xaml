<Window x:Class="Greenshot.SelfService.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        mc:Ignorable="d"
        Title="{wpf:Text SelfService.LogviewerTitle}"
        Width="860"
        Height="580"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="13"
        Background="{Binding WindowBackgroundBrush}"
        Foreground="{Binding TextPrimaryBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action Bar -->
            <RowDefinition Height="46"/>
            <!-- Chunk Loading Banner (if earlier lines available) -->
            <RowDefinition Height="Auto"/>
            <!-- Main Log Content -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <wpf:ThemedTitleBar Grid.Row="0" ShowThemeToggle="True"/>

        <!-- Action Bar with Refresh, Copy Log, Search and Log level -->
        <Border Grid.Row="1" 
                Background="{Binding CardBackgroundBrush}" 
                BorderBrush="{Binding CardBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="14,6">
            <Grid VerticalAlignment="Center">
                <Grid.Resources>
                    <!-- The themed TextBox and ComboBox for search and log level, the buttons keep their own style -->
                    <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Controls: Refresh & Copy -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0" 
                            Click="OnRefreshLogClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 "/>
                            <TextBlock Text="{wpf:Text SelfService.LogviewerRefresh}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,12,0" 
                            Click="OnCopyLogClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 "/>
                            <TextBlock Text="{wpf:Text SelfService.LogviewerCopy}"/>
                        </StackPanel>
                    </Button>
                    <CheckBox Content="{wpf:Text SelfService.LogviewerWrap}" 
                              IsChecked="{Binding WrapText, Mode=TwoWay}" 
                              Foreground="{Binding TextPrimaryBrush}" 
                              VerticalAlignment="Center" 
                              FontSize="12"/>
                </StackPanel>

                <!-- Search: only the log entries with this text, from the whole log file -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0">
                    <TextBlock Text="{wpf:Text SelfService.LogviewerSearch}"
                               FontSize="12"
                               Foreground="{Binding TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBox x:Name="SearchTextBox"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{wpf:Text SelfService.LogviewerTooltipSearch}"
                             Width="200"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Log level: changed only here, never by a greenshot://log link -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{wpf:Text SelfService.LogviewerLevel}"
                               FontSize="12"
                               Foreground="{Binding TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding LogLevels}"
                              SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                              ToolTip="{wpf:Text SelfService.LogviewerTooltipLevel}"
                              Width="90"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chunk Paging Banner (When earlier lines exist) -->
        <Border Grid.Row="2"
                Visibility="{Binding CanLoadMore, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{Binding BadgeBackgroundBrush}" 
                BorderBrush="{Binding CardBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️ " FontSize="12" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding ChunkStatusText}" 
                               FontSize="11.5" 
                               Foreground="{Binding TextSecondaryBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0" 
                            Click="OnLoadEarlierLinesClicked"
                            ToolTip="{wpf:Text SelfService.LogviewerTooltipLoadEarlier}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬆ " FontSize="11" Margin="0,0,3,0"/>
                            <TextBlock Text="{wpf:Text SelfService.LogviewerLoadEarlier}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Click="OnLoadEntireLogClicked"
                            ToolTip="{wpf:Text SelfService.LogviewerTooltipLoadEntire}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏬ " FontSize="11" Margin="0,0,3,0"/>
                            <TextBlock Text="{wpf:Text SelfService.LogviewerLoadEntire}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Log Viewer Content Area -->
        <Border Grid.Row="3" 
                Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}" 
                Padding="4">
            <TextBox x:Name="LogTextBox" 
                     Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="{Binding TextWrappingMode}"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Visible"
                     HorizontalScrollBarVisibility="Visible"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="11.5"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{Binding TextPrimaryBrush}"
                     Padding="8"/>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" 
                Background="{Binding CardBackgroundBrush}" 
                BorderBrush="{Binding CardBorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessageText" 
                           Grid.Column="0"
                           Text="{Binding StatusMessage}" 
                           FontSize="11" 
                           Foreground="{Binding TextSecondaryBrush}" 
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <!-- Line count and size, or the number of search matches -->
                <TextBlock Grid.Column="1" 
                           Text="{Binding LogInfoText}" 
                           FontSize="11" 
                           Foreground="{Binding TextSecondaryBrush}" 
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

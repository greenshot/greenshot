<Window x:Class="Greenshot.SelfService.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        mc:Ignorable="d"
        Title="{wpf:Text SelfService.LogviewerTitle}"
        Width="860"
        Height="580"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="13"
        Background="{Binding WindowBackgroundBrush}"
        Foreground="{Binding TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding BadgeBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action Bar -->
            <RowDefinition Height="46"/>
            <!-- Chunk Loading Banner (if earlier lines available) -->
            <RowDefinition Height="Auto"/>
            <!-- Main Log Content -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <wpf:ThemedTitleBar Grid.Row="0" ShowThemeToggle="True"/>

        <!-- Action Bar with Refresh Glance and Copy Log -->
        <Border Grid.Row="1" 
                Background="{Binding CardBackgroundBrush}" 
                BorderBrush="{Binding CardBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="14,6">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Controls: Refresh & Copy -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0" 
                            Click="OnRefreshLogClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 "/>
                            <TextBlock Text="{wpf:Text SelfService.LogviewerRefresh}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,12,0" 
                            Click="OnCopyLogClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 "/>
                            <TextBlock Text="{wpf:Text SelfService.LogviewerCopy}"/>
                        </StackPanel>
                    </Button>
                    <CheckBox Content="{wpf:Text SelfService.LogviewerWrap}" 
                              IsChecked="{Binding WrapText, Mode=TwoWay}" 
                              Foreground="{Binding TextPrimaryBrush}" 
                              VerticalAlignment="Center" 
                              FontSize="12"/>
                </StackPanel>

                <!-- Right Status: Line count and size -->
                <TextBlock Grid.Column="2" 
                           Text="{Binding LogInfoText}" 
                           FontSize="11.5" 
                           Foreground="{Binding TextSecondaryBrush}" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Chunk Paging Banner (When earlier lines exist) -->
        <Border Grid.Row="2"
                Visibility="{Binding CanLoadMore, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{Binding BadgeBackgroundBrush}" 
                BorderBrush="{Binding CardBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️ " FontSize="12" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding ChunkStatusText}" 
                               FontSize="11.5" 
                               Foreground="{Binding TextSecondaryBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0" 
                            Click="OnLoadEarlierLinesClicked"
                            ToolTip="{wpf:Text SelfService.LogviewerTooltipLoadEarlier}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬆ " FontSize="11" Margin="0,0,3,0"/>
                            <TextBlock Text="{wpf:Text SelfService.LogviewerLoadEarlier}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Click="OnLoadEntireLogClicked"
                            ToolTip="{wpf:Text SelfService.LogviewerTooltipLoadEntire}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏬ " FontSize="11" Margin="0,0,3,0"/>
                            <TextBlock Text="{wpf:Text SelfService.LogviewerLoadEntire}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Log Viewer Content Area -->
        <Border Grid.Row="3" 
                Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}" 
                Padding="4">
            <TextBox x:Name="LogTextBox" 
                     Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="{Binding TextWrappingMode}"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Visible"
                     HorizontalScrollBarVisibility="Visible"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="11.5"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{Binding TextPrimaryBrush}"
                     Padding="8"/>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" 
                Background="{Binding CardBackgroundBrush}" 
                BorderBrush="{Binding CardBorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="14,0">
            <TextBlock x:Name="StatusMessageText" 
                       Text="{Binding StatusMessage}" 
                       FontSize="11" 
                       Foreground="{Binding TextSecondaryBrush}" 
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>

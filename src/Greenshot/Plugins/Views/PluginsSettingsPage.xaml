<!-- The plugins tab of the settings. Not in Greenshot Light, see Greenshot.csproj -->
<UserControl x:Class="Greenshot.Plugins.Views.PluginsSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <wpf:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Which plugins are loaded at the next start, greenshot-fixed.ini makes it a restriction -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{wpf:Text Settings.AdministratorSettings}" Style="{StaticResource SecondaryButtonStyle}" Click="AdministratorSettings_Click"/>
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{wpf:Text Settings.PluginsRestart}" TextWrapping="Wrap"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                <TextBlock Text="{wpf:Text Settings.SetByAdministrator}" TextWrapping="Wrap"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                           Visibility="{Binding ArePluginsFixed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </DockPanel>

        <!-- Compact Plugins List -->
        <Border Grid.Column="0"
                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}">
            <ListBox ItemsSource="{Binding Plugins}" 
                     SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{wpf:Text Settings.Plugins}">
                <!-- The plugin's name for a screen reader, the item is a view model without ToString -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name, TargetNullValue=''}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Loaded at the next start -->
                            <CheckBox Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,6,0"
                                      IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Name, TargetNullValue=''}"
                                      IsEnabled="{Binding DataContext.ArePluginsFixed, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBooleanConverter}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Version}"
                                       FontSize="{wpf:FontSize 11}"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Plugin Configuration Component Host -->
        <Border Grid.Column="2"
                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ControlBackgroundBrush}"
                Padding="8">
            <Grid>
                <TextBlock Text="{wpf:Text Core.PluginsNoOptions}"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding NoSelectedPluginControlVisibility}"/>
                <ScrollViewer Style="{DynamicResource ThemedScrollViewer}"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding SelectedPluginControlVisibility}">
                    <ContentControl Content="{Binding SelectedPluginControl}"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="Greenshot.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:local="clr-namespace:Greenshot.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitleText}"
        Icon="{Binding WindowIconSource}"
        SizeToContent="Height"
        Width="660"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="13"
        Background="{Binding WindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Hyperlink Style -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{Binding AccentBrush}"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{Binding CardBorderBrush}" Background="{Binding WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Main Body -->
                <RowDefinition Height="Auto"/> <!-- Footer / Shortcuts -->
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0" ShowThemeToggle="True"/>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="24,10,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header Section with Animated G Logo -->
                    <RowDefinition Height="Auto"/> <!-- License Card -->
                    <RowDefinition Height="Auto"/> <!-- Links & Credits Card -->
                </Grid.RowDefinitions>

                <!-- Header Section: Logo + Title & Version -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <local:AnimatedLogo Grid.Column="0" Width="95" Height="95" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <!-- Title, Version & Badges -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding AppVersionTitle}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{Binding TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Badges row -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{Binding BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding BitnessText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}"/>
                            </Border>
                            <Border Background="{Binding BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding PortableBadgeVisibility}">
                                <TextBlock Text="Portable" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}"/>
                            </Border>
                            <Border Background="#238636" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding BetaTesterBadgeVisibility}">
                                <TextBlock Text="BETA" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </WrapPanel>

                        <!-- Homepage link -->
                        <TextBlock FontSize="13">
                            <Hyperlink NavigateUri="{Binding WebsiteUrl}" RequestNavigate="OnHyperlinkRequestNavigate">
                                <TextBlock Text="{Binding WebsiteDisplayUrl}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- License & Copyright Card -->
                <Border Grid.Row="1"
                        Background="{Binding CardBackgroundBrush}"
                        BorderBrush="{Binding CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LicenseCopyrightText}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Released as free software under the GNU General Public License (GPLv3)."
                                   Foreground="{Binding TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="12">
                            <Hyperlink NavigateUri="https://www.gnu.org/licenses/gpl.html" RequestNavigate="OnHyperlinkRequestNavigate">
                                <TextBlock Text="https://www.gnu.org/licenses/gpl.html"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Links, Resources & Credits Card -->
                <Border Grid.Row="2"
                        Background="{Binding CardBackgroundBrush}"
                        BorderBrush="{Binding CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel>
                        <!-- GitHub Host -->
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Fill="{Binding TextPrimaryBrush}"
                                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HostLabelText}" Foreground="{Binding TextSecondaryBrush}"/>
                                <Run Text=" "/>
                                <Hyperlink NavigateUri="https://github.com/greenshot/greenshot" RequestNavigate="OnHyperlinkRequestNavigate">
                                    <TextBlock Text="https://github.com/greenshot/greenshot"/>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <!-- Bug Reports -->
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Fill="#F85149"
                                      Data="M19,8V7c0-0.55-0.45-1-1-1h-1.17C16.42,4.88,15.34,4,14.07,4l1.24-1.24c0.39-0.39,0.39-1.02,0-1.41c-0.39-0.39-1.02-0.39-1.41,0L12.19,3H11.8L10.1,1.35c-0.39-0.39-1.02-0.39-1.41,0c-0.39,0.39-0.39,1.02,0,1.41L9.93,4C8.66,4,7.58,4.88,7.17,6H6C5.45,6,5,6.45,5,7v1c0,0.55,0.45,1,1,1h1.03C7.01,9.33,7,9.66,7,10v1H5c-0.55,0-1,0.45-1,1s0.45,1,1,1h2v1c0,0.34,0.01,0.67,0.03,1H6c-0.55,0-1,0.45-1,1v1c0,0.55,0.45,1,1,1h1.17c0.41,1.12,1.49,2,2.76,2v0.59l-1.3,1.3c-0.39,0.39-0.39,1.02,0,1.41c0.39,0.39,1.02,0.39,1.41,0l1.96-1.96V20h2v0.34l1.96,1.96c0.39,0.39,1.02,0.39,1.41,0c0.39-0.39,0.39-1.02,0-1.41l-1.3-1.3V19c1.27,0,2.35-0.88,2.76-2H18c0.55,0,1-0.45,1-1v-1c0-0.55-0.45-1-1-1h-1.03c0.02-0.33,0.03-0.66,0.03-1v-1h2c0.55,0,1-0.45,1-1s-0.45-1-1-1h-2v-1c0-0.34-0.01-0.67-0.03-1H18C18.55,9,19,8.55,19,8z M14,14c0,1.1-0.9,2-2,2s-2-0.9-2-2v-3c0-1.1,0.9-2,2-2s2,0.9,2,2V14z"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BugsLabelText}" Foreground="{Binding TextSecondaryBrush}"/>
                                <Run Text=" "/>
                                <Hyperlink NavigateUri="{Binding BugsUrl}" RequestNavigate="OnHyperlinkRequestNavigate">
                                    <TextBlock Text="https://getgreenshot.org/tickets"/>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <!-- Support / Donations -->
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Fill="#E81123"
                                      Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DonationsLabelText}" Foreground="{Binding TextSecondaryBrush}"/>
                                <Run Text=" "/>
                                <Hyperlink NavigateUri="{Binding DonationsUrl}" RequestNavigate="OnHyperlinkRequestNavigate">
                                    <TextBlock Text="https://getgreenshot.org/support"/>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <!-- Icons Attribution -->
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Fill="#F59E0B"
                                      Data="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10c1.38 0 2.5-1.12 2.5-2.5 0-.61-.23-1.2-.64-1.67-.08-.1-.13-.21-.13-.33 0-.28.22-.5.5-.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 8 6.5 8s1.5.67 1.5 1.5S7.33 11 6.5 11zm3-4C8.67 7 8 6.33 8 5.5S8.67 4 9.5 4s1.5.67 1.5 1.5S10.33 7 9.5 7zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 4 14.5 4s1.5.67 1.5 1.5S15.33 7 14.5 7zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 8 17.5 8s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock Text="{Binding IconsLabelText}" Foreground="{Binding TextSecondaryBrush}"/>
                                <Run Text=" "/>
                                <Hyperlink NavigateUri="https://p.yusukekamiyamane.com" RequestNavigate="OnHyperlinkRequestNavigate">
                                    <TextBlock Text="https://p.yusukekamiyamane.com"/>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>

                        <!-- Translation Credits (if available) -->
                        <Grid Margin="0,2,0,2" Visibility="{Binding TranslationCreditsVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Fill="#38BDF8"
                                      Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{Binding TranslationCreditsText}"
                                       Foreground="{Binding TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer Action Bar & Shortcuts -->
            <Border Grid.Row="2"
                    Background="{Binding CardBackgroundBrush}"
                    BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Self-Service & Diagnostics Button -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnOpenSelfServiceClicked"
                                ToolTip="{Binding SelfServiceButtonToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛠️" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelfServiceButtonText}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Content="{Binding CloseButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            IsCancel="True"
                            Width="90"
                            Height="32"
                            Click="OnCloseClicked"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

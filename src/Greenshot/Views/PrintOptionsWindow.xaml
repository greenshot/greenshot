<Window x:Class="Greenshot.Views.PrintOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text Core.PrintoptionsTitle}"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/GroupBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0"/>

            <!-- Dialog Content -->
            <StackPanel Grid.Row="1" Margin="20,16,20,10">
                <!-- Layout Options -->
                <GroupBox Header="{wpf:Text Core.PrintoptionsLayout}">
                    <StackPanel>
                        <CheckBox x:Name="CheckboxAllowShrink" Content="{wpf:Text Core.PrintoptionsAllowshrink}"/>
                        <CheckBox x:Name="CheckboxAllowEnlarge" Content="{wpf:Text Core.PrintoptionsAllowenlarge}"/>
                        <CheckBox x:Name="CheckboxAllowRotate" Content="{wpf:Text Core.PrintoptionsAllowrotate}"/>
                        <CheckBox x:Name="CheckboxAllowCenter" Content="{wpf:Text Core.PrintoptionsAllowcenter}"/>
                        <CheckBox x:Name="CheckboxDateTime" Content="{wpf:Text Core.PrintoptionsTimestamp}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Color Options -->
                <GroupBox Header="{wpf:Text Core.PrintoptionsColors}">
                    <StackPanel>
                        <RadioButton x:Name="RadioBtnColorPrint" Content="{wpf:Text Core.PrintoptionsPrintcolor}" Style="{StaticResource DefaultRadioButtonStyle}"/>
                        <RadioButton x:Name="RadioBtnGrayScale" Content="{wpf:Text Core.PrintoptionsPrintgrayscale}" Style="{StaticResource DefaultRadioButtonStyle}"/>
                        <RadioButton x:Name="RadioBtnMonochrome" Content="{wpf:Text Core.PrintoptionsPrintmonochrome}" Style="{StaticResource DefaultRadioButtonStyle}"/>
                        <Separator Margin="4,6" Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
                        <CheckBox x:Name="CheckboxPrintInverted" Content="{wpf:Text Core.PrintoptionsInverted}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Don't ask again -->
                <CheckBox x:Name="CheckboxDontAskAgain" 
                          Content="{wpf:Text Core.PrintoptionsDontaskagain}"
                          Margin="4,6,4,0"/>
            </StackPanel>

            <!-- Buttons -->
            <Border Grid.Row="2" 
                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{wpf:Text Core.Ok}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Width="80"
                            Margin="5,0"
                            Click="OkButton_Click"/>
                    <Button Content="{wpf:Text Core.Cancel}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            Width="80"
                            Margin="5,0"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="Greenshot.Views.PrintOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text Core.PrintoptionsTitle}"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <!-- Modern GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{TemplateBinding Header}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{TemplateBinding Foreground}"
                                               Margin="0,0,0,8"/>
                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0"/>

            <!-- Dialog Content -->
            <StackPanel Grid.Row="1" Margin="20,16,20,10">
                <!-- Layout Options -->
                <GroupBox Header="{wpf:Text Core.PrintoptionsLayout}">
                    <StackPanel>
                        <CheckBox x:Name="CheckboxAllowShrink" Content="{wpf:Text Core.PrintoptionsAllowshrink}"/>
                        <CheckBox x:Name="CheckboxAllowEnlarge" Content="{wpf:Text Core.PrintoptionsAllowenlarge}"/>
                        <CheckBox x:Name="CheckboxAllowRotate" Content="{wpf:Text Core.PrintoptionsAllowrotate}"/>
                        <CheckBox x:Name="CheckboxAllowCenter" Content="{wpf:Text Core.PrintoptionsAllowcenter}"/>
                        <CheckBox x:Name="CheckboxDateTime" Content="{wpf:Text Core.PrintoptionsTimestamp}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Color Options -->
                <GroupBox Header="{wpf:Text Core.PrintoptionsColors}">
                    <StackPanel>
                        <RadioButton x:Name="RadioBtnColorPrint" Content="{wpf:Text Core.PrintoptionsPrintcolor}"/>
                        <RadioButton x:Name="RadioBtnGrayScale" Content="{wpf:Text Core.PrintoptionsPrintgrayscale}"/>
                        <RadioButton x:Name="RadioBtnMonochrome" Content="{wpf:Text Core.PrintoptionsPrintmonochrome}"/>
                        <Separator Margin="4,6" Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
                        <CheckBox x:Name="CheckboxPrintInverted" Content="{wpf:Text Core.PrintoptionsInverted}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Don't ask again -->
                <CheckBox x:Name="CheckboxDontAskAgain" 
                          Content="{wpf:Text Core.PrintoptionsDontaskagain}"
                          Margin="4,6,4,0"/>
            </StackPanel>

            <!-- Buttons -->
            <Border Grid.Row="2" 
                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{wpf:Text Core.Ok}" 
                            IsDefault="True"
                            Width="80"
                            Click="OkButton_Click"/>
                    <Button Content="{wpf:Text Core.Cancel}" 
                            IsCancel="True"
                            Width="80"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

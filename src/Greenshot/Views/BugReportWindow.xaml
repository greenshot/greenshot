<Window x:Class="Greenshot.Views.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:vm="clr-namespace:Greenshot.ViewModels"
        mc:Ignorable="d"
        Title="Greenshot - An Unexpected Error Occurred"
        Icon="/icons/applicationIcon/icon.ico"
        Width="660"
        MinWidth="560"
        SizeToContent="Height"
        MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="{wpf:FontSize 13}"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ScrollBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Only a close button, like before: the error dialog stays on top and isn't minimized -->
            <wpf:ThemedTitleBar Grid.Row="0" ShowMinimize="False" ShowMaximize="False"/>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="1"
                          Style="{DynamicResource ThemedScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,18,24,20">

                    <!-- Header & Friendly Explanation -->
                    <TextBlock Text="Something went wrong"
                               FontSize="{wpf:FontSize 18}"
                               FontWeight="SemiBold"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Greenshot encountered an error, but don't worry—your work is safe. You can check if this issue has already been reported or file a new bug report with the details below."
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                               Margin="0,0,0,14"/>

                    <!-- Version Status Banner -->
                    <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                            BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Installed Version: "
                                               FontWeight="SemiBold"
                                               FontSize="{wpf:FontSize 12.5}"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentVersion}"
                                               FontWeight="SemiBold"
                                               FontSize="{wpf:FontSize 12.5}"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>

                                    <TextBlock Text="   |   Latest Release: "
                                               FontWeight="SemiBold"
                                               FontSize="{wpf:FontSize 12.5}"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                    <TextBlock Text="{Binding LatestReleaseVersion, TargetNullValue='Checking...'}"
                                               wpf:LiveRegion.Mode="Polite"
                                               FontWeight="SemiBold"
                                               FontSize="{wpf:FontSize 12.5}"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>

                                <!-- Outdated Version Alert Callout -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding IsOutdated, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="⚠️ " FontSize="{wpf:FontSize 12}"/>
                                    <TextBlock Text="{Binding VersionComparisonText}"
                                               FontWeight="SemiBold"
                                               FontSize="{wpf:FontSize 12}"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=WarningBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Upgrade Button when Outdated -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource WarnButtonStyle}"
                                    Visibility="{Binding IsOutdated, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="OnUpgradeClicked"
                                    AutomationProperties.Name="Download Update"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀 Download Update" Margin="0,0,2,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Duplicate Detection Card with Stack Trace Hash -->
                    <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                            BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Issue Identifier (Stack Trace Hash)"
                                               FontWeight="SemiBold"
                                               FontSize="{wpf:FontSize 12}"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                                               Margin="0,0,0,4"/>
                                    
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Stylized Hash Badge -->
                                        <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                                                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding FormattedHashDisplay}"
                                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                                       FontWeight="Bold"
                                                       FontSize="{wpf:FontSize 13}"
                                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=AccentBrush}"/>
                                        </Border>

                                        <TextBlock Text="{Binding ExceptionType}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{wpf:FontSize 12}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="320"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Direct Search GitHub Button -->
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OnSearchGitHubClicked"
                                        AutomationProperties.Name="Search Existing Issues"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 Search Existing Issues" Margin="0,0,2,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="Searching GitHub for this hash helps avoid filing duplicate issues and lets you quickly see if a fix or workaround is already available."
                                       TextWrapping="Wrap"
                                       FontSize="{wpf:FontSize 11.5}"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                                       Margin="0,10,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Error Message Summary -->
                    <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                            BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="Error Message: "
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                                       DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding ExceptionMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                        </DockPanel>
                    </Border>

                    <!-- Dedicated Stack Trace Card -->
                    <Border Visibility="{Binding HasStackTrace, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                            BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock Text="Stack Trace:"
                                           FontWeight="SemiBold"
                                           FontSize="{wpf:FontSize 11.5}"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource SecondaryTextButtonStyle}"
                                        Padding="4,2"
                                        Click="OnCopyStackTraceClicked"
                                        AutomationProperties.Name="Copy Stack Trace"
                                        ToolTip="Copy Stack Trace to Clipboard">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 " FontSize="{wpf:FontSize 10}"/>
                                        <TextBlock Text="Copy Stack Trace" FontSize="{wpf:FontSize 11}"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <Border Grid.Row="1"
                                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4">
                                <TextBox Text="{Binding StackTrace, Mode=OneWay}"
                                         AutomationProperties.Name="Stack Trace"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         MaxHeight="150"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="{wpf:FontSize 11}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                                         Padding="4"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Collapsible Technical Details Card -->
                    <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                            BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,4,0,4"
                            Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource SecondaryTextButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="OnToggleDetailsClicked">
                                    <TextBlock Text="{Binding ToggleDetailsText}"
                                               FontWeight="SemiBold"
                                               FontSize="{wpf:FontSize 12}"/>
                                </Button>

                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryTextButtonStyle}"
                                        Click="OnCopyReportClicked"
                                        AutomationProperties.Name="{Binding CopyButtonText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 " Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding CopyButtonText}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,8,0,0"
                                    Padding="4">
                                <TextBox Text="{Binding FullReport, Mode=OneWay}"
                                         AutomationProperties.Name="Details"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Height="220"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="{wpf:FontSize 11.5}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                                         Padding="8"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Action Buttons -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="OnOpenSelfServiceClicked"
                                AutomationProperties.Name="{wpf:Text SelfService.Title}"
                                ToolTip="{wpf:Text SelfService.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛠️ " FontSize="{wpf:FontSize 12}" Margin="0,0,2,0"/>
                                <TextBlock Text="{wpf:Text SelfService.Title}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnReportIssueClicked"
                                AutomationProperties.Name="Report on GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐 Report on GitHub" Margin="0,0,2,0"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnCloseClicked"
                                IsCancel="True"
                                MinWidth="90">
                            <TextBlock Text="Close"/>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

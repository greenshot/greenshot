<!-- The welcome window: a wizard in which Greenshot says hello at its first start, explains the basics and checks the setup -->
<Window x:Class="Greenshot.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:local="clr-namespace:Greenshot.Views"
        Title="{wpf:Text Welcome.Title}"
        SizeToContent="Height"
        Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="13"
        Background="{Binding WindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Modern Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding AccentBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=AccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding BadgeBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hyperlink Style -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{Binding AccentBrush}"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A card of the window -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{Binding CardBorderBrush}" Background="{Binding WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Main Body -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0" ShowThemeToggle="True"/>

            <StackPanel Grid.Row="1" Margin="24,10,24,4">
                <!-- Hello: the animated G and a thank you -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:AnimatedLogo Grid.Column="0" Width="110" Height="110" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="{wpf:Text Welcome.Title}" FontSize="24" FontWeight="Bold" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="{wpf:Text Welcome.Thanks}" FontSize="14" Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- The steps of the wizard share one cell: the hidden ones keep their size, so the window doesn't jump.
                     A new step is a panel here and an entry in WelcomeWindow._steps -->
                <Grid>
                    <!-- Step: welcome -->
                    <StackPanel x:Name="StepWelcome">
                        <Border Style="{StaticResource CardStyle}">
                            <TextBlock Text="{wpf:Text Welcome.Intro}" FontSize="14" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- Step: the basics -->
                    <StackPanel x:Name="StepBasics" Visibility="Hidden">
                        <!-- The basics: the user's own hotkeys -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{wpf:Text Welcome.BasicsTitle}" Style="{StaticResource CardTitleStyle}"/>
                                <ItemsControl ItemsSource="{Binding Basics}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" HorizontalAlignment="Left" CornerRadius="4" Padding="8,2"
                                                        Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <TextBlock Text="{Binding Keys}" FontWeight="SemiBold"
                                                               Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{wpf:Text Welcome.BasicsMenu}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{wpf:Text Welcome.BasicsAfter}" Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Step: the setup -->
                    <StackPanel x:Name="StepSetup" Visibility="Hidden">
                        <!-- The setup: every check with ✓, or what keeps Greenshot from working as expected with a fix (SetupSectionViewModel, also in the Self-Service window) -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{wpf:Text Welcome.SetupTitle}" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="{wpf:Text Welcome.SetupSub}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Visibility="{Binding Setup.VersionPendingVisibility}" Text="{Binding Setup.VersionText}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Visibility="{Binding Setup.VersionOkVisibility}" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run Text="✓ " Foreground="{Binding AccentBrush}" FontWeight="Bold"/><Run Text="{Binding Setup.VersionText, Mode=OneWay}"/>
                                </TextBlock>
                                <Grid Visibility="{Binding Setup.VersionOldVisibility}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Setup.VersionText}" Foreground="{Binding WarningTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="{wpf:Text Welcome.SetupVersionDownload}" Style="{StaticResource SecondaryButtonStyle}" Click="OnDownloadClicked" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Visibility="{Binding Setup.TrayIconOkVisibility}" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run Text="✓ " Foreground="{Binding AccentBrush}" FontWeight="Bold"/><Run Text="{wpf:Text Welcome.SetupTrayOk}"/>
                                </TextBlock>
                                <Grid Visibility="{Binding Setup.TrayIconHiddenVisibility}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{wpf:Text Welcome.SetupTrayHidden}" Foreground="{Binding WarningTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="{wpf:Text Welcome.SetupTrayFix}" Style="{StaticResource SecondaryButtonStyle}" Click="OnShowTrayIconClicked" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Visibility="{Binding Setup.PrintKeyOkVisibility}" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run Text="✓ " Foreground="{Binding AccentBrush}" FontWeight="Bold"/><Run Text="{wpf:Text Welcome.SetupPrintOk}"/>
                                </TextBlock>
                                <Grid Visibility="{Binding Setup.SnippingToolVisibility}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{wpf:Text Welcome.SetupSnipping}" Foreground="{Binding WarningTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="{wpf:Text Welcome.SetupSnippingFix}" Style="{StaticResource SecondaryButtonStyle}" Click="OnFixSnippingToolClicked" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Visibility="{Binding Setup.OneDriveVisibility}" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{wpf:Text Welcome.SetupOnedrive}" Foreground="{Binding WarningTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="{wpf:Text Welcome.SetupOnedriveFix}" Style="{StaticResource SecondaryButtonStyle}" Click="OnFixOneDriveClicked" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- The same switch as in the settings: only this user's own entry, see docs/autostart.md -->
                                <CheckBox Content="{wpf:Text Settings.Autostartshortcut}" IsChecked="{Binding Setup.IsAutostartEnabled, Mode=TwoWay}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Step: done, with a tip -->
                    <StackPanel x:Name="StepDone" Visibility="Hidden">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{wpf:Text Welcome.DoneTitle}" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="{wpf:Text Welcome.Done}" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Content="{wpf:Text Welcome.ButtonSettings}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="OnSettingsClicked"/>
                            </StackPanel>
                        </Border>
                        <!-- A tip, from the set of tips in the language file -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💡" FontSize="20" VerticalAlignment="Top" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{wpf:Text Welcome.TipTitle}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CurrentTip}" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock>
                                        <Hyperlink Click="OnNextTipClicked">
                                            <TextBlock Text="{wpf:Text Welcome.TipNext}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{Binding CardBackgroundBrush}"
                    BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Where the user is: one dot per step -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding StepDots}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="1"
                            Content="{wpf:Text Welcome.ButtonBack}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{Binding BackVisibility}"
                            MinWidth="80"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="OnBackClicked"/>
                    <Button Grid.Column="2"
                            Content="{Binding NextText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            MinWidth="110"
                            Height="32"
                            Click="OnNextClicked"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

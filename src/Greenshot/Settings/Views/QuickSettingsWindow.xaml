<Window x:Class="Greenshot.Settings.Views.QuickSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text Core.ContextmenuQuicksettings}"
        SizeToContent="Height"
        Width="440"
        MinWidth="360"
        MaxHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="20,12,20,8" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Title}"
                                           Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibility}}"
                                           FontSize="{wpf:FontSize 13}"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,4"/>
                                <ItemsControl ItemsSource="{Binding Settings}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                          ToolTip="{Binding Description}"
                                                          Visibility="{Binding IsSwitch, Converter={StaticResource BoolToVisibility}}"/>
                                                <Grid Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" Content="{Binding Label}" Target="{Binding ElementName=ChoiceBox}"
                                                           ToolTip="{Binding Description}" VerticalAlignment="Center" Padding="0,0,8,0"/>
                                                    <ComboBox x:Name="ChoiceBox" Grid.Column="1" MinWidth="140"
                                                              ItemsSource="{Binding Choices}"
                                                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                              DisplayMemberPath="Label"/>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{Binding MoreText}"
                                        Command="{Binding MoreCommand}"
                                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource LinkTextButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{wpf:Text Core.ContextmenuSettings}"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="5,0"/>
                    <Button Content="{wpf:Text Editor.Close}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            IsCancel="True"
                            MinWidth="80"
                            Margin="5,0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

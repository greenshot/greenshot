<Window x:Class="Greenshot.Settings.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:views="clr-namespace:Greenshot.Base.Wpf.Views;assembly=Greenshot.Base"
        Title="{wpf:Text Settings.Title}"
        Icon="{Binding WindowIcon}"
        Width="820" Height="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="750" MinHeight="550"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/PillStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ComboBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ExpanderStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ListViewStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/GroupBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <wpf:ExpertVisibilityConverter x:Key="ExpertVisibilityConverter"/>
        <wpf:FixedToEnabledConverter x:Key="FixedToEnabledConverter"/>
        <wpf:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Modern TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        
        <!-- Modern TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TabItemBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="{wpf:FontSize 12}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource GreenshotFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TabItemSelectedBrush}"/>
                                <Setter Property="Panel.ZIndex" Value="100"/>
                            </Trigger>
                            <!-- The muted text color instead of transparency, which keeps the contrast of the palette (and high contrast) -->
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Modern Slider Style -->
        <Style TargetType="wpf:ValueSlider">
            <Setter Property="Margin" Value="6,3"/>
        </Style>


        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <wpf:ThemedTitleBar Grid.Row="0" ShowThemeToggle="True"/>
        
    <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Tab Control -->
        <TabControl x:Name="SettingsTabControl" Grid.Row="0">
            <!-- General Tab -->
            <TabItem Header="{wpf:Text Settings.General}">
                <ScrollViewer Style="{DynamicResource ThemedScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Application Settings -->
                        <GroupBox Header="{wpf:Text Settings.Applicationsettings}">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{wpf:Text Settings.Language}" Target="{Binding ElementName=LanguageComboBox}"/>
                                    <ComboBox x:Name="LanguageComboBox" Grid.Column="1" 
                                              ItemsSource="{Binding SupportedLanguages}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Ietf"
                                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                              IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=Language}"/>
                                </Grid>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{wpf:Text Settings.Theme}" Target="{Binding ElementName=ThemeComboBox}"/>
                                    <ComboBox x:Name="ThemeComboBox" Grid.Column="1"
                                              ItemsSource="{Binding Themes}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Theme"
                                              SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                              IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=Theme}"/>
                                </Grid>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{wpf:Text Settings.Iconsize}" Target="{Binding ElementName=IconSizeTextBox}"/>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="IconSizeTextBox"
                                                 Text="{Binding IconSize, Mode=TwoWay}" 
                                                 TextAlignment="Right"
                                                 IsReadOnly="True"
                                                 IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=BaseIconSize}"/>
                                        <!-- Side by side, big enough to hit; named, the glyphs say nothing to a screen reader -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="2,0,0,0" VerticalAlignment="Center">
                                            <Button Content="▲" Click="IconSizeUp_Click" Padding="4,0" FontSize="{wpf:FontSize 10}" MinWidth="26" MinHeight="26" Margin="0,0,2,0"
                                                    ToolTip="{wpf:Text Settings.IconsizeIncrease}"
                                                    AutomationProperties.Name="{wpf:Text Settings.IconsizeIncrease}"
                                                    IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=BaseIconSize}"/>
                                            <Button Content="▼" Click="IconSizeDown_Click" Padding="4,0" FontSize="{wpf:FontSize 10}" MinWidth="26" MinHeight="26"
                                                    ToolTip="{wpf:Text Settings.IconsizeDecrease}"
                                                    AutomationProperties.Name="{wpf:Text Settings.IconsizeDecrease}"
                                                    IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=BaseIconSize}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                
                                <CheckBox Content="{wpf:Text Settings.Autostartshortcut}"
                                          IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Hotkeys -->
                        <GroupBox Header="{wpf:Text Core.Hotkeys}">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label Grid.Row="0" Grid.Column="0" Content="{wpf:Text Core.ContextmenuCapturefullscreen}" VerticalAlignment="Center"/>
                                    <views:HotkeyDisplayView Grid.Row="0" Grid.Column="1"
                                                                  HeaderText="{wpf:Text Core.ContextmenuCapturefullscreen}"
                                                                  HotkeyString="{Binding CoreConfiguration.FullscreenHotkey, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=FullscreenHotkey}"
                                                                  EditRequested="HotkeyDisplayControl_EditRequested"/>
                                    
                                    <Label Grid.Row="1" Grid.Column="0" Content="{wpf:Text Core.ContextmenuCapturewindow}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <views:HotkeyDisplayView Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                                                  HeaderText="{wpf:Text Core.ContextmenuCapturewindow}"
                                                                  HotkeyString="{Binding CoreConfiguration.WindowHotkey, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=WindowHotkey}"
                                                                  EditRequested="HotkeyDisplayControl_EditRequested"/>
                                    
                                    <Label Grid.Row="2" Grid.Column="0" Content="{wpf:Text Core.ContextmenuCapturearea}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <views:HotkeyDisplayView Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                                                  HeaderText="{wpf:Text Core.ContextmenuCapturearea}"
                                                                  HotkeyString="{Binding CoreConfiguration.RegionHotkey, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=RegionHotkey}"
                                                                  EditRequested="HotkeyDisplayControl_EditRequested"/>
                                    
                                    <Label Grid.Row="3" Grid.Column="0" Content="{wpf:Text Core.ContextmenuCapturelastregion}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <views:HotkeyDisplayView Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                                                                  HeaderText="{wpf:Text Core.ContextmenuCapturelastregion}"
                                                                  HotkeyString="{Binding CoreConfiguration.LastregionHotkey, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=LastregionHotkey}"
                                                                  EditRequested="HotkeyDisplayControl_EditRequested"/>
                                    
                                    <Label Grid.Row="4" Grid.Column="0" Content="{wpf:Text Core.ContextmenuCaptureclipboard}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <views:HotkeyDisplayView Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
                                                                  HeaderText="{wpf:Text Core.ContextmenuCaptureclipboard}"
                                                                  HotkeyString="{Binding CoreConfiguration.ClipboardHotkey, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=ClipboardHotkey}"
                                                                  EditRequested="HotkeyDisplayControl_EditRequested"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Network Settings -->
                        <GroupBox Header="{wpf:Text Settings.Network}">
                            <StackPanel>
                                <CheckBox Content="{wpf:Text Settings.Usedefaultproxy}"
                                          IsChecked="{Binding CoreConfiguration.UseProxy, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=UseProxy}"/>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{wpf:Text Settings.Checkperiod}" Target="{Binding ElementName=CheckPeriodTextBox}"/>
                                    <TextBox x:Name="CheckPeriodTextBox" Grid.Column="1" HorizontalAlignment="Right" Width="80" TextAlignment="Right" Text="{Binding CoreConfiguration.UpdateCheckInterval}"
                                             IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=UpdateCheckInterval}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Capture Tab -->
            <TabItem Header="{wpf:Text Settings.Capture}">
                <ScrollViewer Style="{DynamicResource ThemedScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Header="{wpf:Text Settings.Capture}">
                            <StackPanel>
                                <CheckBox Content="{wpf:Text Settings.CaptureMousepointer}"
                                          IsChecked="{Binding CoreConfiguration.CaptureMousepointer, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=CaptureMousepointer}"/>
                                <CheckBox Content="{wpf:Text Settings.Playsound}"
                                          IsChecked="{Binding CoreConfiguration.PlayCameraSound, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=PlayCameraSound}"/>
                                <CheckBox Content="{wpf:Text Settings.Zoom}"
                                          IsChecked="{Binding CoreConfiguration.ZoomerEnabled, Mode=TwoWay}"
                                           IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=ZoomerEnabled}"/>
                                <CheckBox Content="{wpf:Text Settings.FreezeScreen}"
                                          ToolTip="{wpf:Text Settings.TooltipFreezeScreen}"
                                          IsChecked="{Binding CoreConfiguration.CaptureFreezeScreen, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=CaptureFreezeScreen}"/>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{wpf:Text Settings.Notifications}" Target="{Binding ElementName=NotificationsComboBox}"/>
                                    <ComboBox x:Name="NotificationsComboBox" Grid.Column="1"
                                              ItemsSource="{Binding NotificationLevels}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Level"
                                              SelectedValue="{Binding SelectedNotificationLevel, Mode=TwoWay}"
                                              IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=ShowTrayNotification}"/>
                                </Grid>
                                <!-- Only the toasts show a capture, not the balloons of the tray icon -->
                                <StackPanel IsEnabled="{Binding AreNotificationsShown}"
                                            Visibility="{Binding CanShowNotificationThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <CheckBox Content="{wpf:Text Settings.NotificationThumbnail}"
                                              IsChecked="{Binding CoreConfiguration.ShowNotificationThumbnail, Mode=TwoWay}"
                                              IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=ShowNotificationThumbnail}"/>
                                </StackPanel>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WaitTimeLabel"
                                               Text="{wpf:Text Settings.Waittime}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                    <TextBox Grid.Column="1" 
                                             HorizontalAlignment="Right"
                                             Width="70"
                                             TextAlignment="Right"
                                             Text="{Binding CoreConfiguration.CaptureDelay, Mode=TwoWay}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=WaitTimeLabel}"
                                             IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=CaptureDelay}"/>
                                </Grid>

                                <!-- The sizes of the fixed size capture: pills with an "x", the "+" opens a small popup for width and height -->
                                <StackPanel Margin="0,5"
                                            IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=FixedCaptureSizes}">
                                    <TextBlock Text="{wpf:Text Settings.FixedCaptureSizes}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"
                                               ToolTip="{wpf:Text Settings.TooltipFixedCaptureSizes}"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                    <WrapPanel ToolTip="{wpf:Text Settings.TooltipFixedCaptureSizes}">
                                        <ItemsControl ItemsSource="{Binding FixedCaptureSizes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource PillStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- A click on the size changes it -->
                                                            <Button Style="{StaticResource EditEntryButtonStyle}" Content="{Binding DisplayText}"
                                                                    ToolTip="{wpf:Text Settings.FixedCaptureSizesChange}"
                                                                    AutomationProperties.HelpText="{wpf:Text Settings.FixedCaptureSizesChange}"
                                                                    Click="ChangeFixedCaptureSize_Click"/>
                                                            <Button Style="{StaticResource RemoveEntryButtonStyle}" Margin="4,0,0,0"
                                                                    Click="RemoveFixedCaptureSize_Click"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button x:Name="AddFixedCaptureSizeButton"
                                                Style="{StaticResource AddPillButtonStyle}"
                                                ToolTip="{wpf:Text Settings.FixedCaptureSizesAdd}"
                                                AutomationProperties.Name="{wpf:Text Settings.FixedCaptureSizesAdd}"
                                                Click="AddFixedCaptureSize_Click"/>
                                    </WrapPanel>
                                    <!-- The recent captures, "+" keeps one in your own sizes -->
                                    <StackPanel Visibility="{Binding HasRecentFixedCaptureSizes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{wpf:Text Core.CaptureFixedSizesRecent}" FontSize="{wpf:FontSize 11}" Margin="0,4,0,4"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                        <ItemsControl ItemsSource="{Binding RecentFixedCaptureSizes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource PillStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                            <Button Style="{StaticResource TakeEntryButtonStyle}" Margin="4,0,0,0"
                                                                    ToolTip="{wpf:Text Settings.FixedCaptureSizesKeep}"
                                                                    AutomationProperties.Name="{wpf:Text Settings.FixedCaptureSizesKeep}"
                                                                    Click="KeepFixedCaptureSize_Click"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Popup x:Name="AddFixedCaptureSizePopup"
                                           PlacementTarget="{Binding ElementName=AddFixedCaptureSizeButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           Opened="AddFixedCaptureSizePopup_Opened">
                                        <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
                                                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0"
                                                KeyDown="AddFixedCaptureSizePopup_KeyDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="FixedCaptureSizeWidthLabel" Text="{wpf:Text Settings.FixedCaptureSizesWidth}" FontSize="{wpf:FontSize 11}" Margin="0,0,0,3"
                                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                <TextBlock x:Name="FixedCaptureSizeHeightLabel" Grid.Column="2" Text="{wpf:Text Settings.FixedCaptureSizesHeight}" FontSize="{wpf:FontSize 11}" Margin="0,0,0,3"
                                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                <TextBox x:Name="FixedCaptureSizeWidth" Grid.Row="1" TextAlignment="Right"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=FixedCaptureSizeWidthLabel}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="×" Margin="6,0" VerticalAlignment="Center"
                                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                                <TextBox x:Name="FixedCaptureSizeHeight" Grid.Row="1" Grid.Column="2" TextAlignment="Right"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=FixedCaptureSizeHeightLabel}"/>
                                                <!-- Optionally a place: X and Y from the top left of a screen or of the content of a program's window -->
                                                <TextBlock x:Name="FixedCaptureSizeXLabel" Grid.Row="2" Text="{wpf:Text Settings.FixedCaptureSizesX}" FontSize="{wpf:FontSize 11}" Margin="0,8,0,3"
                                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                <TextBlock x:Name="FixedCaptureSizeYLabel" Grid.Row="2" Grid.Column="2" Text="{wpf:Text Settings.FixedCaptureSizesY}" FontSize="{wpf:FontSize 11}" Margin="0,8,0,3"
                                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                <TextBox x:Name="FixedCaptureSizeX" Grid.Row="3" TextAlignment="Right"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=FixedCaptureSizeXLabel}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="," Margin="6,0" VerticalAlignment="Center"
                                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                                <TextBox x:Name="FixedCaptureSizeY" Grid.Row="3" Grid.Column="2" TextAlignment="Right"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=FixedCaptureSizeYLabel}"/>
                                                <TextBlock x:Name="FixedCaptureSizeRelativeToLabel" Grid.Row="4" Grid.ColumnSpan="3" Text="{wpf:Text Settings.FixedCaptureSizesRelativeTo}" FontSize="{wpf:FontSize 11}" Margin="0,8,0,3"
                                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                <ComboBox x:Name="FixedCaptureSizeRelativeTo" Grid.Row="5" Grid.ColumnSpan="3"
                                                          DisplayMemberPath="DisplayName"
                                                          AutomationProperties.LabeledBy="{Binding ElementName=FixedCaptureSizeRelativeToLabel}"/>
                                                <TextBlock x:Name="FixedCaptureSizeProgramLabel" Grid.Row="6" Grid.ColumnSpan="3" Text="{wpf:Text Settings.FixedCaptureSizesProgramName}" FontSize="{wpf:FontSize 11}" Margin="0,8,0,3"
                                                           Visibility="{Binding SelectedItem.IsProgram, ElementName=FixedCaptureSizeRelativeTo, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                <!-- The programs of the open windows to pick from, another name can be typed -->
                                                <ComboBox x:Name="FixedCaptureSizeProgram" Grid.Row="7" Grid.ColumnSpan="3" IsEditable="True"
                                                          Visibility="{Binding SelectedItem.IsProgram, ElementName=FixedCaptureSizeRelativeTo, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                                          AutomationProperties.LabeledBy="{Binding ElementName=FixedCaptureSizeProgramLabel}"/>
                                                <!-- "+" adds, "✓" when an entry is changed (set in code) -->
                                                <Button x:Name="FixedCaptureSizeConfirm" Grid.Row="1" Grid.Column="3" Content="+" Margin="8,0,0,0" Padding="10,2"
                                                        ToolTip="{wpf:Text Settings.FixedCaptureSizesAdd}"
                                                        AutomationProperties.Name="{wpf:Text Settings.FixedCaptureSizesAdd}"
                                                        Click="AddFixedCaptureSizeConfirm_Click"/>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <!-- What the fixed size capture remembers of the last captures, and whether picking a place moves the mouse -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{wpf:Text Settings.FixedCaptureRemembers}" Target="{Binding ElementName=FixedCaptureRemembersComboBox}"
                                           ToolTip="{wpf:Text Settings.TooltipFixedCaptureRemembers}"/>
                                    <ComboBox x:Name="FixedCaptureRemembersComboBox" Grid.Column="1"
                                              ItemsSource="{Binding FixedCaptureRememberChoices}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding CoreConfiguration.FixedCaptureRemembers, Mode=TwoWay}"
                                              ToolTip="{wpf:Text Settings.TooltipFixedCaptureRemembers}"
                                              IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=FixedCaptureRemembers}"/>
                                </Grid>
                                <CheckBox Content="{wpf:Text Settings.FixedCaptureMovesCursor}"
                                          ToolTip="{wpf:Text Settings.TooltipFixedCaptureMovesCursor}"
                                          IsChecked="{Binding CoreConfiguration.FixedCaptureMovesCursor, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=FixedCaptureMovesCursor}"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="{wpf:Text Settings.Windowscapture}">
                            <StackPanel>
                                <CheckBox Content="{wpf:Text Settings.CaptureWindowsInteractive}"
                                          IsChecked="{Binding CoreConfiguration.CaptureWindowsInteractive, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=CaptureWindowsInteractive}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{wpf:Text Settings.Ocr}"
                                  Visibility="{Binding HasOcr, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OcrLanguageLabel"
                                           Text="{wpf:Text Settings.OcrLanguage}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           ToolTip="{wpf:Text Settings.TooltipOcrLanguage}"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <ComboBox Grid.Column="1"
                                          MinWidth="200"
                                          ItemsSource="{Binding OcrLanguages}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="LanguageTag"
                                          SelectedValue="{Binding SelectedOcrLanguage, Mode=TwoWay}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=OcrLanguageLabel}"
                                          ToolTip="{wpf:Text Settings.TooltipOcrLanguage}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Output Tab -->
            <TabItem Header="{wpf:Text Settings.Output}">
                <ScrollViewer Style="{DynamicResource ThemedScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Header="{wpf:Text Settings.Preferredfilesettings}">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label Grid.Row="0" Grid.Column="0" Content="{wpf:Text Settings.Storagelocation}" Margin="0,0,12,0" Target="{Binding ElementName=StorageLocationTextBox}"/>
                                    <TextBox x:Name="StorageLocationTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding CoreConfiguration.OutputFilePath}"
                                             IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputFilePath}"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="..." Style="{StaticResource SecondaryButtonStyle}" Margin="6,2,0,2" Click="BrowseStorageLocation_Click"
                                            ToolTip="{wpf:Text Settings.StoragelocationBrowse}"
                                            AutomationProperties.Name="{wpf:Text Settings.StoragelocationBrowse}"
                                             IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputFilePath}"/>
                                    
                                    <Label Grid.Row="1" Grid.Column="0" Content="{wpf:Text Settings.Filenamepattern}" Margin="0,0,12,0" Target="{Binding ElementName=FilenamePatternTextBox}"/>
                                    <TextBox x:Name="FilenamePatternTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding CoreConfiguration.OutputFileFilenamePattern}"
                                             IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputFileFilenamePattern}"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="?" Style="{StaticResource SecondaryButtonStyle}" Margin="6,2,0,2" Click="ShowPatternHelp_Click"
                                            ToolTip="{wpf:Text Settings.FilenamepatternHelp}"
                                            AutomationProperties.Name="{wpf:Text Settings.FilenamepatternHelp}"
                                             IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputFileFilenamePattern}"/>
                                    
                                    <Label Grid.Row="2" Grid.Column="0" Content="{wpf:Text Settings.Primaryimageformat}" Margin="0,0,12,0" Target="{Binding ElementName=ImageFormatComboBox}"/>
                                    <ComboBox x:Name="ImageFormatComboBox" Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding ImageFormats}"
                                              DisplayMemberPath="DisplayNameWithPreferredExtension"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding CoreConfiguration.OutputFileFormat, Mode=TwoWay}"
                                              IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputFileFormat}"/>
                                </Grid>
                                
                                <CheckBox Content="{wpf:Text Settings.Copypathtoclipboard}"
                                          IsChecked="{Binding CoreConfiguration.OutputFileCopyPathToClipboard, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputFileCopyPathToClipboard}"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="{wpf:Text Settings.Qualitysettings}">
                            <StackPanel>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="85"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{wpf:Text Settings.Jpegquality}" Target="{Binding ElementName=JpegQualitySlider}"/>
                                    <wpf:ValueSlider x:Name="JpegQualitySlider" ValueFormat="{}{0}%" Grid.Column="1" 
                                            Minimum="0" Maximum="100" 
                                            TickFrequency="10" 
                                            IsSnapToTickEnabled="True" 
                                            Value="{Binding CoreConfiguration.OutputFileJpegQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputFileJpegQuality}"/>
                                    <!-- Only shows the value, the slider says it to a screen reader: no tab stop -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ElementName=JpegQualitySlider, Path=ValueText}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                
                                <CheckBox Content="{wpf:Text Settings.Alwaysshowqualitydialog}"
                                          IsChecked="{Binding CoreConfiguration.OutputFilePromptQuality, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputFilePromptQuality}"/>
                                <CheckBox Content="{wpf:Text Settings.Reducecolors}"
                                          IsChecked="{Binding CoreConfiguration.OutputFileReduceColors, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputFileReduceColors}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Destinations Tab -->
            <TabItem Header="{wpf:Text Settings.Destination}">
                    <GroupBox Header="{wpf:Text Settings.Destination}">
                        <DockPanel LastChildFill="True">
                            <CheckBox Content="{wpf:Text Settings.DestinationPicker}" 
                                      IsChecked="{Binding PickerSelected, Mode=TwoWay}" 
                                      IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputDestinations}"
                                      Margin="5" DockPanel.Dock="Top"/>
                            <!-- Which destinations can be used, greenshot-fixed.ini makes it a restriction -->
                            <DockPanel DockPanel.Dock="Bottom" Margin="5" LastChildFill="False">
                                <Button DockPanel.Dock="Right" Content="{wpf:Text Settings.BlockDestinations}" Style="{StaticResource SecondaryButtonStyle}" Click="AdministratorSettings_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="{wpf:Text Settings.SetByAdministrator}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                                           Visibility="{Binding AreDestinationExclusionsFixed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </DockPanel>
                            <ListView ItemsSource="{Binding Destinations}" 
                                      AutomationProperties.Name="{wpf:Text Settings.Destination}"
                                      KeyboardNavigation.TabNavigation="Continue"
                                      Style="{DynamicResource ThemeListView}"
                                      Margin="5" 
                                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                                      ScrollViewer.CanContentScroll="False"
                                      IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputDestinations}">
                                <ListView.ItemContainerStyle>
                                    <!-- The rows take no focus: Tab (and the arrow keys) go from check box to check box, Space switches one -->
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ThemeListViewItem}">
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{DynamicResource ThemeGridViewColumnHeader}">
                                        <GridViewColumn Width="50">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              AutomationProperties.Name="{Binding Description, TargetNullValue=''}">
                                                        <!-- Not with the picker, and not for a destination which isn't available -->
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource GreenshotCheckBoxStyle}">
                                                                <Setter Property="IsEnabled" Value="{Binding DataContext.PickerSelected, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource InverseBooleanConverter}}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAllowed}" Value="False">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Destination}" Value="{x:Null}">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{wpf:Text Settings.Destination}" Width="330">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding IconSource}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{wpf:Text Settings.DestinationAvailable}" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                                              AutomationProperties.Name="{Binding Description, TargetNullValue=''}"
                                                              AutomationProperties.HelpText="{wpf:Text Settings.DestinationAvailable}"
                                                              IsEnabled="{Binding CanChangeAllowed}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </GroupBox>
            </TabItem>
            
            <!-- Editor Tab -->
            <TabItem Header="{wpf:Text Settings.Editor}">
                <ScrollViewer Style="{DynamicResource ThemedScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Header="{wpf:Text Settings.Editor}">
                            <StackPanel>
                                <CheckBox Content="{wpf:Text Editor.MatchCaptureSize}"
                                          IsChecked="{Binding EditorConfiguration.MatchSizeToCapture, Mode=TwoWay}"
                                          IsEnabled="{Binding EditorConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=MatchSizeToCapture}"/>
                                <CheckBox Content="{wpf:Text Settings.EditorTabs}"
                                          IsChecked="{Binding EditorConfiguration.EditorTabs, Mode=TwoWay}"
                                          IsEnabled="{Binding EditorConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=EditorTabs}"/>
                                <CheckBox Content="{wpf:Text Settings.OpenCaptureAsTab}" Margin="20,0,0,0"
                                          IsChecked="{Binding EditorConfiguration.OpenCaptureAsTab, Mode=TwoWay}">
                                    <!-- Only with tabs -->
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource GreenshotCheckBoxStyle}">
                                            <Setter Property="IsEnabled" Value="{Binding EditorConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OpenCaptureAsTab}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EditorConfiguration.EditorTabs}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <CheckBox Content="{wpf:Text Settings.ExpertSuppresssavedialogatclose}"
                                          IsChecked="{Binding EditorConfiguration.SuppressSaveDialogAtClose, Mode=TwoWay}"
                                          IsEnabled="{Binding EditorConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=SuppressSaveDialogAtClose}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- The image of the "+" after the tabs, and of the editor without a capture -->
                        <GroupBox Header="{wpf:Text Editor.NewImage}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="NewImageSizeLabel" Text="{wpf:Text Settings.NewImageSize}" VerticalAlignment="Center" Margin="0,4,12,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4"
                                            IsEnabled="{Binding EditorConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=DefaultEditorSize}">
                                    <TextBox Width="70" TextAlignment="Right" Text="{Binding NewImageWidth, Mode=TwoWay}"
                                             ToolTip="{wpf:Text Settings.FixedCaptureSizesWidth}"
                                             AutomationProperties.Name="{wpf:Text Settings.FixedCaptureSizesWidth}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=NewImageSizeLabel}"/>
                                    <TextBlock Text="×" Margin="6,0" VerticalAlignment="Center"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                    <TextBox Width="70" TextAlignment="Right" Text="{Binding NewImageHeight, Mode=TwoWay}"
                                             ToolTip="{wpf:Text Settings.FixedCaptureSizesHeight}"
                                             AutomationProperties.Name="{wpf:Text Settings.FixedCaptureSizesHeight}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=NewImageSizeLabel}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{wpf:Text Settings.NewImageColor}" VerticalAlignment="Center" Margin="0,4,12,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,4" Padding="2"
                                        ToolTip="{wpf:Text Settings.NewImageColor}"
                                        AutomationProperties.Name="{wpf:Text Settings.NewImageColor}"
                                        AutomationProperties.HelpText="{wpf:Text Core.AccessibleChooseColor}"
                                        IsEnabled="{Binding EditorConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=NewImageColor}"
                                        Click="NewImageColor_Click">
                                    <Border Width="40" Height="16" BorderThickness="1" Background="{Binding NewImageBrush}"
                                            BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
                                </Button>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Printer Tab -->
            <TabItem Header="{wpf:Text Settings.Printer}">
                <ScrollViewer Style="{DynamicResource ThemedScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Header="{wpf:Text Settings.Printoptions}">
                            <StackPanel>
                                <CheckBox Content="{wpf:Text Settings.Alwaysshowprintoptionsdialog}"
                                          IsChecked="{Binding CoreConfiguration.OutputPrintPromptOptions, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputPrintPromptOptions}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{wpf:Text Core.PrintoptionsColors}">
                            <StackPanel>
                                <CheckBox Content="{wpf:Text Core.PrintoptionsInverted}"
                                          IsChecked="{Binding CoreConfiguration.OutputPrintInverted, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputPrintInverted}"/>
                                <RadioButton Style="{StaticResource DefaultRadioButtonStyle}" Content="{wpf:Text Core.PrintoptionsPrintcolor}"
                                             GroupName="PrintColorMode"
                                             IsChecked="{Binding PrintColor, Mode=TwoWay}">
                                    <RadioButton.IsEnabled>
                                        <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="OutputPrintGrayscale">
                                            <Binding Path="CoreConfiguration"/>
                                        </MultiBinding>
                                    </RadioButton.IsEnabled>
                                </RadioButton>
                                <RadioButton Style="{StaticResource DefaultRadioButtonStyle}" Content="{wpf:Text Core.PrintoptionsPrintgrayscale}"
                                             GroupName="PrintColorMode"
                                             IsChecked="{Binding PrintGrayscale, Mode=TwoWay}"
                                             IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputPrintGrayscale}"/>
                                <RadioButton Style="{StaticResource DefaultRadioButtonStyle}" Content="{wpf:Text Core.PrintoptionsPrintmonochrome}"
                                             GroupName="PrintColorMode"
                                             IsChecked="{Binding PrintMonochrome, Mode=TwoWay}"
                                             IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputPrintMonochrome}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{wpf:Text Core.PrintoptionsLayout}">
                            <StackPanel>
                                <CheckBox Content="{wpf:Text Core.PrintoptionsTimestamp}"
                                          IsChecked="{Binding CoreConfiguration.OutputPrintFooter, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputPrintFooter}"/>
                                <Grid Margin="20,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{wpf:Text Settings.ExpertFooterpattern}" VerticalAlignment="Center" Target="{Binding ElementName=FooterPatternTextBox}"/>
                                    <TextBox x:Name="FooterPatternTextBox" Grid.Column="1" Text="{Binding CoreConfiguration.OutputPrintFooterPattern, Mode=TwoWay}">
                                        <TextBox.IsEnabled>
                                            <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="OutputPrintFooterPattern">
                                                <Binding Path="CoreConfiguration.OutputPrintFooter"/>
                                                <Binding Path="CoreConfiguration"/>
                                            </MultiBinding>
                                        </TextBox.IsEnabled>
                                    </TextBox>
                                </Grid>
                                <CheckBox Content="{wpf:Text Core.PrintoptionsAllowshrink}"
                                          IsChecked="{Binding CoreConfiguration.OutputPrintAllowShrink, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputPrintAllowShrink}"/>
                                <CheckBox Content="{wpf:Text Core.PrintoptionsAllowenlarge}"
                                          IsChecked="{Binding CoreConfiguration.OutputPrintAllowEnlarge, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputPrintAllowEnlarge}"/>
                                <CheckBox Content="{wpf:Text Core.PrintoptionsAllowrotate}"
                                          IsChecked="{Binding CoreConfiguration.OutputPrintAllowRotate, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputPrintAllowRotate}"/>
                                <CheckBox Content="{wpf:Text Core.PrintoptionsAllowcenter}"
                                          IsChecked="{Binding CoreConfiguration.OutputPrintCenter, Mode=TwoWay}"
                                          IsEnabled="{Binding CoreConfiguration, Converter={StaticResource FixedToEnabledConverter}, ConverterParameter=OutputPrintCenter}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Recipes Tab: the extensions (border, drop shadow, caption, ...) and the options recipes declare, one compact card each -->
            <TabItem x:Name="RecipesTabItem" Header="{wpf:Text Settings.Recipes}"
                     Visibility="{Binding HasRecipeOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer Style="{DynamicResource ThemedScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.Resources>
                            <!-- Compact fields: one line per option -->
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Height" Value="24"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <!-- The text centered in the box -->
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{wpf:Text Settings.RecipesDescription}" TextWrapping="Wrap" Margin="4,0,4,6"
                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                        <ItemsControl ItemsSource="{Binding RecipeOptionGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4,2" Padding="10,6" CornerRadius="6" BorderThickness="1"
                                            Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                                            BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}">
                                        <StackPanel>
                                            <!-- The name with its description on one line; an extension has its on/off checkbox in front -->
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{wpf:Text Settings.RecipesReset}" Padding="6,0" Margin="8,0,0,0"
                                                        VerticalAlignment="Center" Command="{Binding ResetCommand}"
                                                        Visibility="{Binding IsOn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                          Visibility="{Binding HasSwitch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding Description, Mode=OneWay}" Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                    </TextBlock>
                                                </CheckBox>
                                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Visibility="{Binding HasNoSwitch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Description, Mode=OneWay}" Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <!-- Only while it is on: the options, and where it is used -->
                                            <StackPanel Margin="20,4,0,0" Visibility="{Binding IsOn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl ItemsSource="{Binding BodyItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1" IsEnabled="{Binding IsEditable}" ToolTip="{Binding Description}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="140"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- A switch takes the whole row -->
                                                                <CheckBox Grid.ColumnSpan="2" Content="{Binding Label}" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                                          Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                                           Visibility="{Binding HasLabelColumn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <!-- Number: a box with the range next to it -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            Visibility="{Binding IsNumber, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBox Width="60" Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                             AutomationProperties.Name="{Binding Label, TargetNullValue=''}"/>
                                                                    <TextBlock Text="{Binding RangeText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                                                </StackPanel>
                                                                <!-- Text -->
                                                                <TextBox Grid.Column="1" Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                         AutomationProperties.Name="{Binding Label, TargetNullValue=''}"
                                                                         Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <!-- Choice -->
                                                                <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="140"
                                                                          ItemsSource="{Binding Choices}" DisplayMemberPath="DisplayLabel"
                                                                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                                          AutomationProperties.Name="{Binding Label, TargetNullValue=''}"
                                                                          Visibility="{Binding IsEnum, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <!-- Color: the swatch opens the color picker, the text can be typed -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            Visibility="{Binding IsColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Button Width="28" Height="22" Padding="0" VerticalAlignment="Center" Click="RecipeOptionColor_Click"
                                                                            AutomationProperties.Name="{Binding Label, TargetNullValue=''}"
                                                                            AutomationProperties.HelpText="{wpf:Text Core.AccessibleChooseColor}"
                                                                            ToolTip="{wpf:Text Core.AccessibleChooseColor}">
                                                                        <Border Width="20" Height="12" Background="{Binding ColorBrush}" BorderThickness="1"
                                                                                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
                                                                    </Button>
                                                                    <TextBox Width="80" Margin="6,1,0,1" Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                             AutomationProperties.Name="{Binding Label, TargetNullValue=''}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Extensions: where they are used, changed in a dialog with the captures and the destinations -->
                                                <Grid Margin="0,3,0,0" Visibility="{Binding HasUseIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{wpf:Text Settings.RecipesUsedfor}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ScopeSummary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <Button Grid.Column="2" Content="{wpf:Text Settings.RecipesChange}" Padding="6,0" Margin="8,0,0,0"
                                                            VerticalAlignment="Center" Click="RecipeExtensionScope_Click"/>
                                                </Grid>                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Per recipe, the extensions which change it, with the values above -->
                        <Border Margin="4,2" Padding="10,6" CornerRadius="6" BorderThickness="1"
                                Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="{wpf:Text Settings.RecipesChanges}" FontWeight="SemiBold"/>
                                <TextBlock Text="{wpf:Text Settings.RecipesChangesNone}" TextWrapping="Wrap" Margin="20,2,0,0"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                                           Visibility="{Binding HasNoRecipeChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding RecipeChanges}" Margin="20,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Extensions}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Recipes}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AI tools Tab (greenshot-mcp): an opt-in, shown for beta testers -->
            <TabItem x:Name="AiToolsTabItem" Header="{wpf:Text Settings.Aitools}"
                     Visibility="{Binding CoreConfiguration.IsBetaTester, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Plugin Tab -->
            <TabItem x:Name="PluginsTabItem" Header="{wpf:Text Settings.Plugins}"/>
            
            <!-- Expert Tab -->
            <TabItem x:Name="ExpertTabItem" Header="{wpf:Text Core.Expertsettings}" Visibility="{Binding IsExpertTabVisible, Converter={StaticResource ExpertVisibilityConverter}}">
                <ScrollViewer Style="{DynamicResource ThemedScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Top Banner: Enable Expert Mode set apart -->
                        <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="8,8,8,4">
                            <CheckBox Content="{wpf:Text Settings.ExpertEnableexpert}"
                                      FontWeight="SemiBold"
                                      IsChecked="{Binding ExpertModeEnabled, Mode=TwoWay}"/>
                        </Border>
                        
                        <!-- Expert settings container: enabled only when expert mode is enabled -->
                        <GroupBox Header="{wpf:Text Core.Expertsettings}"
                                  Margin="8,4,8,8"
                                  IsEnabled="{Binding ExpertModeEnabled}">
                            <StackPanel>
                                <CheckBox Content="{wpf:Text Settings.ExpertAutoreducecolors}"
                                          IsChecked="{Binding CoreConfiguration.OutputFileAutoReduceColors, Mode=TwoWay}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="OutputFileAutoReduceColors">
                                            <Binding Path="ExpertModeEnabled"/>
                                            <Binding Path="CoreConfiguration"/>
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>
                                
                                <CheckBox Content="{wpf:Text Settings.ExpertOptimizeforrdp}"
                                          IsChecked="{Binding CoreConfiguration.OptimizeForRDP, Mode=TwoWay}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="OptimizeForRDP">
                                            <Binding Path="ExpertModeEnabled"/>
                                            <Binding Path="CoreConfiguration"/>
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>
                                
                                <CheckBox Content="{wpf:Text Settings.ExpertThumbnailpreview}"
                                          IsChecked="{Binding CoreConfiguration.ThumnailPreview, Mode=TwoWay}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="ThumnailPreview">
                                            <Binding Path="ExpertModeEnabled"/>
                                            <Binding Path="CoreConfiguration"/>
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>
                                
                                <CheckBox Content="{wpf:Text Settings.ExpertCheckunstableupdates}"
                                          IsChecked="{Binding CoreConfiguration.CheckForUnstable, Mode=TwoWay}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="CheckForUnstable">
                                            <Binding Path="ExpertModeEnabled"/>
                                            <Binding Path="CoreConfiguration"/>
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>
                                
                                <CheckBox Content="{wpf:Text Settings.ExpertBetatester}"
                                          IsChecked="{Binding CoreConfiguration.IsBetaTester, Mode=TwoWay}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="IsBetaTester">
                                            <Binding Path="ExpertModeEnabled"/>
                                            <Binding Path="CoreConfiguration"/>
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>
                                
                                <!-- What a screenshot contains (HDR, covered windows), so no part of the memory profiles -->
                                <CheckBox Content="{wpf:Text Settings.ExpertGraphicscapture}"
                                          IsChecked="{Binding CoreConfiguration.UseGraphicsCapture, Mode=TwoWay}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="UseGraphicsCapture">
                                            <Binding Path="ExpertModeEnabled"/>
                                            <Binding Path="CoreConfiguration"/>
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>

                                <!-- Programs can leave the screen reader flag of Windows on, then the capture keeps starting as with a screen reader -->
                                <CheckBox Content="{wpf:Text Settings.ExpertIgnorescreenreader}"
                                          IsChecked="{Binding CoreConfiguration.IgnoreScreenReader, Mode=TwoWay}">
                                    <CheckBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="IgnoreScreenReader">
                                            <Binding Path="ExpertModeEnabled"/>
                                            <Binding Path="CoreConfiguration"/>
                                        </MultiBinding>
                                    </CheckBox.IsEnabled>
                                </CheckBox>

                                <!-- Memory and speed, collapsed: the header shows the profile the settings match. The profile sets the settings, which can also be changed one by one -->
                                <Expander Margin="0,8,0,5" Style="{StaticResource ExpanderStyle}"
                                          AutomationProperties.Name="{wpf:Text Settings.MemoryProfile}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{wpf:Text Settings.MemoryProfile}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SelectedMemoryProfileName}" Margin="8,0,0,0"
                                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="18,4,0,0">
                                        <!-- The profile; the header of the group already names it -->
                                        <ComboBox Margin="0,0,0,5"
                                                  AutomationProperties.Name="{wpf:Text Settings.MemoryProfile}"
                                                  ItemsSource="{Binding MemoryProfileOptions}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Profile"
                                                  SelectedValue="{Binding SelectedMemoryProfile, Mode=TwoWay}"
                                                  ToolTip="{wpf:Text Settings.TooltipMemoryProfile}"/>

                                        <CheckBox Content="{wpf:Text Settings.ExpertHardwarerendering}"
                                                  IsChecked="{Binding CoreConfiguration.HardwareRendering, Mode=TwoWay}">
                                            <CheckBox.IsEnabled>
                                                <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="HardwareRendering">
                                                    <Binding Path="ExpertModeEnabled"/>
                                                    <Binding Path="CoreConfiguration"/>
                                                </MultiBinding>
                                            </CheckBox.IsEnabled>
                                        </CheckBox>

                                        <CheckBox Content="{wpf:Text Settings.ExpertKeepgraphicscaptureready}"
                                                  IsChecked="{Binding CoreConfiguration.KeepGraphicsCaptureReady, Mode=TwoWay}">
                                            <CheckBox.IsEnabled>
                                                <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="KeepGraphicsCaptureReady">
                                                    <Binding Path="ExpertModeEnabled"/>
                                                    <Binding Path="CoreConfiguration"/>
                                                </MultiBinding>
                                            </CheckBox.IsEnabled>
                                        </CheckBox>

                                        <CheckBox Content="{wpf:Text Settings.ExpertPrewarmcapture}"
                                                  IsChecked="{Binding CoreConfiguration.PrewarmCapture, Mode=TwoWay}">
                                            <CheckBox.IsEnabled>
                                                <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="PrewarmCapture">
                                                    <Binding Path="ExpertModeEnabled"/>
                                                    <Binding Path="CoreConfiguration"/>
                                                </MultiBinding>
                                            </CheckBox.IsEnabled>
                                        </CheckBox>

                                        <CheckBox Content="{wpf:Text Settings.ExpertPrewarmeditor}"
                                                  IsChecked="{Binding CoreConfiguration.PrewarmEditor, Mode=TwoWay}">
                                            <CheckBox.IsEnabled>
                                                <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="PrewarmEditor">
                                                    <Binding Path="ExpertModeEnabled"/>
                                                    <Binding Path="CoreConfiguration"/>
                                                </MultiBinding>
                                            </CheckBox.IsEnabled>
                                        </CheckBox>

                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="BufferPoolLimitLabel"
                                                       Text="{wpf:Text Settings.ExpertBufferpoollimit}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                            <TextBox Grid.Column="1"
                                                     HorizontalAlignment="Right"
                                                     Width="70"
                                                     TextAlignment="Right"
                                                     Text="{Binding CoreConfiguration.BufferPoolLimit, Mode=TwoWay}"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=BufferPoolLimitLabel}">
                                                <TextBox.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="BufferPoolLimit">
                                                        <Binding Path="ExpertModeEnabled"/>
                                                        <Binding Path="CoreConfiguration"/>
                                                    </MultiBinding>
                                                </TextBox.IsEnabled>
                                            </TextBox>
                                        </Grid>

                                        <CheckBox Content="{wpf:Text Settings.ExpertMinimizememoryfootprint}"
                                                  IsChecked="{Binding CoreConfiguration.MinimizeWorkingSetSize, Mode=TwoWay}">
                                            <CheckBox.IsEnabled>
                                                <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="MinimizeWorkingSetSize">
                                                    <Binding Path="ExpertModeEnabled"/>
                                                    <Binding Path="CoreConfiguration"/>
                                                </MultiBinding>
                                            </CheckBox.IsEnabled>
                                        </CheckBox>
                                    </StackPanel>
                                </Expander>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CounterLabel"
                                               Text="{wpf:Text Settings.ExpertCounter}" 
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                    <TextBox Grid.Column="1" 
                                             HorizontalAlignment="Right"
                                             Width="70"
                                             TextAlignment="Right"
                                             Text="{Binding CoreConfiguration.OutputFileIncrementingNumber, Mode=TwoWay}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=CounterLabel}">
                                        <TextBox.IsEnabled>
                                            <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="OutputFileIncrementingNumber">
                                                <Binding Path="ExpertModeEnabled"/>
                                                <Binding Path="CoreConfiguration"/>
                                            </MultiBinding>
                                        </TextBox.IsEnabled>
                                    </TextBox>
                                </Grid>


                                <GroupBox Header="{wpf:Text Settings.ExpertClipboardformats}" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding ClipboardFormats}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <CheckBox.IsEnabled>
                                                        <MultiBinding Converter="{StaticResource FixedToEnabledConverter}" ConverterParameter="ClipboardFormats">
                                                            <Binding Path="DataContext.ExpertModeEnabled" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                            <Binding Path="DataContext.CoreConfiguration" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                        </MultiBinding>
                                                    </CheckBox.IsEnabled>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0">
            <Button Content="{wpf:Text Core.Ok}" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="90" 
                    Margin="5,0"
                    IsDefault="True"
                    Click="OkButton_Click"/>
                <Button Content="{wpf:Text Core.Cancel}" 
                        Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="90"
                    Margin="5,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- In-Window Modal Hotkey Editor Overlay -->
        <views:HotkeyEditorView x:Name="HotkeyModal"
                               Grid.Row="0"
                               Grid.RowSpan="2"
                               Visibility="Collapsed"/>
    </Grid>
</Window>

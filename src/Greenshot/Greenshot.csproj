<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <RootNamespace>Greenshot</RootNamespace>
    <AssemblyName>Greenshot</AssemblyName>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>icons\applicationIcon\icon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationManifest>greenshot.manifest</ApplicationManifest>
	  <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
	  <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <!-- DebugLight and ReleaseLight build Greenshot Light, see Directory.Build.props -->
    <Configurations>Debug;Release;DebugLight;ReleaseLight</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Greenshot.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The edition, read by Greenshot.Base.Core.EditionInfo -->
    <AssemblyMetadata Include="GreenshotEdition" Value="$(GreenshotEdition)" />
  </ItemGroup>
  <!-- Every edition but Full has its name in the version info, so Explorer's file properties show it -->
  <PropertyGroup Condition="'$(GreenshotEdition)' != 'Full'">
    <Product>Greenshot $(GreenshotEdition)</Product>
  </PropertyGroup>
  <!--
    Greenshot Light (/p:GreenshotEdition=Light, or the DebugLight / ReleaseLight configurations): the basics only, for the Light installer
    (setup-light.iss) and the Light portable version. GREENSHOT_LIGHT compiles out loading plugins, the AI tools (greenshot-mcp) and the
    browser extension. It is built next to the full version, in bin\Debug-Light or bin\Release-Light; the Release build of
    Greenshot-Installer builds it too.
  -->
  <PropertyGroup Condition="'$(GreenshotEdition)' == 'Light'">
    <DefineConstants>$(DefineConstants);GREENSHOT_LIGHT</DefineConstants>
    <OutputPath>bin\$(GreenshotBaseConfiguration)-Light\</OutputPath>
    <IntermediateOutputPath>obj\$(GreenshotBaseConfiguration)-Light\</IntermediateOutputPath>
  </PropertyGroup>
  <!-- The code Greenshot Light doesn't have: loading plugins, the AI tools (greenshot-mcp) and the browser extension, with their settings tabs -->
  <ItemGroup Condition="'$(GreenshotEdition)' == 'Light'">
    <Compile Remove="Ipc\BrowserExtension\**\*.cs" />
    <Compile Remove="Settings\ViewModels\SettingsViewModel.AiTools.cs" />
    <Compile Remove="Settings\ViewModels\SettingsViewModel.Plugins.cs" />
    <Compile Remove="Ai\**\*.cs" />
    <Compile Remove="Plugins\**\*.cs" />
    <Page Remove="Ai\**\*.xaml" />
    <Page Remove="Plugins\**\*.xaml" />
  </ItemGroup>
  <!--
    Greenshot Light must not contain that code at all, not only leave it unused: the build fails when one of these types
    (or members) is in the compiled Greenshot.exe. Names are looked up in the metadata string heap (UTF-8, zero terminated).
  -->
  <UsingTask TaskName="CheckLightAssembly" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Assembly ParameterType="System.String" Required="true" />
      <ForbiddenNames ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        byte[] content = File.ReadAllBytes(Assembly);
        string latin = Encoding.GetEncoding("ISO-8859-1").GetString(content);
        var found = ForbiddenNames.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(n => n.Trim())
            .Where(n => latin.Contains("\0" + n + "\0"))
            .ToList();
        foreach (var name in found)
        {
            Log.LogError("Greenshot Light must not contain " + name + ", it is in " + Assembly);
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>
  <Target Name="CheckLightAssembly" AfterTargets="CoreCompile" Condition="'$(GreenshotEdition)' == 'Light'">
    <CheckLightAssembly Assembly="@(IntermediateAssembly->'%(FullPath)')" ForbiddenNames="PluginHelper;LoadPluginsAsync;AiToolIpcHandler;AiRecipeIpcHandler;AiToolCaller;AiToolClient;AiToolAccess;AiToolCapture;AiWindowRefs;McpServerStatus;RegisterAiToolRecipes;ImportCaptureDecoder;BrowserContextTracker;ExtensionOriginPolicy;HandleImportCaptureAsync;AiToolsSettingsPage;PluginsSettingsPage;AiToolsIpcExtension;AiToolRecipes;BrowserExtensionIpcExtension;BrowserExtensionRecipes" />
  </Target>
  <PropertyGroup Condition="'$(GreenshotBaseConfiguration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Languages\greenshot*.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="icons\applicationIcon\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapplo.Windows.AppRestartManager" Version="3.13.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.1.26104.118" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" version="7.1.3" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!-- Images and sounds, loaded with EmbeddedResources (non string .resx entries would need System.Resources.Extensions) -->
    <EmbeddedResource Include="Resources\Tray\*.png" LogicalName="Greenshot.Shell.TrayMenu.%(Filename)" />
    <EmbeddedResource Include="sounds\camera.wav" LogicalName="Greenshot.Sounds.camera" />
  </ItemGroup>

  <ItemGroup>
    <!-- The edition only changes Greenshot.exe, the libraries are the same (and built as Debug or Release for DebugLight and ReleaseLight) -->
    <ProjectReference Include="..\Greenshot.Base\Greenshot.Base.csproj" UndefineProperties="GreenshotEdition" SetConfiguration="Configuration=$(GreenshotBaseConfiguration)" />
    <ProjectReference Include="..\Greenshot.Editor\Greenshot.Editor.csproj" UndefineProperties="GreenshotEdition" SetConfiguration="Configuration=$(GreenshotBaseConfiguration)" />
    <ProjectReference Include="..\Greenshot.BuildTasks\Greenshot.BuildTasks.csproj" ReferenceOutputAssembly="false" ExcludeAssets="all" UndefineProperties="GreenshotEdition" SetConfiguration="Configuration=$(GreenshotBaseConfiguration)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net-release.xml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageReference Update="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageReference Update="MSBuildTasks" Version="1.5.0.235">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <UsingTask TaskName="EmojiDataTask" TaskFactory="TaskHostFactory" AssemblyFile="..\Greenshot.BuildTasks\bin\$(GreenshotBaseConfiguration)\$(TargetFramework)\Greenshot.BuildTasks.dll" />

  <!-- After ResolveProjectReferences: that builds Greenshot.BuildTasks, in a clean build its dll doesn't exist before (BeforeBuild is too early) -->
  <Target Name="GenerateEmojiTestTxtFile" AfterTargets="ResolveProjectReferences" Condition="'$(BuildingProject)' == 'true' And '$(DesignTimeBuild)' != 'true'" Inputs="..\Greenshot.Editor\Controls\Emoji\emoji-test.txt" Outputs="$(TargetDir)emojis.xml">
    <!-- The output directory doesn't exist yet in a clean build (or the first build of Greenshot Light) -->
    <MakeDir Directories="$(TargetDir)" />
    <EmojiDataTask EmojiTestTxtFile="..\Greenshot.Editor\Controls\Emoji\emoji-test.txt" OutputFilename="$(TargetDir)emojis.xml" />
  </Target>

  <PropertyGroup Condition="'$(GreenshotBaseConfiguration)' == 'Debug'">
    <PostBuildEvent>
      copy "$(SolutionDir)Greenshot\log4net-debug.xml" "$(TargetDir)log4net.xml" &gt;nul
    </PostBuildEvent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GreenshotBaseConfiguration)' == 'Release'">
    <PostBuildEvent>
      copy "$(SolutionDir)Greenshot\log4net-release.xml" "$(TargetDir)log4net.xml" &gt;nul
    </PostBuildEvent>
  </PropertyGroup>
</Project>

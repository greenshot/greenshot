<Window x:Class="Greenshot.Recipes.Views.DelayCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text Recipe.DelayCountdownTitle}"
        SizeToContent="WidthAndHeight"
        MinWidth="220"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="-32000"
        Top="-32000"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1" Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding CountdownText}"
                       FontSize="{wpf:FontSize 18}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <Button Grid.Column="1"
                    Content="{wpf:Text Core.Cancel}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center"/>
            <!-- Said by a screen reader when the countdown starts, not shown -->
            <TextBlock Grid.Column="0"
                       Text="{Binding Announcement}"
                       wpf:LiveRegion.Mode="Polite"
                       Width="0" Height="0"
                       Opacity="0"/>
        </Grid>
    </Border>
</Window>

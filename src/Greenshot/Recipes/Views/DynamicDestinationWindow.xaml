<Window x:Class="Greenshot.Recipes.Views.DynamicDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        SizeToContent="Height"
        Width="840"
        MinWidth="760"
        MaxWidth="980"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="{wpf:FontSize 13}"
        Background="{Binding WindowBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="4"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ComboBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Main Window Container -->
        <Border BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/> <!-- Row 0: Modern Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Error Banner -->
                    <RowDefinition Height="*"/>   <!-- Row 2: Main Split Content Area -->
                    <RowDefinition Height="Auto"/> <!-- Row 3: Status / Dismiss Footer -->
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="🎯" FontSize="{wpf:FontSize 14}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HeaderTitle}" FontWeight="Bold" FontSize="{wpf:FontSize 13.5}"
                                   Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{Binding BadgeBackgroundBrush}" CornerRadius="4" 
                                Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding ThumbnailVisibility}">
                            <TextBlock Text="{Binding DimensionsText}" FontSize="{wpf:FontSize 11}" 
                                       Foreground="{Binding TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Caption Buttons: Theme Toggle & Close -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnThemeToggleClicked" ToolTip="{Binding ThemeToggleToolTip}"
                                AutomationProperties.Name="{Binding ThemeToggleToolTip, TargetNullValue=''}">
                            <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="{wpf:FontSize 13}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource TitleCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{Binding CloseButtonToolTip}"/>
                    </StackPanel>
                </Grid>

                <!-- Error Banner (Shown when a prior export failed) -->
                <Border Grid.Row="1" Margin="16,0,16,10" Padding="14,9"
                        Background="{Binding ErrorBackgroundBrush}"
                        BorderBrush="{Binding ErrorBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding ErrorBannerVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="{wpf:FontSize 18}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ErrorMessage}" FontWeight="SemiBold" wpf:LiveRegion.Mode="Assertive"
                                       Foreground="{Binding ErrorTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ErrorSubtitleText}"
                                       FontSize="{wpf:FontSize 11.5}" Foreground="{Binding TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area: Left Column (Preview + Core Destinations) + Right Column (Other Destinations) -->
                <Grid Grid.Row="2" Margin="16,0,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Thumbnail Preview + Core Destinations -->
                    <Border Grid.Column="0" Margin="0,0,14,0" Padding="10"
                            Background="{Binding CardBackgroundBrush}"
                            BorderBrush="{Binding CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <!-- Clickable Thumbnail Container with Zoom Affordance, a button so it also opens with the keyboard -->
                            <Button x:Name="ThumbnailButton"
                                    MaxHeight="125" Cursor="Hand"
                                    Click="Thumbnail_Click"
                                    ToolTip="{Binding ClickToPreviewTooltip}"
                                    AutomationProperties.Name="{Binding ClickToPreviewTooltip, TargetNullValue=''}"
                                    FocusVisualStyle="{StaticResource GreenshotFocusVisual}"
                                    Visibility="{Binding ThumbnailVisibility}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                            <Border x:Name="ThumbnailBorder" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" 
                                    CornerRadius="6" Background="#0D000000" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding PreviewImageSource}" Stretch="Uniform" 
                                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                    <!-- Hover zoom badge -->
                                    <Border Background="#99000000" CornerRadius="3" Padding="5,2" 
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                        <TextBlock FontSize="{wpf:FontSize 10}" Foreground="White" FontWeight="Medium"><Run Text="🔍 "/><Run Text="{wpf:Text Recipe.PickerZoomPreview}"/></TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <TextBlock Text="{Binding DimensionsText}" HorizontalAlignment="Center"
                                       FontSize="{wpf:FontSize 10.5}" Foreground="{Binding TextSecondaryBrush}" Margin="0,6,0,8"
                                       Visibility="{Binding ThumbnailVisibility}"/>

                            <!-- Core Destinations Header -->
                            <TextBlock Text="{Binding CoreDestinationsHeaderText}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11.5}"
                                       Foreground="{Binding TextSecondaryBrush}" Margin="2,0,0,4"/>

                            <!-- Core Destinations List (Editor, Clipboard, Save As, Save, Print, OCR, Share) -->
                            <ItemsControl ItemsSource="{Binding CoreDestinationTiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ToolboxButtonStyle}" Click="DestinationTile_Click" Tag="{Binding}"
                                                AutomationProperties.Name="{Binding Title, TargetNullValue=''}" AutomationProperties.ItemStatus="{Binding BadgeText, TargetNullValue=''}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <Image Grid.Column="0" Source="{Binding IconSource}" Width="18" Height="18"
                                                       Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center" Visibility="{Binding IconVisibility}"/>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" 
                                                           Foreground="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontWeight="SemiBold" FontSize="{wpf:FontSize 12}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Badge (e.g. Retry) -->
                                                <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" 
                                                        CornerRadius="3" Padding="4,1" Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="{wpf:FontSize 9.5}" FontWeight="Bold" Foreground="{Binding BadgeForegroundBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Other Destinations Grid & Recipe Forwarding -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header + Search Filter -->
                            <RowDefinition Height="*"/>    <!-- 2-Column UniformGrid Destinations List -->
                            <RowDefinition Height="Auto"/> <!-- Forward to Recipe -->
                        </Grid.RowDefinitions>

                        <!-- Header with Search Filter -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OtherDestinationsHeaderText}" FontWeight="SemiBold" FontSize="{wpf:FontSize 12.5}"
                                           Foreground="{Binding TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding OtherDestinationCountText}" FontSize="{wpf:FontSize 11.5}"
                                           Foreground="{Binding TextSecondaryBrush}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Search Filter Box -->
                            <Border Grid.Column="1" Background="{Binding CardBackgroundBrush}" 
                                    BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" 
                                    CornerRadius="4" Padding="6,2" Width="160">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="{wpf:FontSize 10}" Margin="0,0,4,0" 
                                               VerticalAlignment="Center" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{wpf:Text Recipe.PickerSearch}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CaretBrush="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                             FontSize="{wpf:FontSize 11.5}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 2-Column UniformGrid Other Destinations in ScrollViewer (Height 34px buttons) -->
                        <ScrollViewer Grid.Row="1" MaxHeight="270" VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding FilteredOtherDestinationTiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ToolboxButtonStyle}" Click="DestinationTile_Click" Tag="{Binding}"
                                                AutomationProperties.Name="{Binding Title, TargetNullValue=''}" AutomationProperties.ItemStatus="{Binding BadgeText, TargetNullValue=''}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <Image Grid.Column="0" Source="{Binding IconSource}" Width="18" Height="18"
                                                       Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center" Visibility="{Binding IconVisibility}"/>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" 
                                                           Foreground="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontWeight="SemiBold" FontSize="{wpf:FontSize 12}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Optional Badge -->
                                                <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" 
                                                        CornerRadius="3" Padding="4,1" Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="{wpf:FontSize 9.5}" FontWeight="Bold" Foreground="{Binding BadgeForegroundBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Forward to Recipe Section -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding RecipeForwardingVisibility}">
                            <TextBlock Text="{Binding ForwardToRecipeHeaderText}" FontWeight="SemiBold" FontSize="{wpf:FontSize 12}"
                                       Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableRecipes}"
                                          SelectedItem="{Binding SelectedRecipe}"
                                          DisplayMemberPath="Name" Margin="0,0,8,0"
                                          AutomationProperties.Name="{Binding ForwardToRecipeHeaderText, TargetNullValue=''}"
                                          Style="{StaticResource DefaultComboBoxStyle}">
                                    <ComboBox.ItemContainerStyle>
                                        <!-- The recipe name instead of the class name for screen readers -->
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name, TargetNullValue=''}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>

                                <Button Grid.Column="1" Content="{Binding RunRecipeButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Background="{Binding AccentBrush}" Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=AccentForegroundBrush}"
                                        FontWeight="SemiBold" Padding="12,5" Height="32"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="RunRecipe_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="runBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="runBorder" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="runBorder" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Bottom Status & Dismiss Bar -->
                <Border Grid.Row="3" Background="{Binding CardBackgroundBrush}"
                        BorderBrush="{Binding CardBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="16,8" CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding TimeoutText}" VerticalAlignment="Center"
                                   FontSize="{wpf:FontSize 11.5}" Foreground="{Binding TextSecondaryBrush}"/>

                        <Button Grid.Column="1" Content="{Binding DismissButtonText}" Padding="16,4" Height="28"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Background="Transparent" BorderBrush="{Binding CardBorderBrush}"
                                BorderThickness="1" Foreground="{Binding TextSecondaryBrush}"
                                Cursor="Hand" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="dBorder" Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="dBorder" Property="Background" Value="{Binding Path=DataContext.HoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="Foreground" Value="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="dBorder" Property="Background" Value="{Binding Path=DataContext.PressedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Fullscreen / Window-filling Animated Preview Overlay -->
        <Grid x:Name="FullPreviewOverlay" Visibility="Collapsed" Background="#E6000000"
              KeyboardNavigation.TabNavigation="Cycle"
              MouseDown="FullPreviewOverlay_MouseDown" Cursor="Hand"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PreviewScale" ScaleX="0.9" ScaleY="0.9"/>
            </Grid.RenderTransform>

            <!-- Top Header Bar on Preview Overlay -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" 
                    Background="#80000000" Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 " FontSize="{wpf:FontSize 13}" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HeaderTitle}" FontWeight="SemiBold" FontSize="{wpf:FontSize 13}" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#40FFFFFF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DimensionsText}" FontSize="{wpf:FontSize 11}" Foreground="#E0E0E0"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FullscreenReturnHintText}" FontSize="{wpf:FontSize 11}" 
                                   Foreground="#C0C0C0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="FullPreviewCloseButton" Style="{StaticResource TitleCloseButtonStyle}" Click="FullPreviewClose_Click" ToolTip="{Binding CloseButtonToolTip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Full-window preview image -->
            <Border Margin="20,48,20,20" ClipToBounds="True">
                <Image Source="{Binding PreviewImageSource}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>

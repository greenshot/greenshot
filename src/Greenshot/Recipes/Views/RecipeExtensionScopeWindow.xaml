<Window x:Class="Greenshot.Recipes.Views.RecipeExtensionScopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        SizeToContent="Height"
        Width="720"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- A column: the header, then the checkboxes one under the other -->
        <DataTemplate x:Key="ScopeItemTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
            </CheckBox>
        </DataTemplate>

        <!-- A column is a card, like the group boxes of the other dialogs -->
        <Style x:Key="ColumnCard" TargetType="Border">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0"/>

            <!-- Two aligned columns: the captures (recipes) and the destinations -->
            <Grid Grid.Row="1" Margin="20,12,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="{wpf:Text Settings.RecipesScopeDescription}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource ColumnCard}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource LinkTextButtonStyle}" Content="{wpf:Text Settings.RecipesScopeAll}" Click="CapturesAll_Click"/>
                                <Button Style="{StaticResource LinkTextButtonStyle}" Content="{wpf:Text Settings.RecipesScopeNone}" Click="CapturesNone_Click"/>
                            </StackPanel>
                            <TextBlock Text="{wpf:Text Settings.RecipesScopeCaptures}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                            <ItemsControl x:Name="CapturesList" ItemTemplate="{StaticResource ScopeItemTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource ColumnCard}" x:Name="DestinationsCard">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource LinkTextButtonStyle}" Content="{wpf:Text Settings.RecipesScopeAll}" Click="DestinationsAll_Click"/>
                                <Button Style="{StaticResource LinkTextButtonStyle}" Content="{wpf:Text Settings.RecipesScopeNone}" Click="DestinationsNone_Click"/>
                            </StackPanel>
                            <TextBlock Text="{wpf:Text Settings.RecipesScopeDestinations}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                            <ItemsControl x:Name="DestinationsList" ItemTemplate="{StaticResource ScopeItemTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <!-- Buttons -->
            <Border Grid.Row="2"
                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,10">
                <DockPanel>
                    <TextBlock x:Name="NoDestinationText" Text="{wpf:Text Settings.RecipesScopeNodestination}" VerticalAlignment="Center"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OkButton" 
                                Content="{wpf:Text Core.Ok}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True" 
                                Width="80" 
                                Margin="5,0"
                                Click="OkButton_Click"/>
                        <Button Content="{wpf:Text Core.Cancel}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsCancel="True" 
                                Width="80" 
                                Margin="5,0"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

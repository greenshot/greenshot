<Window x:Class="Greenshot.Recipes.Views.RecipeApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{wpf:Text Recipe.ApprovalNewSubtitle}"
        SizeToContent="Height"
        Width="600"
        MinWidth="520"
        MinHeight="360"
        MaxHeight="820"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="{wpf:FontSize 13}"
        Background="{Binding WindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ScrollBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{Binding CardBorderBrush}" Background="{Binding WindowBackgroundBrush}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <!-- Extended Titlebar Chrome -->
                <RowDefinition Height="Auto"/>
                <!-- Main Body Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0" ShowMinimize="False"/>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="24,6,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderTitle}" 
                                   FontSize="{wpf:FontSize 18}" FontWeight="SemiBold" 
                                   Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" CornerRadius="4" Padding="8,3" 
                                Background="{Binding StatusBadgeBackgroundBrush}" 
                                BorderBrush="{Binding StatusBadgeBorderBrush}" 
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusBadgeText}" 
                                       FontSize="{wpf:FontSize 11}" FontWeight="Bold" 
                                       Foreground="{Binding StatusBadgeForegroundBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding HeaderDescription}" 
                               TextWrapping="Wrap" 
                               Foreground="{Binding TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Scrollable Content -->
                <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1"
                              Style="{DynamicResource ThemedScrollViewer}"
                              MaxHeight="520" Padding="0,0,6,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Recipe Validation Error Alert Card (Visible only when validation failed) -->
                        <Border x:Name="ValidationErrorAlertPanel" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                Background="{Binding ErrorBackgroundBrush}" 
                                BorderBrush="{Binding ErrorBorderBrush}" 
                                BorderThickness="1"
                                Visibility="{Binding ValidationErrorVisibility}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse Fill="{Binding ErrorTextBrush}" Width="16" Height="16" />
                                        <Path Stroke="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 5,5 L 11,11 M 11,5 L 5,11" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Text="{wpf:Text Recipe.ApprovalValidationFailed}" wpf:LiveRegion.Mode="Assertive" FontWeight="Bold" FontSize="{wpf:FontSize 13}" Foreground="{Binding ErrorTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{wpf:Text Recipe.ApprovalValidationInfo}" 
                                           Foreground="{Binding ErrorTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                                    Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    BorderBrush="{Binding DataContext.ErrorBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="❌" FontSize="{wpf:FontSize 11}" Margin="0,1,6,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontWeight="SemiBold" FontSize="{wpf:FontSize 12}"
                                                                   Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   TextWrapping="Wrap"/>
                                                    </Grid>
                                                    <Border CornerRadius="4" Padding="8,6" Margin="18,6,0,0"
                                                            Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            BorderThickness="1"
                                                            Visibility="{Binding HasHint, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="💡" Margin="0,1,6,0" FontSize="{wpf:FontSize 11}" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{wpf:Text Recipe.ApprovalHint}" FontWeight="Bold" FontSize="{wpf:FontSize 11}"
                                                                           Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,2"/>
                                                                <TextBlock Text="{Binding DiagnosticHint}" FontSize="{wpf:FontSize 11}"
                                                                           Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Recipe Modification Alert Card (Visible only when file modified on disk) -->
                        <Border x:Name="ModificationAlertPanel" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                Background="{Binding WarningBackgroundBrush}" 
                                BorderBrush="{Binding WarningBorderBrush}" 
                                BorderThickness="1"
                                Visibility="{Binding ModificationWarningVisibility}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Fill="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.WarningBrush}"
                                              Data="M 8.87,1.82 C 8.48,1.15 7.52,1.15 7.13,1.82 L 0.22,13.82 C -0.17,14.5 0.31,15.35 1.09,15.35 H 14.91 C 15.69,15.35 16.17,14.5 15.78,13.82 Z" />
                                        <Path Fill="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.WarningForegroundBrush}"
                                              Data="M 7.15,5.2 C 7.15,4.7 7.55,4.3 8.0,4.3 C 8.45,4.3 8.85,4.7 8.85,5.2 L 8.6,9.4 C 8.6,9.8 8.3,10.1 8.0,10.1 C 7.7,10.1 7.4,9.8 7.4,9.4 Z" />
                                        <Ellipse Fill="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.WarningForegroundBrush}" Width="1.8" Height="1.8" Canvas.Left="7.1" Canvas.Top="11.4" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Text="{wpf:Text Recipe.ApprovalModifiedAlert}" FontWeight="Bold" FontSize="{wpf:FontSize 13}" Foreground="{Binding WarningTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{wpf:Text Recipe.ApprovalModifiedAlertText}" 
                                           Foreground="{Binding WarningTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalPreviouslyApproved}" FontWeight="SemiBold" Foreground="{Binding WarningTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PreviousApprovalDate}" Foreground="{Binding WarningTextBrush}"/>
                                </Grid>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalPreviousSha}" FontWeight="SemiBold" Foreground="{Binding WarningTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PreviousFileHash}" FontFamily="Consolas, Courier New" FontSize="{wpf:FontSize 11}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviousFileHash}" Foreground="{Binding WarningTextBrush}"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalNewSha}" FontWeight="SemiBold" Foreground="{Binding WarningTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileHash}" FontFamily="Consolas, Courier New" FontSize="{wpf:FontSize 11}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileHash}" Foreground="{Binding WarningTextBrush}"/>
                                </Grid>

                                <!-- Quick Inspection Actions -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button AutomationProperties.Name="{wpf:Text Recipe.ApprovalShowInExplorer}" Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="10,4" Margin="0,0,8,0"
                                            Click="OnOpenInExplorerClicked"
                                            ToolTip="{wpf:Text Recipe.ApprovalShowInExplorerTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁" Margin="0,0,6,0" FontSize="{wpf:FontSize 11}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{wpf:Text Recipe.ApprovalShowInExplorer}" FontSize="{wpf:FontSize 11}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button AutomationProperties.Name="{wpf:Text Recipe.ApprovalViewRecipeJson}" Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="10,4"
                                            Click="OnViewFileClicked"
                                            ToolTip="{wpf:Text Recipe.ApprovalViewJsonTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{}{ } " FontFamily="Consolas" Margin="0,0,4,0" FontSize="{wpf:FontSize 11}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{wpf:Text Recipe.ApprovalViewRecipeJson}" FontSize="{wpf:FontSize 11}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                                            Padding="10,4" Margin="8,0,0,0"
                                            Click="OnViewChangesClicked"
                                            Visibility="{Binding DiffButtonVisibility}"
                                            ToolTip="{wpf:Text Recipe.ApprovalViewChangesTooltip}">
                                        <TextBlock Text="{wpf:Text Recipe.ApprovalViewChanges}" FontSize="{wpf:FontSize 11}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Proposed by an AI tool -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                Background="{Binding WarningBackgroundBrush}"
                                BorderBrush="{Binding WarningBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding AiProposalVisibility}">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="{wpf:FontSize 13}" Foreground="{Binding WarningTextBrush}" Margin="0,0,0,4"><Run Text="🤖 "/><Run Text="{wpf:Text Recipe.ApprovalAiWritten}"/></TextBlock>
                                <TextBlock Text="{Binding ProposedByText}" Foreground="{Binding WarningTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ProposedBySignerText}" FontSize="{wpf:FontSize 11}" Foreground="{Binding WarningTextBrush}" Margin="0,0,0,8"/>
                                <StackPanel Visibility="{Binding AiRequestVisibility}" Margin="0,0,0,6">
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalAiRequest}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11}" Foreground="{Binding WarningTextBrush}"/>
                                    <Border CornerRadius="4" Padding="8,6" Margin="0,2,0,0" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding AiRequest}" FontStyle="Italic" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Visibility="{Binding AiExplanationVisibility}">
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalAiExplanation}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11}" Foreground="{Binding WarningTextBrush}"/>
                                    <Border CornerRadius="4" Padding="8,6" Margin="0,2,0,0" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding AiExplanation}" FontStyle="Italic" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{wpf:Text Recipe.ApprovalAiCheck}"
                                           FontSize="{wpf:FontSize 11}" Foreground="{Binding WarningTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- What changed: replaced built-in recipe, a new version, or a modified file -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                Background="{Binding CardBackgroundBrush}"
                                BorderBrush="{Binding WarningBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding ChangesVisibility}">
                            <StackPanel>
                                <TextBlock Text="{Binding ChangesTitle}" FontWeight="Bold" FontSize="{wpf:FontSize 13}" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding ChangeDescriptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1,0,1"
                                                       Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                                        Padding="10,4" Margin="0,8,0,0"
                                        Click="OnViewChangesClicked"
                                        Visibility="{Binding DiffButtonVisibility}"
                                        ToolTip="{wpf:Text Recipe.ApprovalViewChangedLinesTooltip}">
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalViewChangedLines}" FontSize="{wpf:FontSize 11}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Recipe Overview Card -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                Background="{Binding CardBackgroundBrush}" 
                                BorderBrush="{Binding CardBorderBrush}" 
                                BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RecipeName}" FontWeight="Bold" FontSize="{wpf:FontSize 15}" Foreground="{Binding TextPrimaryBrush}"/>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Background="{Binding BadgeBackgroundBrush}">
                                        <TextBlock Text="{Binding RecipeVersion}" FontSize="{wpf:FontSize 11}" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding RecipeDescription}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalRecipeId}" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RecipeId}" Foreground="{Binding TextPrimaryBrush}"/>
                                </Grid>

                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalFilePath}" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button AutomationProperties.Name="{wpf:Text Recipe.ApprovalViewJson}" Style="{StaticResource SecondaryButtonStyle}" 
                                                Padding="8,2" FontSize="{wpf:FontSize 11}" Margin="0,0,4,0"
                                                Click="OnViewFileClicked"
                                                ToolTip="{wpf:Text Recipe.ApprovalViewJsonTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{}{ } " FontFamily="Consolas" Margin="0,0,3,0" FontSize="{wpf:FontSize 10}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{wpf:Text Recipe.ApprovalViewJson}" FontSize="{wpf:FontSize 10}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button AutomationProperties.Name="{wpf:Text Recipe.ApprovalExplorer}" Style="{StaticResource SecondaryButtonStyle}" 
                                                Padding="8,2" FontSize="{wpf:FontSize 11}"
                                                Click="OnOpenInExplorerClicked"
                                                ToolTip="{wpf:Text Recipe.ApprovalExplorerTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁" Margin="0,0,4,0" FontSize="{wpf:FontSize 10}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{wpf:Text Recipe.ApprovalExplorer}" FontSize="{wpf:FontSize 10}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SHA-256:" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileHash}" FontFamily="Consolas, Courier New" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileHash}"/>
                                </Grid>
                            </StackPanel>
                        </Border>



                        <!-- Automatic step: which recipes it changes, where and when -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                Background="{Binding CardBackgroundBrush}"
                                BorderBrush="{Binding WarningBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding ExtensionReachVisibility}">
                            <StackPanel>
                                <TextBlock Text="{wpf:Text Recipe.ApprovalExtReachTitle}" FontWeight="Bold" FontSize="{wpf:FontSize 13}" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{wpf:Text Recipe.ApprovalExtReachText}"
                                           FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ExtensionReachLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1,0,1"
                                                       Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Triggers Card: each trigger is switched on or off -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                Background="{Binding CardBackgroundBrush}" 
                                BorderBrush="{Binding CardBorderBrush}" 
                                BorderThickness="1"
                                Visibility="{Binding TriggersVisibility}">
                            <StackPanel>
                                <TextBlock Text="{wpf:Text Recipe.ApprovalWhatStartsIt}" FontWeight="Bold" FontSize="{wpf:FontSize 13}" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <StackPanel Visibility="{Binding TriggerItemsVisibility}">
                                    <TextBlock Text="{Binding TriggerHint}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TriggerHintBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding TriggerItems}" IsEnabled="{Binding IsEditable}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding Explanation}" FontSize="{wpf:FontSize 11}" TextWrapping="Wrap" Margin="20,2,0,0"
                                                               Visibility="{Binding ExplanationVisibility}"
                                                               Foreground="{Binding DataContext.WarningTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <TextBlock Text="{wpf:Text Recipe.ApprovalTriggerOff}" FontSize="{wpf:FontSize 11}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="20,2,0,0"
                                                               Visibility="{Binding OffVisibility}"
                                                               Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding TriggerBadges}" Visibility="{Binding TriggerBadgesVisibility}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="8,4" Margin="0,0,6,6" Background="{Binding BackgroundBrush}" BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Text}" FontSize="{wpf:FontSize 12}" Foreground="{Binding ForegroundBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Steps Card -->
                        <Border CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                Background="{Binding CardBackgroundBrush}" 
                                BorderBrush="{Binding CardBorderBrush}" 
                                BorderThickness="1"
                                Visibility="{Binding PipelineVisibility}">
                            <StackPanel>
                                <TextBlock Text="{wpf:Text Recipe.ApprovalWhatItDoes}" FontWeight="Bold" FontSize="{wpf:FontSize 13}" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{wpf:Text Recipe.ApprovalDescribedBy}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding StepDescriptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding Margin}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" FontSize="{wpf:FontSize 11}" Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding Foreground}" FontWeight="{Binding FontWeight}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- External Command Security Warning Panel -->
                        <Border x:Name="ExternalCommandWarningPanel" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                                Background="{Binding WarningBackgroundBrush}" 
                                BorderBrush="{Binding WarningBorderBrush}" 
                                BorderThickness="1"
                                Visibility="{Binding ExternalCommandWarningVisibility}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Canvas Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Fill="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.WarningBrush}"
                                              Data="M 8.87,1.82 C 8.48,1.15 7.52,1.15 7.13,1.82 L 0.22,13.82 C -0.17,14.5 0.31,15.35 1.09,15.35 H 14.91 C 15.69,15.35 16.17,14.5 15.78,13.82 Z" />
                                        <Path Fill="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.WarningForegroundBrush}"
                                              Data="M 7.15,5.2 C 7.15,4.7 7.55,4.3 8.0,4.3 C 8.45,4.3 8.85,4.7 8.85,5.2 L 8.6,9.4 C 8.6,9.8 8.3,10.1 8.0,10.1 C 7.7,10.1 7.4,9.8 7.4,9.4 Z" />
                                        <Ellipse Fill="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.WarningForegroundBrush}" Width="1.8" Height="1.8" Canvas.Left="7.1" Canvas.Top="11.4" />
                                    </Canvas>
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalPermissionTitle}" FontWeight="Bold" FontSize="{wpf:FontSize 13}" Foreground="{Binding WarningTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{wpf:Text Recipe.ApprovalPermissionText}" 
                                           Foreground="{Binding WarningTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <ItemsControl ItemsSource="{Binding GateItems}" IsEnabled="{Binding IsEditable}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Foreground="{Binding DataContext.WarningTextBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </CheckBox>
                                                <TextBlock Text="{Binding TargetsText}" FontFamily="Consolas, Courier New" FontSize="{wpf:FontSize 11}" TextWrapping="Wrap" Margin="20,3,0,0"
                                                           Foreground="{Binding DataContext.WarningTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock Text="{Binding Explanation}" FontSize="{wpf:FontSize 11}" TextWrapping="Wrap" Margin="20,3,0,0"
                                                           Visibility="{Binding ExplanationVisibility}"
                                                           Foreground="{Binding DataContext.WarningTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="ChkOpenInEditor" Grid.Column="0" VerticalAlignment="Center"
                              Content="{wpf:Text Recipe.ApprovalOpenInEditor}"
                              Foreground="{Binding TextSecondaryBrush}"
                              Visibility="{Binding OpenInEditorVisibility}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Approval actions (a review also has "Keep as Is") -->
                        <Button x:Name="BtnReject" Content="{Binding RejectButtonText}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsCancel="True"
                                MinWidth="120" Height="34" Margin="0,0,10,0" Padding="12,6"
                                Visibility="{Binding DecisionVisibility}"
                                Click="OnRejectClicked"/>

                        <Button x:Name="BtnKeep" Content="{wpf:Text Recipe.ApprovalBtnKeepAsIs}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsCancel="True"
                                MinWidth="110" Height="34" Margin="0,0,10,0" Padding="12,6"
                                Visibility="{Binding KeepVisibility}"
                                ToolTip="{wpf:Text Recipe.ApprovalKeepTooltip}"
                                Click="OnCloseClicked"/>

                        <Button x:Name="BtnApprove" Content="{Binding ApproveButtonText}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True"
                                MinWidth="150" Height="34"
                                Padding="16,6"
                                Visibility="{Binding DecisionVisibility}"
                                Click="OnApproveClicked"/>

                        <!-- Details -->
                        <Button Content="{wpf:Text Core.AccessibleClose}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True" IsCancel="True"
                                MinWidth="110" Height="34"
                                Padding="16,6"
                                Visibility="{Binding ReadOnlyCloseVisibility}"
                                Click="OnCloseClicked"/>

                        <!-- Validation Error Actions -->
                        <Button Content="{wpf:Text Recipe.ApprovalEditFile}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="130" Height="34" Margin="0,0,10,0"
                                Visibility="{Binding ValidationErrorVisibility}"
                                Click="OnEditFileClicked"
                                ToolTip="{wpf:Text Recipe.ApprovalEditFileTooltip}"/>

                        <Button Content="{wpf:Text Core.AccessibleClose}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True" IsCancel="True"
                                MinWidth="110" Height="34"
                                Padding="16,6"
                                Visibility="{Binding ValidationErrorVisibility}"
                                Click="OnCloseClicked"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- In-Dialog JSON Viewer Full Overlay, Tab stays in it while it is open -->
            <Grid Grid.Row="1" 
                  KeyboardNavigation.TabNavigation="Cycle"
                  Background="#99000000" 
                  Visibility="{Binding JsonViewerVisibility}">
                <Border Background="{Binding CardBackgroundBrush}" 
                        BorderBrush="{Binding CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Margin="18" 
                        Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.45" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Overlay Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{}{ } " FontFamily="Consolas" FontWeight="Bold" FontSize="{wpf:FontSize 15}" Foreground="{Binding AccentBrush}"/>
                                <TextBlock Text="{Binding OverlayTitle}" FontWeight="Bold" FontSize="{wpf:FontSize 15}" Foreground="{Binding TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding RecipeName, StringFormat=' — {0}'}" FontSize="{wpf:FontSize 13}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Padding="10,4" FontSize="{wpf:FontSize 11}"
                                    Click="OnCloseJsonViewerClicked"
                                    ToolTip="{wpf:Text Recipe.ApprovalCloseViewerTooltip}">
                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="✕ "/><Run Text="{wpf:Text Core.AccessibleClose}"/></TextBlock>
                            </Button>
                        </Grid>

                        <!-- JSON Content Text Box -->
                        <TextBox x:Name="JsonTextBox"
                                 Grid.Row="1" 
                                 AutomationProperties.Name="{Binding OverlayTitle}"
                                 Text="{Binding RecipeJsonContent, Mode=OneWay}"
                                 FontFamily="Consolas, Courier New" FontSize="{wpf:FontSize 12}"
                                 Background="{Binding WindowBackgroundBrush}" 
                                 Foreground="{Binding TextPrimaryBrush}"
                                 BorderBrush="{Binding CardBorderBrush}"
                                 BorderThickness="1"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="10"
                                 TextWrapping="NoWrap"/>

                        <!-- Overlay Footer Actions -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" 
                                       FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button AutomationProperties.Name="{wpf:Text Recipe.ApprovalCopyClipboard}" Style="{StaticResource SecondaryButtonStyle}" 
                                        Padding="12,5" Margin="0,0,8,0"
                                        Click="OnCopyJsonClicked"
                                        ToolTip="{wpf:Text Recipe.ApprovalCopyJsonTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" Margin="0,0,6,0" FontSize="{wpf:FontSize 11}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{wpf:Text Recipe.ApprovalCopyClipboard}" FontSize="{wpf:FontSize 11}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}" 
                                        Padding="16,5"
                                        Click="OnCloseJsonViewerClicked"
                                        ToolTip="{wpf:Text Recipe.ApprovalCloseViewer}">
                                    <TextBlock Text="{wpf:Text Recipe.ApprovalDone}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="Greenshot.Recipes.Views.RecipeUserPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Greenshot - Decision Prompt"
        SizeToContent="Height"
        Width="520"
        MinWidth="440"
        MinHeight="220"
        MaxHeight="720"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="{wpf:FontSize 13}"
        Background="{Binding WindowBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Bar -->
            <RowDefinition Height="*"/>   <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <wpf:ThemedTitleBar Grid.Row="0"/>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16,20,16">
            <StackPanel>
                <!-- Prompt Title -->
                <TextBlock Text="{Binding PromptTitle}"
                           FontSize="{wpf:FontSize 16}"
                           FontWeight="SemiBold"
                           Foreground="{Binding TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>

                <!-- Prompt Message -->
                <TextBlock Text="{Binding PromptMessage}"
                           FontSize="{wpf:FontSize 13}"
                           Foreground="{Binding TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,0,0,14"/>

                <!-- Optional Preview Image -->
                <Border x:Name="PreviewBorder"
                        Visibility="{Binding PreviewVisibility}"
                        Background="{Binding CardBackgroundBrush}"
                        BorderBrush="{Binding CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4"
                        Margin="0,0,0,14"
                        MaxHeight="260"
                        HorizontalAlignment="Center">
                    <Image Source="{Binding PreviewImageSource}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Optional check box, e.g. "don't ask again" -->
                <CheckBox Content="{Binding CheckBoxText}"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Visibility="{Binding CheckBoxVisibility}"
                          Style="{StaticResource GreenshotCheckBoxStyle}"
                          Margin="0,0,0,8"/>

                <!-- Timeout Notice if active -->
                <TextBlock Text="{Binding TimeoutText}"
                           Visibility="{Binding TimeoutVisibility}"
                           FontSize="{wpf:FontSize 11}"
                           Foreground="{Binding TextSecondaryBrush}"
                           FontStyle="Italic"
                           Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action Buttons -->
        <Border Grid.Row="2"
                Background="{Binding CardBackgroundBrush}"
                BorderBrush="{Binding CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <ItemsControl ItemsSource="{Binding ActionButtons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}"
                                Tag="{Binding Key}"
                                Margin="6,0,0,0"
                                Click="ActionButton_Click"
                                Style="{Binding ButtonStyle}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>

                    <!-- Title, Version & Badges -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding AppVersionTitle}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{Binding TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Badges row -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="{Binding BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding BitnessText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}"/>
                            </Border>
                            <Border Background="{Binding BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding PortableBadgeVisibility}">
                                <TextBlock Text="Portable" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}"/>
                            </Border>
                            <Border Background="#238636" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" Visibility="{Binding BetaTesterBadgeVisibility}">
                                <TextBlock Text="BETA" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </WrapPanel>

                        <!-- Homepage link -->
                        <TextBlock FontSize="13">
                            <Hyperlink NavigateUri="{Binding WebsiteUrl}" RequestNavigate="OnHyperlinkRequestNavigate">
                                <TextBlock Text="{Binding WebsiteDisplayUrl}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- License & Copyright Card -->
                <Border Grid.Row="1"
                        Background="{Binding CardBackgroundBrush}"
                        BorderBrush="{Binding CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LicenseCopyrightText}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Released as free software under the GNU General Public License (GPLv3)."
                                   Foreground="{Binding TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>
                        <TextBlock FontSize="12">
                            <Hyperlink NavigateUri="https://www.gnu.org/licenses/gpl.html" RequestNavigate="OnHyperlinkRequestNavigate">
                                <TextBlock Text="https://www.gnu.org/licenses/gpl.html"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>


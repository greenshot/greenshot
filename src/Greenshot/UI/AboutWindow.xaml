    <Border BorderThickness="1" BorderBrush="{Binding CardBorderBrush}" Background="{Binding WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Custom Chrome Title Bar -->
                <RowDefinition Height="*"/>    <!-- Main Body -->
                <RowDefinition Height="Auto"/> <!-- Footer / Shortcuts -->
            </Grid.RowDefinitions>

            <!-- Custom Chrome Title Bar (Greenshot "G" Icon, no standard title bar, custom buttons like Recipe Editor) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Branding / Window G Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="{Binding WindowIconSource}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Greenshot" FontWeight="Bold" FontSize="12" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WindowTitleSubtitle}" FontSize="12" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Caption Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="OnThemeToggleClicked" ToolTip="{Binding ThemeToggleToolTip}">
                        <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtnStyle}" Click="OnCloseClicked" ToolTip="{Binding CloseButtonToolTip}"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="24,10,24,16">
                <Grid.RowDefinitions>

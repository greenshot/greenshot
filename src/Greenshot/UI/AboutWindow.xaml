<Window x:Class="Greenshot.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitleText}"
        Icon="{Binding WindowIconSource}"
        SizeToContent="Height"
        Width="660"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="13"
        Background="{Binding WindowBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Caption Button Style -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#26888888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Caption Close Button Style -->
        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <Path x:Name="crossPath" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding BadgeBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hyperlink Style -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{Binding AccentBrush}"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Startup Entrance Storyboard (Staggered Pop-in of 21 Bubbles along exact G flow order) -->
        <Storyboard x:Key="StartupStoryboard">
            <!-- Dot 0 (Path 13: Top Right) -->
            <DoubleAnimation Storyboard.TargetName="Dot0Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.00">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot0Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.00">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot0" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.00"/>

            <!-- Dot 1 (Path 7) -->
            <DoubleAnimation Storyboard.TargetName="Dot1Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot1Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.05">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.05"/>

            <!-- Dot 2 (Path 10) -->
            <DoubleAnimation Storyboard.TargetName="Dot2Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.10">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot2Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.10">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.10"/>

            <!-- Dot 3 (Path 15) -->
            <DoubleAnimation Storyboard.TargetName="Dot3Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot3Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.15"/>

            <!-- Dot 4 (Path 6: Top Left) -->
            <DoubleAnimation Storyboard.TargetName="Dot4Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.20">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot4Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.20">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot4" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.20"/>

            <!-- Dot 5 (Path 8) -->
            <DoubleAnimation Storyboard.TargetName="Dot5Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.25">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot5Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.25">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot5" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.25"/>

            <!-- Dot 6 (Path 9) -->
            <DoubleAnimation Storyboard.TargetName="Dot6Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.30">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot6Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.30">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot6" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.30"/>

            <!-- Dot 7 (Path 1) -->
            <DoubleAnimation Storyboard.TargetName="Dot7Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.35">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot7Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.35">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot7" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.35"/>

            <!-- Dot 8 (Path 11) -->
            <DoubleAnimation Storyboard.TargetName="Dot8Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.40">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot8Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.40">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot8" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.40"/>

            <!-- Dot 9 (Path 4) -->
            <DoubleAnimation Storyboard.TargetName="Dot9Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.45">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot9Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.45">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot9" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.45"/>

            <!-- Dot 10 (Path 5) -->
            <DoubleAnimation Storyboard.TargetName="Dot10Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.50">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot10Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.50">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot10" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.50"/>

            <!-- Dot 11 (Path 2) -->
            <DoubleAnimation Storyboard.TargetName="Dot11Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.55">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot11Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.55">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot11" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.55"/>

            <!-- Dot 12 (Path 3) -->
            <DoubleAnimation Storyboard.TargetName="Dot12Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.60">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot12Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.60">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot12" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.60"/>

            <!-- Dot 13 (Path 0) -->
            <DoubleAnimation Storyboard.TargetName="Dot13Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.65">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot13Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.65">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot13" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.65"/>

            <!-- Dot 14 (Path 19) -->
            <DoubleAnimation Storyboard.TargetName="Dot14Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.70">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot14Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.70">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot14" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.70"/>

            <!-- Dot 15 (Path 20) -->
            <DoubleAnimation Storyboard.TargetName="Dot15Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.75">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot15Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.75">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot15" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.75"/>

            <!-- Dot 16 (Path 17) -->
            <DoubleAnimation Storyboard.TargetName="Dot16Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.80">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot16Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.80">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot16" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.80"/>

            <!-- Dot 17 (Path 18) -->
            <DoubleAnimation Storyboard.TargetName="Dot17Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.85">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot17Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.85">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot17" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.85"/>

            <!-- Dot 18 (Path 14: Middle Right) -->
            <DoubleAnimation Storyboard.TargetName="Dot18Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.90">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot18Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.90">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot18" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.90"/>

            <!-- Dot 19 (Path 12: Middle Center) -->
            <DoubleAnimation Storyboard.TargetName="Dot19Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.95">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot19Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.95">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot19" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:0.95"/>

            <!-- Dot 20 (Path 16: Middle Inner) -->
            <DoubleAnimation Storyboard.TargetName="Dot20Scale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:1.00">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot20Scale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:1.00">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dot20" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" BeginTime="0:0:1.00"/>
        </Storyboard>

        <!-- Wave / Ripple Storyboard (Glow & Pulse Wave through bubbles in flow order) -->
        <Storyboard x:Key="WaveStoryboard">
            <!-- Dot 0 -->
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="Dot0Brush" Storyboard.TargetProperty="Color" BeginTime="0:0:0.00">
                <SplineColorKeyFrame KeyTime="0:0:0.00" Value="#8AFF00"/>
                <SplineColorKeyFrame KeyTime="0:0:0.18" Value="#FFFFFF"/>
                <SplineColorKeyFrame KeyTime="0:0:0.36" Value="#8AFF00"/>
            </ColorAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot0Scale" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.00">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1.35"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot0Scale" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.00">
                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.0"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1.35"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- Dot 1 -->
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="Dot1Brush" Storyboard.TargetProperty="Color" BeginTime="0:0:0.04">
                <SplineColorKeyFrame KeyTime="0:0:0.00" Value="#8AFF00"/>
                <SplineColorKeyFrame KeyTime="0:0:0.18" Value="#FFFFFF"/>
                <SplineColorKeyFrame KeyTime="0:0:0.36" Value="#8AFF00"/>
            </ColorAnimationUsingKeyFrames>

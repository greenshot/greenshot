<Window x:Class="Greenshot.UI.DynamicDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        SizeToContent="Height"
        Width="840"
        MinWidth="760"
        MaxWidth="980"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowActivated="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="13"
        Background="{Binding WindowBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="4"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Caption Theme Toggle Button Style -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#26888888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Caption Close Button Style -->
        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Destination Tile Button Style (34px height) -->
        <Style x:Key="CompactDestinationTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding Path=DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderBrush" Value="{Binding Path=DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Foreground" Value="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{Binding Path=DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter TargetName="border" Property="Background" Value="{Binding Path=DataContext.HoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding Path=DataContext.PressedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{Binding Path=DataContext.HoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{Binding Path=DataContext.PressedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="Border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{Binding Path=DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="200">
                                    <Border Name="DropDownBorder"
                                            Background="{Binding Path=DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderBrush="{Binding Path=DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="2"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Focusable="False"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Window Container -->
        <Border BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/> <!-- Row 0: Modern Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Error Banner -->
                    <RowDefinition Height="*"/>   <!-- Row 2: Main Split Content Area -->
                    <RowDefinition Height="Auto"/> <!-- Row 3: Status / Dismiss Footer -->
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="🎯" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HeaderTitle}" FontWeight="Bold" FontSize="13.5"
                                   Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{Binding BadgeBackgroundBrush}" CornerRadius="4" 
                                Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding ThumbnailVisibility}">
                            <TextBlock Text="{Binding DimensionsText}" FontSize="11" 
                                       Foreground="{Binding TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Caption Buttons: Theme Toggle & Close -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionBtnStyle}" Click="OnThemeToggleClicked" ToolTip="{Binding ThemeToggleToolTip}">
                            <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{Binding CloseButtonToolTip}"/>
                    </StackPanel>
                </Grid>

                <!-- Error Banner (Shown when a prior export failed) -->
                <Border Grid.Row="1" Margin="16,0,16,10" Padding="14,9"
                        Background="{Binding ErrorBackgroundBrush}"
                        BorderBrush="{Binding ErrorBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding ErrorBannerVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ErrorMessage}" FontWeight="SemiBold"
                                       Foreground="{Binding ErrorTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ErrorSubtitleText}"
                                       FontSize="11.5" Foreground="{Binding TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area: Left Column (Preview + Core Destinations) + Right Column (Other Destinations) -->
                <Grid Grid.Row="2" Margin="16,0,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Thumbnail Preview + Core Destinations -->
                    <Border Grid.Column="0" Margin="0,0,14,0" Padding="10"
                            Background="{Binding CardBackgroundBrush}"
                            BorderBrush="{Binding CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <!-- Clickable Thumbnail Container with Zoom Affordance -->
                            <Border x:Name="ThumbnailBorder" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" 
                                    CornerRadius="6" Background="#0D000000" ClipToBounds="True" 
                                    MaxHeight="125" Cursor="Hand"
                                    MouseDown="Thumbnail_MouseDown"
                                    ToolTip="{Binding ClickToPreviewTooltip}"
                                    Visibility="{Binding ThumbnailVisibility}">
                                <Grid>
                                    <Image Source="{Binding PreviewImageSource}" Stretch="Uniform" 
                                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                                    <!-- Hover zoom badge -->
                                    <Border Background="#99000000" CornerRadius="3" Padding="5,2" 
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                        <TextBlock Text="🔍 Zoom Preview" FontSize="10" Foreground="White" FontWeight="Medium"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding DimensionsText}" HorizontalAlignment="Center"
                                       FontSize="10.5" Foreground="{Binding TextSecondaryBrush}" Margin="0,6,0,8"
                                       Visibility="{Binding ThumbnailVisibility}"/>

                            <!-- Core Destinations Header -->
                            <TextBlock Text="{Binding CoreDestinationsHeaderText}" FontWeight="SemiBold" FontSize="11.5"
                                       Foreground="{Binding TextSecondaryBrush}" Margin="2,0,0,4"/>

                            <!-- Core Destinations List (Editor, Clipboard, Save As, Save, Print, OCR, Share) -->
                            <ItemsControl ItemsSource="{Binding CoreDestinationTiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CompactDestinationTileStyle}" Click="DestinationTile_Click" Tag="{Binding}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <Image Grid.Column="0" Source="{Binding IconSource}" Width="18" Height="18"
                                                       Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center" Visibility="{Binding IconVisibility}"/>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" 
                                                           Foreground="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Badge (e.g. Retry) -->
                                                <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" 
                                                        CornerRadius="3" Padding="4,1" Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Other Destinations Grid & Recipe Forwarding -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header + Search Filter -->
                            <RowDefinition Height="*"/>    <!-- 2-Column UniformGrid Destinations List -->
                            <RowDefinition Height="Auto"/> <!-- Forward to Recipe -->
                        </Grid.RowDefinitions>

                        <!-- Header with Search Filter -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OtherDestinationsHeaderText}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{Binding TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding OtherDestinationCountText}" FontSize="11.5"
                                           Foreground="{Binding TextSecondaryBrush}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Search Filter Box -->
                            <Border Grid.Column="1" Background="{Binding CardBackgroundBrush}" 
                                    BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" 
                                    CornerRadius="4" Padding="6,2" Width="160">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="10" Margin="0,0,4,0" 
                                               VerticalAlignment="Center" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CaretBrush="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                             FontSize="11.5" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 2-Column UniformGrid Other Destinations in ScrollViewer (Height 34px buttons) -->
                        <ScrollViewer Grid.Row="1" MaxHeight="270" VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding FilteredOtherDestinationTiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CompactDestinationTileStyle}" Click="DestinationTile_Click" Tag="{Binding}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <Image Grid.Column="0" Source="{Binding IconSource}" Width="18" Height="18"
                                                       Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center" Visibility="{Binding IconVisibility}"/>

                                                <!-- Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" 
                                                           Foreground="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Optional Badge -->
                                                <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" 
                                                        CornerRadius="3" Padding="4,1" Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Forward to Recipe Section -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding RecipeForwardingVisibility}">
                            <TextBlock Text="{Binding ForwardToRecipeHeaderText}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableRecipes}"
                                          SelectedItem="{Binding SelectedRecipe}"
                                          DisplayMemberPath="Name" Margin="0,0,8,0"
                                          Style="{StaticResource ModernComboBoxStyle}"/>

                                <Button Grid.Column="1" Content="{Binding RunRecipeButtonText}"
                                        Background="{Binding AccentBrush}" Foreground="White"
                                        FontWeight="SemiBold" Padding="12,5" Height="32"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="RunRecipe_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="runBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="runBorder" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="runBorder" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Bottom Status & Dismiss Bar -->
                <Border Grid.Row="3" Background="{Binding CardBackgroundBrush}"
                        BorderBrush="{Binding CardBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="16,8" CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding TimeoutText}" VerticalAlignment="Center"
                                   FontSize="11.5" Foreground="{Binding TextSecondaryBrush}"/>

                        <Button Grid.Column="1" Content="{Binding DismissButtonText}" Padding="16,4" Height="28"
                                Background="Transparent" BorderBrush="{Binding CardBorderBrush}"
                                BorderThickness="1" Foreground="{Binding TextSecondaryBrush}"
                                Cursor="Hand" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="dBorder" Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="dBorder" Property="Background" Value="{Binding Path=DataContext.HoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="Foreground" Value="{Binding Path=DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="dBorder" Property="Background" Value="{Binding Path=DataContext.PressedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Fullscreen / Window-filling Animated Preview Overlay -->
        <Grid x:Name="FullPreviewOverlay" Visibility="Collapsed" Background="#E6000000"
              MouseDown="FullPreviewOverlay_MouseDown" Cursor="Hand"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PreviewScale" ScaleX="0.9" ScaleY="0.9"/>
            </Grid.RenderTransform>

            <!-- Top Header Bar on Preview Overlay -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" 
                    Background="#80000000" Padding="16,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 " FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HeaderTitle}" FontWeight="SemiBold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#40FFFFFF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DimensionsText}" FontSize="11" Foreground="#E0E0E0"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FullscreenReturnHintText}" FontSize="11" 
                                   Foreground="#C0C0C0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Style="{StaticResource CaptionCloseButtonStyle}" Click="FullPreviewClose_Click" ToolTip="{Binding CloseButtonToolTip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Full-window preview image -->
            <Border Margin="20,48,20,20" ClipToBounds="True">
                <Image Source="{Binding PreviewImageSource}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>

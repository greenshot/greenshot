<Window x:Class="Greenshot.UI.SelfService.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        mc:Ignorable="d"
        Title="Greenshot - Log Viewer"
        Width="860"
        Height="580"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="13"
        Background="{Binding WindowBackgroundBrush}"
        Foreground="{Binding TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Caption Button Style -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#26888888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption Close Button Style -->
        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <Path x:Name="crossPath" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding BadgeBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="42"/>
            <!-- Action Bar -->
            <RowDefinition Height="46"/>
            <!-- Chunk Loading Banner (if earlier lines available) -->
            <RowDefinition Height="Auto"/>
            <!-- Main Log Content -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0"
                Background="{Binding CardBackgroundBrush}"
                BorderBrush="{Binding CardBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="📄 " FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Greenshot Log Viewer" 
                               FontWeight="SemiBold" 
                               FontSize="13.5" 
                               Foreground="{Binding TextPrimaryBrush}" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LogFilePath, StringFormat=' - {0}'}" 
                               FontSize="11.5" 
                               Foreground="{Binding TextSecondaryBrush}" 
                               VerticalAlignment="Center" 
                               TextTrimming="CharacterEllipsis" 
                               MaxWidth="450" 
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Caption Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionBtnStyle}" 
                            ToolTip="{Binding ThemeToggleToolTip}" 
                            Click="OnThemeToggleClicked">
                        <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtnStyle}" 
                            ToolTip="Minimize" 
                            Click="OnMinimizeClicked">
                        <Path Width="10" Height="1" Stretch="Fill" 
                              Stroke="{Binding TextPrimaryBrush}" StrokeThickness="1.2" 
                              Data="M 0,0 L 10,0"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtnStyle}" 
                            ToolTip="Maximize / Restore" 
                            Click="OnMaximizeRestoreClicked">
                        <Path Width="10" Height="10" Stretch="Fill" 
                              Stroke="{Binding TextPrimaryBrush}" StrokeThickness="1.2" 
                              Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtnStyle}" 
                            ToolTip="Close (Esc)" 
                            Click="OnCloseClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Bar with Refresh Glance and Copy Log -->
        <Border Grid.Row="1" 
                Background="{Binding CardBackgroundBrush}" 
                BorderBrush="{Binding CardBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="14,6">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Controls: Refresh & Copy -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0" 
                            Click="OnRefreshLogClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 "/>
                            <TextBlock Text="Refresh Tail (F5)"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,12,0" 
                            Click="OnCopyLogClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 "/>
                            <TextBlock Text="Copy Log"/>
                        </StackPanel>
                    </Button>
                    <CheckBox Content="Wrap text" 
                              IsChecked="{Binding WrapText, Mode=TwoWay}" 
                              Foreground="{Binding TextPrimaryBrush}" 
                              VerticalAlignment="Center" 
                              FontSize="12"/>
                </StackPanel>

                <!-- Right Status: Line count and size -->
                <TextBlock Grid.Column="2" 
                           Text="{Binding LogInfoText}" 
                           FontSize="11.5" 
                           Foreground="{Binding TextSecondaryBrush}" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Chunk Paging Banner (When earlier lines exist) -->
        <Border Grid.Row="2"
                Visibility="{Binding CanLoadMore, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{Binding BadgeBackgroundBrush}" 
                BorderBrush="{Binding CardBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️ " FontSize="12" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding ChunkStatusText}" 
                               FontSize="11.5" 
                               Foreground="{Binding TextSecondaryBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,8,0" 
                            Click="OnLoadEarlierLinesClicked"
                            ToolTip="Load previous 64 KB chunk of log lines">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬆ " FontSize="11" Margin="0,0,3,0"/>
                            <TextBlock Text="Load Earlier (+64 KB)"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                            Click="OnLoadEntireLogClicked"
                            ToolTip="Load all remaining earlier log lines">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏬ " FontSize="11" Margin="0,0,3,0"/>
                            <TextBlock Text="Load Entire Log"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Log Viewer Content Area -->
        <Border Grid.Row="3" 
                Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}" 
                Padding="4">
            <TextBox x:Name="LogTextBox" 
                     Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="{Binding TextWrappingMode}"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Visible"
                     HorizontalScrollBarVisibility="Visible"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="11.5"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{Binding TextPrimaryBrush}"
                     Padding="8"/>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" 
                Background="{Binding CardBackgroundBrush}" 
                BorderBrush="{Binding CardBorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="14,0">
            <TextBlock x:Name="StatusMessageText" 
                       Text="{Binding StatusMessage}" 
                       FontSize="11" 
                       Foreground="{Binding TextSecondaryBrush}" 
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>

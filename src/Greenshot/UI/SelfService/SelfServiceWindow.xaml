<Window x:Class="Greenshot.UI.SelfService.SelfServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:local="clr-namespace:Greenshot.UI.SelfService"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="940"
        Height="680"
        MinWidth="780"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="13"
        Background="{Binding WindowBackgroundBrush}"
        Foreground="{Binding TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Caption Button Style -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#26888888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption Close Button Style -->
        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <Path x:Name="crossPath" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding BadgeBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning Action Button Style -->
        <Style x:Key="WarningButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Themed Fluent Navigation Item Style -->
        <Style x:Key="NavListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder" 
                                Background="Transparent" 
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6" 
                                Padding="8,8">
                            <Grid>
                                <!-- Left Active Indicator Bar -->
                                <Rectangle x:Name="activeIndicator" 
                                           Width="3.5" 
                                           HorizontalAlignment="Left" 
                                           RadiusX="1.5" RadiusY="1.5"
                                           Fill="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="Collapsed"/>
                                <ContentPresenter Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="42"/>
            <!-- Main Content (Master / Detail) -->
            <RowDefinition Height="*"/>
            <!-- Footer Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Modern Custom Title Bar -->
        <Border Grid.Row="0"
                Background="{Binding CardBackgroundBrush}"
                BorderBrush="{Binding CardBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="🛠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{wpf:Translate selfservice_window_title}" 
                               FontWeight="SemiBold" 
                               FontSize="13.5" 
                               Foreground="{Binding TextPrimaryBrush}" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersionTitle, StringFormat=' ({0})'}" 
                               FontSize="11.5" 
                               Foreground="{Binding TextSecondaryBrush}" 
                               VerticalAlignment="Center" 
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Caption Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Theme Toggle -->
                    <Button Style="{StaticResource CaptionBtnStyle}" 
                            ToolTip="{Binding ThemeToggleToolTip}" 
                            Click="OnThemeToggleClicked">
                        <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="14"/>
                    </Button>

                    <!-- Minimize -->
                    <Button Style="{StaticResource CaptionBtnStyle}" 
                            ToolTip="{wpf:Translate selfservice_tooltip_minimize}" 
                            Click="OnMinimizeClicked">
                        <Path Width="10" Height="1" Stretch="Fill" 
                              Stroke="{Binding TextPrimaryBrush}" StrokeThickness="1.2" 
                              Data="M 0,0 L 10,0"/>
                    </Button>

                    <!-- Maximize / Restore -->
                    <Button Style="{StaticResource CaptionBtnStyle}" 
                            ToolTip="{wpf:Translate selfservice_tooltip_maximize}" 
                            Click="OnMaximizeRestoreClicked">
                        <Path Width="10" Height="10" Stretch="Fill" 
                              Stroke="{Binding TextPrimaryBrush}" StrokeThickness="1.2" 
                              Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"/>
                    </Button>

                    <!-- Close -->
                    <Button Style="{StaticResource CaptionCloseBtnStyle}" 
                            ToolTip="{wpf:Translate selfservice_tooltip_close}" 
                            Click="OnCloseClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master / Detail Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Master Column: Navigation Sidebar -->
                <ColumnDefinition Width="250" MinWidth="220" MaxWidth="320"/>
                <!-- Detail Column: Selected Section View -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar (Master) -->
            <Border Grid.Column="0" 
                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ControlBackgroundBrush}" 
                    BorderBrush="{Binding CardBorderBrush}" 
                    BorderThickness="0,0,1,0" 
                    Padding="12,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="{wpf:Translate selfservice_categories_header}" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="{Binding TextSecondaryBrush}" 
                               Margin="8,0,0,10"/>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Sections}" 
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                             Foreground="{Binding TextPrimaryBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SelfServiceSectionViewModel}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Themed Icon Container -->
                                    <Border Grid.Column="0" 
                                            Width="32" Height="32" 
                                            CornerRadius="6" 
                                            Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                            BorderThickness="1"
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" 
                                                   FontSize="16" 
                                                   Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Title & Subtitle with dynamic theme colors -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12.5" 
                                                   Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock Text="{Binding Subtitle}" 
                                                   FontSize="10.5" 
                                                   Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="2" 
                                            Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="{Binding BadgeBrush}" 
                                            CornerRadius="10" 
                                            Padding="6,2" 
                                            VerticalAlignment="Center" 
                                            Margin="4,0,0,0">
                                        <TextBlock Text="{Binding BadgeText}" 
                                                   FontSize="9.5" 
                                                   FontWeight="Bold" 
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Sidebar Footer Tips -->
                    <Border Grid.Row="2" 
                            Background="{Binding BadgeBackgroundBrush}" 
                            BorderBrush="{Binding CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6" 
                            Padding="10" 
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="💡 Navigation" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" Foreground="{Binding TextPrimaryBrush}"/>
                            <TextBlock Text="Press 1-4 to navigate tabs, F5 to refresh, and T to toggle Dark/Light mode." 
                                       FontSize="10.5" 
                                       TextWrapping="Wrap" 
                                       Foreground="{Binding TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Detail View Panel (Right Column) -->
            <Grid Grid.Column="1" Background="{Binding WindowBackgroundBrush}">
                <!-- Section 1: System & Environment -->
                <ScrollViewer x:Name="SystemInfoPanel" 
                              VerticalScrollBarVisibility="Auto" 
                              Padding="22,18">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{wpf:Translate selfservice_system_title}" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{Binding TextPrimaryBrush}"/>
                                <TextBlock Text="{wpf:Translate selfservice_system_sub}" 
                                           FontSize="12" 
                                           Foreground="{Binding TextSecondaryBrush}" 
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButtonStyle}" 
                                        Margin="0,0,8,0" 
                                        Click="OnRefreshCurrentSectionClicked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 "/>
                                        <TextBlock Text="{wpf:Translate selfservice_btn_refresh}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}" 
                                        Click="OnCopySystemInfoClicked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 "/>
                                        <TextBlock Text="{wpf:Translate selfservice_btn_copy_sysinfo}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Memory & Resource Cards Grid -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Process Working Set Card -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{wpf:Translate selfservice_sys_memory_process}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SystemInfoSection.WorkingSetText}" FontSize="18" FontWeight="Bold" Margin="0,6,0,2"/>
                                    <TextBlock Text="{Binding SystemInfoSection.PeakWorkingSetText, StringFormat='Peak: {0}'}" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Managed GC Heap Card -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="{wpf:Translate selfservice_sys_memory_gc}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SystemInfoSection.GcMemoryText}" FontSize="18" FontWeight="Bold" Margin="0,6,0,2"/>
                                    <TextBlock Text="{Binding SystemInfoSection.PrivateMemoryText, StringFormat='Private: {0}'}" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- System RAM Card -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{wpf:Translate selfservice_sys_memory_ram}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SystemInfoSection.SystemMemoryText}" FontSize="14" FontWeight="Bold" Margin="0,6,0,2"/>
                                    <TextBlock Text="{Binding SystemInfoSection.MemoryLoadText, StringFormat='Memory Load: {0}'}" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Process Status Bar Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ " FontSize="14" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding SystemInfoSection.ProcessStatsText}" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{wpf:Translate selfservice_sys_uptime_label}" FontSize="11.5" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SystemInfoSection.UptimeText}" FontWeight="SemiBold" FontSize="11.5"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Full Diagnostic Text Viewer Card -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{wpf:Translate selfservice_sys_report_title}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8"/>
                                <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}" 
                                        BorderBrush="{Binding CardBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="2">
                                    <TextBox Text="{Binding SystemInfoSection.EnvironmentReport, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Height="240"
                                             FontFamily="Consolas, Cascadia Code, Courier New"
                                             FontSize="11.5"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{Binding TextPrimaryBrush}"
                                             Padding="8"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Section 2: Files & Logs -->
                <ScrollViewer x:Name="FileInfoPanel" 
                              VerticalScrollBarVisibility="Auto" 
                              Padding="22,18">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{wpf:Translate selfservice_files_title}" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{Binding TextPrimaryBrush}"/>
                                <TextBlock Text="{wpf:Translate selfservice_files_sub}" 
                                           FontSize="12" 
                                           Foreground="{Binding TextSecondaryBrush}" 
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Click="OnRefreshCurrentSectionClicked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 "/>
                                    <TextBlock Text="{wpf:Translate selfservice_btn_refresh}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Log File Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📄 " FontSize="15" Margin="0,0,4,0"/>
                                        <TextBlock Text="{wpf:Translate selfservice_files_logfile_title}" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding FileInfoSection.LogFileSizeText}" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                </Grid>

                                <!-- Path Display -->
                                <Border Grid.Row="1" 
                                        Background="{Binding BadgeBackgroundBrush}" 
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4" 
                                        Padding="10,6" 
                                        Margin="0,0,0,10">
                                    <TextBlock Text="{Binding FileInfoSection.LogFilePath}" 
                                               FontFamily="Consolas, monospace" 
                                               FontSize="11.5" 
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Actions: Copy Path -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                                            Click="OnCopyLogPathClicked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 "/>
                                            <TextBlock Text="{wpf:Translate selfservice_btn_copy_path}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Config File Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚙️ " FontSize="15" Margin="0,0,4,0"/>
                                        <TextBlock Text="{wpf:Translate selfservice_files_inifile_title}" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding FileInfoSection.ConfigFileSizeText}" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                </Grid>

                                <!-- Path Display -->
                                <Border Grid.Row="1" 
                                        Background="{Binding BadgeBackgroundBrush}" 
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4" 
                                        Padding="10,6" 
                                        Margin="0,0,0,10">
                                    <TextBlock Text="{Binding FileInfoSection.ConfigFilePath}" 
                                               FontFamily="Consolas, monospace" 
                                               FontSize="11.5" 
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Actions: Copy Path -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" 
                                            Click="OnCopyConfigPathClicked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 "/>
                                            <TextBlock Text="{wpf:Translate selfservice_btn_copy_path}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Log Quick Glance Card with Magnify Glass Button -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍 " FontSize="15" Margin="0,0,4,0"/>
                                        <TextBlock Text="{wpf:Translate selfservice_files_quickglance_title}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="13"/>
                                    </StackPanel>
                                    <!-- Magnifying Glass Button to open full log in separate window -->
                                    <Button Grid.Column="1" 
                                            Style="{StaticResource PrimaryButtonStyle}" 
                                            Click="OnOpenLogViewerClicked" 
                                            ToolTip="{wpf:Translate selfservice_tooltip_open_logviewer}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍 " FontSize="12"/>
                                            <TextBlock Text="{wpf:Translate selfservice_btn_open_logviewer}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Grid.Row="1" 
                                           Text="{wpf:Translate selfservice_files_quickglance_desc}" 
                                           FontSize="11.5" 
                                           Foreground="{Binding TextSecondaryBrush}" 
                                           Margin="0,0,0,8"/>

                                <!-- Brief Preview snippet box -->
                                <Border Grid.Row="2" 
                                        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}" 
                                        BorderBrush="{Binding CardBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        MaxHeight="80" 
                                        Padding="6">
                                    <TextBlock Text="{Binding FileInfoSection.RecentLogContent}" 
                                               FontFamily="Consolas, monospace" 
                                               FontSize="11" 
                                               Foreground="{Binding TextSecondaryBrush}" 
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Section 3: Clipboard Diagnostics -->
                <ScrollViewer x:Name="ClipboardPanel" 
                              VerticalScrollBarVisibility="Auto" 
                              Padding="22,18">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{wpf:Translate selfservice_clipboard_title}" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{Binding TextPrimaryBrush}"/>
                                <TextBlock Text="{wpf:Translate selfservice_clipboard_sub}" 
                                           FontSize="12" 
                                           Foreground="{Binding TextSecondaryBrush}" 
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButtonStyle}" 
                                        Margin="0,0,8,0" 
                                        Click="OnRefreshCurrentSectionClicked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 "/>
                                        <TextBlock Text="{wpf:Translate selfservice_clipboard_refresh}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}" 
                                        Click="OnCheckClipboardNowClicked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 "/>
                                        <TextBlock Text="{wpf:Translate selfservice_clipboard_test_now}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Blocker Status Alert Card -->
                        <Border Style="{StaticResource CardBorderStyle}" 
                                BorderBrush="{Binding ClipboardSection.StatusBrush}" 
                                BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header Status -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="🛡️ " FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ClipboardSection.StatusHeader}" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               Foreground="{Binding ClipboardSection.StatusBrush}" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Details -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding ClipboardSection.StatusDetails}" 
                                           FontSize="12" 
                                           TextWrapping="Wrap" 
                                           Foreground="{Binding TextSecondaryBrush}" 
                                           Margin="24,0,0,8"/>

                                <!-- Blocker Details Box (if blocked) -->
                                <Border Grid.Row="2" 
                                        Visibility="{Binding ClipboardSection.IsBlockedVisibility}" 
                                        Background="{Binding BadgeBackgroundBrush}" 
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" 
                                        Padding="10" 
                                        Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{wpf:Translate selfservice_clipboard_locking_process}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock FontFamily="Consolas"><Run Text="{wpf:Translate selfservice_clipboard_label_process_name}"/><Run Text="{Binding ClipboardSection.BlockerProcessName}"/></TextBlock>
                                        <TextBlock FontFamily="Consolas"><Run Text="{wpf:Translate selfservice_clipboard_label_pid}"/><Run Text="{Binding ClipboardSection.BlockerProcessId}"/></TextBlock>
                                        <TextBlock FontFamily="Consolas"><Run Text="{wpf:Translate selfservice_clipboard_label_window_title}"/><Run Text="{Binding ClipboardSection.BlockerWindowTitle}"/></TextBlock>
                                        <TextBlock FontFamily="Consolas" TextWrapping="Wrap" FontWeight="SemiBold"><Run Text="{wpf:Translate selfservice_clipboard_label_executable}"/><Run Text="{Binding ClipboardSection.BlockerExecutablePath}"/></TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Owner Details Box (when accessible) -->
                                <Border Grid.Row="3" 
                                        Visibility="{Binding ClipboardSection.IsAccessibleVisibility}" 
                                        Background="{Binding BadgeBackgroundBrush}" 
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" 
                                        Padding="10" 
                                        Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{wpf:Translate selfservice_clipboard_data_owner}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ClipboardSection.CurrentOwnerInfo}" FontFamily="Consolas" FontSize="11.5"/>
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="{wpf:Translate selfservice_clipboard_label_path}"/><Run Text="{Binding ClipboardSection.OwnerExecutablePath}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Live Diagnostic Loop Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{wpf:Translate selfservice_clipboard_loop_title}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{wpf:Translate selfservice_clipboard_loop_desc}" 
                                                   FontSize="11.5" 
                                                   Foreground="{Binding TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                                Margin="0,0,6,0" 
                                                Click="OnToggleMonitoringClicked">
                                            <TextBlock Text="{Binding ClipboardSection.MonitorToggleText}"/>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                                Click="OnClearClipboardLogClicked">
                                            <TextBlock Text="{wpf:Translate selfservice_clipboard_btn_clear_log}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Event Log Items -->
                                <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}" 
                                        BorderBrush="{Binding CardBorderBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        MaxHeight="160">
                                    <ListBox ItemsSource="{Binding ClipboardSection.MonitorLog}" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ClipboardMonitorEvent}">
                                                <Grid Margin="2,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding Timestamp}" 
                                                               FontFamily="Consolas" 
                                                               FontSize="10.5" 
                                                               Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Message}" 
                                                            FontWeight="SemiBold" 
                                                            FontSize="11.5" 
                                                            Foreground="{Binding StatusBrush}" 
                                                            Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding ProcessDetails}" 
                                                            FontSize="10.5" 
                                                            Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Formats on Clipboard Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{wpf:Translate selfservice_clipboard_formats_title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{wpf:Translate selfservice_clipboard_formats_sub}" FontSize="10.5" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ClipboardSection.Formats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ClipboardFormatItemViewModel}">
                                            <Border Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    BorderThickness="1"
                                                    CornerRadius="4" 
                                                    Padding="10,6" 
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontFamily="Consolas" FontSize="12"/>
                                                        <TextBlock Text="{Binding TypeDescription}" FontSize="10.5" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding Details}" 
                                                               FontSize="11.5" 
                                                               VerticalAlignment="Center" 
                                                               Margin="8,0" 
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding SizeText}" 
                                                               FontSize="11" 
                                                               FontFamily="Consolas" 
                                                               VerticalAlignment="Center" 
                                                               Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Section 4: Hotkeys & Conflicts -->
                <ScrollViewer x:Name="HotkeysPanel" 
                              VerticalScrollBarVisibility="Auto" 
                              Padding="22,18">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{wpf:Translate selfservice_hotkeys_title}" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{Binding TextPrimaryBrush}"/>
                                <TextBlock Text="{wpf:Translate selfservice_hotkeys_sub}" 
                                           FontSize="12" 
                                           Foreground="{Binding TextSecondaryBrush}" 
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Click="OnReRegisterHotkeysClicked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄 "/>
                                    <TextBlock Text="{wpf:Translate selfservice_hotkeys_btn_reregister}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Greenshot Registered Hotkeys Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{wpf:Translate selfservice_hotkeys_configured_title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding HotkeySection.Hotkeys}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:HotkeyStatusItemViewModel}">
                                            <Border Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    BorderThickness="1"
                                                    CornerRadius="4" 
                                                    Padding="10,6" 
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ActionName}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" 
                                                            Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            BorderThickness="1" 
                                                            CornerRadius="4" 
                                                            Padding="8,2" 
                                                            HorizontalAlignment="Left" 
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding HotkeyText}" FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding StatusText}" 
                                                               Foreground="{Binding StatusBrush}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="11.5" 
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- OneDrive Fix Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="☁️ " FontSize="15" Margin="0,0,4,0"/>
                                        <TextBlock Text="{wpf:Translate selfservice_hotkeys_onedrive_title}" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" 
                                            Visibility="{Binding HotkeySection.OneDriveFixButtonVisibility}"
                                            Style="{StaticResource WarningButtonStyle}" 
                                            Click="OnDisableOneDriveHotkeyClicked">
                                        <TextBlock Text="{wpf:Translate selfservice_hotkeys_onedrive_disable_btn}"/>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding HotkeySection.OneDriveStatusText}" 
                                           Foreground="{Binding HotkeySection.OneDriveStatusBrush}" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="2" 
                                           Text="{wpf:Translate selfservice_hotkeys_onedrive_desc}" 
                                           FontSize="11" 
                                           TextWrapping="Wrap" 
                                           Foreground="{Binding TextSecondaryBrush}"/>
                            </Grid>
                        </Border>

                        <!-- Windows Snipping Tool Fix Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🪟 " FontSize="15" Margin="0,0,4,0"/>
                                        <TextBlock Text="{wpf:Translate selfservice_hotkeys_snipping_title}" FontWeight="SemiBold" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Visibility="{Binding HotkeySection.SnippingToolFixButtonVisibility}"
                                                Style="{StaticResource WarningButtonStyle}" 
                                                Margin="0,0,6,0" 
                                                Click="OnDisableSnippingToolTakeoverClicked">
                                            <TextBlock Text="{wpf:Translate selfservice_hotkeys_snipping_disable_btn}"/>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                                Click="OnOpenWindowsKeyboardSettingsClicked">
                                            <TextBlock Text="{wpf:Translate selfservice_hotkeys_snipping_settings_btn}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding HotkeySection.SnippingToolStatusText}" 
                                           Foreground="{Binding HotkeySection.SnippingToolStatusBrush}" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="2" 
                                           Text="{wpf:Translate selfservice_hotkeys_snipping_desc}" 
                                           FontSize="11" 
                                           TextWrapping="Wrap" 
                                           Foreground="{Binding TextSecondaryBrush}"/>
                            </Grid>
                        </Border>

                        <!-- Dropbox Guidance Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="📦 " FontSize="15" Margin="0,0,4,0"/>
                                    <TextBlock Text="{wpf:Translate selfservice_hotkeys_dropbox_title}" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HotkeySection.DropboxStatusText}" 
                                           Foreground="{Binding HotkeySection.DropboxStatusBrush}" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{wpf:Translate selfservice_hotkeys_dropbox_desc}" 
                                           FontSize="11" 
                                           TextWrapping="Wrap" 
                                           Foreground="{Binding TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Contender Apps Detection Card -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{wpf:Translate selfservice_hotkeys_other_title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding HotkeySection.Contenders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:ContenderAppViewModel}">
                                            <Border Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    BorderThickness="1"
                                                    CornerRadius="4" 
                                                    Padding="8,5" 
                                                    Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer Status Bar (no redundant Close button) -->
        <Border Grid.Row="2"
                Background="{Binding CardBackgroundBrush}"
                BorderBrush="{Binding CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status message -->
                <TextBlock Grid.Column="0" 
                           x:Name="FooterStatusText" 
                           FontSize="11.5" 
                           Foreground="{Binding TextSecondaryBrush}" 
                           VerticalAlignment="Center"/>

                <!-- Shortcut indicator -->
                <TextBlock Grid.Column="1" 
                           Text="{wpf:Translate selfservice_shortcuts_hint}" 
                           FontSize="11" 
                           Foreground="{Binding TextSecondaryBrush}" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<!--
    The content of the info panel of the capture window, bound to InfoViewModel. The panel around it (background, border,
    font, foreground) and the theme brushes come from the capture window, see CaptureToolStyle.CreatePanel.
-->
<UserControl x:Class="Greenshot.UI.Capture.Tools.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CaptureTool.MutedForeground}" />
            <Setter Property="Margin" Value="0,1,12,1" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,1,0,1" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="{Binding ScreenLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Screen}" />

            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="{Binding AllScreensLabel}"
                       Visibility="{Binding AllScreensVisibility}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding AllScreens}"
                       Visibility="{Binding AllScreensVisibility}" />

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="{Binding SelectionLabel}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Selection}" />

            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="{Binding WindowLabel}" />
            <!-- Long titles are cut, the panel only grows while shown -->
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Window}"
                       MaxWidth="260" TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="{Binding MouseLabel}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Mouse}" />
        </Grid>
    </StackPanel>
</UserControl>

<UserControl x:Class="Greenshot.UI.Controls.KeyCapBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="70">
    <Border x:Name="KeyCapBorder"
            Margin="2,1"
            Padding="7,3,7,4"
            CornerRadius="4"
            BorderThickness="1,1,1,2"
            VerticalAlignment="Center">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ControlBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.25"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </Border.Style>
        <TextBlock x:Name="KeyCapText"
                   Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=KeyText}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   FontFamily="Segoe UI, Consolas, monospace"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>

<UserControl x:Class="Greenshot.Plugin.ExternalCommand.Views.CommandSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
             xmlns:views="clr-namespace:Greenshot.Base.Wpf.Views;assembly=Greenshot.Base">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8">
        <TextBlock Text="{wpf:Text ExternalCommand.SettingsDescription}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <views:DefinitionListView Title="{wpf:Text ExternalCommand.LabelCommands}" EmptyText="{wpf:Text ExternalCommand.NoCommands}"
                                  Items="{Binding Commands}" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                                  MouseDoubleClick="List_MouseDoubleClick"/>
        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="{wpf:Text ExternalCommand.SettingsNew}" Click="Add_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text ExternalCommand.SettingsImport}" Click="Import_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text ExternalCommand.SettingsApprove}" Click="Approve_Click" IsEnabled="{Binding CanApproveSelected}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text ExternalCommand.SettingsEdit}" Click="Edit_Click" IsEnabled="{Binding CanEditSelected}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text ExternalCommand.SettingsExport}" Click="Export_Click" IsEnabled="{Binding CanExportSelected}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text ExternalCommand.SettingsDelete}" Click="Remove_Click" IsEnabled="{Binding CanRemoveSelected}" Style="{StaticResource LightErrorButtonStyle}" Margin="0,0,0,6"/>
        </WrapPanel>
        <!-- Edit and Remove are off: the command comes with Greenshot -->
        <TextBlock Text="{Binding BuiltInHint}" TextWrapping="Wrap" Margin="0,0,0,6" wpf:LiveRegion.Mode="Polite"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BuiltInHint}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{wpf:Text ExternalCommand.ApprovalHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
        <TextBlock Text="{wpf:Text ExternalCommand.RestartHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
    </StackPanel>
</UserControl>

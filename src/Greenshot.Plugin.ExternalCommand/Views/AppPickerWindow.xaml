<Window x:Class="Greenshot.Plugin.ExternalCommand.Views.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text ExternalCommand.AppPickerTitle}"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/GreenshotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <DockPanel>
            <wpf:ThemedTitleBar DockPanel.Dock="Top"/>
            <DockPanel DockPanel.Dock="Bottom" Margin="14,0,14,14" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="{wpf:Text ExternalCommand.AppPickerBrowse}" Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click"/>
                <Button DockPanel.Dock="Right" Content="{wpf:Text Core.Cancel}" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"/>
                <Button DockPanel.Dock="Right" Content="{wpf:Text ExternalCommand.AppPickerChoose}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Margin="0,0,6,0"
                        IsEnabled="{Binding CanChoose}" Click="Choose_Click"/>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{wpf:Text ExternalCommand.AppPickerHint}" TextWrapping="Wrap" Margin="14,10,14,6"
                       FontSize="{wpf:FontSize 11}" Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
            <DockPanel DockPanel.Dock="Top" Margin="14,0,14,6">
                <Label Content="{wpf:Text ExternalCommand.AppPickerSearch}" Target="{Binding ElementName=SearchBox}" Margin="0,0,12,0"/>
                <TextBox x:Name="SearchBox" Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            </DockPanel>
            <Grid Margin="14,0,14,12">
                <ListBox x:Name="AppList" Style="{StaticResource ThemeListBox}" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                         AutomationProperties.Name="{wpf:Text ExternalCommand.AppPickerTitle}" MouseDoubleClick="AppList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2">
                                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Program}" TextTrimming="CharacterEllipsis" FontSize="{wpf:FontSize 11}"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{wpf:Text ExternalCommand.AppPickerNone}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasNoApps, Converter={StaticResource VisibleWhenTrue}}"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>

<UserControl x:Class="Greenshot.Plugin.Atlassian.Confluence.Views.ConfluenceConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
             xmlns:views="clr-namespace:Greenshot.Base.Wpf.Views;assembly=Greenshot.Base"
             xmlns:confluence="clr-namespace:Greenshot.Plugin.Atlassian.Confluence">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/GreenshotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>



        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8">
        <CheckBox IsChecked="{Binding IncludePersonSpaces}" Content="{wpf:Text Confluence.IncludePersonSpaces}"/>
        <CheckBox IsChecked="{Binding OpenPageAfterUpload}" Content="{wpf:Text Confluence.OpenPageAfterUpload}"/>
        <CheckBox IsChecked="{Binding CopyWikiMarkupForImageToClipboard}" Content="{wpf:Text Confluence.CopyWikimarkup}"/>

        <Grid Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="{wpf:Text Confluence.LabelUrl}" Target="{Binding ElementName=UrlTextBox}"/>
            <TextBox x:Name="UrlTextBox" Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="{wpf:Text Confluence.LabelTimeout}" Target="{Binding ElementName=TimeoutTextBox}"/>
            <TextBox x:Name="TimeoutTextBox" Grid.Column="1" Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="{wpf:Text Confluence.UploadFormat}" Target="{Binding ElementName=UploadFormatCombo}"/>
            <ComboBox x:Name="UploadFormatCombo" Grid.Column="1"
                      DisplayMemberPath="DisplayNameWithPreferredExtension"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding UploadFormat, Mode=TwoWay}"/>
        </Grid>

        <views:ServerAccountView x:Name="AccountView" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>

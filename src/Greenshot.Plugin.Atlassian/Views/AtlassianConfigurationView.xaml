<UserControl x:Class="Greenshot.Plugin.Atlassian.Views.AtlassianConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base">
    <StackPanel>
        <TextBlock Text="{wpf:Text Jira.SettingsTitle}" FontWeight="SemiBold" FontSize="{wpf:FontSize 14}" Margin="8,4,8,0"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
        <ContentControl x:Name="JiraSettings" Focusable="False"/>
        <TextBlock Text="{wpf:Text Confluence.PluginSettings}" FontWeight="SemiBold" FontSize="{wpf:FontSize 14}" Margin="8,16,8,0"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
        <ContentControl x:Name="ConfluenceSettings" Focusable="False"/>
    </StackPanel>
</UserControl>

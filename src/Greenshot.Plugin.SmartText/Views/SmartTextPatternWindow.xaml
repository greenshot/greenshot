<Window x:Class="Greenshot.Plugin.SmartText.Views.SmartTextPatternWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <DockPanel>
            <wpf:ThemedTitleBar DockPanel.Dock="Top"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,14,14">
                <Button Content="{wpf:Text SmartText.Save}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Margin="0,0,6,0" Click="Save_Click"/>
                <Button Content="{wpf:Text Core.Cancel}" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ThemedScrollViewer}" Margin="14,10,14,12">
                <StackPanel>
                    <Label Content="{wpf:Text SmartText.EditorName}" Target="{Binding ElementName=NameBox}" Padding="0" Margin="0,0,0,3"/>
                    <TextBox x:Name="NameBox" Margin="0,0,0,10" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="{wpf:Text SmartText.EditorPattern}" Target="{Binding ElementName=PatternBox}" Padding="0" Margin="0,0,0,3"/>
                    <TextBox x:Name="PatternBox" Margin="0,0,0,3" FontFamily="Consolas" Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{wpf:Text SmartText.EditorPatternHint}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"/>
                    <Label Content="{wpf:Text SmartText.EditorLabel}" Target="{Binding ElementName=LabelBox}" Padding="0" Margin="0,0,0,3"/>
                    <TextBox x:Name="LabelBox" Margin="0,0,0,10" FontFamily="Consolas" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="{wpf:Text SmartText.EditorLabelPosition}" Target="{Binding ElementName=LabelPositionBox}" Padding="0" Margin="0,0,0,3"/>
                    <ComboBox x:Name="LabelPositionBox" Margin="0,0,0,10" IsEnabled="{Binding HasLabel}" ItemsSource="{Binding LabelPositions}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding LabelPosition, Mode=TwoWay}"/>
                    <Label Content="{wpf:Text SmartText.EditorArea}" Target="{Binding ElementName=AreaBox}" Padding="0" Margin="0,0,0,3"/>
                    <ComboBox x:Name="AreaBox" Margin="0,0,0,10" ItemsSource="{Binding AreaChoices}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding Area, Mode=TwoWay}"/>
                    <Label Content="{wpf:Text SmartText.EditorMinDigits}" Target="{Binding ElementName=MinDigitsBox}" Padding="0" Margin="0,0,0,3"/>
                    <TextBox x:Name="MinDigitsBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10" Text="{Binding MinDigits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="{wpf:Text SmartText.EditorMaxDigits}" Target="{Binding ElementName=MaxDigitsBox}" Padding="0" Margin="0,0,0,3"/>
                    <TextBox x:Name="MaxDigitsBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10" Text="{Binding MaxDigits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="{wpf:Text SmartText.EditorNormalize}" Target="{Binding ElementName=NormalizeBox}" Padding="0" Margin="0,0,0,3"/>
                    <ComboBox x:Name="NormalizeBox" Margin="0,0,0,10" ItemsSource="{Binding NormalizeChoices}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding Normalize, Mode=TwoWay}"/>
                    <Label Content="{wpf:Text SmartText.EditorValidate}" Target="{Binding ElementName=ValidateBox}" Padding="0" Margin="0,0,0,3"/>
                    <ComboBox x:Name="ValidateBox" Margin="0,0,0,10" ItemsSource="{Binding ValidateChoices}" DisplayMemberPath="Text" SelectedValuePath="Value" SelectedValue="{Binding Validate, Mode=TwoWay}"/>
                    <Label Content="{wpf:Text SmartText.EditorOpenUrl}" Target="{Binding ElementName=OpenUrlBox}" Padding="0" Margin="0,0,0,3"/>
                    <TextBox x:Name="OpenUrlBox" Margin="0,0,0,10" Text="{Binding OpenUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="{wpf:Text SmartText.EditorMatchCase}" IsChecked="{Binding MatchCase, Mode=TwoWay}" Margin="0,0,0,6"/>
                    <CheckBox IsChecked="{Binding DigitLookAlikes, Mode=TwoWay}" Margin="0,0,0,12">
                        <TextBlock Text="{wpf:Text SmartText.EditorDigitLookAlikes}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <Label Content="{wpf:Text SmartText.EditorTest}" Target="{Binding ElementName=TestBox}" Padding="0" Margin="0,0,0,3"/>
                    <TextBox x:Name="TestBox" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding TestText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,4,0,0" wpf:LiveRegion.Mode="Polite"/>
                    <TextBlock Text="{Binding Problems}" TextWrapping="Wrap" Margin="0,4,0,0" wpf:LiveRegion.Mode="Polite"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ErrorBrush}"
                               Visibility="{Binding ShowProblems, Converter={StaticResource VisibleWhenTrue}}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

<UserControl x:Class="Greenshot.Plugin.SmartText.Views.SmartTextSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
             xmlns:views="clr-namespace:Greenshot.Base.Wpf.Views;assembly=Greenshot.Base">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8">
        <TextBlock Text="{wpf:Text SmartText.SettingsDescription}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <views:DefinitionListView Title="{wpf:Text SmartText.LabelBuiltIn}"
                                  Items="{Binding BuiltIns}" SelectedItem="{Binding SelectedBuiltIn, Mode=TwoWay}"/>

        <views:DefinitionListView Title="{wpf:Text SmartText.LabelOwn}" EmptyText="{wpf:Text SmartText.NoOwn}" Margin="0,12,0,0"
                                  Items="{Binding Patterns}" SelectedItem="{Binding SelectedPattern, Mode=TwoWay}"
                                  MouseDoubleClick="List_MouseDoubleClick"/>
        <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="{wpf:Text SmartText.SettingsNew}" Click="Add_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text SmartText.SettingsImport}" Click="Import_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text SmartText.SettingsApprove}" Click="Approve_Click" IsEnabled="{Binding CanApproveSelected}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text SmartText.SettingsEdit}" Click="Edit_Click" IsEnabled="{Binding CanEditSelected}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text SmartText.SettingsExport}" Click="Export_Click" IsEnabled="{Binding CanExportSelected}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6"/>
            <Button Content="{wpf:Text SmartText.SettingsDelete}" Click="Remove_Click" IsEnabled="{Binding CanRemoveSelected}" Style="{StaticResource LightErrorButtonStyle}" Margin="0,0,0,6"/>
        </WrapPanel>
        <TextBlock Text="{wpf:Text SmartText.ImportTrust}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
    </StackPanel>
</UserControl>

<UserControl x:Class="Greenshot.Plugin.CustomUploader.Views.CustomUploaderSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="MinHeight" Value="80"/>
                <Setter Property="MaxHeight" Value="180"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8">
        <TextBlock Text="{wpf:Text CustomUploader.SettingsDescription}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!-- The uploaders -->
        <TextBlock Text="{wpf:Text CustomUploader.UploadersTitle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ListBox ItemsSource="{Binding Uploaders}" SelectedItem="{Binding SelectedUploader, Mode=TwoWay}"
                 Visibility="{Binding HasUploaders, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" Margin="12,0,0,0"
                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{wpf:Text CustomUploader.NoUploaders}" TextWrapping="Wrap"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasUploaders}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,16">
            <Button Content="{wpf:Text CustomUploader.Import}" Click="Import_Click"/>
            <Button Content="{wpf:Text CustomUploader.Remove}" Click="Remove_Click" IsEnabled="{Binding HasSelectedUploader}"/>
        </StackPanel>

        <!-- The uploads -->
        <TextBlock Text="{wpf:Text CustomUploader.UploadsTitle}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ListBox ItemsSource="{Binding Uploads}" SelectedItem="{Binding SelectedUpload, Mode=TwoWay}"
                 Visibility="{Binding HasUploads, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Text="{Binding Date}" Width="130"
                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                        <TextBlock Text="{Binding Uploader}" Width="120" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{wpf:Text CustomUploader.NoUploads}"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasUploads}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="{wpf:Text CustomUploader.Open}" Click="Open_Click" IsEnabled="{Binding HasSelectedUpload}"/>
            <Button Content="{wpf:Text CustomUploader.Delete}" Click="Delete_Click" IsEnabled="{Binding CanDeleteSelectedUpload}"/>
            <Button Content="{wpf:Text CustomUploader.Forget}" Click="Forget_Click" IsEnabled="{Binding HasSelectedUpload}"/>
        </StackPanel>
        <!-- Delete is off: the service has no delete link, Greenshot can't remove it either -->
        <TextBlock Text="{Binding NoDeletionHint}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoDeletionHint}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>

<Window x:Class="Greenshot.Plugin.CustomUploader.Views.UploaderValuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Width="560" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <DockPanel>
            <wpf:ThemedTitleBar DockPanel.Dock="Top"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,14,14">
                <Button Content="{wpf:Text CustomUploader.ValuesNext}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Margin="0,0,6,0" Click="Next_Click"/>
                <Button Content="{wpf:Text Core.Cancel}" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"/>
            </StackPanel>

            <StackPanel Margin="14,10,14,12">
                <TextBlock Text="{wpf:Text CustomUploader.ValuesIntro}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440" Style="{StaticResource ThemedScrollViewer}">
                    <ItemsControl x:Name="ValueList" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Show"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{Binding Label}" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding Label, TargetNullValue=''}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMasked}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <!-- Keys and tokens are masked until the user asks to see them -->
                                    <PasswordBox Grid.Column="1" IsVisibleChanged="Secret_IsVisibleChanged" PasswordChanged="Secret_PasswordChanged"
                                                 AutomationProperties.Name="{Binding Label, TargetNullValue=''}"
                                                 Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                                                 Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}"
                                                 BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ControlBorderBrush}"
                                                 CaretBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                                                 Visibility="{Binding IsMasked, Converter={StaticResource VisibleWhenTrue}}"/>
                                    <CheckBox Grid.Column="2" Content="{wpf:Text CustomUploader.ValuesShow}" Margin="8,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsRevealed, Mode=TwoWay}"
                                              Visibility="{Binding IsSecret, Converter={StaticResource VisibleWhenTrue}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

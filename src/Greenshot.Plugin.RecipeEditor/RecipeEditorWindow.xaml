<Window x:Class="Greenshot.Plugin.RecipeEditor.RecipeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
        xmlns:vm="clr-namespace:Greenshot.Plugin.RecipeEditor.ViewModels"
        xmlns:conv="clr-namespace:Greenshot.Plugin.RecipeEditor.Converters"
        xmlns:emoji="clr-namespace:Greenshot.Editor.Controls.Emoji;assembly=Greenshot.Editor"
        mc:Ignorable="d"
        Title="Greenshot - Recipe Visual Editor"
        Height="800" Width="1240"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        Background="{Binding WindowBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
        <KeyBinding Key="Back" Command="{Binding DeleteSelectedCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveRecipeCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenRecipeCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewRecipeCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding AutoLayoutCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StepTypeToColorConverter x:Key="StepColorConv"/>
            <conv:StepTypeToIconConverter x:Key="StepIconConv"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
            <conv:StringToVisibilityConverter x:Key="StringToVis"/>
            <conv:StringToBrushConverter x:Key="StringToBrushConv"/>

        <!-- Modern Themed CheckBox Style -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="checkBorder" Grid.Column="0"
                                    Width="16" Height="16"
                                    CornerRadius="3"
                                    Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="checkMark"
                                      Data="M 3,8 L 6.5,11.5 L 12.5,4.5"
                                      Stroke="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      SnapsToDevicePixels="True"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Caption Button Style -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#26888888"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Caption Close Button Style -->
        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <Path x:Name="crossPath" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base Toolbar Button Style -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding BadgeBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Delete Button Style -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#1AEC2B2B"/>
            <Setter Property="BorderBrush" Value="#CCEC2B2B"/>
            <Setter Property="Foreground" Value="#FFEC2B2B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Trigger Delete Button Style -->
        <Style x:Key="TriggerDeleteBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FF6B6B"/>
                                <Setter Property="Foreground" Value="#FFFF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item Delete Button Style (for Annotations, Variables, Branches, Choices) -->
        <Style x:Key="ItemDeleteBtn" TargetType="Button">
            <Setter Property="Background" Value="#1AE81123"/>
            <Setter Property="BorderBrush" Value="#40E81123"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFE81123"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="ToolTip" Value="Delete"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFE81123"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFC42B1C"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFC42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Themed Context Menu -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Themed Menu Item -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="12,0,0,0"
                                           Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" FontSize="10"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding BadgeBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Themed Menu Separator -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="{Binding CardBorderBrush}"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="{Binding AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Toolbox Item Button -->
        <Style x:Key="ToolboxItemBtn" TargetType="Button">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding BadgeBackgroundBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{Binding AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inspector TabItem Style -->
        <Style x:Key="InspectorTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}" Margin="0,0,8,0" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{Binding AccentBrush}"/>
                                <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Pin Connector Style -->
        <Style x:Key="PinConnectorStyle" TargetType="{x:Type nodify:Connector}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type nodify:Connector}">
                        <Grid Background="Transparent">
                            <!-- Soft circular glow on hover / connect -->
                            <Ellipse x:Name="OuterGlow"
                                     Width="18" Height="18"
                                     Fill="{Binding AccentBrush}"
                                     Opacity="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                            <!-- Pin body -->
                            <Ellipse x:Name="PinCircle"
                                     Width="10" Height="10"
                                     Fill="{Binding CardBackgroundBrush}"
                                     Stroke="{Binding CardBorderBrush}"
                                     StrokeThickness="1.5"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsConnected" Value="True">
                                <Setter TargetName="PinCircle" Property="Fill" Value="{Binding AccentBrush}"/>
                                <Setter TargetName="PinCircle" Property="Stroke" Value="White"/>
                                <Setter TargetName="PinCircle" Property="StrokeThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterGlow" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="PinCircle" Property="Stroke" Value="{Binding AccentBrush}"/>
                                <Setter TargetName="PinCircle" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Node Template (Top/Bottom Flow) -->
        <DataTemplate DataType="{x:Type vm:StepNodeViewModel}">
            <Border Background="{Binding DataContext.NodeCardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderBrush="{Binding DataContext.NodeCardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Width="220"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="⭐ Toggle Start Step" Command="{Binding ToggleStartNodeCommand}"/>
                        <Separator/>
                        <MenuItem Header="🗑️ Delete Step" Command="{Binding DeleteNodeCommand}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Content / Summary -->
                        <RowDefinition Height="Auto"/> <!-- Conditional Branches Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{Binding StepType, Converter={StaticResource StepColorConv}}"
                            CornerRadius="7,7,0,0" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StepType, Converter={StaticResource StepIconConv}}"
                                       FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                       FontWeight="Bold" FontSize="12" Foreground="White"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="2" Background="#238636" CornerRadius="3"
                                    Padding="4,1" Margin="4,0,0,0"
                                    Visibility="{Binding IsStartNode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="START" FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <Border Grid.Row="1" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontFamily="Consolas" Margin="0,0,0,4"/>

                            <!-- Standard Step Summary -->
                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasDynamicOutputPorts, Converter={StaticResource InvertBoolToVis}}"/>

                            <!-- Conditional Branches Summary inside Card Body -->
                            <StackPanel Visibility="{Binding IsConditional, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Branches:" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding ConditionBranches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Margin="0,0,6,0"
                                                        Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Expression}" FontSize="10"
                                                           FontFamily="Consolas" VerticalAlignment="Center"
                                                           Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Expression}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- User Decision Choices Summary inside Card Body -->
                            <StackPanel Visibility="{Binding IsUserPrompt, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UserPromptMessage}" FontSize="10"
                                           Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding PromptChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Margin="0,0,6,0"
                                                        Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Conditional Branches Footer (Clean Pins Aligned to Bottom) -->
                    <Border Grid.Row="2"
                            Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,7,7"
                            Padding="2,3,2,0"
                            Visibility="{Binding IsConditional, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding ConditionBranches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30" ToolTip="{Binding Expression}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,1,0,0"
                                                Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                BorderThickness="1" CornerRadius="3" Padding="6,1">
                                            <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Border>
                                        <nodify:Connector Grid.Row="1"
                                                          DataContext="{Binding Port}"
                                                          Style="{StaticResource PinConnectorStyle}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,0,0,-9"
                                                          Panel.ZIndex="10"
                                                          Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                          IsConnected="{Binding IsConnected}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- User Prompt Choices Footer (Clean Pins Aligned to Bottom) -->
                    <Border Grid.Row="2"
                            Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,7,7"
                            Padding="2,3,2,0"
                            Visibility="{Binding IsUserPrompt, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding PromptChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30" ToolTip="{Binding Label}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,1,0,0"
                                                Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                BorderThickness="1" CornerRadius="3" Padding="6,1">
                                            <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Border>
                                        <nodify:Connector Grid.Row="1"
                                                          DataContext="{Binding Port}"
                                                          Style="{StaticResource PinConnectorStyle}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,0,0,-9"
                                                          Panel.ZIndex="10"
                                                          Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                          IsConnected="{Binding IsConnected}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Top Input Pin (Vertical Flow - Centered on Top Edge) -->
                    <nodify:Connector Grid.Row="0"
                                      DataContext="{Binding InputPort}"
                                      Style="{StaticResource PinConnectorStyle}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Margin="0,-9,0,0"
                                      Panel.ZIndex="10"
                                      Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                      IsConnected="{Binding IsConnected}"/>

                    <!-- Bottom Output Pin (For Non-Conditional / Non-Prompt Steps) -->
                    <nodify:Connector Grid.Row="1"
                                      DataContext="{Binding OutputPort}"
                                      Style="{StaticResource PinConnectorStyle}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,-9"
                                      Panel.ZIndex="10"
                                      Visibility="{Binding Node.HasDynamicOutputPorts, Converter={StaticResource InvertBoolToVis}}"
                                      Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                      IsConnected="{Binding IsConnected}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ItemContainerStyle" TargetType="{x:Type nodify:ItemContainer}">
            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type nodify:ItemContainer}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{Binding CardBorderBrush}" Background="{Binding WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Custom Titlebar Chrome -->
                <RowDefinition Height="Auto"/> <!-- Main Toolbar -->
                <RowDefinition Height="*"/>    <!-- Canvas & Sidebars -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Custom Chrome Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="📷" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Greenshot" FontWeight="Bold" FontSize="12" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Recipe Visual Editor" FontSize="12" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Caption Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtnStyle}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToggleToolTip}">
                        <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="OnMinimizeClicked" ToolTip="Minimize">
                        <Rectangle Width="10" Height="1.5" Fill="{Binding TextPrimaryBrush}" SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="OnMaximizeClicked" ToolTip="Maximize / Restore">
                        <Rectangle Width="10" Height="10" Stroke="{Binding TextPrimaryBrush}" StrokeThickness="1.5" Fill="Transparent" SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtnStyle}" Click="OnCloseTitleBarClicked" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Main Toolbar -->
            <Border Grid.Row="1" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="0,1,0,1" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recipe Selector -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Recipe:" FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableRecipes}"
                                  SelectedItem="{Binding ActiveRecipe, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="220" Height="28" Margin="0,0,10,0"/>
                    </StackPanel>

                    <!-- Actions Toolbar -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Left" Margin="15,0,0,0">
                        <Button Content="New" Style="{StaticResource ToolbarBtn}" Command="{Binding NewRecipeCommand}" ToolTip="Create new recipe"/>
                        <Button Content="Open..." Style="{StaticResource ToolbarBtn}" Command="{Binding OpenRecipeCommand}" ToolTip="Open recipe file from disk"/>
                        <Button Content="Save" Style="{StaticResource ToolbarBtn}" Command="{Binding SaveRecipeCommand}" ToolTip="Save current recipe"/>
                        <Button Content="Save As..." Style="{StaticResource ToolbarBtn}" Command="{Binding SaveAsCommand}" ToolTip="Save recipe to new file"/>
                        <Separator Width="1" Background="{Binding CardBorderBrush}" Margin="6,2"/>
                        <Button Content="Auto-Layout" Style="{StaticResource ToolbarBtn}" Command="{Binding AutoLayoutCommand}" ToolTip="Auto-organize DAG layout"/>
                        <Button Content="{}{ } JSON" Style="{StaticResource ToolbarBtn}" Command="{Binding ToggleJsonViewCommand}" ToolTip="View / Edit Raw Recipe JSON"/>
                        <Button Content="🧜 Mermaid" Style="{StaticResource ToolbarBtn}" Command="{Binding ToggleMermaidViewCommand}" ToolTip="Generate Mermaid Diagram DSL for documentation"/>
                    </StackPanel>

                    <!-- Right Action: Test Run -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2">
                        <Button Content="▶ Test Run Recipe" Style="{StaticResource PrimaryBtn}" Command="{Binding TestRunCommand}" ToolTip="Execute capture recipe in Greenshot"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Workspace -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="180" MaxWidth="300"/> <!-- Left Toolbox -->
                    <ColumnDefinition Width="*"/>                                 <!-- Nodify DAG Canvas -->
                    <ColumnDefinition Width="320" MinWidth="260" MaxWidth="440"/> <!-- Right Properties Inspector -->
                </Grid.ColumnDefinitions>

                <!-- Left Toolbox -->
                <Border Grid.Column="0" Background="{Binding WindowBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="0,0,1,0" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="STEP TOOLBOX" FontWeight="Bold" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="4,4,0,8"/>

                            <!-- 1. Acquisition -->
                            <TextBlock Text="ACQUISITION" FontWeight="SemiBold" FontSize="10" Foreground="{Binding TextSecondaryBrush}" Margin="4,8,0,4"/>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Source">
                                <TextBlock Text="📷 Source (Acquisition)"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="InteractiveSelection">
                                <TextBlock Text="🔲 Interactive Selection"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="RecordVideo">
                                <TextBlock Text="🎥 Record Video (WGC)"/>
                            </Button>

                            <!-- 2. Filters & Effects -->
                            <TextBlock Text="FILTERS &amp; EFFECTS" FontWeight="SemiBold" FontSize="10" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Effect">
                                <TextBlock Text="✨ Effect (Border/Shadow/Filters)"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="TextEffect">
                                <TextBlock Text="🛡️ Text Effect / DLP"/>
                            </Button>

                            <!-- 3. Annotations & Variables -->
                            <TextBlock Text="ANNOTATIONS &amp; DATA" FontWeight="SemiBold" FontSize="10" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Annotation">
                                <TextBlock Text="🎨 Annotation"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="SetVariable">
                                <TextBlock Text="💲 Set Variable"/>
                            </Button>

                            <!-- 4. Execution & Logic -->
                            <TextBlock Text="FLOW &amp; FEEDBACK" FontWeight="SemiBold" FontSize="10" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="UserPrompt">
                                <TextBlock Text="❓ User Decision Prompt"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Conditional">
                                <TextBlock Text="🔀 Conditional Branch"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="ImmediateFeedback">
                                <TextBlock Text="🔊 Shutter Sound"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Notification">
                                <TextBlock Text="🔔 Toast Notification"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Processors">
                                <TextBlock Text="⚙️ Processors / OCR"/>
                            </Button>

                            <!-- 5. Destinations & Output -->
                            <TextBlock Text="OUTPUT &amp; DESTINATIONS" FontWeight="SemiBold" FontSize="10" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="SaveFile">
                                <TextBlock Text="💾 Save to File"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Clipboard">
                                <TextBlock Text="📋 System Clipboard"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Editor">
                                <TextBlock Text="🎨 Image Editor"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Printer">
                                <TextBlock Text="🖨️ Printer"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Email">
                                <TextBlock Text="📧 E-Mail"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="CustomDestination">
                                <TextBlock Text="↗️ Custom Destination"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Destinations">
                                <TextBlock Text="↗️ Multi-Destinations"/>
                            </Button>

                            <!-- 6. Extensions & Plugins -->
                            <TextBlock Text="EXTENSIONS &amp; PLUGINS" FontWeight="SemiBold" FontSize="10" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="ExternalCommand">
                                <TextBlock Text="⚡ External Command"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Imgur">
                                <TextBlock Text="🖼️ Imgur Upload"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Jira">
                                <TextBlock Text="🎯 Atlassian Jira"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Confluence">
                                <TextBlock Text="📄 Confluence Page"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Office">
                                <TextBlock Text="📊 Microsoft Office"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Zxing">
                                <TextBlock Text="🔍 ZXing Barcode / QR"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Box">
                                <TextBlock Text="📦 Box Cloud Storage"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxItemBtn}" Command="{Binding AddStepCommand}" CommandParameter="Dropbox">
                                <TextBlock Text="📦 Dropbox"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Center Nodify DAG Canvas -->
                <Grid Grid.Column="1" Background="{Binding WindowBackgroundBrush}">
                    <nodify:NodifyEditor x:Name="EditorCanvas"
                                         ItemsSource="{Binding Nodes}"
                                         SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                         SelectedConnection="{Binding SelectedConnection, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource ItemContainerStyle}"
                                         Connections="{Binding Connections}"
                                         PendingConnection="{Binding PendingConnection}"
                                         DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                         Background="{Binding WindowBackgroundBrush}">
                        <nodify:NodifyEditor.PendingConnectionTemplate>
                            <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                                <nodify:PendingConnection StartedCommand="{Binding StartedCommand}"
                                                          CompletedCommand="{Binding CompletedCommand}"
                                                          Source="{Binding Source, Mode=TwoWay}"
                                                          Target="{Binding Target, Mode=TwoWay}"
                                                          TargetAnchor="{Binding TargetLocation}"
                                                          IsVisible="{Binding IsVisible, Mode=TwoWay}"
                                                          Stroke="#0098FF"
                                                          StrokeThickness="2.5" />
                            </DataTemplate>
                        </nodify:NodifyEditor.PendingConnectionTemplate>
                        <nodify:NodifyEditor.ConnectionTemplate>
                            <DataTemplate DataType="{x:Type vm:StepConnectionViewModel}">
                                <nodify:Connection Source="{Binding Source.Anchor}"
                                                   Target="{Binding Target.Anchor}"
                                                   SourceOrientation="Vertical"
                                                   TargetOrientation="Vertical"
                                                   Spacing="0"
                                                   ArrowEnds="End"
                                                   ArrowSize="10 10"
                                                   PreviewMouseLeftButtonDown="OnConnectionPreviewMouseLeftButtonDown"
                                                   Cursor="Hand"
                                                   Text="{Binding Label}"
                                                   TextBackground="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   DisconnectCommand="{Binding DisconnectCommand}"
                                                   ToolTip="Click to select connection (Press Delete or Backspace to remove)">
                                    <nodify:Connection.Style>
                                        <Style TargetType="{x:Type nodify:Connection}">
                                            <Setter Property="Stroke" Value="{Binding IsCycle, Converter={StaticResource StepColorConv}, ConverterParameter=cycle}"/>
                                            <Setter Property="StrokeThickness" Value="2.5"/>
                                            <Setter Property="OutlineThickness" Value="5"/>
                                            <Setter Property="OutlineBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="#00D2FF"/>
                                                    <Setter Property="StrokeThickness" Value="3"/>
                                                    <Setter Property="OutlineThickness" Value="4"/>
                                                    <Setter Property="OutlineBrush" Value="#4400D2FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </nodify:Connection.Style>
                                    <nodify:Connection.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="🗑️ Delete Connection" Command="{Binding DisconnectCommand}"/>
                                        </ContextMenu>
                                    </nodify:Connection.ContextMenu>
                                </nodify:Connection>
                            </DataTemplate>
                        </nodify:NodifyEditor.ConnectionTemplate>
                    </nodify:NodifyEditor>


                    <!-- In-Canvas JSON Editor Overlay -->
                    <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Margin="30" Padding="15"
                            Visibility="{Binding IsJsonViewVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Recipe JSON Definition" FontWeight="Bold" FontSize="14" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1" Text="{Binding RawJsonText, Mode=TwoWay}"
                                     FontFamily="Consolas" FontSize="12"
                                     Background="{Binding WindowBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Apply Changes" Style="{StaticResource PrimaryBtn}" Command="{Binding ApplyJsonCommand}"/>
                                <Button Content="Close" Style="{StaticResource ToolbarBtn}" Command="{Binding ToggleJsonViewCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- In-Canvas Mermaid Editor Overlay -->
                    <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Margin="30" Padding="15"
                            Visibility="{Binding IsMermaidViewVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mermaid Workflow DSL" FontWeight="Bold" FontSize="14" Foreground="{Binding TextPrimaryBrush}"/>
                                    <TextBlock Text="Copy this Mermaid syntax to use in documentation, markdown files, or PR descriptions."
                                               FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <TextBox Grid.Row="1" Text="{Binding MermaidText, Mode=OneWay}"
                                     FontFamily="Consolas" FontSize="12"
                                     Background="{Binding WindowBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="📋 Copy Mermaid Code" Style="{StaticResource PrimaryBtn}" Command="{Binding CopyMermaidCommand}" Margin="0,0,8,0"/>
                                <Button Content="Close" Style="{StaticResource ToolbarBtn}" Command="{Binding ToggleMermaidViewCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Sidebar: Properties & Step Inspector / Recipe & Triggers Tabs -->
                <Border Grid.Column="2" Background="{Binding WindowBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1,0,0,0">
                    <TabControl SelectedIndex="{Binding SelectedInspectorTabIndex, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Margin="4,4,4,4">
                        <!-- Tab 1: Step Inspector -->
                        <TabItem Header="⚙️ Step Inspector" Style="{StaticResource InspectorTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,8,6,8">
                                <StackPanel>
                                    <!-- When a connection is selected -->
                                    <StackPanel Visibility="{Binding HasSelectedConnection, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="CONNECTION SELECTED" FontWeight="Bold" FontSize="11" Foreground="{Binding AccentBrush}" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding BadgeBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                        <StackPanel>
                                                            <TextBlock Text="FROM" FontSize="9" FontWeight="Bold" Foreground="{Binding TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SelectedConnection.SourceNode.DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SelectedConnection.Source.Title}" FontSize="10" Foreground="{Binding AccentBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="➔" FontSize="14" FontWeight="Bold" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0"/>
                                                    <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                        <StackPanel>
                                                            <TextBlock Text="TO" FontSize="9" FontWeight="Bold" Foreground="{Binding TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SelectedConnection.TargetNode.DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SelectedConnection.Target.Title}" FontSize="10" Foreground="{Binding AccentBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Button Content="🗑️ Delete Connection" Style="{StaticResource DangerBtn}"
                                                        Command="{Binding SelectedConnection.DisconnectCommand}"
                                                        ToolTip="Remove this connection (or press Delete / Backspace)"/>
                                                <TextBlock Text="Tip: Press Delete or Backspace key to remove the connection." FontSize="10" Foreground="{Binding TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- When a node is selected -->
                                    <StackPanel Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVis}}">
                                        <!-- Start Step Status / Toggle -->
                                        <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="Flow Entry Point" FontWeight="SemiBold" FontSize="11" Foreground="{Binding TextPrimaryBrush}"/>
                                                        <TextBlock Text="Defines if this step starts the recipe execution" FontSize="10" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#238636" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                            Visibility="{Binding SelectedNode.IsStartNode, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="⭐ START STEP" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Content="⭐ Mark as Start Step" Style="{StaticResource ToolbarBtn}" Margin="0,0,6,0"
                                                            Command="{Binding SelectedNode.ToggleStartNodeCommand}"
                                                            Visibility="{Binding SelectedNode.IsStartNode, Converter={StaticResource InvertBoolToVis}}"
                                                            ToolTip="Add this step as a parallel entry point"/>
                                                    <Button Content="⭐ Remove Start Step" Style="{StaticResource ToolbarBtn}" Margin="0,0,6,0"
                                                            Command="{Binding SelectedNode.ToggleStartNodeCommand}"
                                                            Visibility="{Binding SelectedNode.IsStartNode, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Remove this step from start steps"/>
                                                    <Button Content="🗑️ Delete Step" Style="{StaticResource DangerBtn}"
                                                            Command="{Binding DeleteSelectedCommand}"
                                                            ToolTip="Delete this step from the recipe"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Node Metadata -->
                                        <TextBlock Text="Node ID" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                        <TextBox Text="{Binding SelectedNode.Id, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                 Padding="6,4" Margin="0,2,0,8" ToolTip="Unique identifier for this step. Editing this ID updates all DAG references."/>

                                        <TextBlock Text="Step Type" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                        <TextBox Text="{Binding SelectedNode.StepType, Mode=OneWay}" IsReadOnly="True"
                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextSecondaryBrush}"
                                                 Padding="6,4" Margin="0,2,0,8"/>

                                        <TextBlock Text="Display Name / Label" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                        <TextBox Text="{Binding SelectedNode.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                 Padding="6,4" Margin="0,2,0,12"/>

                                        <Separator Background="{Binding CardBorderBrush}" Margin="0,4,0,12"/>
                                        <TextBlock Text="STEP PARAMETERS" FontWeight="Bold" FontSize="10" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,8"/>

                                        <!-- 1. Source Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Source}">
                                            <TextBlock Text="Source Type" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.SourceType, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Region (Interactive select)" Tag="Region"/>
                                                <ComboBoxItem Content="Window (Window picker)" Tag="Window"/>
                                                <ComboBoxItem Content="ActiveWindow (Focused window)" Tag="ActiveWindow"/>
                                                <ComboBoxItem Content="FullScreen (All displays)" Tag="FullScreen"/>
                                                <ComboBoxItem Content="LastRegion (Repeat region)" Tag="LastRegion"/>
                                                <ComboBoxItem Content="Clipboard (From clipboard image)" Tag="Clipboard"/>
                                                <ComboBoxItem Content="File (Load from disk)" Tag="File"/>
                                                <ComboBoxItem Content="TextOcr (Screen OCR capture)" Tag="TextOcr"/>
                                                <ComboBoxItem Content="CurrentEditor (Current editor image)" Tag="CurrentEditor"/>
                                            </ComboBox>

                                            <StackPanel Visibility="{Binding SelectedNode.IsWindowSource, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Window Title Pattern (Regex)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.WindowTitlePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="Process Name" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <TextBlock Text="Capture Mouse Cursor" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.CaptureMouseCursorMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Always True" Tag="true"/>
                                                <ComboBoxItem Content="Always False" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Screen Capture Mode" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.ScreenCaptureMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="All Displays (Desktop)" Tag="FullScreen"/>
                                                <ComboBoxItem Content="Primary Screen" Tag="PrimaryScreen"/>
                                            </ComboBox>

                                            <TextBlock Text="Window Capture Mode" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.WindowCaptureMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Auto Detect" Tag="Auto"/>
                                                <ComboBoxItem Content="Aero / Transparent" Tag="Aero"/>
                                                <ComboBoxItem Content="Classic / GDI" Tag="Classic"/>
                                            </ComboBox>

                                            <TextBlock Text="Align Multi-DPI Displays" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.AlignDpiMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Enabled (Align coordinates)" Tag="true"/>
                                                <ComboBoxItem Content="Disabled" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Delay (ms)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 2. InteractiveSelection Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=InteractiveSelection}">
                                            <TextBlock Text="Selection Mode" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.SelectionMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Region (Rubberband rectangle)" Tag="Region"/>
                                                <ComboBoxItem Content="Window (Hover &amp; click window)" Tag="Window"/>
                                                <ComboBoxItem Content="Text (OCR selection box)" Tag="Text"/>
                                            </ComboBox>

                                            <TextBlock Text="Window Snapping" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.AllowWindowSnappingMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Enabled (Snap to Windows)" Tag="true"/>
                                                <ComboBoxItem Content="Disabled" Tag="false"/>
                                            </ComboBox>
                                        </StackPanel>
 
                                        <!-- RecordVideo Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=RecordVideo}">
                                            <TextBlock Text="Source / Target Type" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.VideoSourceType, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Active Window (Currently focused)" Tag="ActiveWindow"/>
                                                <ComboBoxItem Content="Window (Match title / process)" Tag="Window"/>
                                                <ComboBoxItem Content="Full Screen (Display / Monitor)" Tag="FullScreen"/>
                                                <ComboBoxItem Content="Region (Crop coordinates)" Tag="Region"/>
                                            </ComboBox>

                                            <!-- Window targeting options -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsVideoWindowSource, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Window Title Pattern (Regex)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.WindowTitlePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="Process Name (e.g. notepad)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="Record until target window closes" IsChecked="{Binding SelectedNode.VideoUntilWindowCloses, Mode=TwoWay}"
                                                          Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- Region targeting options -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsVideoRegionSource, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Region X (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.VideoRegionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Region Y (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.VideoRegionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Region Width" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.VideoRegionWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Region Height" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.VideoRegionHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Monitor targeting options -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsVideoMonitorSource, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Monitor Index (-1 = Primary display)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.VideoMonitorIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- Timing & Duration -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Duration (s, 0=unlimited)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedNode.VideoDurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Countdown Delay (ms)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedNode.DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Output Path -->
                                            <TextBlock Text="Output MP4 File Path" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.VideoOutputFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <!-- Encoding Preset & Format -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Preset" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox SelectedValue="{Binding SelectedNode.VideoPreset, Mode=TwoWay}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="Balanced (30 FPS, 2.5 Mbps)" Tag="Balanced"/>
                                                        <ComboBoxItem Content="Small Size (15 FPS, 800 kbps, 720p)" Tag="SmallSize"/>
                                                        <ComboBoxItem Content="High Quality (60 FPS, 8 Mbps)" Tag="HighQuality"/>
                                                        <ComboBoxItem Content="Gaming (144 FPS, 25 Mbps)" Tag="HighFrameRateGaming"/>
                                                        <ComboBoxItem Content="Custom (Manual values below)" Tag="Custom"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Format / Codec" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox SelectedValue="{Binding SelectedNode.VideoFormat, Mode=TwoWay}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="MP4 (H.264 / AVC)" Tag="Mp4_H264"/>
                                                        <ComboBoxItem Content="MP4 (HEVC / H.265)" Tag="Mp4_Hevc"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Framerate & Bitrate -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Frame Rate (FPS)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedNode.VideoFrameRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Bitrate (bps)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedNode.VideoBitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Dimensions & Scaling -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Width (0=orig)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedNode.VideoTargetWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Height (0=orig)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedNode.VideoTargetHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Scale Factor" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedNode.VideoScaleFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Audio Source -->
                                            <TextBlock Text="Audio Recording Source" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.VideoAudioSource, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="None (Mute video)" Tag="None"/>
                                                <ComboBoxItem Content="Microphone (WASAPI input)" Tag="Microphone"/>
                                                <ComboBoxItem Content="System Audio (Speaker loopback)" Tag="SystemAudioLoopback"/>
                                            </ComboBox>

                                            <!-- Canvas & Appearance -->
                                            <TextBlock Text="Window Resize Behavior" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.VideoResizeBehavior, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Letterbox (Fixed Canvas, centered)" Tag="LetterboxFixedCanvas"/>
                                                <ComboBoxItem Content="Crop to Canvas" Tag="CropToCanvas"/>
                                                <ComboBoxItem Content="Scale Content" Tag="ScaleContent"/>
                                            </ComboBox>

                                            <TextBlock Text="Color Mode" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.VideoColorMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Full Color (32-bit BGRA)" Tag="FullColor"/>
                                                <ComboBoxItem Content="Grayscale (Monochrome)" Tag="Grayscale"/>
                                            </ComboBox>

                                            <CheckBox Content="Capture Mouse Cursor" IsChecked="{Binding SelectedNode.VideoCaptureCursor, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,6"/>

                                            <CheckBox Content="Show OS Capture Border (Yellow WGC border)" IsChecked="{Binding SelectedNode.VideoShowCaptureBorder, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,6"/>

                                            <CheckBox Content="Prevent System Sleep while recording" IsChecked="{Binding SelectedNode.VideoPreventSleep, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,6"/>

                                            <CheckBox Content="Auto-pause when Windows locked (Win+L)" IsChecked="{Binding SelectedNode.VideoAutoPauseOnLock, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 3. Border Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Border}">
                                            <TextBlock Text="Border Width (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.BorderWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                             <TextBlock Text="Border Color Hex" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                             <Grid Margin="0,0,0,8">
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="26"/>
                                                     <ColumnDefinition Width="6"/>
                                                     <ColumnDefinition Width="*"/>
                                                 </Grid.ColumnDefinitions>
                                                 <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4"
                                                         BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                         Background="{Binding SelectedNode.BorderColor, Converter={StaticResource StringToBrushConv}}"
                                                         Cursor="Hand" ToolTip="Click to pick color...">
                                                     <Border.InputBindings>
                                                         <MouseBinding MouseAction="LeftClick" Command="{Binding SelectedNode.PickBorderColorCommand}"/>
                                                     </Border.InputBindings>
                                                 </Border>
                                                 <TextBox Grid.Column="2" Text="{Binding SelectedNode.BorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                          VerticalContentAlignment="Center" Padding="6,4"/>
                                             </Grid>
                                        </StackPanel>

                                        <!-- 4. Effect Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Effect}">
                                            <TextBlock Text="Effect Type" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.EffectType, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Border / Frame" Tag="Border"/>
                                                <ComboBoxItem Content="Drop Shadow" Tag="DropShadow"/>
                                                <ComboBoxItem Content="Torn Edge" Tag="TornEdge"/>
                                                <ComboBoxItem Content="Invert Colors" Tag="Invert"/>
                                                <ComboBoxItem Content="Grayscale" Tag="Grayscale"/>
                                                <ComboBoxItem Content="Monochrome (B&amp;W)" Tag="Monochrome"/>
                                                <ComboBoxItem Content="Adjust (Brightness/Contrast/Gamma)" Tag="Adjust"/>
                                                <ComboBoxItem Content="Rotate" Tag="Rotate"/>
                                                <ComboBoxItem Content="Resize Image" Tag="Resize"/>
                                                <ComboBoxItem Content="Resize Canvas (Add Padding)" Tag="ResizeCanvas"/>
                                                <ComboBoxItem Content="Reduce Colors" Tag="ReduceColors"/>
                                                <ComboBoxItem Content="Remove Transparency" Tag="RemoveTransparency"/>
                                            </ComboBox>

                                            <!-- 4a. Border Effect -->
                                             <StackPanel Visibility="{Binding SelectedNode.IsBorderEffect, Converter={StaticResource BoolToVis}}">
                                                 <TextBlock Text="Border Width (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                 <TextBox Text="{Binding SelectedNode.EffectBorderWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                          Padding="6,4" Margin="0,0,0,8"/>

                                                 <TextBlock Text="Border Color (#HEX or Named)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                 <Grid Margin="0,0,0,8">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="26"/>
                                                         <ColumnDefinition Width="6"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4"
                                                             BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                             Background="{Binding SelectedNode.EffectBorderColor, Converter={StaticResource StringToBrushConv}}"
                                                             Cursor="Hand" ToolTip="Click to pick color...">
                                                         <Border.InputBindings>
                                                             <MouseBinding MouseAction="LeftClick" Command="{Binding SelectedNode.PickBorderColorCommand}"/>
                                                         </Border.InputBindings>
                                                     </Border>
                                                     <TextBox Grid.Column="2" Text="{Binding SelectedNode.EffectBorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                              VerticalContentAlignment="Center" Padding="6,4"/>
                                                 </Grid>
                                             </StackPanel>

                                            <!-- 4b. DropShadow Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsDropShadowEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Shadow Size (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.ShadowSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="Shadow Darkness (0.0 - 1.0)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.ShadowDarkness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Offset X (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.ShadowOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Offset Y (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.ShadowOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4c. TornEdge Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsTornEdgeEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Tooth Height (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.ToothHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="H-Tooth Range" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.HorizontalToothRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="V-Tooth Range" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.VerticalToothRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Active Edges (top,right,bottom,left)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.TornEdges, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="Generate Drop Shadow" IsChecked="{Binding SelectedNode.TornEdgeShadow, Mode=TwoWay}"
                                                          Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4d. Monochrome Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsMonochromeEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="B&amp;W Threshold (0 - 255)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.MonochromeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4e. Adjust Colors Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsAdjustEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Brightness (e.g. 1.0 = normal, 1.2 = lighter, 0.8 = darker)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.AdjustBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="Contrast (e.g. 1.0 = normal, 1.3 = higher contrast)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.AdjustContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="Gamma (e.g. 1.0 = normal)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.AdjustGamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4f. Rotate Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsRotateEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Rotation Angle (Degrees clockwise)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.RotateAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4g. Resize Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsResizeEffect, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Target Width (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.ResizeWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Target Height (px)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Text="{Binding SelectedNode.ResizeHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Scale Percentage (% or 0 for exact WxH)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.ResizePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="Maintain Aspect Ratio" IsChecked="{Binding SelectedNode.ResizeMaintainAspectRatio, Mode=TwoWay}"
                                                          Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4h. Resize Canvas / Padding Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsResizeCanvasEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Padding / Margin (px on all sides)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.CanvasMargin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="Background Color (#HEX or Named)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4"
                                                            BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                            Background="{Binding SelectedNode.CanvasBackgroundColor, Converter={StaticResource StringToBrushConv}}"/>
                                                    <TextBox Grid.Column="2" Text="{Binding SelectedNode.CanvasBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                             VerticalContentAlignment="Center" Padding="6,4"/>
                                                    <Button Grid.Column="4" Content="🎨" Style="{StaticResource ToolbarBtn}" Margin="0" Height="26"
                                                            Command="{Binding SelectedNode.PickCanvasBackgroundColorCommand}" ToolTip="Pick Color..."/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4i. Reduce Colors Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsReduceColorsEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Target Colors (2 - 256)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.ReduceColorsCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4j. Remove Transparency Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsRemoveTransparencyEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Matte Background Color" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4"
                                                            BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                            Background="{Binding SelectedNode.TransparencyBackgroundColor, Converter={StaticResource StringToBrushConv}}"
                                                            Cursor="Hand" ToolTip="Click to pick color...">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectedNode.PickTransparencyBackgroundColorCommand}"/>
                                                        </Border.InputBindings>
                                                    </Border>
                                                    <TextBox Grid.Column="2" Text="{Binding SelectedNode.TransparencyBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                             VerticalContentAlignment="Center" Padding="6,4"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4k. Invert / Grayscale Info -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsInvertEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Inverts all RGB pixel colors across the capture surface." FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SelectedNode.IsGrayscaleEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Converts all colors on the capture surface to grayscale." FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 5. TextEffect / DLP Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=TextEffect}">
                                            <TextBlock Text="DLP Action" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.TextEffectAction, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Blackout (Redact box)" Tag="Blackout"/>
                                                <ComboBoxItem Content="Pixelize (Mosaic text)" Tag="Pixelize"/>
                                                <ComboBoxItem Content="Blur (Gaussian blur)" Tag="Blur"/>
                                                <ComboBoxItem Content="Highlight (Yellow tint)" Tag="Highlight"/>
                                            </ComboBox>

                                            <TextBlock Text="Target Pattern / Regex" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.TextEffectPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="Fill Color (for Blackout)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4"
                                                        BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                        Background="{Binding SelectedNode.TextEffectFillColor, Converter={StaticResource StringToBrushConv}}"
                                                        Cursor="Hand" ToolTip="Click to pick color...">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectedNode.PickTextEffectColorCommand}"/>
                                                    </Border.InputBindings>
                                                </Border>
                                                <TextBox Grid.Column="2" Text="{Binding SelectedNode.TextEffectFillColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         VerticalContentAlignment="Center" Padding="6,4"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 6. ObfuscateText Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=ObfuscateText}">
                                            <TextBlock Text="Preset Patterns (DLP)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.TextEffectPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 7. SetVariable Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=SetVariable}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Variables (Key / Value)" FontWeight="SemiBold" FontSize="11" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Variable" Style="{StaticResource PrimaryBtn}" Padding="6,2" Command="{Binding SelectedNode.AddVariableCommand}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.Variables}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontFamily="Consolas" FontSize="11"
                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Padding="4,2"/>
                                                                <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontFamily="Consolas" FontSize="11"
                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Padding="4,2"/>
                                                                <Button Grid.Column="3" Content="✕"
                                                                        Style="{StaticResource ItemDeleteBtn}"
                                                                        Command="{Binding RemoveCommand}" ToolTip="Delete Variable" Margin="4,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="Available scopes: ${user.username}, ${machine.computername}, ${now:yyyy-MM-dd}, ${payload.width}"
                                                       FontSize="10" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        </StackPanel>

                                        <!-- 8. Annotation Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Annotation}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Annotations" FontWeight="SemiBold" FontSize="11" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <ComboBox x:Name="AnnotationTypeSelector" Width="95" Height="24" Margin="0,0,4,0" SelectedIndex="0">
                                                            <ComboBoxItem Content="Arrow"/>
                                                            <ComboBoxItem Content="Barcode"/>
                                                            <ComboBoxItem Content="Blur"/>
                                                            <ComboBoxItem Content="Cursor"/>
                                                            <ComboBoxItem Content="Ellipse"/>
                                                            <ComboBoxItem Content="Emoji"/>
                                                            <ComboBoxItem Content="Highlight"/>
                                                            <ComboBoxItem Content="Image"/>
                                                            <ComboBoxItem Content="Line"/>
                                                            <ComboBoxItem Content="Magnify"/>
                                                            <ComboBoxItem Content="Pixelize"/>
                                                            <ComboBoxItem Content="QRCode"/>
                                                            <ComboBoxItem Content="Rectangle"/>
                                                            <ComboBoxItem Content="Speechbubble"/>
                                                            <ComboBoxItem Content="StepLabel"/>
                                                            <ComboBoxItem Content="Svg"/>
                                                            <ComboBoxItem Content="Text"/>
                                                        </ComboBox>
                                                        <Button Content="+ Add Annotation" Style="{StaticResource PrimaryBtn}" Padding="6,2"
                                                                Command="{Binding SelectedNode.AddAnnotationCommand}"
                                                                CommandParameter="{Binding SelectedItem.Content, ElementName=AnnotationTypeSelector}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Template / Import Row -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,2">
                                                    <TextBlock Text="Template:" FontSize="10" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Button Content="📷 From Editor..." Style="{StaticResource ToolbarBtn}" Padding="6,2" Margin="0,0,4,0"
                                                            Command="{Binding SelectedNode.ImportFromEditorCommand}" ToolTip="Import annotations from open image editor"/>
                                                    <Button Content="📁 From File..." Style="{StaticResource ToolbarBtn}" Padding="6,2" Margin="0"
                                                            Command="{Binding SelectedNode.ImportFromGreenshotFileCommand}" ToolTip="Import annotations from .greenshot file"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.Annotations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <!-- Header: Type Picker & Delete -->
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox Grid.Column="0" SelectedValue="{Binding Type, Mode=TwoWay}" SelectedValuePath="Content" Width="110" HorizontalAlignment="Left">
                                                                        <ComboBoxItem Content="Arrow"/>
                                                                        <ComboBoxItem Content="Barcode"/>
                                                                        <ComboBoxItem Content="Blur"/>
                                                                        <ComboBoxItem Content="Cursor"/>
                                                                        <ComboBoxItem Content="Ellipse"/>
                                                                        <ComboBoxItem Content="Emoji"/>
                                                                        <ComboBoxItem Content="Highlight"/>
                                                                        <ComboBoxItem Content="Image"/>
                                                                        <ComboBoxItem Content="Line"/>
                                                                        <ComboBoxItem Content="Magnify"/>
                                                                        <ComboBoxItem Content="Pixelize"/>
                                                                        <ComboBoxItem Content="QRCode"/>
                                                                        <ComboBoxItem Content="Rectangle"/>
                                                                        <ComboBoxItem Content="Speechbubble"/>
                                                                        <ComboBoxItem Content="StepLabel"/>
                                                                        <ComboBoxItem Content="Svg"/>
                                                                        <ComboBoxItem Content="Text"/>
                                                                    </ComboBox>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SourceSummaryBadge}"
                                                                               FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                    <Button Grid.Column="2" Content="✕"
                                                                            Style="{StaticResource ItemDeleteBtn}"
                                                                            Command="{Binding RemoveCommand}" ToolTip="Delete Drawable"/>
                                                                </Grid>

                                                                <!-- Text Field (for Text, Speechbubble) -->
                                                                <StackPanel Visibility="{Binding IsTextType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="Text / Content (${...} supported)" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="11"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- Step Label Counter / Number -->
                                                                <StackPanel Visibility="{Binding IsStepLabelType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="Step Number / Counter" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox Text="{Binding StepNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="11"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- QR / Barcode Payload / Text -->
                                                                <StackPanel Visibility="{Binding IsQrCodeType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="Payload / Text / URL (${...} supported)" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="11"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- Custom / Extension Drawable Configuration Panel -->
                                                                <Border Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVis}}" 
                                                                        Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2,0,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="Extension Configuration" FontSize="10" FontWeight="SemiBold"
                                                                                       Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <TextBlock Text="{Binding ConfigurationSummary}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Content="⚙ Configure..." Style="{StaticResource ToolbarBtn}" Padding="8,3" Margin="6,0,0,0"
                                                                                Command="{Binding ConfigureCommand}" ToolTip="Open the extension configuration editor"
                                                                                VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Font Settings (for Text, Speechbubble) -->
                                                                <StackPanel Visibility="{Binding HasFontSettings, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="Font &amp; Text Style" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <Grid Margin="0,2,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="4"/>
                                                                            <ColumnDefinition Width="46"/>
                                                                            <ColumnDefinition Width="4"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="2"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="4"/>
                                                                            <ColumnDefinition Width="68"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding FontFamily, Mode=TwoWay}"
                                                                                  IsEditable="True" Height="24" FontSize="11" ToolTip="Font Family"/>
                                                                        <TextBox Grid.Column="2" Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontFamily="Consolas" FontSize="11" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 ToolTip="Font Size (pt)"/>
                                                                        <ToggleButton Grid.Column="4" Width="24" Height="24" Content="B" FontWeight="Bold" FontSize="11"
                                                                                      IsChecked="{Binding FontBold, Mode=TwoWay}" ToolTip="Bold"/>
                                                                        <ToggleButton Grid.Column="6" Width="24" Height="24" Content="I" FontStyle="Italic" FontSize="11"
                                                                                      IsChecked="{Binding FontItalic, Mode=TwoWay}" ToolTip="Italic"/>
                                                                        <ComboBox Grid.Column="8" ItemsSource="{Binding AvailableTextAlignments}" SelectedItem="{Binding TextAlignment, Mode=TwoWay}"
                                                                                  Height="24" FontSize="11" ToolTip="Text Alignment"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Arrow Heads (for Arrow) -->
                                                                <StackPanel Visibility="{Binding IsArrowType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="Arrow Heads" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <ComboBox ItemsSource="{Binding AvailableArrowHeads}" SelectedItem="{Binding ArrowHeads, Mode=TwoWay}"
                                                                              Height="24" FontSize="11" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Speechbubble Tail Controls -->
                                                                <StackPanel Visibility="{Binding IsSpeechbubbleType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="Tail Direction / Placement" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <ComboBox SelectedValue="{Binding TailDirection, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,4">
                                                                        <ComboBoxItem Content="Bottom-Left (Default)" Tag="BottomLeft"/>
                                                                        <ComboBoxItem Content="Bottom-Right" Tag="BottomRight"/>
                                                                        <ComboBoxItem Content="Bottom-Center" Tag="BottomCenter"/>
                                                                        <ComboBoxItem Content="Top-Left" Tag="TopLeft"/>
                                                                        <ComboBoxItem Content="Top-Right" Tag="TopRight"/>
                                                                        <ComboBoxItem Content="Top-Center" Tag="TopCenter"/>
                                                                        <ComboBoxItem Content="Left" Tag="Left"/>
                                                                        <ComboBoxItem Content="Right" Tag="Right"/>
                                                                    </ComboBox>
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="Tail Offset X" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <TextBox Text="{Binding TailOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                            <TextBlock Text="Tail Offset Y" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <TextBox Text="{Binding TailOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Emoji Field with Picker -->
                                                                <StackPanel Visibility="{Binding IsEmojiType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="Emoji / Icon" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <Grid Margin="0,2,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                BorderThickness="1" CornerRadius="3"
                                                                                Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                Padding="2" VerticalAlignment="Center">
                                                                            <emoji:EmojiPicker Selection="{Binding Emoji, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <TextBox Grid.Column="2" Text="{Binding Emoji, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontSize="13" VerticalContentAlignment="Center"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Padding="4,2"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Obfuscate Settings (Blur / Pixelize) -->
                                                                <StackPanel Visibility="{Binding IsBlurType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="Blur Radius" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox Text="{Binding BlurRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="11"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding IsPixelizeType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="Pixel Size" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox Text="{Binding PixelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="11"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Magnification Factor (Magnify) -->
                                                                <StackPanel Visibility="{Binding IsMagnifyType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="Magnification Factor (e.g. 2, 3)" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox Text="{Binding MagnificationFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="11"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Image Controls -->
                                                                <StackPanel Visibility="{Binding IsImageType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Image Source" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <RadioButton Content="Embed (Base64)" IsChecked="{Binding IsEmbedMode, Mode=TwoWay}" FontSize="10" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="Link File" IsChecked="{Binding IsLinkMode, Mode=TwoWay}" FontSize="10"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,1,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Grid.Column="0" Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontFamily="Consolas" FontSize="11"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Padding="4,2"/>
                                                                        <Button Grid.Column="2" Content="Browse..." Style="{StaticResource ToolbarBtn}" Padding="6,2"
                                                                                Command="{Binding BrowseFileCommand}"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- SVG Controls -->
                                                                <StackPanel Visibility="{Binding IsSvgType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="SVG Source" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <RadioButton Content="Embed (XML)" IsChecked="{Binding IsEmbedMode, Mode=TwoWay}" FontSize="10" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="Link File" IsChecked="{Binding IsLinkMode, Mode=TwoWay}" FontSize="10"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,1,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Grid.Column="0" Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontFamily="Consolas" FontSize="11"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Padding="4,2"/>
                                                                        <Button Grid.Column="2" Content="Browse..." Style="{StaticResource ToolbarBtn}" Padding="6,2"
                                                                                Command="{Binding BrowseFileCommand}"/>
                                                                    </Grid>
                                                                    <TextBlock Text="Inline SVG XML" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox Text="{Binding SvgXml, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="10" Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Margin="0,1,0,3" Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- Cursor Controls -->
                                                                <StackPanel Visibility="{Binding IsCursorType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Cursor Source" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <RadioButton Content="Preset" IsChecked="{Binding IsCursorPresetMode, Mode=TwoWay}" FontSize="10" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="Embed (Base64)" IsChecked="{Binding IsCursorEmbedMode, Mode=TwoWay}" FontSize="10" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="Link File" IsChecked="{Binding IsCursorLinkMode, Mode=TwoWay}" FontSize="10"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Preset Mode -->
                                                                    <StackPanel Visibility="{Binding IsCursorPresetMode, Converter={StaticResource BoolToVis}}" Margin="0,1,0,3">
                                                                        <TextBlock Text="Windows Cursor Preset" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <ComboBox ItemsSource="{Binding AvailableCursors}" SelectedItem="{Binding CursorName, Mode=TwoWay}"
                                                                                  Height="24" Margin="0,2,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- Embed Mode (Base64) -->
                                                                    <StackPanel Visibility="{Binding IsCursorEmbedMode, Converter={StaticResource BoolToVis}}" Margin="0,1,0,3">
                                                                        <Border Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="📦 Embedded Cursor Bitmap (Base64)" FontWeight="SemiBold" FontSize="10" Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                                    <TextBlock Text="Bitmap cursor is embedded directly in this recipe." FontSize="9" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                                </StackPanel>
                                                                                <Button Grid.Column="1" Content="Load File..." Style="{StaticResource ToolbarBtn}" Padding="6,2" Margin="4,0,0,0"
                                                                                        Command="{Binding BrowseFileCommand}" ToolTip="Replace embedded bitmap from file"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <!-- Link File Mode -->
                                                                    <Grid Visibility="{Binding IsCursorLinkMode, Converter={StaticResource BoolToVis}}" Margin="0,1,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox Grid.Column="0" Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontFamily="Consolas" FontSize="11"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Padding="4,2"/>
                                                                        <Button Grid.Column="2" Content="Browse..." Style="{StaticResource ToolbarBtn}" Padding="6,2"
                                                                                Command="{Binding BrowseFileCommand}"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Anchors: H-Anchor & V-Anchor -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="H-Anchor" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <ComboBox SelectedValue="{Binding HorizontalAnchor, Mode=TwoWay}" SelectedValuePath="Tag">
                                                                            <ComboBoxItem Content="None (Absolute)" Tag="None"/>
                                                                            <ComboBoxItem Content="Left" Tag="Left"/>
                                                                            <ComboBoxItem Content="Center" Tag="Center"/>
                                                                            <ComboBoxItem Content="Right" Tag="Right"/>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="V-Anchor" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <ComboBox SelectedValue="{Binding VerticalAnchor, Mode=TwoWay}" SelectedValuePath="Tag">
                                                                            <ComboBoxItem Content="None (Absolute)" Tag="None"/>
                                                                            <ComboBoxItem Content="Top" Tag="Top"/>
                                                                            <ComboBoxItem Content="Center" Tag="Center"/>
                                                                            <ComboBoxItem Content="Bottom" Tag="Bottom"/>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Width & Height -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="Width" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="Height" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                    </StackPanel>
                                                                    <CheckBox Grid.Column="3" Content="Lock Ratio" IsChecked="{Binding LockAspectRatio, Mode=TwoWay}"
                                                                              ToolTip="Locks dimensions to maintain aspect ratio"
                                                                              FontSize="10" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                                                                </Grid>

                                                                <!-- Offset X & Offset Y -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="Offset X / Left" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox Text="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="Offset Y / Top" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox Text="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Line Thickness & Shadow -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Visibility="{Binding HasLineThickness, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="Line / Border Thickness" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox Text="{Binding LineThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontFamily="Consolas" FontSize="11"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Padding="4,2" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <CheckBox Grid.Column="1" Content="Shadow" IsChecked="{Binding Shadow, Mode=TwoWay}"
                                                                              Visibility="{Binding HasShadow, Converter={StaticResource BoolToVis}}"
                                                                              ToolTip="Enable drop shadow effect"
                                                                              FontSize="10" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                                                                </Grid>

                                                                <!-- Standard Colors (Fill & Line Color) -->
                                                                <Grid Visibility="{Binding HasAnyStandardColor, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Visibility="{Binding HasFillColor, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding FillColorLabel}" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <Grid Margin="0,2,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="20"/>
                                                                                <ColumnDefinition Width="4"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3"
                                                                                    BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1"
                                                                                    Background="{Binding FillColor, Converter={StaticResource StringToBrushConv}}"
                                                                                    Cursor="Hand" ToolTip="Click to pick color...">
                                                                                <Border.InputBindings>
                                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding PickFillColorCommand}"/>
                                                                                </Border.InputBindings>
                                                                            </Border>
                                                                            <TextBox Grid.Column="2" Text="{Binding FillColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     VerticalContentAlignment="Center" Padding="4,2"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Visibility="{Binding HasLineColor, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding LineColorLabel}" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <Grid Margin="0,2,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="20"/>
                                                                                <ColumnDefinition Width="4"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3"
                                                                                    BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1"
                                                                                    Background="{Binding LineColor, Converter={StaticResource StringToBrushConv}}"
                                                                                    Cursor="Hand" ToolTip="Click to pick color...">
                                                                                <Border.InputBindings>
                                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding PickLineColorCommand}"/>
                                                                                </Border.InputBindings>
                                                                            </Border>
                                                                            <TextBox Grid.Column="2" Text="{Binding LineColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     VerticalContentAlignment="Center" Padding="4,2"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- QR / Barcode Specific Colors & Options -->
                                                                <StackPanel Visibility="{Binding IsQrCodeType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                                    <Grid Margin="0,2,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="Code Color (Fore)" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <Grid Margin="0,2,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="20"/>
                                                                                    <ColumnDefinition Width="4"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3"
                                                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1"
                                                                                        Background="{Binding ForeColor, Converter={StaticResource StringToBrushConv}}"
                                                                                        Cursor="Hand" ToolTip="Click to pick foreground color...">
                                                                                    <Border.InputBindings>
                                                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding PickForeColorCommand}"/>
                                                                                    </Border.InputBindings>
                                                                                </Border>
                                                                                <TextBox Grid.Column="2" Text="{Binding ForeColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                         VerticalContentAlignment="Center" Padding="4,2"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                            <TextBlock Text="Background (Back)" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <Grid Margin="0,2,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="20"/>
                                                                                    <ColumnDefinition Width="4"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3"
                                                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1"
                                                                                        Background="{Binding BackColor, Converter={StaticResource StringToBrushConv}}"
                                                                                        Cursor="Hand" ToolTip="Click to pick background color...">
                                                                                    <Border.InputBindings>
                                                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding PickBackColorCommand}"/>
                                                                                    </Border.InputBindings>
                                                                                </Border>
                                                                                <TextBox Grid.Column="2" Text="{Binding BackColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                         VerticalContentAlignment="Center" Padding="4,2"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,2,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="Quiet Zone Margin" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <TextBox Text="{Binding Margin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="11"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                        <CheckBox Grid.Column="1" Content="Rounded Dots" IsChecked="{Binding RoundedDots, Mode=TwoWay}"
                                                                                  ToolTip="Render QR modules with rounded corners"
                                                                                  FontSize="10" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 9. Conditional Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Conditional}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Condition Branches" FontWeight="Bold" FontSize="11" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Branch" Style="{StaticResource ToolbarBtn}"
                                                        Command="{Binding SelectedNode.AddConditionBranchCommand}" Padding="8,2" FontSize="10"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.ConditionBranches}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Key, StringFormat='Pin {0}'}" FontWeight="Bold" FontSize="10"
                                                                                   Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    </Border>
                                                                    <TextBox Grid.Column="1" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             FontFamily="Consolas" FontSize="10" Padding="4,2" MaxLength="10"
                                                                             ToolTip="Branch identifier (e.g. A, B, True, False)"/>
                                                                    <Button Grid.Column="2" Style="{StaticResource TriggerDeleteBtn}" Command="{Binding RemoveCommand}"
                                                                            ToolTip="Delete branch" Margin="4,0,0,0"/>
                                                                </Grid>
                                                                <TextBox Grid.Row="1" Text="{Binding Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         FontFamily="Consolas" FontSize="11" Padding="6,4"
                                                                         ToolTip="Condition expression (e.g. ${payload.width > 800} or 'else')"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Branch Execution Logic:" FontWeight="Bold" FontSize="11" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="• Each condition gets its own output connector pin (A, B, C...).&#x0a;• Connect each pin to the destination step for that branch.&#x0a;• Use 'else' for default fallback branch."
                                                               FontSize="11" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 9b. UserPrompt Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=UserPrompt}">
                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="User Prompt Interaction:" FontWeight="Bold" FontSize="11" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="• Displays an interactive modal dialog to the user during capture flow.&#x0a;• Execution branches along the connector pin corresponding to the clicked button."
                                                               FontSize="11" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="Prompt Window Title" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.UserPromptTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="Prompt Message / Question" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.UserPromptMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     TextWrapping="Wrap" AcceptsReturn="True" Height="50"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <CheckBox Content="Show Capture Image Preview"
                                                      IsChecked="{Binding SelectedNode.UserPromptShowPreview, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Timeout (seconds, 0=None)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox Text="{Binding SelectedNode.UserPromptTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                             Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Default Choice Key" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox ItemsSource="{Binding SelectedNode.PromptChoices}"
                                                              DisplayMemberPath="Key"
                                                              SelectedValuePath="Key"
                                                              SelectedValue="{Binding SelectedNode.UserPromptDefaultChoice, Mode=TwoWay}"
                                                              Height="26"
                                                              ToolTip="Select the fallback or default choice key for timeouts / Enter key"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,4,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Decision Choices &amp; Buttons" FontWeight="Bold" FontSize="11" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="+ Add Choice" Style="{StaticResource ToolbarBtn}"
                                                        Command="{Binding SelectedNode.AddPromptChoiceCommand}" Padding="8,2" FontSize="10"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.PromptChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Key, StringFormat='Pin {0}'}" FontWeight="Bold" FontSize="10"
                                                                                   Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    </Border>
                                                                    <TextBox Grid.Column="1" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             FontFamily="Consolas" FontSize="10" Padding="4,2" MaxLength="15"
                                                                             ToolTip="Choice key (branch identifier)"/>
                                                                    <Button Grid.Column="2" Style="{StaticResource TriggerDeleteBtn}" Command="{Binding RemoveCommand}"
                                                                            ToolTip="Delete choice" Margin="4,0,0,0"/>
                                                                </Grid>

                                                                <TextBlock Text="Button Label" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,2,0,1"/>
                                                                <TextBox Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         FontSize="11" Padding="4,2" Margin="0,0,0,4"/>

                                                                <Grid Margin="0,2,0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox SelectedValue="{Binding Style, Mode=TwoWay}"
                                                                              SelectedValuePath="Tag" Height="22" FontSize="10">
                                                                        <ComboBoxItem Content="Primary (Accent)" Tag="Primary"/>
                                                                        <ComboBoxItem Content="Secondary (Subtle)" Tag="Secondary"/>
                                                                        <ComboBoxItem Content="Danger (Red)" Tag="Danger"/>
                                                                    </ComboBox>
                                                                    <CheckBox Grid.Column="1" Content="Default" IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                                                              Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                    <CheckBox Grid.Column="2" Content="Cancel" IsChecked="{Binding IsCancel, Mode=TwoWay}"
                                                                              Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 10. ImmediateFeedback Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=ImmediateFeedback}">
                                            <CheckBox Content="Play Shutter Camera Sound"
                                                      IsChecked="{Binding SelectedNode.PlaySound, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,4,0,8"/>

                                            <TextBlock Text="Custom Sound File (.wav, optional)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding SelectedNode.SoundFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                         Padding="6,4" ToolTip="Path to custom .wav sound file or expression (leave empty for default)"/>
                                                <Button Grid.Column="1" Content="..." Style="{StaticResource ToolbarBtn}"
                                                        Command="{Binding SelectedNode.BrowseSoundFileCommand}"
                                                        ToolTip="Browse for .wav audio file" Margin="4,0,0,0" Padding="8,4"/>
                                                <Button Grid.Column="2" Content="▶️" Style="{StaticResource ToolbarBtn}"
                                                        Command="{Binding SelectedNode.PlaySoundPreviewCommand}"
                                                        ToolTip="Play preview sound" Margin="4,0,0,0" Padding="8,4"/>
                                            </Grid>
                                            <TextBlock Text="Leave empty to use the default camera shutter sound configured in Greenshot settings."
                                                       FontSize="10" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 11. Notification Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Notification}">
                                            <TextBlock Text="Notification Title" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.NotificationTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                      Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="Message Template" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.NotificationMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                      Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 11b. Processors / OCR Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Processors}">
                                            <TextBlock Text="Processor Execution Mode" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.ProcessorMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="⚡ All Active Processors" Tag="All"/>
                                                <ComboBoxItem Content="🔍 OCR Only (Windows 10 OCR)" Tag="OCR"/>
                                                <ComboBoxItem Content="🛠️ Selected Processors" Tag="Selected"/>
                                            </ComboBox>

                                            <TextBlock Text="OCR Language Tag (empty = Config)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.OcrLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="Execution Timing Stage" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.ProcessorTiming, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Any / All Stages" Tag="Any"/>
                                                <ComboBoxItem Content="Before Interactive Selection" Tag="BeforeInteractiveSelection"/>
                                                <ComboBoxItem Content="After Interactive Selection" Tag="AfterInteractiveSelection"/>
                                                <ComboBoxItem Content="Pre-Export" Tag="PreExport"/>
                                            </ComboBox>

                                            <!-- Checkboxes for Selected Processors mode -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsCustomProcessorsEnabled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Active Processors" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <CheckBox Content="Windows OCR (Text &amp; Words Recognition)" IsChecked="{Binding SelectedNode.ProcessorRunOcr, Mode=TwoWay}"
                                                                  Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,4"/>
                                                        <CheckBox Content="Window Title Fixer (Auto-detect Window Titles)" IsChecked="{Binding SelectedNode.ProcessorRunTitleFix, Mode=TwoWay}"
                                                                  Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,4"/>
                                                        <CheckBox Content="Plugin Processors (QR / Barcode Scanner, etc.)" IsChecked="{Binding SelectedNode.ProcessorRunPlugins, Mode=TwoWay}"
                                                                  Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,2"/>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Text="Specific Processor IDs (Optional)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.CustomProcessorIdsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,4"/>
                                                <TextBlock Text="Comma-separated processor class names or designations (e.g. Win10OcrProcessor, TitleFixProcessor)."
                                                           FontSize="10" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 12. Save to File Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=SaveFile}">
                                            <TextBlock Text="Save Directory" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SelectedNode.SaveDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4"/>
                                                <Button Grid.Column="1" Content="📁 Browse..." Style="{StaticResource ToolbarBtn}" Margin="6,0,0,0"
                                                        Command="{Binding SelectedNode.BrowseSaveDirectoryCommand}" ToolTip="Browse for storage folder"/>
                                            </Grid>

                                            <TextBlock Text="Filename Pattern" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.FilenamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="Image Format" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.OutputFileFormat, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="PNG (Portable Network Graphics)" Tag="png"/>
                                                <ComboBoxItem Content="Greenshot Format (.greenshot)" Tag="greenshot"/>
                                                <ComboBoxItem Content="JPEG (Joint Photographic Experts Group)" Tag="jpg"/>
                                                <ComboBoxItem Content="BMP (Windows Bitmap)" Tag="bmp"/>
                                                <ComboBoxItem Content="GIF (Graphics Interchange Format)" Tag="gif"/>
                                                <ComboBoxItem Content="TIFF (Tagged Image File Format)" Tag="tiff"/>
                                                <ComboBoxItem Content="ICO (Windows Icon)" Tag="ico"/>
                                            </ComboBox>

                                            <TextBlock Text="Allow Overwrite" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.OutputFileAllowOverwrite, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Enabled (Overwrite existing)" Tag="true"/>
                                                <ComboBoxItem Content="Disabled (Auto-number files)" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Quality Prompt" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.OutputFilePromptQuality, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Prompt when saving" Tag="true"/>
                                                <ComboBoxItem Content="Never prompt" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Copy Path to Clipboard" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.OutputFileCopyPath, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Enabled (Copy filepath)" Tag="true"/>
                                                <ComboBoxItem Content="Disabled" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="JPEG Quality (1-100 or empty=Config)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.OutputFileJpegQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 13. System Clipboard Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Clipboard}">
                                            <TextBlock Text="Clipboard Content" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.ClipboardMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="🖼️ Image only (standard)" Tag="ImageOnly"/>
                                                <ComboBoxItem Content="📄 OCR / Plain Text only" Tag="TextOnly"/>
                                                <ComboBoxItem Content="🖼️ + 📄 Image and OCR Text" Tag="ImageAndText"/>
                                            </ComboBox>

                                            <TextBlock Text="Clipboard Formats (Active for this step)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <CheckBox Content="PNG (Lossless / Office &amp; Web)" IsChecked="{Binding SelectedNode.ClipboardFormatPNG, Mode=TwoWay}"
                                                              Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,4"/>
                                                    <CheckBox Content="DIB (Device Independent Bitmap)" IsChecked="{Binding SelectedNode.ClipboardFormatDIB, Mode=TwoWay}"
                                                              Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,4"/>
                                                    <CheckBox Content="DIBv5 (32-bit with Alpha Channel)" IsChecked="{Binding SelectedNode.ClipboardFormatDIBV5, Mode=TwoWay}"
                                                              Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,4"/>
                                                    <CheckBox Content="Bitmap (Windows Standard)" IsChecked="{Binding SelectedNode.ClipboardFormatBitmap, Mode=TwoWay}"
                                                              Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,4"/>
                                                    <CheckBox Content="HTML (Image File Reference)" IsChecked="{Binding SelectedNode.ClipboardFormatHTML, Mode=TwoWay}"
                                                              Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,4"/>
                                                    <CheckBox Content="HTML (Inline Base64 Data URL)" IsChecked="{Binding SelectedNode.ClipboardFormatHTMLDataUrl, Mode=TwoWay}"
                                                              Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,4"/>
                                                    <CheckBox Content="Plain Text / OCR Text" IsChecked="{Binding SelectedNode.ClipboardFormatText, Mode=TwoWay}"
                                                              Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Text / OCR settings when Text format or TextOnly is active -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsClipboardTextEnabled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Text / OCR Template" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.ClipboardCustomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,4"/>
                                                <TextBlock Text="Use ${ocr_text} for extracted OCR text, ${title}, ${now:yyyy-MM-dd}, etc."
                                                           FontSize="10" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 14. Image Editor Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Editor}">
                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                                <TextBlock Text="🎨 Opens the captured image in the interactive Greenshot Image Editor for annotations and drawing."
                                                           FontSize="11" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </Border>

                                            <TextBlock Text="Match Editor Window Size to Capture" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.EditorMatchSizeToCapture, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Yes (Resize window to match)" Tag="true"/>
                                                <ComboBoxItem Content="No (Keep current window size)" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Target Editor" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.EditorTargetEditor, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="New editor" Tag="NewEditor"/>
                                                <ComboBoxItem Content="Available editor" Tag="AvailableEditor"/>
                                                <ComboBoxItem Content="Current editor" Tag="CurrentEditor"/>
                                            </ComboBox>

                                            <TextBlock Text="Suppress Save Confirmation Dialog" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.EditorSuppressSaveDialog, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Yes (Close without asking)" Tag="true"/>
                                                <ComboBoxItem Content="No (Ask to save unsaved edits)" Tag="false"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 15. Printer Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Printer}">
                                            <TextBlock Text="Printer Name (empty = Default Printer)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.PrinterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="Show Print Dialog" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.PrinterShowPrintDialog, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Always Show Print Dialog" Tag="true"/>
                                                <ComboBoxItem Content="Silent (Direct Print)" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Auto-Rotate to Fit Page" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.PrinterAllowRotate, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Yes (Rotate if needed)" Tag="true"/>
                                                <ComboBoxItem Content="No (Keep orientation)" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Allow Enlarge to Fit Page" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.PrinterAllowEnlarge, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Yes (Enlarge small captures)" Tag="true"/>
                                                <ComboBoxItem Content="No" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Allow Shrink to Fit Page" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.PrinterAllowShrink, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Yes (Shrink oversized captures)" Tag="true"/>
                                                <ComboBoxItem Content="No" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Center on Page" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.PrinterCenter, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Yes" Tag="true"/>
                                                <ComboBoxItem Content="No" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Color Mode" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.PrinterColorMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Full Color" Tag="Color"/>
                                                <ComboBoxItem Content="Grayscale" Tag="Grayscale"/>
                                                <ComboBoxItem Content="Monochrome (Black &amp; White)" Tag="Monochrome"/>
                                            </ComboBox>

                                            <TextBlock Text="Print Footer Date / Title" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.PrinterPrintFooter, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="(From Configuration)" Tag=""/>
                                                <ComboBoxItem Content="Yes (Print Footer)" Tag="true"/>
                                                <ComboBoxItem Content="No" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="Footer Pattern (empty = Config)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.PrinterFooterPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 16. Email Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Email}">
                                            <TextBlock Text="Email Subject" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.EmailSubject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="Default Recipient (Optional)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.EmailRecipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 17. Custom Destination Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=CustomDestination}">
                                            <TextBlock Text="Destination ID / Name" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.CustomDestinationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="Enter any built-in or plugin destination designation (e.g. Imgur, Jira, Confluence, Dropbox, Box, ZxingQr, ExternalCommand)."
                                                       FontSize="10" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 18. Generic Multi-Destinations Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Destinations}">
                                            <TextBlock Text="Export Destinations" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <CheckBox Content="Greenshot Image Editor" IsChecked="{Binding SelectedNode.DestinationEditor, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="System Clipboard" IsChecked="{Binding SelectedNode.DestinationClipboard, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="Save to File" IsChecked="{Binding SelectedNode.DestinationFile, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="Send to Printer" IsChecked="{Binding SelectedNode.DestinationPrinter, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="Send via E-Mail" IsChecked="{Binding SelectedNode.DestinationEmail, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="Optical Character Recognition (OCR)" IsChecked="{Binding SelectedNode.DestinationOcr, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- File Save Settings (Visible when Save to File is checked) -->
                                            <StackPanel Visibility="{Binding SelectedNode.DestinationFile, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8">
                                                <TextBlock Text="Save Directory" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding SelectedNode.SaveDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                             Padding="6,4"/>
                                                    <Button Grid.Column="1" Content="📁 Browse..." Style="{StaticResource ToolbarBtn}" Margin="6,0,0,0"
                                                            Command="{Binding SelectedNode.BrowseSaveDirectoryCommand}" ToolTip="Browse for storage folder"/>
                                                </Grid>

                                                <TextBlock Text="Filename Pattern" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding SelectedNode.FilenamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,6"/>
                                            </StackPanel>
                                            <!-- Custom Destinations -->
                                            <TextBlock Text="Custom Destinations (comma separated)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.CustomDestinationsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,4"/>
                                            <TextBlock Text="Example: Imgur, Jira, Confluence, Dropbox, ExternalCommand" FontSize="10" Foreground="{Binding TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- 19. External Command Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsExternalCommand, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Executable / Script Path" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding SelectedNode.ExternalCommandLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4"/>
                                                <Button Grid.Column="1" Content="📁 Browse..." Style="{StaticResource ToolbarBtn}" Margin="6,0,0,0"
                                                        Command="{Binding SelectedNode.BrowseExternalExecutableCommand}" ToolTip="Browse for executable or script"/>
                                            </Grid>

                                            <TextBlock Text="Arguments (use {0} for image file)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.ExternalCommandArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <TextBlock Text="Temporary Image Format" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.ExternalCommandFormat, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,6">
                                                <ComboBoxItem Content="PNG (Lossless)" Tag="png"/>
                                                <ComboBoxItem Content="JPEG / JPG" Tag="jpg"/>
                                                <ComboBoxItem Content="BMP (Bitmap)" Tag="bmp"/>
                                                <ComboBoxItem Content="GIF" Tag="gif"/>
                                            </ComboBox>

                                            <TextBlock Text="Working Directory (Optional)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.ExternalCommandWorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <CheckBox Content="Run in background (asynchronously)" IsChecked="{Binding SelectedNode.ExternalCommandRunInBackground, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="Copy standard output to clipboard" IsChecked="{Binding SelectedNode.ExternalCommandOutputToClipboard, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="Copy detected URL from output to clipboard" IsChecked="{Binding SelectedNode.ExternalCommandUriToClipboard, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="Reload image after execution" IsChecked="{Binding SelectedNode.ExternalCommandReloadAfterExecution, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="Store Output in Variable (Optional)" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.ExternalCommandSetOutputVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,4"/>
                                        </StackPanel>

                                        <!-- 20. Imgur Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsImgur, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Upload Image Format" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.ImgurFormat, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,6">
                                                <ComboBoxItem Content="PNG (Lossless)" Tag="png"/>
                                                <ComboBoxItem Content="JPEG / JPG" Tag="jpg"/>
                                            </ComboBox>

                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <CheckBox Content="Copy upload link to clipboard" IsChecked="{Binding SelectedNode.ImgurCopyLinkToClipboard, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="Open image in web browser" IsChecked="{Binding SelectedNode.ImgurOpenInBrowser, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 21. Jira Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsJira, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Jira Issue Key / ID" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.JiraIssueKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>
                                            <TextBlock Text="Upload Format" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.JiraFormat, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,6">
                                                <ComboBoxItem Content="PNG (Lossless)" Tag="png"/>
                                                <ComboBoxItem Content="JPEG / JPG" Tag="jpg"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 22. Confluence Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsConfluence, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Confluence Page ID / Title" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.ConfluencePageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>
                                            <TextBlock Text="Upload Format" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.ConfluenceFormat, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,6">
                                                <ComboBoxItem Content="PNG (Lossless)" Tag="png"/>
                                                <ComboBoxItem Content="JPEG / JPG" Tag="jpg"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 23. Office Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsOffice, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Target Office Application" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox SelectedValue="{Binding SelectedNode.OfficeApplication, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,6">
                                                <ComboBoxItem Content="Microsoft Word" Tag="Word"/>
                                                <ComboBoxItem Content="Microsoft Excel" Tag="Excel"/>
                                                <ComboBoxItem Content="Microsoft PowerPoint" Tag="PowerPoint"/>
                                                <ComboBoxItem Content="Microsoft OneNote" Tag="OneNote"/>
                                                <ComboBoxItem Content="Microsoft Outlook" Tag="Outlook"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 24. ZXing Barcode / QR Code Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsZxing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Extracted Text Variable Name" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding SelectedNode.ZxingSetVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>
                                            <CheckBox Content="Copy decoded text to clipboard" IsChecked="{Binding SelectedNode.ZxingCopyToClipboard, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,6"/>
                                        </StackPanel>

                                        <!-- 25. Cloud Storage Inspector (Box / Dropbox) -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsCloudStorage, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Cloud Storage Destination" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Captures will be uploaded directly to your cloud storage account and the public sharing link placed in the clipboard/properties."
                                                       FontSize="11" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- When nothing is selected -->
                                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource InvertBoolToVis}}"
                                                VerticalAlignment="Center" Margin="0,40,0,0">
                                        <TextBlock Text="No Element Selected" FontWeight="SemiBold" FontSize="13" Foreground="{Binding TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click a step node or connection wire on the canvas to configure parameters, or select a step from the toolbox to add one."
                                                   FontSize="11" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="10,6,10,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: Recipe & Triggers -->
                        <TabItem Header="⚡ Recipe &amp; Triggers" Style="{StaticResource InspectorTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,8,6,8">
                                <StackPanel>
                                    <TextBlock Text="RECIPE CONFIGURATION" FontWeight="Bold" FontSize="11" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Recipe Name" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding RecipeTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                             Padding="6,4" Margin="0,2,0,8"/>

                                    <TextBlock Text="Description" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding RecipeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="48"
                                             Padding="6,4" Margin="0,2,0,8"/>

                                    <TextBlock Text="Version" FontSize="11" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding RecipeVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                             Padding="6,4" Margin="0,2,0,10"/>

                                    <!-- Start Steps / Entry Points -->
                                    <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="START STEPS (ENTRY POINTS)" FontWeight="Bold" FontSize="10" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Select one or more entry steps. Multiple start steps execute concurrently in parallel when triggered."
                                                       FontSize="10" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Nodes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsStartNode, Mode=TwoWay}" Margin="0,3" Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding StepType, Converter={StaticResource StepIconConv}}" FontSize="11" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding Id, StringFormat=' ({0})'}" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Separator Background="{Binding CardBorderBrush}" Margin="0,6,0,12"/>

                                    <!-- Triggers Header & Action Bar -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="TRIGGERS" FontWeight="Bold" FontSize="11" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Triggers.Count, StringFormat='{}{0} configured'}" FontSize="11" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Quick Add Buttons -->
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="+ Hotkey" Style="{StaticResource ToolbarBtn}" Command="{Binding AddTriggerCommand}" CommandParameter="Hotkey" Margin="0,0,4,4"/>
                                        <Button Content="+ Context Menu" Style="{StaticResource ToolbarBtn}" Command="{Binding AddTriggerCommand}" CommandParameter="ContextMenu" Margin="0,0,4,4"/>
                                        <Button Content="+ Editor" Style="{StaticResource ToolbarBtn}" Command="{Binding AddTriggerCommand}" CommandParameter="Editor" Margin="0,0,4,4"/>
                                        <Button Content="+ Clipboard" Style="{StaticResource ToolbarBtn}" Command="{Binding AddTriggerCommand}" CommandParameter="Clipboard" Margin="0,0,4,4"/>
                                        <Button Content="+ Manual" Style="{StaticResource ToolbarBtn}" Command="{Binding AddTriggerCommand}" CommandParameter="Manual" Margin="0,0,0,4"/>
                                    </WrapPanel>

                                    <!-- Triggers List -->
                                    <ItemsControl ItemsSource="{Binding Triggers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <!-- Card Header -->
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="11"
                                                                       Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                      Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      FontSize="10" VerticalAlignment="Center" Margin="6,0"/>
                                                            <Button Grid.Column="2" Style="{StaticResource TriggerDeleteBtn}"
                                                                    Command="{Binding DataContext.RemoveTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Delete Trigger"/>
                                                        </Grid>

                                                        <!-- Trigger specific fields -->
                                                        <!-- 1. Hotkey -->
                                                        <StackPanel Visibility="{Binding IsHotkey, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="Hotkey Combination (e.g. Ctrl + Alt + R)" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox Text="{Binding Hotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                        </StackPanel>

                                                        <!-- 2. Context Menu -->
                                                        <StackPanel Visibility="{Binding IsContextMenu, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="Menu Item Label" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox Text="{Binding MenuItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="Menu Group" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 3. Editor Menu -->
                                                        <StackPanel Visibility="{Binding IsEditor, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="Editor Menu Item Label" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox Text="{Binding MenuItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="Editor Menu Group" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 4. Clipboard -->
                                                        <StackPanel Visibility="{Binding IsClipboard, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="Format Filter (Optional, e.g. PNG, DeviceIndependentBitmap)" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox Text="{Binding FormatFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas" FontSize="11"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 5. Manual -->
                                                        <StackPanel Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="Trigger Name" FontSize="10" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Greenshot DAG Pipeline Engine" FontSize="11" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>


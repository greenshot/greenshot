<Window x:Class="Greenshot.Plugin.RecipeEditor.Dialogs.SelectEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="Greenshot — Select Image Editor"
        Height="540" Width="820"
        MinHeight="440" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        Background="{x:Static wpf:WpfThemeHelper.WindowBackground}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Caption Close Button -->
        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{x:Static wpf:WpfThemeHelper.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <Path x:Name="crossPath" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dialog Button Style -->
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Background" Value="{x:Static wpf:WpfThemeHelper.CardBackground}"/>
            <Setter Property="Foreground" Value="{x:Static wpf:WpfThemeHelper.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{x:Static wpf:WpfThemeHelper.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{x:Static wpf:WpfThemeHelper.BadgeBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dialog Primary Button -->
        <Style x:Key="DialogPrimaryBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Background" Value="{x:Static wpf:WpfThemeHelper.Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{x:Static wpf:WpfThemeHelper.Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border -->
    <Border BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Custom Title bar -->
                <RowDefinition Height="Auto"/> <!-- Description header -->
                <RowDefinition Height="*"/> <!-- Two-column content: List & Preview -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{x:Static wpf:WpfThemeHelper.CardBackground}" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="🖼️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Greenshot" FontWeight="Bold" FontSize="12" Foreground="{x:Static wpf:WpfThemeHelper.TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Select Image Editor" FontSize="12" Foreground="{x:Static wpf:WpfThemeHelper.TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource CaptionCloseBtnStyle}" Click="OnCloseTitleBarClicked" ToolTip="Close"/>
            </Grid>

            <!-- Header Description -->
            <Border Grid.Row="1" Margin="16,10,16,10">
                <TextBlock Text="Multiple image editors are open. Select an editor to preview its annotations and import them into the recipe step:"
                           FontSize="11" Foreground="{x:Static wpf:WpfThemeHelper.TextSecondary}" TextWrapping="Wrap"/>
            </Border>

            <!-- Main Content: Left List & Right Preview -->
            <Grid Grid.Row="2" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Open Editors List -->
                <Border Grid.Column="0" Background="{x:Static wpf:WpfThemeHelper.CardBackground}"
                        BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}" BorderThickness="0,0,0,1" Padding="6,4,6,8" Margin="0,0,0,4">
                            <TextBlock x:Name="ListHeaderTextBlock" Text="Open Editors" FontWeight="SemiBold" FontSize="11" Foreground="{x:Static wpf:WpfThemeHelper.TextSecondary}"/>
                        </Border>

                        <ListBox x:Name="EditorListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="EditorListBox_SelectionChanged"
                                 MouseDoubleClick="EditorListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder"
                                                        Background="Transparent"
                                                        BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{x:Static wpf:WpfThemeHelper.BadgeBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{x:Static wpf:WpfThemeHelper.WindowBackground}"/>
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{x:Static wpf:WpfThemeHelper.Accent}"/>
                                                        <Setter TargetName="itemBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4"
                                                Background="{x:Static wpf:WpfThemeHelper.BadgeBackground}"
                                                BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}"
                                                BorderThickness="1" Margin="0,0,10,0"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🖼️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{x:Static wpf:WpfThemeHelper.TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       Foreground="{x:Static wpf:WpfThemeHelper.TextSecondary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="➔" FontSize="11"
                                                   Foreground="{x:Static wpf:WpfThemeHelper.Accent}"
                                                   VerticalAlignment="Center" Margin="6,0,2,0"
                                                   FontWeight="Bold"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Right Column: Live Preview Panel -->
                <Border Grid.Column="1" Margin="12,0,0,0"
                        Background="{x:Static wpf:WpfThemeHelper.CardBackground}"
                        BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Preview Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="PREVIEW" FontSize="9" FontWeight="Bold" Foreground="{x:Static wpf:WpfThemeHelper.Accent}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PreviewTitleTextBlock" Text="Selected Editor" FontWeight="Bold" FontSize="12"
                                           Foreground="{x:Static wpf:WpfThemeHelper.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{x:Static wpf:WpfThemeHelper.BadgeBackground}"
                                        BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="PreviewDimensionsBadge" Text="0 × 0 px" FontSize="10" Foreground="{x:Static wpf:WpfThemeHelper.TextPrimary}"/>
                                </Border>

                                <Border Background="{x:Static wpf:WpfThemeHelper.BadgeBackground}"
                                        BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,3">
                                    <TextBlock x:Name="PreviewCountBadge" Text="0 annotations" FontSize="10" FontWeight="SemiBold" Foreground="{x:Static wpf:WpfThemeHelper.Accent}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Preview Display Surface -->
                        <Border Grid.Row="1"
                                Background="{x:Static wpf:WpfThemeHelper.WindowBackground}"
                                BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}"
                                BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10" SnapsToDevicePixels="True"/>
                                <TextBlock x:Name="NoPreviewTextBlock" Text="No preview available"
                                           FontSize="11" Foreground="{x:Static wpf:WpfThemeHelper.TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="3" Background="{x:Static wpf:WpfThemeHelper.CardBackground}"
                    BorderBrush="{x:Static wpf:WpfThemeHelper.CardBorder}"
                    BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusTextBlock" Text="0 editors available" FontSize="11" Foreground="{x:Static wpf:WpfThemeHelper.TextSecondary}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel" Style="{StaticResource DialogBtn}" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click"/>
                        <Button x:Name="OkButton" Content="Import Annotations" Style="{StaticResource DialogPrimaryBtn}" IsDefault="True" Click="OkButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

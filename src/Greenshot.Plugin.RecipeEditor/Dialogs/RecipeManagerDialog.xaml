<Window x:Class="Greenshot.Plugin.RecipeEditor.Dialogs.RecipeManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:vm="clr-namespace:Greenshot.Plugin.RecipeEditor.ViewModels"
        xmlns:conv="clr-namespace:Greenshot.Plugin.RecipeEditor.Converters"
        mc:Ignorable="d"
        Title="Greenshot — Capture Recipe Manager"
        Height="680" Width="920"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        Background="{x:Static ui:WpfThemeHelper.WindowBackground}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
            <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush"/>

            <!-- Modern Caption Button Style -->
            <Style x:Key="CaptionBtnStyle" TargetType="Button">
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{x:Static ui:WpfThemeHelper.TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#26888888"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#40888888"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Caption Close Button Style -->
            <Style x:Key="CaptionCloseBtnStyle" TargetType="Button">
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{x:Static ui:WpfThemeHelper.TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                <Path x:Name="crossPath" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="10" Height="10" Stretch="Uniform"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                      Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                      SnapsToDevicePixels="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                    <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                    <Setter TargetName="crossPath" Property="Stroke" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Standard Toolbar Button Style -->
            <Style x:Key="DlgBtn" TargetType="Button">
                <Setter Property="Background" Value="{x:Static ui:WpfThemeHelper.CardBackground}"/>
                <Setter Property="Foreground" Value="{x:Static ui:WpfThemeHelper.TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{x:Static ui:WpfThemeHelper.CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{x:Static ui:WpfThemeHelper.BadgeBackground}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Accent Button -->
            <Style x:Key="DlgPrimaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
                <Setter Property="Background" Value="{x:Static ui:WpfThemeHelper.Accent}"/>
                <Setter Property="BorderBrush" Value="{x:Static ui:WpfThemeHelper.Accent}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Danger Button -->
            <Style x:Key="DlgDangerBtn" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
                <Setter Property="Background" Value="#1AEC2B2B"/>
                <Setter Property="BorderBrush" Value="#66EC2B2B"/>
                <Setter Property="Foreground" Value="#FFEC2B2B"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Filter Chip Button Style -->
            <Style x:Key="FilterChipStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{x:Static ui:WpfThemeHelper.TextSecondary}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="{x:Static ui:WpfThemeHelper.CardBackground}"
                                    BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{x:Static ui:WpfThemeHelper.Accent}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{x:Static ui:WpfThemeHelper.Accent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{x:Static ui:WpfThemeHelper.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Custom Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Header & Controls -->
                <RowDefinition Height="*"/>    <!-- Recipe Cards List -->
                <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Greenshot" FontWeight="Bold" FontSize="12" Foreground="{x:Static ui:WpfThemeHelper.TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Capture Recipe Manager" FontSize="12" Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtnStyle}" Click="OnMinimizeClicked" ToolTip="Minimize">
                        <Rectangle Width="10" Height="1.5" Fill="{x:Static ui:WpfThemeHelper.TextPrimary}" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtnStyle}" Click="OnCloseClicked" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Controls & Filter Header -->
            <Border Grid.Row="1" Background="{x:Static ui:WpfThemeHelper.CardBackground}"
                    BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}" BorderThickness="0,1,0,1" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Action Buttons & Search Box -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Column="0" Background="{x:Static ui:WpfThemeHelper.WindowBackground}"
                                BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}" BorderThickness="1"
                                CornerRadius="4" Padding="6,4" MaxWidth="360" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍 " FontSize="11" VerticalAlignment="Center" Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{x:Static ui:WpfThemeHelper.TextPrimary}"
                                         VerticalAlignment="Center" FontSize="11" Width="280"/>
                            </Grid>
                        </Border>

                        <!-- Actions: Load Recipe from Disk, Create New, Reload -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="➕ Load Recipe..." Style="{StaticResource DlgPrimaryBtn}" Command="{Binding LoadRecipeFromFileCommand}"
                                    ToolTip="Load and register a .gsrecipe.json file into Greenshot" Margin="0,0,6,0"/>
                            <Button Content="✨ New Recipe" Style="{StaticResource DlgBtn}" Command="{Binding CreateNewRecipeCommand}"
                                    ToolTip="Create a new capture recipe in the Visual Editor" Margin="0,0,6,0"/>
                            <Button Content="🔄 Reload All" Style="{StaticResource DlgBtn}" Command="{Binding ReloadAllCommand}"
                                    ToolTip="Reload configured recipe files from disk"/>
                        </StackPanel>
                    </Grid>

                    <!-- Filter Category Chips -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="All" Style="{StaticResource FilterChipStyle}" IsChecked="True"
                                     Click="OnFilterAllClicked"/>
                        <RadioButton Content="Active" Style="{StaticResource FilterChipStyle}"
                                     Click="OnFilterActiveClicked"/>
                        <RadioButton Content="Deactivated" Style="{StaticResource FilterChipStyle}"
                                     Click="OnFilterDeactivatedClicked"/>
                        <RadioButton Content="Built-in" Style="{StaticResource FilterChipStyle}"
                                     Click="OnFilterBuiltInClicked"/>
                        <RadioButton Content="Custom" Style="{StaticResource FilterChipStyle}"
                                     Click="OnFilterCustomClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recipe List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
                <ItemsControl ItemsSource="{Binding FilteredRecipes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RecipeManagerItemViewModel}">
                            <Border Background="{x:Static ui:WpfThemeHelper.CardBackground}"
                                    BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="14,12"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Active Switch Column -->
                                        <ColumnDefinition Width="*"/>    <!-- Details Column -->
                                        <ColumnDefinition Width="Auto"/> <!-- Action Buttons Column -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Active / Deactivate Toggle Switch -->
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center" Width="85" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource DlgBtn}" Command="{Binding ToggleActiveCommand}"
                                                Padding="6,4" HorizontalAlignment="Stretch" ToolTip="Click to toggle Activate / Deactivate">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center"
                                                         Fill="{Binding IsEnabled, Converter={StaticResource BoolToStatusBrush}}"/>
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding IsEnabled, Converter={StaticResource BoolToStatusBrush}}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Recipe Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Header Row: Name, Version, Type Badges -->
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{x:Static ui:WpfThemeHelper.TextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Border Background="{x:Static ui:WpfThemeHelper.BadgeBackground}"
                                                    BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}"
                                                    BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RecipeTypeBadge}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10"
                                                       Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Id, StringFormat='({0})'}" FontSize="10" FontFamily="Consolas"
                                                       Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}" VerticalAlignment="Center"/>
                                        </WrapPanel>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{x:Static ui:WpfThemeHelper.TextPrimary}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Visibility="{Binding Description.Length, Converter={StaticResource BoolToVis}}"/>

                                        <!-- Triggers & Pipeline Summary Badges -->
                                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Background="{x:Static ui:WpfThemeHelper.BadgeBackground}"
                                                    BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}"
                                                    BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding TriggersSummary}" FontSize="10"
                                                           Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}"/>
                                            </Border>
                                            <Border Background="{x:Static ui:WpfThemeHelper.BadgeBackground}"
                                                    BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}"
                                                    BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding StepCount, StringFormat='{}{0} steps'}" FontSize="10"
                                                           Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}"/>
                                            </Border>
                                            <Border Background="{x:Static ui:WpfThemeHelper.BadgeBackground}"
                                                    BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}"
                                                    BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,4"
                                                    Visibility="{Binding HasFilePath, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding FilePath}">
                                                <TextBlock Text="{Binding FilePath}" FontSize="10" FontFamily="Consolas"
                                                           Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Actions Column -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Content="✏️ Edit" Style="{StaticResource DlgPrimaryBtn}" Command="{Binding EditCommand}"
                                                ToolTip="Open recipe in Visual Editor canvas" Margin="0,0,6,0"/>
                                        <Button Content="▶ Test Run" Style="{StaticResource DlgBtn}" Command="{Binding TestRunCommand}"
                                                ToolTip="Test execute capture recipe in Greenshot" Margin="0,0,6,0"/>
                                        <Button Content="{Binding UnloadButtonText}" Style="{StaticResource DlgDangerBtn}" Command="{Binding UnloadCommand}"
                                                ToolTip="{Binding UnloadToolTip}"
                                                Visibility="{Binding CanUnload, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Status Footer -->
            <Border Grid.Row="3" Background="{x:Static ui:WpfThemeHelper.CardBackground}"
                    BorderBrush="{x:Static ui:WpfThemeHelper.CardBorder}" BorderThickness="0,1,0,0" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount, StringFormat='Total: {0}'}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{x:Static ui:WpfThemeHelper.TextPrimary}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding ActiveCount, StringFormat='Active: {0}'}" FontSize="11"
                                   Foreground="#238636" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding DeactivatedCount, StringFormat='Deactivated: {0}'}" FontSize="11"
                                   Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontStyle="Italic"
                                   Foreground="{x:Static ui:WpfThemeHelper.TextSecondary}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Close" Style="{StaticResource DlgBtn}" Command="{Binding CloseCommand}"
                            Padding="16,6" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

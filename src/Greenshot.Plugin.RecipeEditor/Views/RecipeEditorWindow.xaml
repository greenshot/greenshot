<Window x:Class="Greenshot.Plugin.RecipeEditor.Views.RecipeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
        xmlns:vm="clr-namespace:Greenshot.Plugin.RecipeEditor.ViewModels"
        xmlns:conv="clr-namespace:Greenshot.Plugin.RecipeEditor.Converters"
        xmlns:emoji="clr-namespace:Greenshot.Editor.Controls.Emoji;assembly=Greenshot.Editor"
        xmlns:views="clr-namespace:Greenshot.Base.Wpf.Views;assembly=Greenshot.Base"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="800" Width="1240"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        Background="{Binding WindowBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
        <KeyBinding Key="Back" Command="{Binding DeleteSelectedCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveRecipeCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenRecipeCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewRecipeCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding AutoLayoutCommand}"/>
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding OpenRecipeManagerCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ComboBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/generic.xaml"/>
                <!-- Nodify's focus frames for the keyboard navigation of the editor and its connections -->
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/FocusVisual.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StepTypeToColorConverter x:Key="StepColorConv"/>
            <conv:StepTypeToIconConverter x:Key="StepIconConv"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
            <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConv"/>
            <conv:StringToVisibilityConverter x:Key="StringToVis"/>
            <conv:StringToBrushConverter x:Key="StringToBrushConv"/>

        <!-- Modern Themed Context Menu -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{Binding CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Themed Menu Item -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="{wpf:FontSize 11}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="12,0,0,0"
                                           Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" FontSize="{wpf:FontSize 10}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding BadgeBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Themed Menu Separator -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="{Binding CardBorderBrush}"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

     <!-- Inspector TabItem Style -->
        <Style x:Key="InspectorTabItem" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GreenshotFocusVisual}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="{wpf:FontSize 11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}" Margin="0,0,8,0" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{Binding AccentBrush}"/>
                                <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{Binding TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Pin Connector Style -->
        <Style x:Key="PinConnectorStyle" TargetType="{x:Type nodify:Connector}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type nodify:Connector}">
                        <Grid Background="Transparent">
                            <!-- Soft circular glow on hover / connect -->
                            <Ellipse x:Name="OuterGlow"
                                     Width="18" Height="18"
                                     Fill="{Binding AccentBrush}"
                                     Opacity="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                            <!-- Pin body -->
                            <Ellipse x:Name="PinCircle"
                                     Width="10" Height="10"
                                     Fill="{Binding CardBackgroundBrush}"
                                     Stroke="{Binding CardBorderBrush}"
                                     StrokeThickness="1.5"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsConnected" Value="True">
                                <Setter TargetName="PinCircle" Property="Fill" Value="{Binding AccentBrush}"/>
                                <Setter TargetName="PinCircle" Property="Stroke" Value="White"/>
                                <Setter TargetName="PinCircle" Property="StrokeThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterGlow" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="PinCircle" Property="Stroke" Value="{Binding AccentBrush}"/>
                                <Setter TargetName="PinCircle" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Node Template (Top/Bottom Flow) -->
        <DataTemplate DataType="{x:Type vm:StepNodeViewModel}">
            <Border Background="{Binding DataContext.NodeCardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderBrush="{Binding DataContext.NodeCardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Width="220"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{wpf:Text RecipeEditor.ToggleStartStep}" Command="{Binding ToggleStartNodeCommand}"/>
                        <Separator/>
                        <MenuItem Header="{wpf:Text RecipeEditor.DeleteStep}" Command="{Binding DeleteNodeCommand}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Content / Summary -->
                        <RowDefinition Height="Auto"/> <!-- Conditional Branches Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{Binding StepType, Converter={StaticResource StepColorConv}}"
                            CornerRadius="7,7,0,0" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StepType, Converter={StaticResource StepIconConv}}"
                                       FontSize="{wpf:FontSize 13}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                       FontWeight="Bold" FontSize="{wpf:FontSize 12}" Foreground="White"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <!-- Palette colors: readable in the light, dark and high contrast themes -->
                            <Border Grid.Column="2" Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.BadgeBackground}" CornerRadius="3"
                                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.SuccessBrush}" BorderThickness="1"
                                    Padding="4,1" Margin="4,0,0,0"
                                    Visibility="{Binding IsStartNode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{wpf:Text RecipeEditor.BadgeStart}" FontSize="{wpf:FontSize 9}" FontWeight="Bold" Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.SuccessBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <Border Grid.Row="1" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Id}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontFamily="Consolas" Margin="0,0,0,4"/>

                            <!-- Standard Step Summary -->
                            <TextBlock Text="{Binding Summary}" FontSize="{wpf:FontSize 11}" Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasDynamicOutputPorts, Converter={StaticResource InvertBoolToVis}}"/>

                            <!-- Slot: the extensions which plug in, greyed out (they are not part of the recipe) -->
                            <StackPanel Visibility="{Binding IsSlot, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <ItemsControl ItemsSource="{Binding SlotExtensions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='⤷ {0}'}" FontSize="{wpf:FontSize 10}" FontStyle="Italic"
                                                       Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{wpf:Text RecipeEditor.SlotNoExtensions}" FontSize="{wpf:FontSize 10}" FontStyle="Italic"
                                           Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding HasNoSlotExtensions, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Conditional Branches Summary inside Card Body -->
                            <StackPanel Visibility="{Binding IsConditional, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{wpf:Text RecipeEditor.Branches}" FontSize="{wpf:FontSize 10}" FontWeight="SemiBold"
                                           Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding ConditionBranches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Margin="0,0,6,0"
                                                        Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding Key}" FontSize="{wpf:FontSize 9}" FontWeight="Bold"
                                                               Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Expression}" FontSize="{wpf:FontSize 10}"
                                                           FontFamily="Consolas" VerticalAlignment="Center"
                                                           Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Expression}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- User Decision Choices Summary inside Card Body -->
                            <StackPanel Visibility="{Binding IsUserPrompt, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UserPromptMessage}" FontSize="{wpf:FontSize 10}"
                                           Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding PromptChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Margin="0,0,6,0"
                                                        Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding Key}" FontSize="{wpf:FontSize 9}" FontWeight="Bold"
                                                               Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="{wpf:FontSize 10}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Conditional Branches Footer (Clean Pins Aligned to Bottom) -->
                    <Border Grid.Row="2"
                            Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,7,7"
                            Padding="2,3,2,0"
                            Visibility="{Binding IsConditional, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding ConditionBranches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30" ToolTip="{Binding Expression}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,1,0,0"
                                                Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                BorderThickness="1" CornerRadius="3" Padding="6,1">
                                            <TextBlock Text="{Binding Key}" FontSize="{wpf:FontSize 9}" FontWeight="Bold"
                                                       Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Border>
                                        <nodify:Connector Grid.Row="1"
                                                          DataContext="{Binding Port}"
                                                          Style="{StaticResource PinConnectorStyle}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,0,0,-9"
                                                          Panel.ZIndex="10"
                                                          Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                          IsConnected="{Binding IsConnected}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- User Prompt Choices Footer (Clean Pins Aligned to Bottom) -->
                    <Border Grid.Row="2"
                            Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,7,7"
                            Padding="2,3,2,0"
                            Visibility="{Binding IsUserPrompt, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding PromptChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30" ToolTip="{Binding Label}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,1,0,0"
                                                Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                BorderThickness="1" CornerRadius="3" Padding="6,1">
                                            <TextBlock Text="{Binding Key}" FontSize="{wpf:FontSize 9}" FontWeight="Bold"
                                                       Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Border>
                                        <nodify:Connector Grid.Row="1"
                                                          DataContext="{Binding Port}"
                                                          Style="{StaticResource PinConnectorStyle}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Bottom"
                                                          Margin="0,0,0,-9"
                                                          Panel.ZIndex="10"
                                                          Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                          IsConnected="{Binding IsConnected}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Top Input Pin (Vertical Flow - Centered on Top Edge) -->
                    <nodify:Connector Grid.Row="0"
                                      DataContext="{Binding InputPort}"
                                      Style="{StaticResource PinConnectorStyle}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Margin="0,-9,0,0"
                                      Panel.ZIndex="10"
                                      Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                      IsConnected="{Binding IsConnected}"/>

                    <!-- Bottom Output Pin (For Non-Conditional / Non-Prompt Steps) -->
                    <nodify:Connector Grid.Row="1"
                                      DataContext="{Binding OutputPort}"
                                      Style="{StaticResource PinConnectorStyle}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,-9"
                                      Panel.ZIndex="10"
                                      Visibility="{Binding Node.HasDynamicOutputPorts, Converter={StaticResource InvertBoolToVis}}"
                                      Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                      IsConnected="{Binding IsConnected}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ItemContainerStyle" TargetType="{x:Type nodify:ItemContainer}">
            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <!-- The real size of a step, for the auto-layout -->
            <Setter Property="ActualSize" Value="{Binding Size, Mode=OneWayToSource}" />
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <!-- Nodify moves the keyboard focus between the steps with the arrow keys, the frame shows which one has it -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource GreenshotFocusVisual}"/>
            <!-- Screen readers announce the step by its title instead of the view model's class name -->
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName, TargetNullValue=''}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type nodify:ItemContainer}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A color swatch which opens the color picker: a real button, so it can be reached and used with the keyboard -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource GreenshotFocusVisual}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Names for the items of the combo boxes with objects (without them screen readers announce the class name) -->
        <Style x:Key="RecipeComboItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, TargetNullValue=''}"/>
        </Style>
        <Style x:Key="FileFormatComboItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayNameWithPreferredExtension, TargetNullValue=''}"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{Binding CardBorderBrush}" Background="{Binding WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Main Toolbar -->
                <RowDefinition Height="*"/>    <!-- Canvas & Sidebars -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0" ShowThemeToggle="True"/>

            <!-- Main Toolbar -->
            <Border Grid.Row="1" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                <DockPanel LastChildFill="True">
                    <!-- What is pending for the approval of the current recipe -->
                    <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="10,5" CornerRadius="4"
                            Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.WarningBackground}" BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.WarningBorder}" BorderThickness="1"
                            Visibility="{Binding HasApprovalNotice, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡 " FontSize="{wpf:FontSize 12}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ApprovalNotice}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Content="{wpf:Text RecipeEditor.ReviewApproval}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ReviewApprovalCommand}" Margin="10,0,0,0" Padding="8,2"
                                    Visibility="{Binding CanReviewApproval, Converter={StaticResource BoolToVis}}" ToolTip="{wpf:Text RecipeEditor.TipReviewApproval}"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Recipe Selector & Manager -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"><Run Text="{wpf:Text RecipeEditor.Recipe}"/><Run Text=":"/></TextBlock>
                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.Recipe}" ItemsSource="{Binding AvailableRecipes}"
                                      SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                                      TextSearch.TextPath="Name" ItemContainerStyle="{StaticResource RecipeComboItemStyle}"
                                      Width="200" Height="28" Margin="0,0,6,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding IsEnabled, Converter={StaticResource BoolToStatusBrushConv}}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <TextBlock FontStyle="Italic" FontSize="{wpf:FontSize 10}"
                                                       Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsEnabled, Converter={StaticResource InvertBoolToVis}}"><Run Text=" "/><Run Text="{wpf:Text RecipeEditor.Deactivated}"/></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Quick Active / Deactivate Toggle for Selected Recipe -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleActiveRecipeEnabledCommand}" AutomationProperties.Name="{Binding ActiveRecipeStatusText, TargetNullValue=''}"
                                    ToolTip="{wpf:Text RecipeEditor.TipToggleRecipeActive}" Margin="0,0,6,0" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Fill="{Binding IsActiveRecipeEnabled, Converter={StaticResource BoolToStatusBrushConv}}"/>
                                    <TextBlock Text="{Binding ActiveRecipeStatusText}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}"/>
                                </StackPanel>
                            </Button>

                            <!-- Quick Unload button if custom or overridden -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding UnloadActiveRecipeCommand}" AutomationProperties.Name="{Binding UnloadActiveRecipeText, TargetNullValue=''}"
                                    Visibility="{Binding CanUnloadActiveRecipe, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding UnloadActiveRecipeToolTip}" Margin="0,0,6,0" Padding="8,4">
                                <TextBlock Text="{Binding UnloadActiveRecipeText}" FontSize="{wpf:FontSize 10}"/>
                            </Button>

                            <!-- Visual Recipe Manager Button -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenRecipeManagerCommand}" AutomationProperties.Name="{wpf:Text RecipeEditor.ManageRecipes}"
                                    ToolTip="{wpf:Text RecipeEditor.TipManageRecipes}" Margin="0,0,6,0" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋 " FontSize="{wpf:FontSize 11}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{wpf:Text RecipeEditor.ManageRecipes}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Actions Toolbar -->
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Left" Margin="15,0,0,0">
                            <Button Content="{wpf:Text RecipeEditor.BtnNew}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NewRecipeCommand}" ToolTip="{wpf:Text RecipeEditor.TipNewRecipe}"/>
                            <Button Content="{wpf:Text RecipeEditor.BtnNewExtension}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NewExtensionCommand}"
                                    ToolTip="{wpf:Text RecipeEditor.TipNewExtension}"/>
                            <Button Content="{wpf:Text RecipeEditor.BtnOpen}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenRecipeCommand}" ToolTip="{wpf:Text RecipeEditor.TipOpenRecipe}"/>
                            <Button Content="{wpf:Text RecipeEditor.BtnSave}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveRecipeCommand}" ToolTip="{wpf:Text RecipeEditor.TipSaveRecipe}"/>
                            <Button Content="{wpf:Text RecipeEditor.BtnSaveAs}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveAsCommand}" ToolTip="{wpf:Text RecipeEditor.TipSaveRecipeAs}"/>
                            <Separator Width="1" Background="{Binding CardBorderBrush}" Margin="6,2"/>
                            <Button Content="{wpf:Text RecipeEditor.BtnUndo}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding UndoCommand}" ToolTip="{wpf:Text RecipeEditor.TipUndo}"/>
                            <Button Content="{wpf:Text RecipeEditor.BtnRedo}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RedoCommand}" ToolTip="{wpf:Text RecipeEditor.TipRedo}"/>
                            <Separator Width="1" Background="{Binding CardBorderBrush}" Margin="6,2"/>
                            <Button Content="{wpf:Text RecipeEditor.BtnAutoLayout}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AutoLayoutCommand}" ToolTip="{wpf:Text RecipeEditor.TipAutoLayout}"/>
                            <Button Content="{}{ } JSON" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleJsonViewCommand}" ToolTip="{wpf:Text RecipeEditor.TipEditJson}"/>
                            <Button Content="🧜 Mermaid" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleMermaidViewCommand}" ToolTip="{wpf:Text RecipeEditor.TipMermaid}"/>
                        </StackPanel>

                        <!-- Right Action: Test Run -->
                        <StackPanel Orientation="Horizontal" Grid.Column="2">
                            <Button Content="{wpf:Text RecipeEditor.BtnTestRun}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding TestRunCommand}" ToolTip="{wpf:Text RecipeEditor.TipTestRun}"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Main Workspace -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="180" MaxWidth="300"/> <!-- Left Toolbox -->
                    <ColumnDefinition Width="*"/>                                 <!-- Nodify DAG Canvas -->
                    <ColumnDefinition Width="320" MinWidth="260" MaxWidth="440"/> <!-- Right Properties Inspector -->
                </Grid.ColumnDefinitions>

                <!-- Left Toolbox -->
                <Border Grid.Column="0" Background="{Binding WindowBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="0,0,1,0" Padding="8">
                    <ScrollViewer Style="{DynamicResource ThemedScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{wpf:Text RecipeEditor.HeaderStepToolbox}" FontWeight="Bold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="4,4,0,2"/>
                            <TextBlock Text="{wpf:Text RecipeEditor.HintToolbox}" FontSize="{wpf:FontSize 10}" TextWrapping="Wrap"
                                       Foreground="{Binding TextSecondaryBrush}" Margin="4,0,0,8"/>

                            <!-- 1. Acquisition -->
                            <TextBlock Text="{wpf:Text RecipeEditor.HeaderAcquisition}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="4,8,0,4"/>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepSource}" Command="{Binding AddStepCommand}" CommandParameter="Source">
                                <TextBlock><Run Text="📷 "/><Run Text="{wpf:Text RecipeEditor.StepSource}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepInteractiveSelection}" Command="{Binding AddStepCommand}" CommandParameter="InteractiveSelection">
                                <TextBlock><Run Text="🔲 "/><Run Text="{wpf:Text RecipeEditor.StepInteractiveSelection}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepRecordVideo}" Command="{Binding AddStepCommand}" CommandParameter="RecordVideo">
                                <TextBlock><Run Text="🎥 "/><Run Text="{wpf:Text RecipeEditor.StepRecordVideo}"/></TextBlock>
                            </Button>

                            <!-- 2. Filters & Effects -->
                            <TextBlock Text="{wpf:Text RecipeEditor.HeaderFiltersEffects}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepEffect}" Command="{Binding AddStepCommand}" CommandParameter="Effect">
                                <TextBlock><Run Text="✨ "/><Run Text="{wpf:Text RecipeEditor.StepEffect}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepTextEffect}" Command="{Binding AddStepCommand}" CommandParameter="TextEffect">
                                <TextBlock><Run Text="🛡️ "/><Run Text="{wpf:Text RecipeEditor.StepTextEffect}"/></TextBlock>
                            </Button>

                            <!-- 3. Annotations & Variables -->
                            <TextBlock Text="{wpf:Text RecipeEditor.HeaderAnnotationsData}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepAnnotation}" Command="{Binding AddStepCommand}" CommandParameter="Annotation">
                                <TextBlock><Run Text="🎨 "/><Run Text="{wpf:Text RecipeEditor.StepAnnotation}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepSetVariable}" Command="{Binding AddStepCommand}" CommandParameter="SetVariable">
                                <TextBlock><Run Text="💲 "/><Run Text="{wpf:Text RecipeEditor.StepSetVariable}"/></TextBlock>
                            </Button>

                            <!-- 4. Execution & Logic -->
                            <TextBlock Text="{wpf:Text RecipeEditor.HeaderFlowFeedback}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.SummaryPromptNone}" Command="{Binding AddStepCommand}" CommandParameter="UserPrompt">
                                <TextBlock><Run Text="❓ "/><Run Text="{wpf:Text RecipeEditor.SummaryPromptNone}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepConditional}" Command="{Binding AddStepCommand}" CommandParameter="Conditional">
                                <TextBlock><Run Text="🔀 "/><Run Text="{wpf:Text RecipeEditor.StepConditional}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepSlot}" Command="{Binding AddStepCommand}" CommandParameter="Slot"
                                    ToolTip="{wpf:Text RecipeEditor.TipStepSlot}">
                                <TextBlock><Run Text="🧩 "/><Run Text="{wpf:Text RecipeEditor.StepSlot}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepShutterSound}" Command="{Binding AddStepCommand}" CommandParameter="ImmediateFeedback">
                                <TextBlock><Run Text="🔊 "/><Run Text="{wpf:Text RecipeEditor.StepShutterSound}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepNotification}" Command="{Binding AddStepCommand}" CommandParameter="Notification">
                                <TextBlock><Run Text="🔔 "/><Run Text="{wpf:Text RecipeEditor.StepNotification}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepOcr}" Command="{Binding AddStepCommand}" CommandParameter="Ocr">
                                <TextBlock><Run Text="🔤 "/><Run Text="{wpf:Text RecipeEditor.StepOcr}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepStdout}" Command="{Binding AddStepCommand}" CommandParameter="Stdout">
                                <TextBlock><Run Text="📤 "/><Run Text="{wpf:Text RecipeEditor.StepStdout}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepStderr}" Command="{Binding AddStepCommand}" CommandParameter="Stderr">
                                <TextBlock><Run Text="⛔ "/><Run Text="{wpf:Text RecipeEditor.StepStderr}"/></TextBlock>
                            </Button>

                            <!-- 5. Destinations & Output -->
                            <TextBlock Text="{wpf:Text RecipeEditor.HeaderOutputDestinations}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepDynamicDestination}" Command="{Binding AddStepCommand}" CommandParameter="DynamicDestination">
                                <TextBlock><Run Text="🎯 "/><Run Text="{wpf:Text RecipeEditor.StepDynamicDestination}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepSaveFile}" Command="{Binding AddStepCommand}" CommandParameter="SaveFile">
                                <TextBlock><Run Text="💾 "/><Run Text="{wpf:Text RecipeEditor.StepSaveFile}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepClipboard}" Command="{Binding AddStepCommand}" CommandParameter="Clipboard">
                                <TextBlock><Run Text="📋 "/><Run Text="{wpf:Text RecipeEditor.StepClipboard}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.ImportSourceImageEditor}" Command="{Binding AddStepCommand}" CommandParameter="Editor">
                                <TextBlock><Run Text="🎨 "/><Run Text="{wpf:Text RecipeEditor.ImportSourceImageEditor}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepPrinter}" Command="{Binding AddStepCommand}" CommandParameter="Printer">
                                <TextBlock><Run Text="🖨️ "/><Run Text="{wpf:Text RecipeEditor.StepPrinter}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepEmail}" Command="{Binding AddStepCommand}" CommandParameter="Email">
                                <TextBlock><Run Text="📧 "/><Run Text="{wpf:Text RecipeEditor.StepEmail}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.SummaryCustomDestination}" Command="{Binding AddStepCommand}" CommandParameter="CustomDestination">
                                <TextBlock><Run Text="↗️ "/><Run Text="{wpf:Text RecipeEditor.SummaryCustomDestination}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepDestinations}" Command="{Binding AddStepCommand}" CommandParameter="Destinations">
                                <TextBlock><Run Text="↗️ "/><Run Text="{wpf:Text RecipeEditor.StepDestinations}"/></TextBlock>
                            </Button>

                            <!-- 6. Extensions & Plugins -->
                            <TextBlock Text="{wpf:Text RecipeEditor.HeaderPlugins}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="4,12,0,4"/>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepExternalCommand}" Command="{Binding AddStepCommand}" CommandParameter="ExternalCommand">
                                <TextBlock><Run Text="⚡ "/><Run Text="{wpf:Text RecipeEditor.StepExternalCommand}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="Atlassian Jira" Command="{Binding AddStepCommand}" CommandParameter="Jira">
                                <TextBlock Text="🎯 Atlassian Jira"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepConfluence}" Command="{Binding AddStepCommand}" CommandParameter="Confluence">
                                <TextBlock><Run Text="📄 "/><Run Text="{wpf:Text RecipeEditor.StepConfluence}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="Microsoft Office" Command="{Binding AddStepCommand}" CommandParameter="Office">
                                <TextBlock Text="📊 Microsoft Office"/>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text Pdf.Destination}" Command="{Binding AddStepCommand}" CommandParameter="Pdf">
                                <TextBlock><Run Text="💾 "/><Run Text="{wpf:Text Pdf.Destination}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepZxing}" Command="{Binding AddStepCommand}" CommandParameter="BarcodeScan">
                                <TextBlock><Run Text="🔍 "/><Run Text="{wpf:Text RecipeEditor.StepZxing}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="{wpf:Text RecipeEditor.StepBox}" Command="{Binding AddStepCommand}" CommandParameter="Box">
                                <TextBlock><Run Text="📦 "/><Run Text="{wpf:Text RecipeEditor.StepBox}"/></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolboxButtonStyle}" AutomationProperties.Name="Dropbox" Command="{Binding AddStepCommand}" CommandParameter="Dropbox">
                                <TextBlock Text="📦 Dropbox"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Center Nodify DAG Canvas -->
                <Grid Grid.Column="1" Background="{Binding WindowBackgroundBrush}">
                    <nodify:NodifyEditor x:Name="EditorCanvas"
                                         ItemsSource="{Binding Nodes}"
                                         SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                         SelectedConnection="{Binding SelectedConnection, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource ItemContainerStyle}"
                                         Connections="{Binding Connections}"
                                         PendingConnection="{Binding PendingConnection}"
                                         DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                         ItemsDragCompletedCommand="{Binding NodesDraggedCommand}"
                                         Background="{Binding WindowBackgroundBrush}">
                        <nodify:NodifyEditor.PendingConnectionTemplate>
                            <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                                <nodify:PendingConnection StartedCommand="{Binding StartedCommand}"
                                                          CompletedCommand="{Binding CompletedCommand}"
                                                          Source="{Binding Source, Mode=TwoWay}"
                                                          Target="{Binding Target, Mode=TwoWay}"
                                                          TargetAnchor="{Binding TargetLocation}"
                                                          IsVisible="{Binding IsVisible, Mode=TwoWay}"
                                                          Stroke="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          StrokeThickness="2.5" />
                            </DataTemplate>
                        </nodify:NodifyEditor.PendingConnectionTemplate>
                        <nodify:NodifyEditor.ConnectionTemplate>
                            <DataTemplate DataType="{x:Type vm:StepConnectionViewModel}">
                                <nodify:Connection Source="{Binding Source.Anchor}"
                                                   Target="{Binding Target.Anchor}"
                                                   SourceOrientation="Vertical"
                                                   TargetOrientation="Vertical"
                                                   Spacing="0"
                                                   ArrowEnds="End"
                                                   ArrowSize="10 10"
                                                   PreviewMouseLeftButtonDown="OnConnectionPreviewMouseLeftButtonDown"
                                                   Cursor="Hand"
                                                   Text="{Binding Label}"
                                                   TextBackground="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="{wpf:FontSize 10}"
                                                   FontWeight="Bold"
                                                   DisconnectCommand="{Binding DisconnectCommand}"
                                                   ToolTip="{wpf:Text RecipeEditor.TipConnection}">
                                    <nodify:Connection.Style>
                                        <Style TargetType="{x:Type nodify:Connection}">
                                            <Setter Property="Stroke" Value="{Binding IsCycle, Converter={StaticResource StepColorConv}, ConverterParameter=cycle}"/>
                                            <Setter Property="StrokeThickness" Value="2.5"/>
                                            <Setter Property="OutlineThickness" Value="5"/>
                                            <Setter Property="OutlineBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Setter Property="StrokeThickness" Value="3"/>
                                                    <Setter Property="OutlineThickness" Value="4"/>
                                                    <Setter Property="OutlineBrush" Value="#4400D2FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </nodify:Connection.Style>
                                    <nodify:Connection.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{wpf:Text RecipeEditor.DeleteConnection}" Command="{Binding DisconnectCommand}"/>
                                        </ContextMenu>
                                    </nodify:Connection.ContextMenu>
                                </nodify:Connection>
                            </DataTemplate>
                        </nodify:NodifyEditor.ConnectionTemplate>
                    </nodify:NodifyEditor>


                    <!-- In-Canvas JSON Editor Overlay -->
                    <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Margin="30" Padding="15"
                            Visibility="{Binding IsJsonViewVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{wpf:Text RecipeEditor.RecipeJson}" FontWeight="Bold" FontSize="{wpf:FontSize 14}" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.RecipeJson}" Grid.Row="1" Text="{Binding RawJsonText, Mode=TwoWay}"
                                     FontFamily="Consolas" FontSize="{wpf:FontSize 12}"
                                     Background="{Binding WindowBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="{wpf:Text RecipeEditor.BtnApplyChanges}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApplyJsonCommand}"/>
                                <Button Content="{wpf:Text Core.AccessibleClose}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleJsonViewCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- In-Canvas Mermaid Editor Overlay -->
                    <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Margin="30" Padding="15"
                            Visibility="{Binding IsMermaidViewVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{wpf:Text RecipeEditor.MermaidDsl}" FontWeight="Bold" FontSize="{wpf:FontSize 14}" Foreground="{Binding TextPrimaryBrush}"/>
                                    <TextBlock Text="{wpf:Text RecipeEditor.HintMermaid}"
                                               FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.MermaidDsl}" Grid.Row="1" Text="{Binding MermaidText, Mode=OneWay}"
                                     FontFamily="Consolas" FontSize="{wpf:FontSize 12}"
                                     Background="{Binding WindowBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="{wpf:Text RecipeEditor.BtnCopyMermaid}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CopyMermaidCommand}" Margin="0,0,8,0"/>
                                <Button Content="{wpf:Text Core.AccessibleClose}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ToggleMermaidViewCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Sidebar: Properties & Step Inspector / Recipe & Triggers Tabs -->
                <Border Grid.Column="2" Background="{Binding WindowBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1,0,0,0">
                    <TabControl SelectedIndex="{Binding SelectedInspectorTabIndex, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Margin="4,4,4,4">
                        <!-- Tab 1: Step Inspector -->
                        <TabItem Header="{wpf:Text RecipeEditor.TabStepInspector}" Style="{StaticResource InspectorTabItem}">
                            <ScrollViewer Style="{DynamicResource ThemedScrollViewer}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="6,8,6,8">
                                <StackPanel>
                                    <!-- When a connection is selected -->
                                    <StackPanel Visibility="{Binding HasSelectedConnection, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{wpf:Text RecipeEditor.HeaderConnectionSelected}" FontWeight="Bold" FontSize="{wpf:FontSize 11}" Foreground="{Binding AccentBrush}" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding BadgeBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                        <StackPanel>
                                                            <TextBlock Text="{wpf:Text RecipeEditor.ConnectionFrom}" FontSize="{wpf:FontSize 9}" FontWeight="Bold" Foreground="{Binding TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SelectedConnection.SourceNode.DisplayName}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SelectedConnection.Source.Title}" FontSize="{wpf:FontSize 10}" Foreground="{Binding AccentBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="➔" FontSize="{wpf:FontSize 14}" FontWeight="Bold" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0"/>
                                                    <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                        <StackPanel>
                                                            <TextBlock Text="{wpf:Text RecipeEditor.ConnectionTo}" FontSize="{wpf:FontSize 9}" FontWeight="Bold" Foreground="{Binding TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding SelectedConnection.TargetNode.DisplayName}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SelectedConnection.Target.Title}" FontSize="{wpf:FontSize 10}" Foreground="{Binding AccentBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Button Content="{wpf:Text RecipeEditor.DeleteConnection}" Style="{StaticResource LightErrorButtonStyle}"
                                                        Command="{Binding SelectedConnection.DisconnectCommand}"
                                                        ToolTip="{wpf:Text RecipeEditor.TipDeleteConnection}"/>
                                                <TextBlock Text="{wpf:Text RecipeEditor.HintDeleteConnection}" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- When a node is selected -->
                                    <StackPanel Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVis}}">
                                        <!-- Start Step Status / Toggle -->
                                        <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.FlowEntryPoint}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextPrimaryBrush}"/>
                                                        <TextBlock Text="{wpf:Text RecipeEditor.HintFlowEntryPoint}" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.BadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                            BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.SuccessBrush}" BorderThickness="1"
                                                            Visibility="{Binding SelectedNode.IsStartNode, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.BadgeStartStep}" FontWeight="Bold" FontSize="{wpf:FontSize 10}" Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.SuccessBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Content="{wpf:Text RecipeEditor.BtnMarkStart}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                                            Command="{Binding SelectedNode.ToggleStartNodeCommand}"
                                                            Visibility="{Binding SelectedNode.IsStartNode, Converter={StaticResource InvertBoolToVis}}"
                                                            ToolTip="{wpf:Text RecipeEditor.TipMarkStart}"/>
                                                    <Button Content="{wpf:Text RecipeEditor.BtnRemoveStart}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                                            Command="{Binding SelectedNode.ToggleStartNodeCommand}"
                                                            Visibility="{Binding SelectedNode.IsStartNode, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="{wpf:Text RecipeEditor.TipRemoveStart}"/>
                                                    <Button Content="{wpf:Text RecipeEditor.DeleteStep}" Style="{StaticResource LightErrorButtonStyle}"
                                                            Command="{Binding DeleteSelectedCommand}"
                                                            ToolTip="{wpf:Text RecipeEditor.TipDeleteStep}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Node Metadata -->
                                        <TextBlock Text="{wpf:Text RecipeEditor.NodeId}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.NodeId}" Text="{Binding SelectedNode.Id, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                 Padding="6,4" Margin="0,2,0,8" ToolTip="{wpf:Text RecipeEditor.TipNodeId}"/>

                                        <TextBlock Text="{wpf:Text RecipeEditor.StepType}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.StepType}" Text="{Binding SelectedNode.StepType, Mode=OneWay}" IsReadOnly="True"
                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextSecondaryBrush}"
                                                 Padding="6,4" Margin="0,2,0,8"/>

                                        <TextBlock Text="{wpf:Text RecipeEditor.DisplayName}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.DisplayName}" Text="{Binding SelectedNode.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                 Padding="6,4" Margin="0,2,0,12"/>

                                        <Separator Background="{Binding CardBorderBrush}" Margin="0,4,0,12"/>
                                        <TextBlock Text="{wpf:Text RecipeEditor.HeaderStepParameters}" FontWeight="Bold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,8"/>

                                        <!-- 1. Source Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Source}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.SourceType}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.SourceType}" SelectedValue="{Binding SelectedNode.SourceType, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceRegion}" Tag="Region"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceWindow}" Tag="Window"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceActiveWindow}" Tag="ActiveWindow"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceFullscreen}" Tag="FullScreen"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceLastRegion}" Tag="LastRegion"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceClipboard}" Tag="Clipboard"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceFile}" Tag="File"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceTextOcr}" Tag="TextOcr"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceCurrentEditor}" Tag="CurrentEditor"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SourceBrowserExtension}" Tag="Extension"/>
                                            </ComboBox>

                                            <StackPanel Visibility="{Binding SelectedNode.IsFileSource, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.SourceFilePath}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.SourceFilePath}" Text="{Binding SelectedNode.SourceFilename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding SelectedNode.IsWindowSource, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.WindowTitlePattern}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.WindowTitlePattern}" Text="{Binding SelectedNode.WindowTitlePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{wpf:Text RecipeEditor.ProcessName}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ProcessName}" Text="{Binding SelectedNode.ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="{wpf:Text RecipeEditor.MatchCase}" IsChecked="{Binding SelectedNode.WindowMatchCase, Mode=TwoWay}"
                                                          Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <TextBlock Text="{wpf:Text RecipeEditor.CaptureMouseCursor}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.CaptureMouseCursor}" SelectedValue="{Binding SelectedNode.CaptureMouseCursorMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.OutputFormatFromConfiguration}" Tag=""/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.AlwaysTrue}" Tag="true"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.AlwaysFalse}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.ScreenCaptureMode}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.ScreenCaptureMode}" SelectedValue="{Binding SelectedNode.ScreenCaptureMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.OutputFormatFromConfiguration}" Tag=""/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.ScreenAuto}" Tag="Auto"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.ScreenAll}" Tag="FullScreen"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.ScreenFixed}" Tag="Fixed"/>
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.AlignDpi}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.AlignDpi}" SelectedValue="{Binding SelectedNode.AlignDpiMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.OutputFormatFromConfiguration}" Tag=""/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.AlignDpiEnabled}" Tag="true"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.Disabled}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.DelayMs}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.DelayMs}" Text="{Binding SelectedNode.DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 2. InteractiveSelection Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=InteractiveSelection}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.SelectionMode}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.SelectionMode}" SelectedValue="{Binding SelectedNode.SelectionMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SelectionRegion}" Tag="Region"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SelectionWindow}" Tag="Window"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SelectionText}" Tag="Text"/>
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.WindowSnapping}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.WindowSnapping}" SelectedValue="{Binding SelectedNode.AllowWindowSnappingMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.OutputFormatFromConfiguration}" Tag=""/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.WindowSnappingEnabled}" Tag="true"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.Disabled}" Tag="false"/>
                                            </ComboBox>
                                        </StackPanel>
 
                                        <!-- RecordVideo Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=RecordVideo}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.SourceTargetType}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.SourceTargetType}" SelectedValue="{Binding SelectedNode.VideoSourceType, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.TargetActiveWindow}" Tag="ActiveWindow"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.TargetWindow}" Tag="Window"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.TargetMonitor}" Tag="Monitor"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.TargetRegion}" Tag="Region"/>
                                            </ComboBox>

                                            <!-- Window targeting options -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsVideoWindowSource, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.WindowTitlePattern}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.WindowTitlePattern}" Text="{Binding SelectedNode.WindowTitlePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{wpf:Text RecipeEditor.ProcessNameExample}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ProcessNameExample}" Text="{Binding SelectedNode.ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="{wpf:Text RecipeEditor.RecordUntilWindowCloses}" IsChecked="{Binding SelectedNode.VideoUntilWindowCloses, Mode=TwoWay}"
                                                          Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- Region targeting options -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsVideoRegionSource, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.RegionX}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.RegionX}" Text="{Binding SelectedNode.VideoRegionX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.RegionY}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.RegionY}" Text="{Binding SelectedNode.VideoRegionY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.RegionWidth}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.RegionWidth}" Text="{Binding SelectedNode.VideoRegionWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.RegionHeight}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.RegionHeight}" Text="{Binding SelectedNode.VideoRegionHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Monitor targeting options -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsVideoMonitorSource, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.MonitorIndex}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.MonitorIndex}" Text="{Binding SelectedNode.VideoMonitorIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- Timing & Duration -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.Duration}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Duration}" Text="{Binding SelectedNode.VideoDurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.CountdownDelayMs}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CountdownDelayMs}" Text="{Binding SelectedNode.DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Output Path -->
                                            <TextBlock Text="{wpf:Text RecipeEditor.SaveDirectory}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.SaveDirectory}" Text="{Binding SelectedNode.VideoOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.FilenamePattern}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.FilenamePattern}" Text="{Binding SelectedNode.VideoFilenamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <!-- Encoding Preset & Format -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.Preset}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.Preset}" SelectedValue="{Binding SelectedNode.VideoPreset, Mode=TwoWay}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PresetBalanced}" Tag="Balanced"/>
                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PresetSmall}" Tag="SmallSize"/>
                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PresetHighQuality}" Tag="HighQuality"/>
                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PresetGaming}" Tag="HighFrameRateGaming"/>
                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PresetCustom}" Tag="Custom"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.FormatCodec}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.FormatCodec}" SelectedValue="{Binding SelectedNode.VideoFormat, Mode=TwoWay}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="MP4 (H.264 / AVC)" Tag="Mp4_H264"/>
                                                        <ComboBoxItem Content="MP4 (HEVC / H.265)" Tag="Mp4_Hevc"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Framerate & Bitrate -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.FrameRate}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.FrameRate}" Text="{Binding SelectedNode.VideoFrameRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.Bitrate}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Bitrate}" Text="{Binding SelectedNode.VideoBitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Dimensions & Scaling -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.VideoWidth}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.VideoWidth}" Text="{Binding SelectedNode.VideoTargetWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.VideoHeight}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.VideoHeight}" Text="{Binding SelectedNode.VideoTargetHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.ScaleFactor}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ScaleFactor}" Text="{Binding SelectedNode.VideoScaleFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas" Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Audio Source -->
                                            <TextBlock Text="{wpf:Text RecipeEditor.AudioSource}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.AudioSource}" SelectedValue="{Binding SelectedNode.VideoAudioSource, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.AudioNone}" Tag="None"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.AudioMicrophone}" Tag="Microphone"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.AudioSystem}" Tag="SystemAudioLoopback"/>
                                            </ComboBox>

                                            <!-- Canvas & Appearance -->
                                            <TextBlock Text="{wpf:Text RecipeEditor.WindowResizeBehavior}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.WindowResizeBehavior}" SelectedValue="{Binding SelectedNode.VideoResizeBehavior, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.ResizeLetterbox}" Tag="LetterboxFixedCanvas"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.ResizeCrop}" Tag="CropToCanvas"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.ResizeScale}" Tag="ScaleContent"/>
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.ColorMode}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.ColorMode}" SelectedValue="{Binding SelectedNode.VideoColorMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.ColorFull32bit}" Tag="FullColor"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.ColorGrayscaleMono}" Tag="Grayscale"/>
                                            </ComboBox>

                                            <CheckBox Content="{wpf:Text RecipeEditor.CaptureMouseCursor}" IsChecked="{Binding SelectedNode.VideoCaptureCursor, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,6"/>

                                            <CheckBox Content="{wpf:Text RecipeEditor.ShowWgcBorder}" IsChecked="{Binding SelectedNode.VideoShowCaptureBorder, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,6"/>

                                            <CheckBox Content="{wpf:Text RecipeEditor.PreventSleep}" IsChecked="{Binding SelectedNode.VideoPreventSleep, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,6"/>

                                            <CheckBox Content="{wpf:Text RecipeEditor.AutoPauseLocked}" IsChecked="{Binding SelectedNode.VideoAutoPauseOnLock, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 4. Effect Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Effect}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.EffectType}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.EffectType}" SelectedValue="{Binding SelectedNode.EffectType, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.EffectBorder}" Tag="Border"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.EffectDropShadow}" Tag="DropShadow"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.EffectTornEdge}" Tag="TornEdge"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SummaryInvert}" Tag="Invert"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SummaryGrayscale}" Tag="Grayscale"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.EffectMonochrome}" Tag="Monochrome"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.EffectAdjust}" Tag="Adjust"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.EffectRotate}" Tag="Rotate"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.EffectResizeImage}" Tag="Resize"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.EffectResizeCanvas}" Tag="ResizeCanvas"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.EffectReduceColors}" Tag="ReduceColors"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SummaryRemoveTransparency}" Tag="RemoveTransparency"/>
                                            </ComboBox>

                                            <!-- 4a. Border Effect -->
                                             <StackPanel Visibility="{Binding SelectedNode.IsBorderEffect, Converter={StaticResource BoolToVis}}">
                                                 <TextBlock Text="{wpf:Text RecipeEditor.BorderWidth}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                 <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.BorderWidth}" Text="{Binding SelectedNode.EffectBorderWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                          Padding="6,4" Margin="0,0,0,8"/>

                                                 <TextBlock Text="{wpf:Text RecipeEditor.BorderColor}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                 <Grid Margin="0,0,0,8">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="26"/>
                                                         <ColumnDefinition Width="6"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <Button Style="{StaticResource ColorSwatchButtonStyle}" Grid.Column="0" Width="26" Height="26"
                                                             BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                             Background="{Binding SelectedNode.EffectBorderColor, Converter={StaticResource StringToBrushConv}}" ToolTip="{wpf:Text RecipeEditor.ClickPickColor}"
                                                             Command="{Binding SelectedNode.PickBorderColorCommand}" AutomationProperties.Name="{wpf:Text RecipeEditor.PickColor}"/>
                                                     <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.BorderColor}" Grid.Column="2" Text="{Binding SelectedNode.EffectBorderColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                              VerticalContentAlignment="Center" Padding="6,4"/>
                                                 </Grid>
                                             </StackPanel>

                                            <!-- 4b. DropShadow Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsDropShadowEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.ShadowSize}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ShadowSize}" Text="{Binding SelectedNode.ShadowSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{wpf:Text RecipeEditor.ShadowDarkness}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ShadowDarkness}" Text="{Binding SelectedNode.ShadowDarkness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.OffsetXPx}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OffsetXPx}" Text="{Binding SelectedNode.ShadowOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.OffsetYPx}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OffsetYPx}" Text="{Binding SelectedNode.ShadowOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4c. TornEdge Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsTornEdgeEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.ToothHeight}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ToothHeight}" Text="{Binding SelectedNode.ToothHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.HToothRange}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.HToothRange}" Text="{Binding SelectedNode.HorizontalToothRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.VToothRange}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.VToothRange}" Text="{Binding SelectedNode.VerticalToothRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{wpf:Text RecipeEditor.ActiveEdges}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ActiveEdges}" Text="{Binding SelectedNode.TornEdges, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="{wpf:Text RecipeEditor.GenerateDropShadow}" IsChecked="{Binding SelectedNode.TornEdgeShadow, Mode=TwoWay}"
                                                          Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4d. Monochrome Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsMonochromeEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.BwThreshold}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.BwThreshold}" Text="{Binding SelectedNode.MonochromeThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4e. Adjust Colors Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsAdjustEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.Brightness}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Brightness}" Text="{Binding SelectedNode.AdjustBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{wpf:Text RecipeEditor.Contrast}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Contrast}" Text="{Binding SelectedNode.AdjustContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{wpf:Text RecipeEditor.Gamma}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Gamma}" Text="{Binding SelectedNode.AdjustGamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4f. Rotate Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsRotateEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.RotationAngle}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.RotationAngle}" Text="{Binding SelectedNode.RotateAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4g. Resize Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsResizeEffect, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.TargetWidth}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.TargetWidth}" Text="{Binding SelectedNode.ResizeWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.TargetHeight}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.TargetHeight}" Text="{Binding SelectedNode.ResizeHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{wpf:Text RecipeEditor.ScalePercentage}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ScalePercentage}" Text="{Binding SelectedNode.ResizePercentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="{wpf:Text RecipeEditor.MaintainAspectRatio}" IsChecked="{Binding SelectedNode.ResizeMaintainAspectRatio, Mode=TwoWay}"
                                                          Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4h. Resize Canvas / Padding Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsResizeCanvasEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.CanvasLeft}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CanvasLeft}" Text="{Binding SelectedNode.CanvasLeft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                                <TextBlock Text="{wpf:Text RecipeEditor.CanvasTop}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CanvasTop}" Text="{Binding SelectedNode.CanvasTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                                <TextBlock Text="{wpf:Text RecipeEditor.CanvasRight}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CanvasRight}" Text="{Binding SelectedNode.CanvasRight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                                <TextBlock Text="{wpf:Text RecipeEditor.CanvasBottom}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CanvasBottom}" Text="{Binding SelectedNode.CanvasBottom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{wpf:Text RecipeEditor.BackgroundColor}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4"
                                                            BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                            Background="{Binding SelectedNode.CanvasBackgroundColor, Converter={StaticResource StringToBrushConv}}"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.BackgroundColor}" Grid.Column="2" Text="{Binding SelectedNode.CanvasBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                             VerticalContentAlignment="Center" Padding="6,4"/>
                                                    <Button AutomationProperties.Name="{wpf:Text RecipeEditor.PickColor}" Grid.Column="4" Content="🎨" Style="{StaticResource SecondaryButtonStyle}" Margin="0" Height="26"
                                                            Command="{Binding SelectedNode.PickCanvasBackgroundColorCommand}" ToolTip="{wpf:Text RecipeEditor.ClickPickColor}"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4i. Reduce Colors Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsReduceColorsEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.TargetColors}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.TargetColors}" Text="{Binding SelectedNode.ReduceColorsCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4j. Remove Transparency Effect -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsRemoveTransparencyEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.MatteColor}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource ColorSwatchButtonStyle}" Grid.Column="0" Width="26" Height="26"
                                                            BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                            Background="{Binding SelectedNode.TransparencyBackgroundColor, Converter={StaticResource StringToBrushConv}}" ToolTip="{wpf:Text RecipeEditor.ClickPickColor}"
                                                            Command="{Binding SelectedNode.PickTransparencyBackgroundColorCommand}" AutomationProperties.Name="{wpf:Text RecipeEditor.PickColor}"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.MatteColor}" Grid.Column="2" Text="{Binding SelectedNode.TransparencyBackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                             VerticalContentAlignment="Center" Padding="6,4"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4k. Invert / Grayscale Info -->
                                            <StackPanel Visibility="{Binding SelectedNode.IsInvertEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.HintInvert}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding SelectedNode.IsGrayscaleEffect, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{wpf:Text RecipeEditor.HintGrayscale}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 5. TextEffect / DLP Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=TextEffect}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.DlpAction}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.DlpAction}" SelectedValue="{Binding SelectedNode.TextEffectAction, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.DlpRedact}" Tag="Redact"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.DlpPixelize}" Tag="Pixelize"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.DlpBlur}" Tag="Blur"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.DlpHighlight}" Tag="Highlight"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.DlpMagnify}" Tag="Magnify"/>
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.PatternsRegex}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.PatternsRegex}" Text="{Binding SelectedNode.TextEffectPatterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="44" VerticalScrollBarVisibility="Auto"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{wpf:Text RecipeEditor.FillColor}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Grid.Column="0" Width="26" Height="26"
                                                        BorderBrush="{Binding CardBorderBrush}" BorderThickness="1"
                                                        Background="{Binding SelectedNode.TextEffectFillColor, Converter={StaticResource StringToBrushConv}}" ToolTip="{wpf:Text RecipeEditor.ClickPickColor}"
                                                        Command="{Binding SelectedNode.PickTextEffectColorCommand}" AutomationProperties.Name="{wpf:Text RecipeEditor.PickColor}"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.FillColor}" Grid.Column="2" Text="{Binding SelectedNode.TextEffectFillColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         VerticalContentAlignment="Center" Padding="6,4"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 7. SetVariable Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=SetVariable}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{wpf:Text RecipeEditor.Variables}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{wpf:Text RecipeEditor.BtnAddVariable}" Style="{StaticResource PrimaryButtonStyle}" Padding="6,2" Command="{Binding SelectedNode.AddVariableCommand}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.Variables}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.VariableKey}" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Padding="4,2"/>
                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.VariableValue}" Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Padding="4,2"/>
                                                                <Button AutomationProperties.Name="{wpf:Text RecipeEditor.DeleteVariable}" Grid.Column="3" Content="✕"
                                                                        Style="{StaticResource LightErrorButtonStyle}"
                                                                        Command="{Binding RemoveCommand}" ToolTip="{wpf:Text RecipeEditor.DeleteVariable}" Margin="4,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{wpf:Text RecipeEditor.HintVariableScopes}"
                                                       FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        </StackPanel>

                                        <!-- 8. Annotation Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Annotation}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{wpf:Text RecipeEditor.Annotations}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.AnnotationTypeToAdd}" x:Name="AnnotationTypeSelector" Width="95" Height="24" Margin="0,0,4,0" SelectedIndex="0">
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeArrow}" Tag="Arrow"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeBarcode}" Tag="Barcode"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeBlur}" Tag="Blur"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeCursor}" Tag="Cursor"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeEllipse}" Tag="Ellipse"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeEmoji}" Tag="Emoji"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeHighlight}" Tag="Highlight"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeImage}" Tag="Image"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeLine}" Tag="Line"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeMagnify}" Tag="Magnify"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypePixelize}" Tag="Pixelize"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeQrCode}" Tag="QRCode"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeRectangle}" Tag="Rectangle"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeSpeechBubble}" Tag="Speechbubble"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeStepLabel}" Tag="StepLabel"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeText}" Tag="Text"/>
                                                        </ComboBox>
                                                        <Button Content="{wpf:Text RecipeEditor.BtnAddAnnotation}" Style="{StaticResource PrimaryButtonStyle}" Padding="6,2"
                                                                Command="{Binding SelectedNode.AddAnnotationCommand}"
                                                                CommandParameter="{Binding SelectedItem.Tag, ElementName=AnnotationTypeSelector}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Template / Import Row -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,2">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.Template}" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Button Content="{wpf:Text RecipeEditor.BtnFromEditor}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" Margin="0,0,4,0"
                                                            Command="{Binding SelectedNode.ImportFromEditorCommand}" ToolTip="{wpf:Text RecipeEditor.TipFromEditor}"/>
                                                    <Button Content="{wpf:Text RecipeEditor.BtnFromFile}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" Margin="0"
                                                            Command="{Binding SelectedNode.ImportFromGreenshotFileCommand}" ToolTip="{wpf:Text RecipeEditor.TipFromFile}"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.Annotations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <!-- Header: Type Picker & Delete -->
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.AnnotationType}" Grid.Column="0" SelectedValue="{Binding Type, Mode=TwoWay}" SelectedValuePath="Tag" Width="110" HorizontalAlignment="Left">
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeArrow}" Tag="Arrow"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeBarcode}" Tag="Barcode"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeBlur}" Tag="Blur"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeCursor}" Tag="Cursor"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeEllipse}" Tag="Ellipse"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeEmoji}" Tag="Emoji"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeHighlight}" Tag="Highlight"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeImage}" Tag="Image"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeLine}" Tag="Line"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeMagnify}" Tag="Magnify"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypePixelize}" Tag="Pixelize"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeQrCode}" Tag="QRCode"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeRectangle}" Tag="Rectangle"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeSpeechBubble}" Tag="Speechbubble"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeStepLabel}" Tag="StepLabel"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.AnnotationTypeText}" Tag="Text"/>
                                                                    </ComboBox>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SourceSummaryBadge}"
                                                                               FontSize="{wpf:FontSize 10}" FontWeight="SemiBold"
                                                                               Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                    <Button AutomationProperties.Name="{wpf:Text RecipeEditor.DeleteAnnotation}" Grid.Column="2" Content="✕"
                                                                            Style="{StaticResource LightErrorButtonStyle}"
                                                                            Command="{Binding RemoveCommand}" ToolTip="{wpf:Text RecipeEditor.DeleteAnnotation}"/>
                                                                </Grid>

                                                                <!-- Text Field (for Text, Speechbubble) -->
                                                                <StackPanel Visibility="{Binding IsTextType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{wpf:Text RecipeEditor.AnnotationContent}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.AnnotationContent}" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- Step Label Counter / Number -->
                                                                <StackPanel Visibility="{Binding IsStepLabelType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{wpf:Text RecipeEditor.StepNumber}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.StepNumber}" Text="{Binding StepNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- QR / Barcode Payload / Text -->
                                                                <StackPanel Visibility="{Binding IsQrCodeType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{wpf:Text RecipeEditor.PayloadText}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.PayloadText}" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- Custom / Extension Drawable Configuration Panel -->
                                                                <Border Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVis}}" 
                                                                        Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2,0,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{wpf:Text RecipeEditor.PluginConfiguration}" FontSize="{wpf:FontSize 10}" FontWeight="SemiBold"
                                                                                       Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <TextBlock Text="{Binding ConfigurationSummary}" FontSize="{wpf:FontSize 11}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Content="{wpf:Text RecipeEditor.BtnConfigure}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Margin="6,0,0,0"
                                                                                Command="{Binding ConfigureCommand}" ToolTip="{wpf:Text RecipeEditor.TipConfigure}"
                                                                                VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Font Settings (for Text, Speechbubble) -->
                                                                <StackPanel Visibility="{Binding HasFontSettings, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{wpf:Text RecipeEditor.FontTextStyle}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <Grid Margin="0,2,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="4"/>
                                                                            <ColumnDefinition Width="46"/>
                                                                            <ColumnDefinition Width="4"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="2"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="4"/>
                                                                            <ColumnDefinition Width="68"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.FontFamily}" Grid.Column="0" ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding FontFamily, Mode=TwoWay}"
                                                                                  IsEditable="True" Height="24" FontSize="{wpf:FontSize 11}" ToolTip="{wpf:Text RecipeEditor.FontFamily}"/>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.FontSize}" Grid.Column="2" Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontFamily="Consolas" FontSize="{wpf:FontSize 11}" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 ToolTip="{wpf:Text RecipeEditor.FontSize}"/>
                                                                        <ToggleButton AutomationProperties.Name="{wpf:Text Editor.Bold}" Grid.Column="4" Width="24" Height="24" Content="B" FontWeight="Bold" FontSize="{wpf:FontSize 11}"
                                                                                      IsChecked="{Binding FontBold, Mode=TwoWay}" ToolTip="{wpf:Text Editor.Bold}"/>
                                                                        <ToggleButton AutomationProperties.Name="{wpf:Text Editor.Italic}" Grid.Column="6" Width="24" Height="24" Content="I" FontStyle="Italic" FontSize="{wpf:FontSize 11}"
                                                                                      IsChecked="{Binding FontItalic, Mode=TwoWay}" ToolTip="{wpf:Text Editor.Italic}"/>
                                                                        <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.TextAlignment}" Grid.Column="8" ItemsSource="{Binding AvailableTextAlignments}" SelectedItem="{Binding TextAlignment, Mode=TwoWay}"
                                                                                  Height="24" FontSize="{wpf:FontSize 11}" ToolTip="{wpf:Text RecipeEditor.TextAlignment}"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Arrow Heads (for Arrow) -->
                                                                <StackPanel Visibility="{Binding IsArrowType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{wpf:Text Editor.Arrowheads}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <ComboBox AutomationProperties.Name="{wpf:Text Editor.Arrowheads}" ItemsSource="{Binding AvailableArrowHeads}" SelectedItem="{Binding ArrowHeads, Mode=TwoWay}"
                                                                              Height="24" FontSize="{wpf:FontSize 11}" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Speechbubble Tail Controls -->
                                                                <StackPanel Visibility="{Binding IsSpeechbubbleType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{wpf:Text RecipeEditor.TailDirection}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.TailDirection}" SelectedValue="{Binding TailDirection, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,4">
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionBottomLeftDefault}" Tag="BottomLeft"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionBottomRight}" Tag="BottomRight"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionBottomCenter}" Tag="BottomCenter"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionTopLeft}" Tag="TopLeft"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionTopRight}" Tag="TopRight"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionTopCenter}" Tag="TopCenter"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionLeft}" Tag="Left"/>
                                                                        <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionRight}" Tag="Right"/>
                                                                    </ComboBox>
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="{wpf:Text RecipeEditor.TailOffsetX}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.TailOffsetX}" Text="{Binding TailOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                            <TextBlock Text="{wpf:Text RecipeEditor.TailOffsetY}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.TailOffsetY}" Text="{Binding TailOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Emoji Field with Picker -->
                                                                <StackPanel Visibility="{Binding IsEmojiType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{wpf:Text RecipeEditor.EmojiIcon}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <Grid Margin="0,2,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                BorderThickness="1" CornerRadius="3"
                                                                                Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                Padding="2" VerticalAlignment="Center">
                                                                            <emoji:EmojiPicker AutomationProperties.Name="{wpf:Text RecipeEditor.PickEmoji}" Selection="{Binding Emoji, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.EmojiIcon}" Grid.Column="2" Text="{Binding Emoji, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontSize="{wpf:FontSize 13}" VerticalContentAlignment="Center"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Padding="4,2"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Obfuscate Settings (Blur / Pixelize) -->
                                                                <StackPanel Visibility="{Binding IsBlurType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{wpf:Text RecipeEditor.BlurRadius}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.BlurRadius}" Text="{Binding BlurRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding IsPixelizeType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{wpf:Text RecipeEditor.PixelSize}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.PixelSize}" Text="{Binding PixelSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Magnification Factor (Magnify) -->
                                                                <StackPanel Visibility="{Binding IsMagnifyType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{wpf:Text RecipeEditor.Magnification}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Magnification}" Text="{Binding MagnificationFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Padding="4,2" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Image Controls -->
                                                                <StackPanel Visibility="{Binding IsImageType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.AnnotationImageSource}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <RadioButton Content="{wpf:Text RecipeEditor.EmbedBase64}" IsChecked="{Binding IsEmbedMode, Mode=TwoWay}" FontSize="{wpf:FontSize 10}" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="{wpf:Text RecipeEditor.LinkFile}" IsChecked="{Binding IsLinkMode, Mode=TwoWay}" FontSize="{wpf:FontSize 10}"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,1,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ImageFile}" Grid.Column="0" Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Padding="4,2"/>
                                                                        <Button Grid.Column="2" Content="{wpf:Text RecipeEditor.ImportBtnBrowse}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2"
                                                                                Command="{Binding BrowseFileCommand}"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Cursor Controls -->
                                                                <StackPanel Visibility="{Binding IsCursorType, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.CursorSource}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <RadioButton Content="{wpf:Text RecipeEditor.Preset}" IsChecked="{Binding IsCursorPresetMode, Mode=TwoWay}" FontSize="{wpf:FontSize 10}" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="{wpf:Text RecipeEditor.EmbedBase64}" IsChecked="{Binding IsCursorEmbedMode, Mode=TwoWay}" FontSize="{wpf:FontSize 10}" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="{wpf:Text RecipeEditor.LinkFile}" IsChecked="{Binding IsCursorLinkMode, Mode=TwoWay}" FontSize="{wpf:FontSize 10}"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Preset Mode -->
                                                                    <StackPanel Visibility="{Binding IsCursorPresetMode, Converter={StaticResource BoolToVis}}" Margin="0,1,0,3">
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.CursorPreset}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.CursorPreset}" ItemsSource="{Binding AvailableCursors}" SelectedItem="{Binding CursorName, Mode=TwoWay}"
                                                                                  Height="24" Margin="0,2,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- Embed Mode (Base64) -->
                                                                    <StackPanel Visibility="{Binding IsCursorEmbedMode, Converter={StaticResource BoolToVis}}" Margin="0,1,0,3">
                                                                        <Border Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="{wpf:Text RecipeEditor.EmbeddedCursor}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                                    <TextBlock Text="{wpf:Text RecipeEditor.HintEmbeddedCursor}" FontSize="{wpf:FontSize 9}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                                </StackPanel>
                                                                                <Button Grid.Column="1" Content="{wpf:Text RecipeEditor.BtnLoadFile}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2" Margin="4,0,0,0"
                                                                                        Command="{Binding BrowseFileCommand}" ToolTip="{wpf:Text RecipeEditor.TipLoadFile}"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <!-- Link File Mode -->
                                                                    <Grid Visibility="{Binding IsCursorLinkMode, Converter={StaticResource BoolToVis}}" Margin="0,1,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CursorFile}" Grid.Column="0" Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Padding="4,2"/>
                                                                        <Button Grid.Column="2" Content="{wpf:Text RecipeEditor.ImportBtnBrowse}" Style="{StaticResource SecondaryButtonStyle}" Padding="6,2"
                                                                                Command="{Binding BrowseFileCommand}"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Anchors: H-Anchor & V-Anchor -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.HAnchor}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.HAnchor}" SelectedValue="{Binding HorizontalAnchor, Mode=TwoWay}" SelectedValuePath="Tag">
                                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnchorNone}" Tag="None"/>
                                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionLeft}" Tag="Left"/>
                                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionCenter}" Tag="Center"/>
                                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionRight}" Tag="Right"/>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.VAnchor}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.VAnchor}" SelectedValue="{Binding VerticalAnchor, Mode=TwoWay}" SelectedValuePath="Tag">
                                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.AnchorNone}" Tag="None"/>
                                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionTop}" Tag="Top"/>
                                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionCenter}" Tag="Center"/>
                                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.PositionBottom}" Tag="Bottom"/>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Width & Height -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.Width}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Width}" Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.Height}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Height}" Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                    </StackPanel>
                                                                    <CheckBox Grid.Column="3" Content="{wpf:Text RecipeEditor.LockRatio}" IsChecked="{Binding LockAspectRatio, Mode=TwoWay}"
                                                                              ToolTip="{wpf:Text RecipeEditor.TipLockRatio}"
                                                                              FontSize="{wpf:FontSize 10}" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                                                                </Grid>

                                                                <!-- Offset X & Offset Y -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.OffsetXLeft}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OffsetXLeft}" Text="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.OffsetYTop}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OffsetYTop}" Text="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Padding="4,2"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Line Thickness & Shadow -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Visibility="{Binding HasLineThickness, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{wpf:Text RecipeEditor.LineThickness}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.LineThickness}" Text="{Binding LineThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Padding="4,2" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <CheckBox Grid.Column="1" Content="{wpf:Text RecipeEditor.Shadow}" IsChecked="{Binding Shadow, Mode=TwoWay}"
                                                                              Visibility="{Binding HasShadow, Converter={StaticResource BoolToVis}}"
                                                                              ToolTip="{wpf:Text RecipeEditor.TipShadow}"
                                                                              FontSize="{wpf:FontSize 10}" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                                                                </Grid>

                                                                <!-- Standard Colors (Fill & Line Color) -->
                                                                <Grid Visibility="{Binding HasAnyStandardColor, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Visibility="{Binding HasFillColor, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding FillColorLabel}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <Grid Margin="0,2,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="20"/>
                                                                                <ColumnDefinition Width="4"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Grid.Column="0" Width="20" Height="20"
                                                                                    BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1"
                                                                                    Background="{Binding FillColor, Converter={StaticResource StringToBrushConv}}" ToolTip="{wpf:Text RecipeEditor.ClickPickColor}"
                                                                                    Command="{Binding PickFillColorCommand}" AutomationProperties.Name="{wpf:Text RecipeEditor.PickColor}"/>
                                                                            <TextBox AutomationProperties.Name="{Binding FillColorLabel, TargetNullValue=''}" Grid.Column="2" Text="{Binding FillColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     VerticalContentAlignment="Center" Padding="4,2"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Visibility="{Binding HasLineColor, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{Binding LineColorLabel}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <Grid Margin="0,2,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="20"/>
                                                                                <ColumnDefinition Width="4"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Grid.Column="0" Width="20" Height="20"
                                                                                    BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1"
                                                                                    Background="{Binding LineColor, Converter={StaticResource StringToBrushConv}}" ToolTip="{wpf:Text RecipeEditor.ClickPickColor}"
                                                                                    Command="{Binding PickLineColorCommand}" AutomationProperties.Name="{wpf:Text RecipeEditor.PickColor}"/>
                                                                            <TextBox AutomationProperties.Name="{Binding LineColorLabel, TargetNullValue=''}" Grid.Column="2" Text="{Binding LineColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     VerticalContentAlignment="Center" Padding="4,2"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- QR / Barcode Specific Colors & Options -->
                                                                <StackPanel Visibility="{Binding IsQrCodeType, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                                    <Grid Margin="0,2,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="{wpf:Text RecipeEditor.CodeColor}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <Grid Margin="0,2,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="20"/>
                                                                                    <ColumnDefinition Width="4"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Grid.Column="0" Width="20" Height="20"
                                                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1"
                                                                                        Background="{Binding ForeColor, Converter={StaticResource StringToBrushConv}}" ToolTip="{wpf:Text RecipeEditor.ClickPickForeground}"
                                                                                        Command="{Binding PickForeColorCommand}" AutomationProperties.Name="{wpf:Text RecipeEditor.PickForeground}"/>
                                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CodeColor}" Grid.Column="2" Text="{Binding ForeColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                         VerticalContentAlignment="Center" Padding="4,2"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                            <TextBlock Text="{wpf:Text RecipeEditor.BackgroundBack}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <Grid Margin="0,2,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="20"/>
                                                                                    <ColumnDefinition Width="4"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button Style="{StaticResource ColorSwatchButtonStyle}" Grid.Column="0" Width="20" Height="20"
                                                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="1"
                                                                                        Background="{Binding BackColor, Converter={StaticResource StringToBrushConv}}" ToolTip="{wpf:Text RecipeEditor.ClickPickBackground}"
                                                                                        Command="{Binding PickBackColorCommand}" AutomationProperties.Name="{wpf:Text RecipeEditor.PickBackground}"/>
                                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.BackgroundBack}" Grid.Column="2" Text="{Binding BackColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                         VerticalContentAlignment="Center" Padding="4,2"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,2,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="{wpf:Text RecipeEditor.QuietZone}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.QuietZone}" Text="{Binding QuietZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                        <CheckBox Grid.Column="1" Content="{wpf:Text RecipeEditor.QrRoundedDots}" IsChecked="{Binding RoundedDots, Mode=TwoWay}"
                                                                                  ToolTip="{wpf:Text RecipeEditor.TipRoundedDots}"
                                                                                  FontSize="{wpf:FontSize 10}" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 9. Conditional Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Conditional}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{wpf:Text RecipeEditor.ConditionBranches}" FontWeight="Bold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{wpf:Text RecipeEditor.BtnAddBranch}" Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding SelectedNode.AddConditionBranchCommand}" Padding="8,2" FontSize="{wpf:FontSize 10}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.ConditionBranches}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Key, StringFormat='Pin {0}'}" FontWeight="Bold" FontSize="{wpf:FontSize 10}"
                                                                                   Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    </Border>
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.BranchId}" Grid.Column="1" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             FontFamily="Consolas" FontSize="{wpf:FontSize 10}" Padding="4,2" MaxLength="10"
                                                                             ToolTip="{wpf:Text RecipeEditor.BranchId}"/>
                                                                    <Button AutomationProperties.Name="{wpf:Text RecipeEditor.DeleteBranch}" Grid.Column="2"  Content="✕" Style="{StaticResource LightErrorButtonStyle}" Command="{Binding RemoveCommand}"
                                                                            ToolTip="{wpf:Text RecipeEditor.DeleteBranch}" Margin="4,0,0,0"/>
                                                                </Grid>
                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.BranchCondition}" Grid.Row="1" Text="{Binding Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         FontFamily="Consolas" FontSize="{wpf:FontSize 11}" Padding="6,4"
                                                                         ToolTip="{wpf:Text RecipeEditor.TipBranchCondition}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{wpf:Text RecipeEditor.BranchLogicTitle}" FontWeight="Bold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBlock FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap"><Run Text="• "/><Run Text="{wpf:Text RecipeEditor.HintBranchPins}"/><LineBreak/><Run Text="• "/><Run Text="{wpf:Text RecipeEditor.HintBranchConnect}"/><LineBreak/><Run Text="• "/><Run Text="{wpf:Text RecipeEditor.HintBranchElse}"/></TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 9b. UserPrompt Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=UserPrompt}">
                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{wpf:Text RecipeEditor.PromptInteractionTitle}" FontWeight="Bold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBlock FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap"><Run Text="• "/><Run Text="{wpf:Text RecipeEditor.HintPromptDialog}"/><LineBreak/><Run Text="• "/><Run Text="{wpf:Text RecipeEditor.HintPromptBranches}"/></TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{wpf:Text RecipeEditor.PromptTitle}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.PromptTitle}" Text="{Binding SelectedNode.UserPromptTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{wpf:Text RecipeEditor.PromptMessage}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.PromptMessage}" Text="{Binding SelectedNode.UserPromptMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     TextWrapping="Wrap" AcceptsReturn="True" Height="50"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <CheckBox Content="{wpf:Text RecipeEditor.ShowCapturePreview}"
                                                      IsChecked="{Binding SelectedNode.UserPromptShowPreview, Mode=TwoWay}"
                                                      Foreground="{Binding TextPrimaryBrush}" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.PromptTimeout}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.PromptTimeout}" Text="{Binding SelectedNode.UserPromptTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                             Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,4,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{wpf:Text RecipeEditor.DecisionChoices}" FontWeight="Bold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{wpf:Text RecipeEditor.BtnAddChoice}" Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding SelectedNode.AddPromptChoiceCommand}" Padding="8,2" FontSize="{wpf:FontSize 10}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.PromptChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Key, StringFormat='Pin {0}'}" FontWeight="Bold" FontSize="{wpf:FontSize 10}"
                                                                                   Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    </Border>
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ChoiceKey}" Grid.Column="1" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                             FontFamily="Consolas" FontSize="{wpf:FontSize 10}" Padding="4,2" MaxLength="15"
                                                                             ToolTip="{wpf:Text RecipeEditor.ChoiceKey}"/>
                                                                    <Button AutomationProperties.Name="{wpf:Text RecipeEditor.DeleteChoice}" Grid.Column="2"  Content="✕" Style="{StaticResource LightErrorButtonStyle}" Command="{Binding RemoveCommand}"
                                                                            ToolTip="{wpf:Text RecipeEditor.DeleteChoice}" Margin="4,0,0,0"/>
                                                                </Grid>

                                                                <TextBlock Text="{wpf:Text RecipeEditor.ButtonLabel}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,2,0,1"/>
                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ButtonLabel}" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"

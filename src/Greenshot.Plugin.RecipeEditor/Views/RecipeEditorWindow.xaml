                                            <TextBlock Text="{wpf:Text RecipeEditor.CenterOnPage}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.CenterOnPage}" SelectedValue="{Binding SelectedNode.PrinterCenter, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.OutputFormatFromConfiguration}" Tag=""/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.Yes}" Tag="true"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.No}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.ColorMode}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.ColorMode}" SelectedValue="{Binding SelectedNode.PrinterColorMode, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.OutputFormatFromConfiguration}" Tag=""/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.FullColor}" Tag="Color"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.SummaryGrayscale}" Tag="Grayscale"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.MonochromeBw}" Tag="Monochrome"/>
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.PrintFooter}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.PrintFooter}" SelectedValue="{Binding SelectedNode.PrinterPrintFooter, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.OutputFormatFromConfiguration}" Tag=""/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.PrintFooterYes}" Tag="true"/>
                                                <ComboBoxItem Content="{wpf:Text RecipeEditor.No}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.FooterPattern}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.FooterPattern}" Text="{Binding SelectedNode.PrinterFooterPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 17. Custom Destination Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=CustomDestination}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.DestinationId}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.DestinationId}" Text="{Binding SelectedNode.CustomDestinationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HintDestinationId}"
                                                       FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 18. Generic Multi-Destinations Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=Destinations}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.ExportDestinations}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.DestinationEditor}" IsChecked="{Binding SelectedNode.DestinationEditor, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.StepClipboard}" IsChecked="{Binding SelectedNode.DestinationClipboard, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.StepSaveFile}" IsChecked="{Binding SelectedNode.DestinationFile, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.SummaryPrinter}" IsChecked="{Binding SelectedNode.DestinationPrinter, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.SummaryEmail}" IsChecked="{Binding SelectedNode.DestinationEmail, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- File Save Settings (Visible when Save to File is checked) -->
                                            <StackPanel Visibility="{Binding SelectedNode.DestinationFile, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8">
                                                <TextBlock Text="{wpf:Text RecipeEditor.SaveDirectory}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.SaveDirectory}" Text="{Binding SelectedNode.SaveDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                             Padding="6,4"/>
                                                    <Button Grid.Column="1" Content="{wpf:Text RecipeEditor.ImportBtnBrowse}" ContentStringFormat="📁 {0}" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"
                                                            Command="{Binding SelectedNode.BrowseSaveDirectoryCommand}" ToolTip="{wpf:Text RecipeEditor.TipBrowseFolder}"/>
                                                </Grid>

                                                <TextBlock Text="{wpf:Text RecipeEditor.FilenamePattern}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.FilenamePattern}" Text="{Binding SelectedNode.FilenamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4" Margin="0,0,0,6"/>
                                            </StackPanel>
                                            <!-- Custom Destinations -->
                                            <TextBlock Text="{wpf:Text RecipeEditor.CustomDestinations}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CustomDestinations}" Text="{Binding SelectedNode.CustomDestinationsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,4"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HintCustomDestinations}" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- 18b. WPF Dynamic Destination Step Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.StepType, Converter={StaticResource StringToVis}, ConverterParameter=DynamicDestination}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.PickerWindowTitle}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.PickerWindowTitle}" Text="{Binding SelectedNode.DynamicDestinationTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.ShowThumbnail}" IsChecked="{Binding SelectedNode.DynamicDestinationShowPreview, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.AllowForwarding}" IsChecked="{Binding SelectedNode.DynamicDestinationAllowRecipeForwarding, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{wpf:Text RecipeEditor.AutoDismissTimeout}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.AutoDismissTimeout}" Text="{Binding SelectedNode.DynamicDestinationTimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <TextBlock Text="{wpf:Text RecipeEditor.DestinationsFilter}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.DestinationsFilter}" Text="{Binding SelectedNode.DynamicDestinationSpecificDestinations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,4"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HintDestinationsFilter}" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                            <Border Background="{Binding BadgeBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                                <StackPanel>
                                                    <TextBlock Text="{wpf:Text RecipeEditor.DynamicDestinationTitle}" FontWeight="SemiBold" FontSize="{wpf:FontSize 10}" Foreground="{Binding AccentBrush}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{wpf:Text RecipeEditor.HintDynamicDestination}" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 19. External Command Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsExternalCommand, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.ConfiguredCommand}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ConfiguredCommand}" Text="{Binding SelectedNode.ExternalCommandCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HintConfiguredCommand}"
                                                       FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <TextBlock Text="{wpf:Text RecipeEditor.ExecutablePath}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ExecutablePath}" Text="{Binding SelectedNode.ExternalCommandLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                         Padding="6,4"/>
                                                <Button Grid.Column="1" Content="{wpf:Text RecipeEditor.ImportBtnBrowse}" ContentStringFormat="📁 {0}" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"
                                                        Command="{Binding SelectedNode.BrowseExternalExecutableCommand}" ToolTip="{wpf:Text RecipeEditor.TipBrowseExecutable}"/>
                                            </Grid>

                                            <TextBlock Text="{wpf:Text RecipeEditor.Arguments}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Arguments}" Text="{Binding SelectedNode.ExternalCommandArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <TextBlock Text="{wpf:Text RecipeEditor.TempImageFormat}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.TempImageFormat}" ItemsSource="{Binding DataContext.OutputFormatOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      DisplayMemberPath="DisplayNameWithPreferredExtension" ItemContainerStyle="{StaticResource FileFormatComboItemStyle}" SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedNode.ExternalCommandFormat, Mode=TwoWay}"
                                                      Margin="0,0,0,6">
                                            </ComboBox>

                                            <TextBlock Text="{wpf:Text RecipeEditor.ShellVerb}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ShellVerb}" Text="{Binding SelectedNode.ExternalCommandVerb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{wpf:Text RecipeEditor.WorkingDirectory}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.WorkingDirectory}" Text="{Binding SelectedNode.ExternalCommandWorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.RunAsync}" IsChecked="{Binding SelectedNode.ExternalCommandRunInBackground, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.CopyStdout}" IsChecked="{Binding SelectedNode.ExternalCommandOutputToClipboard, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.CopyDetectedUrl}" IsChecked="{Binding SelectedNode.ExternalCommandUriToClipboard, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                    <CheckBox Content="{wpf:Text RecipeEditor.ReloadImage}" IsChecked="{Binding SelectedNode.ExternalCommandReloadAfterExecution, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{wpf:Text RecipeEditor.StoreOutputVariable}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.StoreOutputVariable}" Text="{Binding SelectedNode.ExternalCommandSetOutputVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{wpf:Text RecipeEditor.StoreExitCodeVariable}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.StoreExitCodeVariable}" Text="{Binding SelectedNode.ExternalCommandSetExitCodeVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 21. Jira Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsJira, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.JiraIssueKey}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.JiraIssueKey}" Text="{Binding SelectedNode.JiraIssueKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.UploadFormat}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.UploadFormat}" ItemsSource="{Binding DataContext.OutputFormatOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      DisplayMemberPath="DisplayNameWithPreferredExtension" ItemContainerStyle="{StaticResource FileFormatComboItemStyle}" SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedNode.JiraFormat, Mode=TwoWay}"
                                                      Margin="0,0,0,6">
                                            </ComboBox>
                                            <TextBlock Text="{wpf:Text RecipeEditor.JpegQuality}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.JpegQuality}" Text="{Binding SelectedNode.JiraJpegQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 22. Confluence Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsConfluence, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.ConfluencePageId}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ConfluencePageId}" Text="{Binding SelectedNode.ConfluencePageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.UploadFormat}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.UploadFormat}" ItemsSource="{Binding DataContext.OutputFormatOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                      DisplayMemberPath="DisplayNameWithPreferredExtension" ItemContainerStyle="{StaticResource FileFormatComboItemStyle}" SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedNode.ConfluenceFormat, Mode=TwoWay}"
                                                      Margin="0,0,0,6">
                                            </ComboBox>
                                            <TextBlock Text="{wpf:Text RecipeEditor.JpegQuality}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.JpegQuality}" Text="{Binding SelectedNode.ConfluenceJpegQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 23. Office Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsOffice, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.TargetOfficeApp}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.TargetOfficeApp}" SelectedValue="{Binding SelectedNode.OfficeApplication, Mode=TwoWay}"
                                                      SelectedValuePath="Tag" Margin="0,0,0,6">
                                                <ComboBoxItem Content="Microsoft Word" Tag="Word"/>
                                                <ComboBoxItem Content="Microsoft Excel" Tag="Excel"/>
                                                <ComboBoxItem Content="Microsoft PowerPoint" Tag="PowerPoint"/>
                                                <ComboBoxItem Content="Microsoft OneNote" Tag="OneNote"/>
                                                <ComboBoxItem Content="Microsoft Outlook" Tag="Outlook"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 24. ZXing Barcode / QR Code Inspector -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsZxing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.OcrVariableName}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OcrVariableName}" Text="{Binding SelectedNode.ZxingSetVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" FontFamily="Consolas"
                                                     Padding="6,4" Margin="0,0,0,6"/>
                                            <CheckBox Content="{wpf:Text RecipeEditor.CopyDecodedText}" IsChecked="{Binding SelectedNode.ZxingCopyToClipboard, Mode=TwoWay}" Foreground="{Binding TextPrimaryBrush}" Margin="0,2,0,6"/>
                                        </StackPanel>

                                        <!-- 25. Cloud Storage Inspector (Box / Dropbox) -->
                                        <StackPanel Visibility="{Binding SelectedNode.IsCloudStorage, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{wpf:Text RecipeEditor.CloudDestination}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HintCloudDestination}"
                                                       FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        </StackPanel>

                                        <Separator Background="{Binding CardBorderBrush}" Margin="0,12,0,10"/>

                                        <!-- Step Error Handling & Fallback -->
                                        <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{wpf:Text RecipeEditor.HeaderStepErrorHandling}" FontWeight="Bold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}"/>
                                                        <TextBlock Text="{wpf:Text RecipeEditor.HintStepErrorHandling}" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{Binding BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedNode.OnErrorAction}" FontWeight="Bold" FontSize="{wpf:FontSize 9}" Foreground="{Binding AccentBrush}"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{wpf:Text RecipeEditor.OnError}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.OnError}" SelectedValue="{Binding SelectedNode.OnErrorAction, Mode=TwoWay}"
                                                          SelectedValuePath="Tag" Margin="0,0,0,6">
                                                    <ComboBoxItem Content="{wpf:Text RecipeEditor.OnErrorDefault}" Tag="Default"/>
                                                    <ComboBoxItem Content="{wpf:Text RecipeEditor.OnErrorRouteStep}" Tag="Step"/>
                                                    <ComboBoxItem Content="{wpf:Text RecipeEditor.OnErrorForwardRecipe}" Tag="Recipe"/>
                                                </ComboBox>

                                                <!-- Target Step Selector -->
                                                <StackPanel Visibility="{Binding SelectedNode.IsOnErrorStep, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.FallbackStep}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.FallbackStep}" ItemsSource="{Binding SelectedNode.AvailableTargetSteps}"
                                                              SelectedValue="{Binding SelectedNode.OnErrorNodeId, Mode=TwoWay}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="DisplayName"/>
                                                </StackPanel>

                                                <!-- Target Recipe Selector -->
                                                <StackPanel Visibility="{Binding SelectedNode.IsOnErrorRecipe, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                                    <TextBlock Text="{wpf:Text RecipeEditor.FallbackRecipe}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.FallbackRecipe}" ItemsSource="{Binding SelectedNode.AvailableTargetRecipes}"
                                                              SelectedValue="{Binding SelectedNode.OnErrorRecipeId, Mode=TwoWay}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="Name"
                                                              ItemContainerStyle="{StaticResource RecipeComboItemStyle}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- When nothing is selected -->
                                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource InvertBoolToVis}}"
                                                VerticalAlignment="Center" Margin="0,40,0,0">
                                        <TextBlock Text="{wpf:Text RecipeEditor.NoElementSelected}" FontWeight="SemiBold" FontSize="{wpf:FontSize 13}" Foreground="{Binding TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{wpf:Text RecipeEditor.HintNoElementSelected}"
                                                   FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="10,6,10,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: Recipe & Triggers -->
                        <TabItem Header="{wpf:Text RecipeEditor.TabRecipeTriggers}" Style="{StaticResource InspectorTabItem}">
                            <ScrollViewer Style="{DynamicResource ThemedScrollViewer}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="6,8,6,8">
                                <StackPanel>
                                    <TextBlock Text="{wpf:Text RecipeEditor.HeaderRecipeConfiguration}" FontWeight="Bold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,10"/>

                                    <TextBlock Text="{wpf:Text RecipeEditor.RecipeId}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.RecipeId}" Text="{Binding RecipeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                                 FontFamily="Consolas" Padding="6,4"/>
                                        <Button Grid.Column="1" Content="{wpf:Text RecipeEditor.BtnCopy}" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding CopyRecipeIdCommand}" Margin="4,0,0,0" ToolTip="{wpf:Text RecipeEditor.TipCopyRecipeId}"/>
                                    </Grid>

                                    <TextBlock Text="{wpf:Text RecipeEditor.RecipeName}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.RecipeName}" Text="{Binding RecipeTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                             Padding="6,4" Margin="0,2,0,8"/>

                                    <TextBlock Text="{wpf:Text RecipeEditor.Description}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Description}" Text="{Binding RecipeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="48"
                                             Padding="6,4" Margin="0,2,0,8"/>

                                    <TextBlock Text="{wpf:Text RecipeEditor.Version}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.Version}" Text="{Binding RecipeVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}"
                                             Padding="6,4" Margin="0,2,0,10"/>

                                    <!-- Automatic step: where it goes -->
                                    <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                            Visibility="{Binding IsExtensionMode, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HeaderAutomaticStep}" FontWeight="Bold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HintAutomaticStep}"
                                                       FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.ExtensionRecipes}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ExtensionRecipes}" Text="{Binding ExtensionTargets, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" Padding="6,4" Margin="0,2,0,8"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.ExtensionSlot}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.ExtensionSlot}" ItemsSource="{Binding ExtensionSlotNames}" SelectedItem="{Binding ExtensionSlot, Mode=TwoWay}" Margin="0,2,0,8"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.ExtensionOrder}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ExtensionOrder}" Text="{Binding ExtensionOrder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" Padding="6,4" Margin="0,2,0,8"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.ExtensionWhen}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}"/>
                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ExtensionWhen}" Text="{Binding ExtensionWhen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                                                     Background="{Binding CardBackgroundBrush}" Foreground="{Binding TextPrimaryBrush}" Padding="6,4" Margin="0,2,0,8"/>
                                            <TextBlock Text="{Binding ExtensionReachText}" FontSize="{wpf:FontSize 10}" FontStyle="Italic" TextWrapping="Wrap" Foreground="{Binding TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Options: values the user sets once in Settings > Recipes, read by the steps with ${option.key} -->
                                    <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{wpf:Text RecipeEditor.HeaderOptions}" FontWeight="Bold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{wpf:Text RecipeEditor.BtnAddOption}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddOptionCommand}"/>
                                            </Grid>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HintOptions}"
                                                       FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding RecipeOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="0,1,0,0" Padding="0,6,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.Resources>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="FontSize" Value="{wpf:FontSize 11}"/>
                                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                                        <Setter Property="Foreground" Value="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    </Style>
                                                                    <Style TargetType="TextBox">
                                                                        <Setter Property="Margin" Value="0,1"/>
                                                                        <Setter Property="Padding" Value="4,2"/>
                                                                        <Setter Property="Background" Value="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        <Setter Property="Foreground" Value="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    </Style>
                                                                </Grid.Resources>
                                                                <TextBlock Grid.Row="0" Text="{wpf:Text RecipeEditor.OptionKey}"/>
                                                                <DockPanel Grid.Row="0" Grid.Column="1">
                                                                    <Button AutomationProperties.Name="{wpf:Text RecipeEditor.TipRemoveOption}" DockPanel.Dock="Right" Content="🗑" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemoveCommand}" ToolTip="{wpf:Text RecipeEditor.TipRemoveOption}" Margin="4,0,0,0"/>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsageText}" FontFamily="Consolas" FontSize="{wpf:FontSize 10}" Margin="6,0,0,0"/>
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OptionKey}" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"/>
                                                                </DockPanel>
                                                                <TextBlock Grid.Row="1" Text="{wpf:Text RecipeEditor.OptionType}"/>
                                                                <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.OptionType}" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TypeNames}" SelectedItem="{Binding Type, Mode=TwoWay}" Margin="0,1"/>
                                                                <TextBlock Grid.Row="2" Text="{wpf:Text RecipeEditor.OptionLabel}"/>
                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OptionLabel}" Grid.Row="2" Grid.Column="1" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                                <TextBlock Grid.Row="3" Text="{wpf:Text RecipeEditor.OptionDefault}"/>
                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OptionDefault}" Grid.Row="3" Grid.Column="1" Text="{Binding DefaultText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                                <TextBlock Grid.Row="4" Text="{wpf:Text RecipeEditor.OptionRange}" Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}"/>
                                                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}">
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.TipOptionMin}" Width="60" Text="{Binding MinText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{wpf:Text RecipeEditor.TipOptionMin}"/>
                                                                    <TextBlock Text=" – " />
                                                                    <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.TipOptionMax}" Width="60" Text="{Binding MaxText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="{wpf:Text RecipeEditor.TipOptionMax}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Row="5" Text="{wpf:Text RecipeEditor.OptionChoices}" VerticalAlignment="Top" Margin="0,3,0,0" Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OptionChoices}" Grid.Row="5" Grid.Column="1" Text="{Binding ChoicesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="40"
                                                                         ToolTip="{wpf:Text RecipeEditor.TipOptionChoices}" Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}"/>
                                                                <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,2,0,0">
                                                                    <CheckBox Content="{wpf:Text RecipeEditor.OptionQuickSettings}" IsChecked="{Binding QuickSettings, Mode=TwoWay}" Margin="0,0,10,0"
                                                                              IsEnabled="{Binding CanBeQuickSetting}" Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <CheckBox Content="{wpf:Text RecipeEditor.OptionExpandPlaceholders}" IsChecked="{Binding IsTemplate, Mode=TwoWay}" Margin="0,0,10,0"
                                                                              ToolTip="{wpf:Text RecipeEditor.TipOptionExpandPlaceholders}"
                                                                              Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock><Run Text="{wpf:Text RecipeEditor.OptionEnabledWhen}"/><Run Text=" "/></TextBlock>
                                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.OptionEnabledWhen}" Width="90" Text="{Binding EnabledWhen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas"
                                                                                 ToolTip="{wpf:Text RecipeEditor.TipOptionEnabledWhen}"/>
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Start Steps / Entry Points -->
                                    <Border Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                            Visibility="{Binding IsRecipeMode, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HeaderStartSteps}" FontWeight="Bold" FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{wpf:Text RecipeEditor.HintStartSteps}"
                                                       FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Nodes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsStartNode, Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName, TargetNullValue=''}" Margin="0,3" Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding StepType, Converter={StaticResource StepIconConv}}" FontSize="{wpf:FontSize 11}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11}"/>
                                                                <TextBlock Text="{Binding Id, StringFormat=' ({0})'}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Separator Background="{Binding CardBorderBrush}" Margin="0,6,0,12" Visibility="{Binding IsRecipeMode, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Triggers Header & Action Bar -->
                                    <Grid Margin="0,0,0,8" Visibility="{Binding IsRecipeMode, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{wpf:Text RecipeEditor.HeaderTriggers}" FontWeight="Bold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Triggers.Count, StringFormat='{}{0} configured'}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Quick Add Buttons -->
                                    <WrapPanel Margin="0,0,0,10" Visibility="{Binding IsRecipeMode, Converter={StaticResource BoolToVis}}">
                                        <Button Content="{wpf:Text RecipeEditor.TriggerAddHotkey}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddTriggerCommand}" CommandParameter="Hotkey" Margin="0,0,4,4"/>
                                        <Button Content="{wpf:Text RecipeEditor.TriggerAddContextMenu}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddTriggerCommand}" CommandParameter="ContextMenu" Margin="0,0,4,4"/>
                                        <Button Content="{wpf:Text RecipeEditor.TriggerAddEditor}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddTriggerCommand}" CommandParameter="Editor" Margin="0,0,4,4"/>
                                        <Button Content="{wpf:Text RecipeEditor.TriggerAddClipboard}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddTriggerCommand}" CommandParameter="Clipboard" Margin="0,0,4,4"/>
                                        <Button Content="{wpf:Text RecipeEditor.TriggerAddCli}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddTriggerCommand}" CommandParameter="Commandline" Margin="0,0,4,4" ToolTip="{wpf:Text RecipeEditor.TipTriggerAddCli}"/>
                                        <Button Content="{wpf:Text RecipeEditor.TriggerAddOpenWith}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddTriggerCommand}" CommandParameter="OpenFile" Margin="0,0,4,4" ToolTip="{wpf:Text RecipeEditor.TipTriggerAddOpenWith}"/>
                                        <Button Content="{wpf:Text RecipeEditor.TriggerAddBrowserExtension}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddTriggerCommand}" CommandParameter="Extension" Margin="0,0,4,4" ToolTip="{wpf:Text RecipeEditor.TipTriggerAddBrowserExtension}"/>
                                        <Button Content="{wpf:Text RecipeEditor.TriggerAddAiTool}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddTriggerCommand}" CommandParameter="AiTool" Margin="0,0,4,4" ToolTip="{wpf:Text RecipeEditor.TipTriggerAddAiTool}"/>
                                        <Button Content="{wpf:Text RecipeEditor.TriggerAddManual}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddTriggerCommand}" CommandParameter="Manual" Margin="0,0,0,4"/>
                                    </WrapPanel>

                                    <!-- Triggers List -->
                                    <ItemsControl ItemsSource="{Binding Triggers}" Visibility="{Binding IsRecipeMode, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                           <DataTemplate>
                                                <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <!-- Card Header -->
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="{wpf:FontSize 11}"
                                                                       Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <CheckBox Grid.Column="1" Content="{wpf:Text RecipeEditor.Enabled}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                      Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      FontSize="{wpf:FontSize 10}" VerticalAlignment="Center" Margin="6,0"/>
                                                            <Button AutomationProperties.Name="{wpf:Text RecipeEditor.DeleteTrigger}" Grid.Column="2" Content="✕" Style="{StaticResource LightErrorButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{wpf:Text RecipeEditor.DeleteTrigger}"/>
                                                        </Grid>

                                                        <!-- Trigger specific fields -->
                                                        <!-- 1. Hotkey -->
                                                        <StackPanel Visibility="{Binding IsHotkey, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.HotkeyTrigger}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <views:HotkeyDisplayView AutomationProperties.Name="{wpf:Text RecipeEditor.HotkeyTrigger}" Margin="0,4,0,4"
                                                                                      HotkeyString="{Binding Hotkey, Mode=TwoWay}"
                                                                                      HeaderText="{Binding DisplayTitle}"
                                                                                      EditRequested="HotkeyDisplayControl_EditRequested"
                                                                                      Visibility="{Binding IsFixedHotkey, Converter={StaticResource BoolToVis}}"/>
                                                            <!-- A hotkey from an option or the general settings: shown with its source, changed there -->
                                                            <DockPanel Margin="0,4,0,4" Visibility="{Binding IsHotkeyReference, Converter={StaticResource BoolToVis}}">
                                                                <Button DockPanel.Dock="Right" Content="{wpf:Text RecipeEditor.TriggerHotkeyUseFixed}" Style="{StaticResource SecondaryButtonStyle}"
                                                                        Margin="6,0,0,0" Command="{Binding UseFixedHotkeyCommand}"/>
                                                                <TextBlock Text="{Binding HotkeySourceText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                        </StackPanel>

                                                        <!-- 2. Context Menu -->
                                                        <StackPanel Visibility="{Binding IsContextMenu, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.MenuItemLabel}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.MenuItemLabel}" Text="{Binding MenuItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{wpf:Text RecipeEditor.MenuGroup}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.MenuGroup}" Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{wpf:Text RecipeEditor.MenuItemOrder}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.MenuItemOrder}" Text="{Binding Order, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 3. Editor Menu -->
                                                        <StackPanel Visibility="{Binding IsEditor, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.EditorMenuItemLabel}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.EditorMenuItemLabel}" Text="{Binding MenuItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{wpf:Text RecipeEditor.EditorMenuGroup}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.EditorMenuGroup}" Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{wpf:Text RecipeEditor.EditorMenuItemOrder}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.EditorMenuItemOrder}" Text="{Binding Order, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 4. Clipboard -->
                                                        <StackPanel Visibility="{Binding IsClipboard, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.FormatFilter}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.FormatFilter}" Text="{Binding FormatFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas" FontSize="{wpf:FontSize 11}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 5. Manual -->
                                                        <StackPanel Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.TriggerName}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.TriggerName}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 6. Commandline (CLI) -->
                                                        <StackPanel Visibility="{Binding IsCommandline, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.CliCommandName}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CliCommandName}" Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{wpf:Text RecipeEditor.CliDescription}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.CliDescription}" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <CheckBox Content="{wpf:Text RecipeEditor.FireAndForgetWait}"
                                                                      IsChecked="{Binding FireAndForget, Mode=TwoWay}"
                                                                      Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      FontSize="{wpf:FontSize 10}" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 7. Open With File -->
                                                        <StackPanel Visibility="{Binding IsOpenFile, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.FileExtensions}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.FileExtensions}" Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <CheckBox Content="{wpf:Text RecipeEditor.FireAndForget}"
                                                                      IsChecked="{Binding FireAndForget, Mode=TwoWay}"
                                                                      Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      FontSize="{wpf:FontSize 10}" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- AI tool (greenshot-mcp) -->
                                                        <StackPanel Visibility="{Binding IsAiTool, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.AiToolName}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.AiToolName}" Text="{Binding ToolName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{wpf:Text RecipeEditor.AiToolTitle}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.AiToolTitle}" Text="{Binding ToolTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{wpf:Text RecipeEditor.AiToolDescription}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.AiToolDescription}" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <CheckBox Content="{wpf:Text RecipeEditor.AiToolReadOnly}"
                                                                      IsChecked="{Binding ReadOnly, Mode=TwoWay}"
                                                                      Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      FontSize="{wpf:FontSize 10}" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 8. Browser Extension -->
                                                        <StackPanel Visibility="{Binding IsExtension, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.BrowserFilter}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.BrowserFilter}" Text="{Binding Browser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontFamily="Consolas"
                                                                     Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <CheckBox Content="{wpf:Text RecipeEditor.FireAndForget}"
                                                                      IsChecked="{Binding FireAndForget, Mode=TwoWay}"
                                                                      Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      FontSize="{wpf:FontSize 10}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Background="{Binding CardBorderBrush}" Margin="0,10,0,12"/>

                                    <!-- Error Handling & Fallback Routes Header -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{wpf:Text RecipeEditor.HeaderErrorHandling}" FontWeight="Bold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ErrorTransitions.Count, StringFormat='{}{0} configured'}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{wpf:Text RecipeEditor.HintErrorHandling}"
                                               FontSize="{wpf:FontSize 10}" Foreground="{Binding TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <Button Content="{wpf:Text RecipeEditor.BtnAddErrorRoute}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddErrorTransitionCommand}" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                                    <!-- Error Transitions List -->
                                    <ItemsControl ItemsSource="{Binding ErrorTransitions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding DataContext.CardBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderBrush="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock FontSize="{wpf:FontSize 10}" FontWeight="SemiBold" Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,4,0"><Run Text="⚠️ "/><Run Text="{wpf:Text RecipeEditor.ErrorRouteFrom}"/><Run Text=":"/></TextBlock>
                                                                <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ErrorRouteFrom}" Text="{Binding FromNodeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Width="100" FontFamily="Consolas" FontSize="{wpf:FontSize 10}"
                                                                         Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Padding="3,1" ToolTip="{wpf:Text RecipeEditor.TipErrorRouteFrom}"/>
                                                            </StackPanel>
                                                            <Button AutomationProperties.Name="{wpf:Text RecipeEditor.RemoveErrorRoute}" Grid.Column="1" Content="🗑️" Style="{StaticResource LightErrorButtonStyle}"
                                                                    Command="{Binding DeleteCommand}" Padding="4,1" FontSize="{wpf:FontSize 10}" ToolTip="{wpf:Text RecipeEditor.RemoveErrorRoute}"/>
                                                        </Grid>

                                                        <TextBlock Text="{wpf:Text RecipeEditor.ErrorFilter}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{wpf:Text RecipeEditor.ErrorFilter}" Text="{Binding ErrorType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontFamily="Consolas" FontSize="{wpf:FontSize 10}"
                                                                 Background="{Binding DataContext.WindowBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Padding="4,2" Margin="0,0,0,6"/>

                                                        <TextBlock Text="{wpf:Text RecipeEditor.RouteTo}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,2"/>
                                                        <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.RouteTo}" SelectedValue="{Binding TargetType, Mode=TwoWay}"
                                                                  SelectedValuePath="Tag" Margin="0,0,0,4">
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.RouteStep}" Tag="Step"/>
                                                            <ComboBoxItem Content="{wpf:Text RecipeEditor.RouteRecipe}" Tag="Recipe"/>
                                                        </ComboBox>

                                                        <!-- Target Step -->
                                                        <StackPanel Visibility="{Binding IsTargetStep, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.FallbackStep}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.FallbackStep}" ItemsSource="{Binding AvailableNodes}"
                                                                      SelectedValue="{Binding ToNodeId, Mode=TwoWay}"
                                                                      SelectedValuePath="Id"
                                                                      DisplayMemberPath="DisplayName"/>
                                                        </StackPanel>

                                                        <!-- Target Recipe -->
                                                        <StackPanel Visibility="{Binding IsTargetRecipe, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                            <TextBlock Text="{wpf:Text RecipeEditor.FallbackRecipe}" FontSize="{wpf:FontSize 10}" Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            <ComboBox AutomationProperties.Name="{wpf:Text RecipeEditor.FallbackRecipe}" ItemsSource="{Binding AvailableRecipes}"
                                                                      SelectedValue="{Binding TargetRecipeId, Mode=TwoWay}"
                                                                      SelectedValuePath="Id"
                                                                      DisplayMemberPath="Name"
                                                                      ItemContainerStyle="{StaticResource RecipeComboItemStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{Binding CardBackgroundBrush}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" wpf:LiveRegion.Mode="Polite" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{wpf:Text RecipeEditor.PipelineEngine}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- In-Window Modal Hotkey Editor Overlay -->
            <views:HotkeyEditorView x:Name="HotkeyModal"
                                   Grid.RowSpan="4"
                                   Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>

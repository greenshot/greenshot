<UserControl x:Class="Greenshot.Plugin.RecipeEditor.Views.RecipeEditorConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/GreenshotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The recipe files and the switch of the recipe feature stay in greenshot.ini: Greenshot keeps the file list itself
         (opening or importing a file adds it, deleting the recipe removes it), switching the plugin off switches recipes off -->
    <StackPanel Margin="8" Orientation="Horizontal" VerticalAlignment="Top">
        <Button Content="{wpf:Text Core.ContextmenuRecipeeditor}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OpenEditor_Click"/>
        <Button Content="{wpf:Text Core.ContextmenuManagerecipes}" Style="{StaticResource SecondaryButtonStyle}" Click="OpenManager_Click"/>
    </StackPanel>
</UserControl>

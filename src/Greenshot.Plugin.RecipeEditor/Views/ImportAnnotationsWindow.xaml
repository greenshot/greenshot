<Window x:Class="Greenshot.Plugin.RecipeEditor.Views.ImportAnnotationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        xmlns:helpers="clr-namespace:Greenshot.Plugin.RecipeEditor.Helpers"
        Title="{ui:Text RecipeEditor.ImportTitle}"
        Height="580" Width="720"
        MinHeight="460" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.WindowBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ComboBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Window Border -->
    <Border BorderBrush="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title bar -->
                <RowDefinition Height="Auto"/> <!-- Source header & Target Step Mode -->
                <RowDefinition Height="*"/> <!-- Elements List -->
                <RowDefinition Height="Auto"/> <!-- External Asset Output -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <ui:ThemedTitleBar Grid.Row="0"/>

            <!-- Header & Mode Selection -->
            <StackPanel Grid.Row="1" Margin="16,10,16,10">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SourceTextBlock" FontSize="{ui:FontSize 11}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="SortButton" Content="{ui:Text RecipeEditor.ImportSortAscending}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="{ui:FontSize 10}" Click="OnSortClicked" ToolTip="{ui:Text RecipeEditor.ImportSortTooltip}"/>
                </Grid>

                <!-- Target Step Mode Selection -->
                <Border Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBackground}"
                        BorderBrush="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{ui:Text RecipeEditor.ImportTargetStepMode}" FontWeight="SemiBold" FontSize="{ui:FontSize 11}"
                                   Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border x:Name="AppendCard" Grid.Column="1" Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.WindowBackground}"
                                BorderBrush="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,0"
                                PreviewMouseDown="OnAppendCardClicked" Cursor="Hand">
                            <RadioButton Style="{StaticResource DefaultRadioButtonStyle}" x:Name="AppendRadio" GroupName="TargetStepMode" Content="{ui:Text RecipeEditor.ImportModeAppend}" IsChecked="True"/>
                        </Border>
                        <Border x:Name="ReplaceCard" Grid.Column="2" Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.WindowBackground}"
                                BorderBrush="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6"
                                PreviewMouseDown="OnReplaceCardClicked" Cursor="Hand">
                            <RadioButton Style="{StaticResource DefaultRadioButtonStyle}" x:Name="ReplaceRadio" GroupName="TargetStepMode" Content="{ui:Text RecipeEditor.ImportModeReplace}"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Elements List / Table -->
            <Border Grid.Row="2" Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBackground}"
                    BorderBrush="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="6" Margin="16,0,16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header Bar -->
                    <Border Grid.Row="0" BorderBrush="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}" BorderThickness="0,0,0,1" Padding="6,4,6,6" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SelectAllCheckBox" AutomationProperties.Name="{ui:Text RecipeEditor.ImportSelectAll}" Click="OnSelectAllClicked" IsChecked="True" ToolTip="{ui:Text RecipeEditor.ImportSelectAll}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{ui:Text RecipeEditor.ImportColumnType}" FontWeight="SemiBold" FontSize="{ui:FontSize 11}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="{ui:Text RecipeEditor.ImportColumnDescription}" FontWeight="SemiBold" FontSize="{ui:FontSize 11}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="{ui:Text RecipeEditor.ImportColumnStorage}" FontWeight="SemiBold" FontSize="{ui:FontSize 11}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}"/>
                        </Grid>
                    </Border>

                    <!-- Items ListView -->
                    <ListView x:Name="ElementsListView" Grid.Row="1" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <!-- The template draws no focus, the shared frame shows the keyboard focus -->
                                <Setter Property="FocusVisualStyle" Value="{StaticResource GreenshotFocusVisual}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="0,1">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.BadgeBackground}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding TargetNullValue=''}" Click="OnItemSelectionChanged" VerticalAlignment="Center"/>

                                    <!-- Type Badge -->
                                    <Border Grid.Column="1" Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.BadgeBackground}"
                                            BorderBrush="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}"
                                            BorderThickness="1" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontWeight="SemiBold" FontSize="{ui:FontSize 10}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.Accent}"/>
                                    </Border>

                                    <!-- Description -->
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="{ui:FontSize 11}"
                                               Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextPrimary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- Storage Mode (Embed vs File) -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding CanSaveAsFile, Converter={StaticResource BoolToVis}}">
                                        <ComboBox SelectedValue="{Binding StorageMode, Mode=TwoWay}" AutomationProperties.Name="{ui:Text RecipeEditor.ImportColumnStorage}"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="OnStorageModeChanged"
                                                  Width="160" Height="24" FontSize="{ui:FontSize 10}">
                                            <ComboBoxItem Content="{ui:Text RecipeEditor.ImportStorageEmbed}" Tag="{x:Static helpers:AssetStorageMode.EmbedBase64}"/>
                                            <ComboBoxItem Content="{ui:Text RecipeEditor.ImportStorageFile}" Tag="{x:Static helpers:AssetStorageMode.SaveToFile}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- External Asset Output Section (Issue 3: Clear labels and explanation) -->
            <Border x:Name="AssetOutputPanel" Grid.Row="3" Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBackground}"
                    BorderBrush="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="16,0,16,10"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{ui:Text RecipeEditor.ImportFileDestination}"
                               FontWeight="SemiBold" FontSize="{ui:FontSize 11}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextPrimary}" Margin="0,0,0,8"/>

                    <!-- Directory Path Picker -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DirectoryLabel" Grid.Column="0" Text="{ui:Text RecipeEditor.ImportSaveToFolder}" FontSize="{ui:FontSize 11}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="DirectoryTextBox" Grid.Column="1" AutomationProperties.LabeledBy="{Binding ElementName=DirectoryLabel}" FontSize="{ui:FontSize 11}" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="6,3"
                                 Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.WindowBackground}"
                                 Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextPrimary}"/>
                        <Button Grid.Column="3" Content="{ui:Text RecipeEditor.ImportBtnBrowse}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Click="OnBrowseDirectoryClicked"/>
                    </Grid>

                    <!-- Base Filename Prefix -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BaseFileNameLabel" Grid.Column="0" Text="{ui:Text RecipeEditor.ImportFilenamePrefix}" FontSize="{ui:FontSize 11}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="BaseFileNameTextBox" Grid.Column="1" AutomationProperties.LabeledBy="{Binding ElementName=BaseFileNameLabel}" FontSize="{ui:FontSize 11}" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="6,3"
                                 ToolTip="{ui:Text RecipeEditor.ImportFilenamePrefixTooltip}"
                                 Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.WindowBackground}"
                                 Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextPrimary}"/>
                    </Grid>

                    <!-- Helper explanation -->
                    <TextBlock Text="{ui:Text RecipeEditor.ImportFileNamingHint}"
                               FontSize="{ui:FontSize 10}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}" Margin="110,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="4" Background="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBackground}"
                    BorderBrush="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusTextBlock" ui:LiveRegion.Mode="Polite" FontSize="{ui:FontSize 11}" Foreground="{Binding Source={x:Static ui:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{ui:Text Core.Cancel}" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClicked" IsCancel="True" Margin="0,0,8,0"/>
                        <Button x:Name="ImportBtn" Content="{ui:Text RecipeEditor.ImportBtnProceed}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnProceedClicked"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

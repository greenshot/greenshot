<Window x:Class="Greenshot.Editor.Forms.TornEdgeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Translate editor_tornedge_settings}"
        SizeToContent="Height"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{TemplateBinding Header}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{TemplateBinding Foreground}"
                                               Margin="0,0,0,8"/>
                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" 
                  Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" 
                       Source="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}"
                       Width="16" Height="16"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       WindowChrome.IsHitTestVisibleInChrome="False"/>

                <TextBlock Grid.Column="1"
                           Text="{wpf:Translate editor_tornedge_settings}"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           WindowChrome.IsHitTestVisibleInChrome="False"/>

                <Button Grid.Column="2"
                        Content="✕" 
                        Click="CloseButton_Click"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- Dialog Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,12,20,10">
                    <!-- Edges Selection Group -->
                    <GroupBox Header="{wpf:Translate editor_tornedge_settings}">
                        <Grid HorizontalAlignment="Center" Margin="0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <!-- Top -->
                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="TopEdgeCheckBox" 
                                      Content="{wpf:Translate editor_tornedge_top}" 
                                      HorizontalAlignment="Center" Margin="12,4" Click="Edge_Click"/>

                            <!-- Left -->
                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="LeftEdgeCheckBox" 
                                      Content="{wpf:Translate editor_tornedge_left}" 
                                      VerticalAlignment="Center" Margin="12,4" Click="Edge_Click"/>

                            <!-- All (Center) -->
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="AllEdgesCheckBox" 
                                      Content="{wpf:Translate editor_tornedge_all}" 
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,4" Click="AllEdges_Click"/>

                            <!-- Right -->
                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="RightEdgeCheckBox" 
                                      Content="{wpf:Translate editor_tornedge_right}" 
                                      VerticalAlignment="Center" Margin="12,4" Click="Edge_Click"/>

                            <!-- Bottom -->
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="BottomEdgeCheckBox" 
                                      Content="{wpf:Translate editor_tornedge_bottom}" 
                                      HorizontalAlignment="Center" Margin="12,4" Click="Edge_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- Tooth Dimensions Group -->
                    <GroupBox Header="{wpf:Translate editor_tornedge_toothsize}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{wpf:Translate editor_tornedge_toothsize}"
                                       VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                <Slider x:Name="ToothSizeSlider" Minimum="0" Maximum="40" Value="10" Width="170" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ElementName=ToothSizeSlider, Path=Value, StringFormat={}{0:0} px}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{wpf:Translate editor_tornedge_horizontaltoothrange}"
                                       VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                <Slider x:Name="HorizontalToothRangeSlider" Minimum="0" Maximum="40" Value="20" Width="170" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ElementName=HorizontalToothRangeSlider, Path=Value, StringFormat={}{0:0} px}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="{wpf:Translate editor_tornedge_verticaltoothrange}"
                                       VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                <Slider x:Name="VerticalToothRangeSlider" Minimum="0" Maximum="40" Value="20" Width="170" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ElementName=VerticalToothRangeSlider, Path=Value, StringFormat={}{0:0} px}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Shadow Group -->
                    <GroupBox Header="{wpf:Translate editor_tornedge_shadow}">
                        <StackPanel>
                            <CheckBox x:Name="GenerateShadowCheckBox" Content="{wpf:Translate editor_tornedge_shadow}" Margin="0,2,0,8" Click="GenerateShadow_Click"/>
                            <Grid x:Name="ShadowSettingsGrid" IsEnabled="{Binding ElementName=GenerateShadowCheckBox, Path=IsChecked}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{wpf:Translate editor_dropshadow_thickness}"
                                           VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                    <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="20" Value="9" Width="170" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=ThicknessSlider, Path=Value, StringFormat={}{0:0} px}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{wpf:Translate editor_dropshadow_offset}"
                                           VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="X:" VerticalAlignment="Center" Width="20"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                        <Slider x:Name="OffsetXSlider" Minimum="-20" Maximum="20" Value="0" Width="150" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=OffsetXSlider, Path=Value, StringFormat={}{0:0} px}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Y:" VerticalAlignment="Center" Width="20"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                        <Slider x:Name="OffsetYSlider" Minimum="-20" Maximum="20" Value="0" Width="150" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=OffsetYSlider, Path=Value, StringFormat={}{0:0} px}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{wpf:Translate editor_dropshadow_darkness}"
                                           VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                    <Slider x:Name="DarknessSlider" Minimum="1" Maximum="40" Value="40" Width="170" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=DarknessSlider, Path=Value, StringFormat={}{0:0}}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Border Grid.Row="2" 
                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{wpf:Translate OK}" 
                            IsDefault="True"
                            Width="80"
                            Click="OkButton_Click"/>
                    <Button Content="{wpf:Translate CANCEL}" 
                            IsCancel="True"
                            Width="80"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<!--
    Copy the style or size of one element, apply it to the selected elements. The shared button style follows the editor theme
    (ThemeScope of the panel area).
-->
<UserControl x:Class="Greenshot.Editor.Panels.Views.StyleAndSizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,2,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Grid.Column="0" Margin="0,2,4,2" Style="{StaticResource SecondaryButtonStyle}"
                Content="{wpf:Text Editor.CopyStyle}" ToolTip="Ctrl+Shift+C" IsEnabled="{Binding CanCopy}" Click="CopyStyle_Click"/>
        <Button Grid.Row="0" Grid.Column="1" Margin="4,2,0,2" Style="{StaticResource SecondaryButtonStyle}"
                Content="{wpf:Text Editor.ApplyStyle}" ToolTip="Ctrl+Shift+V" IsEnabled="{Binding CanApplyStyle}" Click="ApplyStyle_Click"/>
        <Button Grid.Row="1" Grid.Column="0" Margin="0,2,4,2" Style="{StaticResource SecondaryButtonStyle}"
                Content="{wpf:Text Editor.CopySize}" IsEnabled="{Binding CanCopy}" Click="CopySize_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Margin="4,2,0,2" Style="{StaticResource SecondaryButtonStyle}"
                Content="{wpf:Text Editor.ApplySize}" IsEnabled="{Binding CanApplySize}" Click="ApplySize_Click"/>
    </Grid>
</UserControl>

<!--
    The Effects panel: the effect, its presets, its settings, a preview of the capture with the effect and Apply.
    A change of a setting shows at once in the preview, the capture only changes with Apply (one step for Ctrl+Z).
    The shared styles follow ThemeScope.Theme (the editor theme in the panel area).
-->
<UserControl x:Class="Greenshot.Editor.Panels.Effects.EffectsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
             Foreground="{Binding Path=(wpf:ThemeScope.Theme).ForegroundBrush, RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/SliderStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="Padding" Value="0,6,0,2"/>
                <Setter Property="Foreground" Value="{Binding Path=(wpf:ThemeScope.Theme).ForegroundBrush, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,10,0,2"/>
            </Style>
            <Style x:Key="ValueText" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="MinWidth" Value="40"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Swatch" TargetType="Border">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="{Binding Path=(wpf:ThemeScope.Theme).ControlBorderBrush, RelativeSource={RelativeSource Self}}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="8,4,8,8">
        <StackPanel>
            <Label Content="{wpf:Text Editor.EffectsEffect}" Target="{Binding ElementName=EffectBox}"/>
            <ComboBox x:Name="EffectBox" ItemsSource="{Binding Effects}" DisplayMemberPath="Title" SelectedIndex="{Binding EffectIndex}"/>

            <!-- The preview: the whole capture, for the effects on the edges also the bottom right corner at 100 % -->
            <TextBlock Text="{wpf:Text Editor.EffectsPreview}" Style="{StaticResource SectionHeader}"/>
            <Border BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True"
                    Background="{Binding Path=(wpf:ThemeScope.Theme).TextBoxBackgroundBrush, RelativeSource={RelativeSource Self}}"
                    BorderBrush="{Binding Path=(wpf:ThemeScope.Theme).ControlBorderBrush, RelativeSource={RelativeSource Self}}">
                <Image x:Name="PreviewImage" AutomationProperties.Name="{wpf:Text Editor.EffectsPreview}" Stretch="Uniform" StretchDirection="DownOnly"
                       MaxHeight="220" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Visibility="{Binding ShowsDetail, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{wpf:Text Editor.EffectsPreviewDetail}" FontSize="{wpf:FontSize 11}" Margin="0,8,0,2"
                           Foreground="{Binding Path=(wpf:ThemeScope.Theme).MutedBrush, RelativeSource={RelativeSource Self}}"/>
                <Border BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True" HorizontalAlignment="Left"
                        Background="{Binding Path=(wpf:ThemeScope.Theme).TextBoxBackgroundBrush, RelativeSource={RelativeSource Self}}"
                        BorderBrush="{Binding Path=(wpf:ThemeScope.Theme).ControlBorderBrush, RelativeSource={RelativeSource Self}}">
                    <Image x:Name="PreviewDetailImage" AutomationProperties.Name="{wpf:Text Editor.EffectsPreviewDetail}" Stretch="Uniform" StretchDirection="DownOnly"
                           Margin="6" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
            </StackPanel>

            <!-- Presets: a click sets the settings below, which can be changed afterwards -->
            <StackPanel Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{wpf:Text Editor.EffectsPresets}" Style="{StaticResource SectionHeader}"/>
                <ItemsControl ItemsSource="{Binding Presets}" Focusable="False" AutomationProperties.Name="{wpf:Text Editor.EffectsPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Name}" Padding="10,3" Margin="0,2,6,2"
                                    Click="Preset_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Border -->
            <StackPanel Visibility="{Binding ShowsBorder, Converter={StaticResource BoolToVisibility}}">
                <Label x:Name="BorderWidthLabel" Content="{wpf:Text Editor.EffectsBorderWidth}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=BorderWidthSlider, Path=ValueText}" Style="{StaticResource ValueText}"/>
                    <wpf:ValueSlider x:Name="BorderWidthSlider" ValueFormat="{}{0:0} px" Minimum="1" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding BorderWidth}" AutomationProperties.LabeledBy="{Binding ElementName=BorderWidthLabel}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border x:Name="BorderColorSwatch" Style="{StaticResource Swatch}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{wpf:Text Editor.EffectsColor}" Margin="6,0,0,0" Padding="10,4"
                            Click="BorderColor_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Torn edges -->
            <StackPanel Visibility="{Binding ShowsTornEdges, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox Content="{wpf:Text Editor.TornedgeTop}" IsChecked="{Binding TornTop}" Margin="0,2,12,2"/>
                    <CheckBox Content="{wpf:Text Editor.TornedgeRight}" IsChecked="{Binding TornRight}" Margin="0,2,12,2"/>
                    <CheckBox Content="{wpf:Text Editor.TornedgeBottom}" IsChecked="{Binding TornBottom}" Margin="0,2,12,2"/>
                    <CheckBox Content="{wpf:Text Editor.TornedgeLeft}" IsChecked="{Binding TornLeft}" Margin="0,2,12,2"/>
                </WrapPanel>
                <Label x:Name="ToothHeightLabel" Content="{wpf:Text Editor.TornedgeToothsize}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ToothHeightSlider, Path=ValueText}" Style="{StaticResource ValueText}"/>
                    <wpf:ValueSlider x:Name="ToothHeightSlider" ValueFormat="{}{0:0} px" Minimum="1" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ToothHeight}" AutomationProperties.LabeledBy="{Binding ElementName=ToothHeightLabel}"/>
                </DockPanel>
                <Label x:Name="ToothRangeLabel" Content="{wpf:Text Editor.EffectsToothRange}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ToothRangeSlider, Path=ValueText}" Style="{StaticResource ValueText}"/>
                    <wpf:ValueSlider x:Name="ToothRangeSlider" ValueFormat="{}{0:0} px" Minimum="2" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ToothRange}" AutomationProperties.LabeledBy="{Binding ElementName=ToothRangeLabel}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border x:Name="TornBackgroundSwatch" Style="{StaticResource Swatch}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{wpf:Text Editor.TornedgeBackgroundColor}" Margin="6,0,0,0" Padding="10,4"
                            Click="TornBackground_Click"/>
                </StackPanel>
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{wpf:Text Editor.CutMarkReseed}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4"
                        Click="NewEdges_Click"/>
                <CheckBox Content="{wpf:Text Editor.TornedgeShadow}" IsChecked="{Binding TornShadow}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Shadow of the drop shadow or of the torn edges -->
            <StackPanel Visibility="{Binding ShowsShadow, Converter={StaticResource BoolToVisibility}}">
                <Label x:Name="DarknessLabel" Content="{wpf:Text Editor.DropshadowDarkness}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=DarknessSlider, Path=ValueText}" Style="{StaticResource ValueText}"/>
                    <wpf:ValueSlider x:Name="DarknessSlider" ValueFormat="{}{0:0}" Minimum="1" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ShadowDarkness}" AutomationProperties.LabeledBy="{Binding ElementName=DarknessLabel}"/>
                </DockPanel>
                <Label x:Name="ShadowSizeLabel" Content="{wpf:Text Editor.DropshadowThickness}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ShadowSizeSlider, Path=ValueText}" Style="{StaticResource ValueText}"/>
                    <wpf:ValueSlider x:Name="ShadowSizeSlider" ValueFormat="{}{0:0} px" Minimum="1" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ShadowSize}" AutomationProperties.LabeledBy="{Binding ElementName=ShadowSizeLabel}"/>
                </DockPanel>
                <Label x:Name="OffsetLabel" Content="{wpf:Text Editor.DropshadowOffset}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="X" Width="14" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=OffsetXSlider, Path=ValueText}" Style="{StaticResource ValueText}"/>
                    <wpf:ValueSlider x:Name="OffsetXSlider" ValueFormat="{}{0:0} px" Minimum="-20" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ShadowOffsetX}" AutomationProperties.LabeledBy="{Binding ElementName=OffsetLabel}" AutomationProperties.HelpText="X"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Y" Width="14" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=OffsetYSlider, Path=ValueText}" Style="{StaticResource ValueText}"/>
                    <wpf:ValueSlider x:Name="OffsetYSlider" ValueFormat="{}{0:0} px" Minimum="-20" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ShadowOffsetY}" AutomationProperties.LabeledBy="{Binding ElementName=OffsetLabel}" AutomationProperties.HelpText="Y"/>
                </DockPanel>
            </StackPanel>

            <!-- Remove transparency -->
            <StackPanel Visibility="{Binding ShowsTransparency, Converter={StaticResource BoolToVisibility}}" Orientation="Horizontal" Margin="0,8,0,0">
                <Border x:Name="TransparencySwatch" Style="{StaticResource Swatch}"/>
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{wpf:Text Editor.EffectsColor}" Margin="6,0,0,0" Padding="10,4"
                        Click="TransparencyColor_Click"/>
            </StackPanel>

            <!-- Resize -->
            <Grid Visibility="{Binding ShowsResize, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="{wpf:Text Editor.ResizeWidth}" Target="{Binding ElementName=ResizeWidthBox}"/>
                <TextBox x:Name="ResizeWidthBox" Grid.Row="1" Grid.Column="0" Text="{Binding ResizeWidth, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{wpf:Text Editor.ResizeWidth}" PreviewMouseWheel="ResizeBox_PreviewMouseWheel"/>
                <Label Grid.Row="0" Grid.Column="2" Content="{wpf:Text Editor.ResizeHeight}" Target="{Binding ElementName=ResizeHeightBox}"/>
                <TextBox x:Name="ResizeHeightBox" Grid.Row="1" Grid.Column="2" Text="{Binding ResizeHeight, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{wpf:Text Editor.ResizeHeight}" PreviewMouseWheel="ResizeBox_PreviewMouseWheel"/>
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="{wpf:Text Editor.ResizeAspectratio}" IsChecked="{Binding KeepAspectRatio}" Margin="0,8,0,0"/>
            </Grid>

            <!-- Hints and errors, announced when they change -->
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="{wpf:FontSize 11}" Margin="0,8,0,0" wpf:LiveRegion.Mode="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{Binding Path=(wpf:ThemeScope.Theme).MutedBrush, RelativeSource={RelativeSource Self}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{Binding Path=(wpf:ThemeScope.Theme).ErrorBrush, RelativeSource={RelativeSource Self}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding ApplyText}" HorizontalAlignment="Right" MinWidth="100" Margin="0,10,0,0"
                    IsEnabled="{Binding CanApply}" Click="Apply_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>

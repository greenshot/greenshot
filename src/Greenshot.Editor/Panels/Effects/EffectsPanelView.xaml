<!--
    The Effects panel: the effect, its presets, its settings, a preview of the capture with the effect and Apply.
    A change of a setting shows at once in the preview, the capture only changes with Apply (one step for Ctrl+Z).
    The shared styles follow ThemeScope.Theme (the editor theme in the panel area).
-->
<UserControl x:Class="Greenshot.Editor.Panels.Effects.EffectsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
             xmlns:local="clr-namespace:Greenshot.Editor.Panels.Effects"
             Foreground="{Binding Path=(wpf:ThemeScope.Theme).ForegroundBrush, RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/GreenshotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style TargetType="Label" BasedOn="{StaticResource GreenshotLabelStyle}">
                <Setter Property="Padding" Value="0,6,0,2"/>
            </Style>
            <Style x:Key="Swatch" TargetType="Border">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="{Binding Path=(wpf:ThemeScope.Theme).ControlBorderBrush, RelativeSource={RelativeSource Self}}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="8,4,8,8">
        <StackPanel>
            <Label Content="{wpf:Text Editor.EffectsEffect}" Target="{Binding ElementName=EffectBox}"/>
            <ComboBox x:Name="EffectBox" ItemsSource="{Binding Effects}" DisplayMemberPath="Title" SelectedIndex="{Binding EffectIndex}"/>

            <!-- The preview: the capture with the effect in its full size, zoomed to fit; the wheel zooms, dragging moves it -->
            <TextBlock Text="{wpf:Text Editor.EffectsPreview}" Style="{StaticResource HeadingTextStyle}"/>
            <local:ZoomPanImage x:Name="PreviewImage" Height="260" BorderThickness="1" CornerRadius="4" Padding="2" SnapsToDevicePixels="True"
                                AutomationProperties.Name="{wpf:Text Editor.EffectsPreview}" AutomationProperties.HelpText="{wpf:Text Editor.EffectsPreviewHint}"
                                ToolTip="{wpf:Text Editor.EffectsPreviewHint}"
                                Background="{Binding Path=(wpf:ThemeScope.Theme).TextBoxBackgroundBrush, RelativeSource={RelativeSource Self}}"
                                BorderBrush="{Binding Path=(wpf:ThemeScope.Theme).ControlBorderBrush, RelativeSource={RelativeSource Self}}"/>
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="1:1" Padding="10,2" Margin="6,0,0,0"
                        AutomationProperties.Name="{wpf:Text Core.ViewerActualSize}" ToolTip="{wpf:Text Core.ViewerActualSize}" Click="ActualSize_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="{wpf:Text Editor.EffectsPreviewFit}" Padding="10,2"
                        Click="ShowAll_Click"/>
                <TextBlock x:Name="ZoomText" VerticalAlignment="Center" FontSize="{wpf:FontSize 11}"
                           Foreground="{Binding Path=(wpf:ThemeScope.Theme).MutedBrush, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>

            <!-- Presets: a click sets the settings below, which can be changed afterwards -->
            <StackPanel Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{wpf:Text Editor.EffectsPresets}" Style="{StaticResource HeadingTextStyle}"/>
                <ItemsControl ItemsSource="{Binding Presets}" Focusable="False" AutomationProperties.Name="{wpf:Text Editor.EffectsPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{Binding Name}" Padding="10,3" Margin="0,2,6,2"
                                    Click="Preset_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Border -->
            <StackPanel Visibility="{Binding ShowsBorder, Converter={StaticResource BoolToVisibility}}">
                <Label x:Name="BorderWidthLabel" Content="{wpf:Text Editor.EffectsBorderWidth}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=BorderWidthSlider, Path=ValueText}" Style="{StaticResource ValueTextStyle}"/>
                    <wpf:ValueSlider x:Name="BorderWidthSlider" ValueFormat="{}{0:0} px" Minimum="1" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding BorderWidth}" AutomationProperties.LabeledBy="{Binding ElementName=BorderWidthLabel}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border x:Name="BorderColorSwatch" Style="{StaticResource Swatch}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{wpf:Text Editor.EffectsColor}" Margin="6,0,0,0" Padding="10,4"
                            Click="BorderColor_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Drop shadow -->
            <StackPanel Visibility="{Binding ShowsShadow, Converter={StaticResource BoolToVisibility}}">
                <Label x:Name="DarknessLabel" Content="{wpf:Text Editor.DropshadowDarkness}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=DarknessSlider, Path=ValueText}" Style="{StaticResource ValueTextStyle}"/>
                    <wpf:ValueSlider x:Name="DarknessSlider" ValueFormat="{}{0:0}" Minimum="1" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ShadowDarkness}" AutomationProperties.LabeledBy="{Binding ElementName=DarknessLabel}"/>
                </DockPanel>
                <Label x:Name="ShadowSizeLabel" Content="{wpf:Text Editor.DropshadowThickness}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ShadowSizeSlider, Path=ValueText}" Style="{StaticResource ValueTextStyle}"/>
                    <wpf:ValueSlider x:Name="ShadowSizeSlider" ValueFormat="{}{0:0} px" Minimum="1" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ShadowSize}" AutomationProperties.LabeledBy="{Binding ElementName=ShadowSizeLabel}"/>
                </DockPanel>
                <Label x:Name="OffsetLabel" Content="{wpf:Text Editor.DropshadowOffset}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="X" Width="14" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=OffsetXSlider, Path=ValueText}" Style="{StaticResource ValueTextStyle}"/>
                    <wpf:ValueSlider x:Name="OffsetXSlider" ValueFormat="{}{0:0} px" Minimum="-20" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ShadowOffsetX}" AutomationProperties.LabeledBy="{Binding ElementName=OffsetLabel}" AutomationProperties.HelpText="X"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="Y" Width="14" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=OffsetYSlider, Path=ValueText}" Style="{StaticResource ValueTextStyle}"/>
                    <wpf:ValueSlider x:Name="OffsetYSlider" ValueFormat="{}{0:0} px" Minimum="-20" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                                     Value="{Binding ShadowOffsetY}" AutomationProperties.LabeledBy="{Binding ElementName=OffsetLabel}" AutomationProperties.HelpText="Y"/>
                </DockPanel>
            </StackPanel>

            <!-- Remove transparency -->
            <StackPanel Visibility="{Binding ShowsTransparency, Converter={StaticResource BoolToVisibility}}" Orientation="Horizontal" Margin="0,8,0,0">
                <Border x:Name="TransparencySwatch" Style="{StaticResource Swatch}"/>
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{wpf:Text Editor.EffectsColor}" Margin="6,0,0,0" Padding="10,4"
                        Click="TransparencyColor_Click"/>
            </StackPanel>

            <!-- Resize -->
            <Grid Visibility="{Binding ShowsResize, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="{wpf:Text Editor.ResizeWidth}" Target="{Binding ElementName=ResizeWidthBox}"/>
                <TextBox x:Name="ResizeWidthBox" Grid.Row="1" Grid.Column="0" Text="{Binding ResizeWidth, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{wpf:Text Editor.ResizeWidth}" PreviewMouseWheel="ResizeBox_PreviewMouseWheel"/>
                <Label Grid.Row="0" Grid.Column="2" Content="{wpf:Text Editor.ResizeHeight}" Target="{Binding ElementName=ResizeHeightBox}"/>
                <TextBox x:Name="ResizeHeightBox" Grid.Row="1" Grid.Column="2" Text="{Binding ResizeHeight, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{wpf:Text Editor.ResizeHeight}" PreviewMouseWheel="ResizeBox_PreviewMouseWheel"/>
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="{wpf:Text Editor.ResizeAspectratio}" IsChecked="{Binding KeepAspectRatio}" Margin="0,8,0,0"/>
            </Grid>

            <!-- Hints and errors, announced when they change -->
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="{wpf:FontSize 11}" Margin="0,8,0,0" wpf:LiveRegion.Mode="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{Binding Path=(wpf:ThemeScope.Theme).MutedBrush, RelativeSource={RelativeSource Self}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{Binding Path=(wpf:ThemeScope.Theme).ErrorBrush, RelativeSource={RelativeSource Self}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{wpf:Text Editor.EffectsApply}" HorizontalAlignment="Right" MinWidth="100" Margin="0,10,0,0"
                    IsEnabled="{Binding CanApply}" Click="Apply_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="Greenshot.Editor.Views.DropShadowSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text Editor.DropshadowSettings}"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="wpf:ValueSlider">
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" 
                  Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" 
                       Source="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}"
                       Width="16" Height="16"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       WindowChrome.IsHitTestVisibleInChrome="False"/>

                <TextBlock Grid.Column="1"
                           Text="{wpf:Text Editor.DropshadowSettings}"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontSize="{wpf:FontSize 13}"
                           FontWeight="SemiBold"
                           WindowChrome.IsHitTestVisibleInChrome="False"/>

                <Button Grid.Column="2"
                        Click="CloseButton_Click"
                        Style="{StaticResource TitleCloseButtonStyle}"
                        ToolTip="{wpf:Text Core.AccessibleClose}"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- Dialog Content -->
            <Grid Grid.Row="1" Margin="24,16,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thickness / Size -->
                <TextBlock x:Name="ThicknessLabel" Grid.Row="0" Grid.Column="0"
                           Text="{wpf:Text Editor.DropshadowThickness}"
                           VerticalAlignment="Center"
                           Margin="0,8"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8">
                    <wpf:ValueSlider x:Name="ThicknessSlider" ValueFormat="{}{0:0} px" AutomationProperties.LabeledBy="{Binding ElementName=ThicknessLabel}" Minimum="1" Maximum="20" Value="9" Width="170" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ElementName=ThicknessSlider, Path=ValueText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                </StackPanel>

                <!-- Offset X and Y -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{wpf:Text Editor.DropshadowOffset}"
                           VerticalAlignment="Center"
                           Margin="0,8"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock x:Name="OffsetXLabel" Text="X:" VerticalAlignment="Center" Width="20"
                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                        <wpf:ValueSlider x:Name="OffsetXSlider" ValueFormat="{}{0:0} px" AutomationProperties.HelpText="{wpf:Text Editor.DropshadowOffset}" AutomationProperties.LabeledBy="{Binding ElementName=OffsetXLabel}" Minimum="-20" Maximum="20" Value="0" Width="150" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=OffsetXSlider, Path=ValueText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock x:Name="OffsetYLabel" Text="Y:" VerticalAlignment="Center" Width="20"
                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                        <wpf:ValueSlider x:Name="OffsetYSlider" ValueFormat="{}{0:0} px" AutomationProperties.HelpText="{wpf:Text Editor.DropshadowOffset}" AutomationProperties.LabeledBy="{Binding ElementName=OffsetYLabel}" Minimum="-20" Maximum="20" Value="0" Width="150" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=OffsetYSlider, Path=ValueText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Darkness -->
                <TextBlock x:Name="DarknessLabel" Grid.Row="2" Grid.Column="0"
                           Text="{wpf:Text Editor.DropshadowDarkness}"
                           VerticalAlignment="Center"
                           Margin="0,8"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8">
                    <wpf:ValueSlider x:Name="DarknessSlider" ValueFormat="{}{0:0}" AutomationProperties.LabeledBy="{Binding ElementName=DarknessLabel}" Minimum="1" Maximum="40" Value="40" Width="170" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ElementName=DarknessSlider, Path=ValueText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Buttons -->
            <Border Grid.Row="2" 
                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{wpf:Text Core.Ok}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Width="80"
                            Margin="4"
                            Click="OkButton_Click"/>
                    <Button Content="{wpf:Text Core.Cancel}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            Width="80"
                            Margin="4"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

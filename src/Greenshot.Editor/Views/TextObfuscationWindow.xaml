<Window x:Class="Greenshot.Editor.Views.TextObfuscationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text Editor.ObfuscateTextTitle}"
        SizeToContent="Height"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ComboBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Modern GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{TemplateBinding Header}"
                                               FontWeight="SemiBold"
                                               FontSize="{wpf:FontSize 13}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Margin="0,0,0,8"/>
                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TextBoxBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="wpf:ValueSlider">
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" 
                  Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" 
                       Source="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}"
                       Width="16" Height="16"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       WindowChrome.IsHitTestVisibleInChrome="False"/>

                <TextBlock Grid.Column="1"
                           Text="{wpf:Text Editor.ObfuscateTextTitle}"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontSize="{wpf:FontSize 13}"
                           FontWeight="SemiBold"
                           WindowChrome.IsHitTestVisibleInChrome="False"/>

                <Button Grid.Column="2"
                        Click="CloseButton_Click"
                        Style="{StaticResource TitleCloseButtonStyle}"
                        ToolTip="{wpf:Text Core.AccessibleClose}"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- Dialog Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,12,20,10">
                    <!-- Search Section -->
                    <GroupBox Header="{wpf:Text Editor.ObfuscateTextSearch}">
                        <StackPanel>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="SearchTextBox" AutomationProperties.Name="{wpf:Text Editor.ObfuscateTextSearch}" TextChanged="SearchInput_Changed"/>
                                <Button Grid.Column="1" Content="{wpf:Text Editor.ObfuscateTextSearchButton}" 
                                        Margin="6,0,0,0" Padding="12,4" Click="SearchButton_Click"/>
                            </Grid>

                            <WrapPanel Margin="0,4">
                                <CheckBox x:Name="RegexCheckBox" Content="{wpf:Text Editor.ObfuscateTextRegex}" Margin="0,4,16,4" Click="SearchInput_Changed"/>
                                <CheckBox x:Name="CaseSensitiveCheckBox" Content="{wpf:Text Editor.ObfuscateTextCaseSensitive}" Margin="0,4,16,4" Click="SearchInput_Changed"/>
                            </WrapPanel>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SearchScopeLabel" Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextSearchScope}" VerticalAlignment="Center"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <ComboBox Grid.Column="1" x:Name="SearchScopeComboBox" AutomationProperties.LabeledBy="{Binding ElementName=SearchScopeLabel}" SelectionChanged="SearchInput_Changed"/>
                            </Grid>

                            <!-- Match Count Status -->
                            <TextBlock x:Name="MatchCountTextBlock" wpf:LiveRegion.Mode="Polite" Margin="0,6,0,2" FontWeight="SemiBold"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Effect Selection -->
                    <GroupBox Header="{wpf:Text Editor.ObfuscateTextApply}">
                        <StackPanel>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="EffectLabel" Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextEffect}" VerticalAlignment="Center"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <ComboBox Grid.Column="1" x:Name="EffectComboBox" AutomationProperties.LabeledBy="{Binding ElementName=EffectLabel}" SelectionChanged="EffectComboBox_SelectionChanged"/>
                            </Grid>

                            <!-- Dynamic Effect Parameter Controls -->
                            <!-- Pixel Size -->
                            <Grid x:Name="PixelSizeRow" Margin="0,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PixelSizeLabel" Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextPixelSize}" VerticalAlignment="Center"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <wpf:ValueSlider x:Name="PixelSizeSlider" ValueFormat="{}{0:0} px" AutomationProperties.LabeledBy="{Binding ElementName=PixelSizeLabel}" Minimum="1" Maximum="50" Value="10" Width="170" VerticalAlignment="Center" ValueChanged="Setting_Changed"/>
                                    <TextBlock Text="{Binding ElementName=PixelSizeSlider, Path=ValueText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Blur Radius -->
                            <Grid x:Name="BlurRadiusRow" Margin="0,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BlurRadiusLabel" Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextBlurRadius}" VerticalAlignment="Center"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <wpf:ValueSlider x:Name="BlurRadiusSlider" ValueFormat="{}{0:0} px" AutomationProperties.LabeledBy="{Binding ElementName=BlurRadiusLabel}" Minimum="1" Maximum="30" Value="10" Width="170" VerticalAlignment="Center" ValueChanged="Setting_Changed"/>
                                    <TextBlock Text="{Binding ElementName=BlurRadiusSlider, Path=ValueText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Highlight Color -->
                            <Grid x:Name="HighlightColorRow" Margin="0,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextColor}" VerticalAlignment="Center"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Border x:Name="ColorPreviewBorder" Width="40" Height="26" CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                                            Background="#FFFF00" Margin="0,0,8,0"/>
                                    <Button Content="{wpf:Text Editor.ObfuscateTextPickColor}" Click="PickColorButton_Click" Padding="12,4"/>
                                </StackPanel>
                            </Grid>

                            <!-- Magnification -->
                            <Grid x:Name="MagnificationRow" Margin="0,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MagnificationLabel" Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextMagnification}" VerticalAlignment="Center"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <wpf:ValueSlider x:Name="MagnificationSlider" ValueFormat="{}{0:0}x" AutomationProperties.LabeledBy="{Binding ElementName=MagnificationLabel}" Minimum="1" Maximum="10" Value="2" Width="170" VerticalAlignment="Center" ValueChanged="Setting_Changed"/>
                                    <TextBlock Text="{Binding ElementName=MagnificationSlider, Path=ValueText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Advanced Settings Expander -->
                    <Expander Header="{wpf:Text Editor.ObfuscateTextAdvanced}" Margin="0,4,0,8">
                        <Border Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"
                                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="HorizontalPaddingLabel" Grid.Row="0" Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextHorizontalPadding}" VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                    <wpf:ValueSlider x:Name="HorizontalPaddingSlider" ValueFormat="{}{0:0} %" AutomationProperties.LabeledBy="{Binding ElementName=HorizontalPaddingLabel}" Minimum="-50" Maximum="100" Value="0" Width="150" ValueChanged="Setting_Changed"/>
                                    <TextBlock Text="{Binding ElementName=HorizontalPaddingSlider, Path=ValueText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>

                                <TextBlock x:Name="VerticalPaddingLabel" Grid.Row="1" Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextVerticalPadding}" VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                    <wpf:ValueSlider x:Name="VerticalPaddingSlider" ValueFormat="{}{0:0} %" AutomationProperties.LabeledBy="{Binding ElementName=VerticalPaddingLabel}" Minimum="-50" Maximum="100" Value="0" Width="150" ValueChanged="Setting_Changed"/>
                                    <TextBlock Text="{Binding ElementName=VerticalPaddingSlider, Path=ValueText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>

                                <TextBlock x:Name="HorizontalOffsetLabel" Grid.Row="2" Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextHorizontalOffset}" VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                    <wpf:ValueSlider x:Name="HorizontalOffsetSlider" ValueFormat="{}{0:0} px" AutomationProperties.LabeledBy="{Binding ElementName=HorizontalOffsetLabel}" Minimum="-100" Maximum="100" Value="0" Width="150" ValueChanged="Setting_Changed"/>
                                    <TextBlock Text="{Binding ElementName=HorizontalOffsetSlider, Path=ValueText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>

                                <TextBlock x:Name="VerticalOffsetLabel" Grid.Row="3" Grid.Column="0" Text="{wpf:Text Editor.ObfuscateTextVerticalOffset}" VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                    <wpf:ValueSlider x:Name="VerticalOffsetSlider" ValueFormat="{}{0:0} px" AutomationProperties.LabeledBy="{Binding ElementName=VerticalOffsetLabel}" Minimum="-100" Maximum="100" Value="0" Width="150" ValueChanged="Setting_Changed"/>
                                    <TextBlock Text="{Binding ElementName=VerticalOffsetSlider, Path=ValueText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Border Grid.Row="2" 
                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{wpf:Text Editor.ObfuscateTextApply}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Width="80"
                            Margin="5,0"
                            Click="ApplyButton_Click"/>
                    <Button Content="{wpf:Text Core.Cancel}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            Width="80"
                            Margin="5,0"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

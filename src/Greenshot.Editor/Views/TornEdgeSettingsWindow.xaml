<Window x:Class="Greenshot.Editor.Views.TornEdgeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text Editor.TornedgeSettings}"
        SizeToContent="Height"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/SliderStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Modern GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{TemplateBinding Header}"
                                               FontWeight="SemiBold"
                                               FontSize="{wpf:FontSize 13}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Margin="0,0,0,8"/>
                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" 
                  Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" 
                       Source="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}"
                       Width="16" Height="16"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       WindowChrome.IsHitTestVisibleInChrome="False"/>

                <TextBlock Grid.Column="1"
                           Text="{wpf:Text Editor.TornedgeSettings}"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontSize="{wpf:FontSize 13}"
                           FontWeight="SemiBold"
                           WindowChrome.IsHitTestVisibleInChrome="False"/>

                <Button Grid.Column="2"
                        Click="CloseButton_Click"
                        Style="{StaticResource TitleCloseButtonStyle}"
                        ToolTip="{wpf:Text Core.AccessibleClose}"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- Dialog Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,12,20,10">
                    <!-- Edges Selection Group -->
                    <GroupBox x:Name="EdgesGroupBox" Header="{wpf:Text Editor.TornedgeSettings}">
                        <Grid HorizontalAlignment="Center" Margin="0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <!-- Top -->
                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="TopEdgeCheckBox" 
                                      Content="{wpf:Text Editor.TornedgeTop}" 
                                      HorizontalAlignment="Center" Margin="12,4" Click="Edge_Click"/>

                            <!-- Left -->
                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="LeftEdgeCheckBox" 
                                      Content="{wpf:Text Editor.TornedgeLeft}" 
                                      VerticalAlignment="Center" Margin="12,4" Click="Edge_Click"/>

                            <!-- All (Center) -->
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="AllEdgesCheckBox" 
                                      Content="{wpf:Text Editor.TornedgeAll}" 
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,4" Click="AllEdges_Click"/>

                            <!-- Right -->
                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="RightEdgeCheckBox" 
                                      Content="{wpf:Text Editor.TornedgeRight}" 
                                      VerticalAlignment="Center" Margin="12,4" Click="Edge_Click"/>

                            <!-- Bottom -->
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="BottomEdgeCheckBox" 
                                      Content="{wpf:Text Editor.TornedgeBottom}" 
                                      HorizontalAlignment="Center" Margin="12,4" Click="Edge_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- Tooth Dimensions Group -->
                    <GroupBox Header="{wpf:Text Editor.TornedgeToothsize}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="ToothSizeLabel" Grid.Row="0" Grid.Column="0"
                                       Text="{wpf:Text Editor.TornedgeToothsize}"
                                       VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                <wpf:ValueSlider x:Name="ToothSizeSlider" ValueFormat="{}{0:0} px" AutomationProperties.LabeledBy="{Binding ElementName=ToothSizeLabel}" Minimum="0" Maximum="40" Value="10" Width="170" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ElementName=ToothSizeSlider, Path=ValueText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="HorizontalToothRangeLabel" Grid.Row="1" Grid.Column="0"
                                       Text="{wpf:Text Editor.TornedgeHorizontaltoothrange}"
                                       VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                <wpf:ValueSlider x:Name="HorizontalToothRangeSlider" ValueFormat="{}{0:0} px" AutomationProperties.LabeledBy="{Binding ElementName=HorizontalToothRangeLabel}" Minimum="0" Maximum="40" Value="20" Width="170" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ElementName=HorizontalToothRangeSlider, Path=ValueText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="VerticalToothRangeLabel" Grid.Row="2" Grid.Column="0"
                                       Text="{wpf:Text Editor.TornedgeVerticaltoothrange}"
                                       VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                <wpf:ValueSlider x:Name="VerticalToothRangeSlider" ValueFormat="{}{0:0} px" AutomationProperties.LabeledBy="{Binding ElementName=VerticalToothRangeLabel}" Minimum="0" Maximum="40" Value="20" Width="170" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ElementName=VerticalToothRangeSlider, Path=ValueText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="BackgroundColorLabel" Grid.Row="3" Grid.Column="0"
                                       Text="{wpf:Text Editor.TornedgeBackgroundColor}"
                                       VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                            <Button Grid.Row="3" Grid.Column="1" x:Name="BackgroundColorButton" AutomationProperties.LabeledBy="{Binding ElementName=BackgroundColorLabel}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,4" Padding="2"
                                    Click="BackgroundColor_Click">
                                <Border x:Name="BackgroundColorSwatch" Width="40" Height="16"
                                        BorderThickness="1"
                                        BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
                            </Button>
                        </Grid>
                    </GroupBox>

                    <!-- Shadow Group -->
                    <GroupBox Header="{wpf:Text Editor.TornedgeShadow}">
                        <StackPanel>
                            <CheckBox x:Name="GenerateShadowCheckBox" Content="{wpf:Text Editor.TornedgeShadow}" Margin="0,2,0,8" Click="GenerateShadow_Click"/>
                            <Grid x:Name="ShadowSettingsGrid" IsEnabled="{Binding ElementName=GenerateShadowCheckBox, Path=IsChecked}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="ThicknessLabel" Grid.Row="0" Grid.Column="0"
                                           Text="{wpf:Text Editor.DropshadowThickness}"
                                           VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                    <wpf:ValueSlider x:Name="ThicknessSlider" ValueFormat="{}{0:0} px" AutomationProperties.LabeledBy="{Binding ElementName=ThicknessLabel}" Minimum="1" Maximum="20" Value="9" Width="170" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=ThicknessSlider, Path=ValueText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{wpf:Text Editor.DropshadowOffset}"
                                           VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock x:Name="OffsetXLabel" Text="X:" VerticalAlignment="Center" Width="20"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                        <wpf:ValueSlider x:Name="OffsetXSlider" ValueFormat="{}{0:0} px" AutomationProperties.HelpText="{wpf:Text Editor.DropshadowOffset}" AutomationProperties.LabeledBy="{Binding ElementName=OffsetXLabel}" Minimum="-20" Maximum="20" Value="0" Width="150" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=OffsetXSlider, Path=ValueText}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock x:Name="OffsetYLabel" Text="Y:" VerticalAlignment="Center" Width="20"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                        <wpf:ValueSlider x:Name="OffsetYSlider" ValueFormat="{}{0:0} px" AutomationProperties.HelpText="{wpf:Text Editor.DropshadowOffset}" AutomationProperties.LabeledBy="{Binding ElementName=OffsetYLabel}" Minimum="-20" Maximum="20" Value="0" Width="150" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=OffsetYSlider, Path=ValueText}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="DarknessLabel" Grid.Row="2" Grid.Column="0"
                                           Text="{wpf:Text Editor.DropshadowDarkness}"
                                           VerticalAlignment="Center" Margin="0,4"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                    <wpf:ValueSlider x:Name="DarknessSlider" ValueFormat="{}{0:0}" AutomationProperties.LabeledBy="{Binding ElementName=DarknessLabel}" Minimum="1" Maximum="40" Value="40" Width="170" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=DarknessSlider, Path=ValueText}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="45"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Border Grid.Row="2" 
                    Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=TitleBarBrush}"
                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{wpf:Text Core.Ok}" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Width="80"
                            Margin="4"
                            Click="OkButton_Click"/>
                    <Button Content="{wpf:Text Core.Cancel}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            Width="80"
                            Margin="4"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

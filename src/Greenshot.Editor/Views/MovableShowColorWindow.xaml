<Window x:Class="Greenshot.Editor.Views.MovableShowColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text Core.ColorpickerUnderCursor}"
        Width="100"
        Height="100"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        Background="{x:Static SystemColors.InfoBrush}"
        Foreground="{x:Static SystemColors.InfoTextBrush}">
    <Border BorderBrush="{x:Static SystemColors.ActiveBorderBrush}" BorderThickness="1">
        <Canvas>
            <Border x:Name="Preview"
                    Canvas.Left="4" Canvas.Top="4"
                    Width="32" Height="32"
                    BorderBrush="{x:Static SystemColors.InfoTextBrush}" BorderThickness="1" />

            <TextBlock Canvas.Left="39" Canvas.Top="4" Text="{wpf:Text Core.ColorpickerHtmlcolor}" />
            <TextBlock x:Name="Html" Canvas.Left="39" Canvas.Top="17" Width="57" />

            <TextBlock Canvas.Left="1" Canvas.Top="35" Text="{wpf:Text Core.ColorpickerRed}" />
            <TextBlock x:Name="Red" Canvas.Left="43" Canvas.Top="35" Width="53" />

            <TextBlock Canvas.Left="1" Canvas.Top="48" Text="{wpf:Text Core.ColorpickerGreen}" />
            <TextBlock x:Name="Green" Canvas.Left="43" Canvas.Top="48" Width="53" />

            <TextBlock Canvas.Left="1" Canvas.Top="61" Text="{wpf:Text Core.ColorpickerBlue}" />
            <TextBlock x:Name="Blue" Canvas.Left="43" Canvas.Top="61" Width="53" />

            <TextBlock Canvas.Left="1" Canvas.Top="74" Text="{wpf:Text Core.ColorpickerAlpha}" />
            <TextBlock x:Name="Alpha" Canvas.Left="43" Canvas.Top="74" Width="53" />
        </Canvas>
    </Border>
</Window>

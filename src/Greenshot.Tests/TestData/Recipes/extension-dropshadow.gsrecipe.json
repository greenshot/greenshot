{
  "kind": "extension",
  "extends": {
    "recipes": [
      "*capture"
    ],
    "slot": "BeforeDestination",
    "order": 300
  },
  "version": "2.0",
  "id": "ext_dropshadow",
  "name": "Recipe.extension_dropshadow",
  "description": "Recipe.extension_dropshadow_description",
  "requires": [],
  "nodes": [
    {
      "id": "shadow",
      "stepType": "Effect",
      "name": "Drop shadow",
      "enabled": true,
      "parameters": {
        "Effect": "DropShadow",
        "ShadowSize": "${option.size}",
        "Darkness": "${option.darkness}",
        "ShadowOffsetX": "${option.offset}",
        "ShadowOffsetY": "${option.offset}"
      }
    }
  ],
  "flow": {
    "startNodes": [
      "shadow"
    ],
    "transitions": []
  },
  "options": [
    {
      "key": "enabled",
      "type": "Boolean",
      "default": false,
      "label": "Recipe.extension_dropshadow_enabled",
      "quickSettings": true
    },
    {
      "key": "size",
      "type": "Integer",
      "default": 7,
      "label": "Recipe.extension_dropshadow_size",
      "min": 1.0,
      "max": 50.0,
      "enabledWhen": "enabled",
      "quickSettings": false
    },
    {
      "key": "darkness",
      "type": "Decimal",
      "default": 0.6,
      "label": "Recipe.extension_dropshadow_darkness",
      "min": 0.1,
      "max": 1.0,
      "enabledWhen": "enabled",
      "quickSettings": false
    },
    {
      "key": "offset",
      "type": "Integer",
      "default": -1,
      "label": "Recipe.extension_dropshadow_offset",
      "min": -20.0,
      "max": 20.0,
      "enabledWhen": "enabled",
      "quickSettings": false
    }
  ]
}

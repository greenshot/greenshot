<Window x:Class="Greenshot.Plugin.Jira.Views.JiraUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="{wpf:Text Jira.UploadMenuItem}"
        Width="760" Height="440"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0"/>

            <Grid Grid.Row="1" Margin="14,10,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="{wpf:Text Jira.LabelJirafilter}" Margin="0,0,12,0"/>
                <ComboBox x:Name="FilterBox" Grid.Row="0" Grid.Column="1" DisplayMemberPath="Name"
                          SelectionChanged="FilterBox_SelectionChanged"/>

                <!-- The issues of the filter -->
                <ListView x:Name="IssueList" Grid.Row="1" Grid.Column="1" Margin="0,8,0,8"
                          SelectionMode="Single"
                          SelectionChanged="IssueList_SelectionChanged"
                          MouseDoubleClick="IssueList_MouseDoubleClick"
                          GridViewColumnHeader.Click="IssueList_HeaderClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{wpf:Text Jira.ColumnIssueType}" Width="44">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Icon}" Width="16" Height="16" ToolTip="{Binding IssueType}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{wpf:Text Jira.ColumnId}" Width="90" DisplayMemberBinding="{Binding Key}"/>
                            <GridViewColumn Header="{wpf:Text Jira.ColumnCreated}" Width="90" DisplayMemberBinding="{Binding CreatedText}"/>
                            <GridViewColumn Header="{wpf:Text Jira.ColumnAssignee}" Width="120" DisplayMemberBinding="{Binding Assignee}"/>
                            <GridViewColumn Header="{wpf:Text Jira.ColumnReporter}" Width="120" DisplayMemberBinding="{Binding Reporter}"/>
                            <GridViewColumn Header="{wpf:Text Jira.ColumnSummary}" Width="260" DisplayMemberBinding="{Binding Summary}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Label Grid.Row="2" Grid.Column="0" Content="{wpf:Text Jira.LabelFilename}" Margin="0,0,12,0"/>
                <TextBox x:Name="FilenameBox" Grid.Row="2" Grid.Column="1"/>

                <Label Grid.Row="3" Grid.Column="0" Content="{wpf:Text Jira.LabelComment}" Margin="0,8,12,0"/>
                <TextBox x:Name="CommentBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"/>

                <Label Grid.Row="4" Grid.Column="0" Content="{wpf:Text Jira.LabelJira}" Margin="0,8,12,0"/>
                <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" LastChildFill="False">
                    <TextBox x:Name="KeyBox" Width="160" DockPanel.Dock="Left" TextChanged="KeyBox_TextChanged"/>
                    <Button DockPanel.Dock="Right" Content="{wpf:Text Core.Cancel}" IsCancel="True" Click="CancelButton_Click" Margin="8,0,0,0"/>
                    <Button x:Name="UploadButton" DockPanel.Dock="Right" Content="{wpf:Text Jira.Upload}" IsDefault="True"
                            Click="UploadButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Languages\greenshot*.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Loaded with EmbeddedResources.GetImage(typeof(JiraPlugin), "Jira") -->
    <EmbeddedResource Include="Images\Jira.png" LogicalName="Greenshot.Plugin.Jira.JiraPlugin.Jira" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Greenshot.Base\Greenshot.Base.csproj" />
    <!-- For the source generator of the JSON serializer, the library comes with Greenshot.Base -->
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
</Project>
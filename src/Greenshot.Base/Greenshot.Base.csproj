<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapplo.HttpExtensions.JsonNet" Version="2.0.12" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="Dapplo.Windows" Version="3.14.2" />
    <PackageReference Include="Dapplo.Windows.Automation" Version="3.14.2" />
    <PackageReference Include="Dapplo.Windows.Clipboard" Version="3.14.2" />
    <PackageReference Include="Dapplo.Windows.DesktopWindowsManager" Version="3.14.2" />
    <PackageReference Include="Dapplo.Windows.Dpi" Version="3.14.2" />
    <PackageReference Include="Dapplo.Windows.Gdi32" Version="3.14.2" />
    <PackageReference Include="Dapplo.Windows.Icons" Version="3.14.2" />
    <PackageReference Include="Dapplo.Windows.Input" Version="3.14.2" />
    <PackageReference Include="Dapplo.Windows.Kernel32" Version="3.14.2" />
    <PackageReference Include="Dapplo.Windows.Multimedia" Version="3.14.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="log4net" version="3.5.0" />
    <PackageReference Include="Svg" Version="3.4.8" />
    <!-- Newer than the one Dapplo.Windows brings, here so Greenshot and every plugin get the same System.Reactive.dll -->
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Dapplo.Ini" Version="1.1.11" />
    <PackageReference Include="Dapplo.Ini.Generator" Version="1.1.11" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.28000.2705" />
    <Reference Include="Accessibility" />
    <Reference Include="CustomMarshalers" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Greenshot" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Greenshot.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="log4net-embedded.xml" />
    <!-- The images and icons of GreenshotResources, see EmbeddedResources for the naming -->
    <EmbeddedResource Include="Resources\GreenshotResources\*.*" LogicalName="Greenshot.Base.Core.GreenshotResources.%(Filename)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageReference Update="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
  </ItemGroup>
</Project>

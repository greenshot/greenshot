<Window x:Class="Greenshot.Base.Wpf.Views.ServerSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <DockPanel>
            <wpf:ThemedTitleBar DockPanel.Dock="Top"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
                <Button x:Name="SignInButton" Content="{wpf:Text Core.SigninButton}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
                        IsEnabled="{Binding IsIdle}" Margin="0,0,6,0" Click="SignIn_Click"/>
                <Button Content="{wpf:Text Core.Cancel}" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"/>
            </StackPanel>

            <StackPanel Margin="16,10,16,12" IsEnabled="{Binding IsIdle}">
                <TextBlock Text="{Binding Url}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>

                <RadioButton Content="{wpf:Text Core.SigninKindCloud}" IsChecked="{Binding IsCloud}" GroupName="Kind"
                             Style="{StaticResource DefaultRadioButtonStyle}" Margin="0,0,0,6"
                             Visibility="{Binding OffersCloud, Converter={StaticResource VisibleWhenTrue}}"/>
                <RadioButton Content="{wpf:Text Core.SigninKindPassword}" IsChecked="{Binding IsPassword}" GroupName="Kind"
                             Style="{StaticResource DefaultRadioButtonStyle}" Margin="0,0,0,6"/>
                <RadioButton Content="{wpf:Text Core.SigninKindToken}" IsChecked="{Binding IsToken}" GroupName="Kind"
                             Style="{StaticResource DefaultRadioButtonStyle}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,8" Visibility="{Binding ShowsUserName, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="{Binding UserNameLabel}" Target="{Binding ElementName=UserNameBox}"/>
                    <TextBox x:Name="UserNameBox" Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="{Binding SecretLabel}" Target="{Binding ElementName=SecretBox}"/>
                    <PasswordBox x:Name="SecretBox" Grid.Column="1" PasswordChanged="SecretBox_PasswordChanged"/>
                </Grid>

                <Button Content="{wpf:Text Core.SigninCreateApiToken}" Style="{StaticResource LinkTextButtonStyle}" HorizontalAlignment="Left"
                        Margin="130,0,0,8" Click="CreateApiToken_Click"
                        Visibility="{Binding IsCloud, Converter={StaticResource VisibleWhenTrue}}"/>

                <CheckBox Content="{wpf:Text Core.SigninRemember}" IsChecked="{Binding Remember}" Margin="0,4,0,0"/>

                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" wpf:LiveRegion.Mode="Polite"
                           Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

<UserControl x:Class="Greenshot.Base.Wpf.Views.HotkeyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf"
             xmlns:views="clr-namespace:Greenshot.Base.Wpf.Views"
             xmlns:core="clr-namespace:Greenshot.Base.Core"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="520"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.ControlTabNavigation="Cycle"
             PreviewKeyDown="HotkeyEditorModal_PreviewKeyDown"
             PreviewKeyUp="HotkeyEditorModal_PreviewKeyUp">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/CheckBoxStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ComboBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Modern GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
            <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=GroupBoxBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{TemplateBinding Header}"
                                           FontWeight="SemiBold"
                                           FontSize="{wpf:FontSize 12}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="0,0,0,8"/>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#80000000" Focusable="False">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="500"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"
                Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.4"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="{Binding ActionTitle, StringFormat='Configure Hotkey: {0}'}"
                           FontSize="{wpf:FontSize 15}"
                           FontWeight="Bold"
                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                           Margin="0,0,0,16"/>

                <!-- Modifiers Section -->
                <GroupBox Grid.Row="1" Header="Modifiers" Margin="0,0,0,12">
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Ctrl -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
                            <CheckBox Content="Ctrl" IsChecked="{Binding Ctrl, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="56"/>
                            <ComboBox ItemsSource="{Binding AvailableLocations}"
                                      SelectedItem="{Binding CtrlLocation, Mode=TwoWay}"
                                      AutomationProperties.Name="Ctrl key, left or right"
                                      IsEnabled="{Binding Ctrl}"/>
                        </StackPanel>

                        <!-- Alt -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
                            <CheckBox Content="Alt" IsChecked="{Binding Alt, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="56"/>
                            <ComboBox ItemsSource="{Binding AvailableLocations}"
                                      SelectedItem="{Binding AltLocation, Mode=TwoWay}"
                                      AutomationProperties.Name="Alt key, left or right"
                                      IsEnabled="{Binding Alt}"/>
                        </StackPanel>

                        <!-- Shift -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
                            <CheckBox Content="Shift" IsChecked="{Binding Shift, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="56"/>
                            <ComboBox ItemsSource="{Binding AvailableLocations}"
                                      SelectedItem="{Binding ShiftLocation, Mode=TwoWay}"
                                      AutomationProperties.Name="Shift key, left or right"
                                      IsEnabled="{Binding Shift}"/>
                        </StackPanel>

                        <!-- Win -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
                            <CheckBox Content="Win" IsChecked="{Binding Win, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="56"/>
                            <ComboBox ItemsSource="{Binding AvailableLocations}"
                                      SelectedItem="{Binding WinLocation, Mode=TwoWay}"
                                      AutomationProperties.Name="Win key, left or right"
                                      IsEnabled="{Binding Win}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Key Sequence Capture Area -->
                <GroupBox Grid.Row="2" Header="Key Sequence Steps &amp; Capture" Margin="0,0,0,12">
                    <StackPanel Margin="0,6">
                        <!-- Step Chips & + Add Next Step -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding StepItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- A button, so a step can be selected with the keyboard too; the name says which one is selected -->
                                            <Button Margin="0,0,6,0"
                                                    Background="{Binding BackgroundBrush}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    Padding="8,4"
                                                    Cursor="Hand"
                                                    Command="{Binding SelectCommand}"
                                                    AutomationProperties.Name="{Binding AccessibleName}"
                                                    FocusVisualStyle="{StaticResource GreenshotFocusVisual}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="4"
                                                                BorderThickness="1.5"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StepHeader}" FontWeight="SemiBold" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StepText}" FontSize="{wpf:FontSize 11}" Foreground="{Binding TextBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    <Button Content="✕"
                                                            Command="{Binding RemoveCommand}"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Margin="6,0,0,0"
                                                            Padding="3,0"
                                                            FontSize="{wpf:FontSize 10}"
                                                            Cursor="Hand"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="{Binding MutedBrush}"
                                                            AutomationProperties.Name="Remove step"
                                                            ToolTip="Remove step"
                                                            FocusVisualStyle="{StaticResource GreenshotFocusVisual}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Column="1"
                                    Content="+ Add Step"
                                    Command="{Binding AddStepCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="{wpf:FontSize 11}"
                                    Padding="10,4"
                                    MinHeight="28"
                                    ToolTip="Add next chord step to this sequence"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Takes the pressed keys (the handlers of the UserControl), for a screen reader a read-only field with the hotkey as value -->
                        <views:HotkeyCaptureBox x:Name="KeyCaptureBorder"
                                Focusable="True"
                                Cursor="Hand"
                                CornerRadius="5"
                                BorderThickness="2"
                                MinHeight="54"
                                Padding="12,8"
                                AutomationProperties.Name="Hotkey"
                                AutomationProperties.HelpText="Press the keys of the hotkey. Tab moves on, Esc cancels."
                                MouseLeftButtonDown="KeyCaptureBorder_MouseLeftButtonDown"
                                GotFocus="KeyCaptureBorder_GotFocus"
                                LostFocus="KeyCaptureBorder_LostFocus">
                            <views:HotkeyCaptureBox.Style>
                                <!-- The colors in the style, local values would win over the focus trigger -->
                                <Style TargetType="views:HotkeyCaptureBox">
                                    <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
                                    <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ControlBackgroundBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </views:HotkeyCaptureBox.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TriggerKeyDisplay}"
                                           FontSize="{wpf:FontSize 14}"
                                           FontWeight="Bold"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CaptureHintText"
                                           Text="Click here to focus and press shortcut keys"
                                           FontSize="{wpf:FontSize 11}"
                                           FontStyle="Italic"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </views:HotkeyCaptureBox>

                        <!-- Multi-chord options -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1"
                                    Content="Clear / Reset"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource LightErrorButtonStyle}"
                                    FontSize="{wpf:FontSize 11}"
                                    Padding="10,4"
                                    MinHeight="28"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Live Preview Badges -->
                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                    <TextBlock Text="Preview:"
                               FontSize="{wpf:FontSize 11}"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"
                               Margin="0,0,0,4"/>
                    <views:HotkeyDisplayView x:Name="LivePreviewControl"
                                               ShowEditButton="False"
                                               HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Validation Feedback Banner -->
                <Border Grid.Row="4"
                        Margin="0,0,0,16"
                        Padding="8,6"
                        CornerRadius="4"
                        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.ErrorBackground}"
                        BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.ErrorBorder}"
                        BorderThickness="1"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ValidationError}"
                               FontSize="{wpf:FontSize 11}"
                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.ErrorBrush}"
                               TextWrapping="Wrap"
                               wpf:LiveRegion.Mode="Assertive"/>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save / Apply"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="100"
                            FontWeight="SemiBold"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="100"
                            Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

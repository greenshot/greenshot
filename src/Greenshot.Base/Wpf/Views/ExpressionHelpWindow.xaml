<Window x:Class="Greenshot.Base.Wpf.Views.ExpressionHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf"
        Title="{wpf:Text Core.ExpressionHelpTitle}"
        Height="600" Width="760"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.WindowBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ListViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0"/>

            <TextBlock x:Name="IntroTextBlock" Grid.Row="1" Margin="16,10,16,8" TextWrapping="Wrap"
                       FontSize="{wpf:FontSize 11}" Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}"/>

            <Grid Grid.Row="2" Margin="16,0,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="{wpf:Text Core.ExpressionHelpSearch}" Target="{Binding ElementName=SearchBox}" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.TextPrimary}"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            </Grid>

            <ListView x:Name="EntryList" Grid.Row="3" Margin="16,0,16,8"
                      AutomationProperties.Name="{wpf:Text Core.ExpressionHelpTitle}"
                      MouseDoubleClick="EntryList_MouseDoubleClick" KeyDown="EntryList_KeyDown"
                      SelectionMode="Single"
                      Style="{DynamicResource ThemeListView}">
                <ListView.ItemContainerStyle>
                    <!-- The theme's colors, also for the selected line; a screen reader says what to write and what it is -->
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ThemeListViewItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding SpokenText, TargetNullValue=''}"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,8,0,2"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.Accent}"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{DynamicResource ThemeGridViewColumnHeader}">
                        <GridViewColumn Header="{wpf:Text Core.ExpressionHelpExpression}" Width="280">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Expression}" FontFamily="Consolas, Segoe UI Mono, Courier New"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{wpf:Text Core.ExpressionHelpDescription}" Width="420">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Row="4" Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.CardBackground}"
                    BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.CardBorder}"
                    BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusTextBlock" wpf:LiveRegion.Mode="Polite" VerticalAlignment="Center" TextWrapping="Wrap"
                               FontSize="{wpf:FontSize 11}" Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=CurrentPalette.TextSecondary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CopyButton" Content="{wpf:Text Core.ExpressionHelpCopy}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="CopyButton_Click"/>
                        <Button Content="{wpf:Text Core.AccessibleClose}" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

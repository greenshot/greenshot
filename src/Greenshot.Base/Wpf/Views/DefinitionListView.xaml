<UserControl x:Class="Greenshot.Base.Wpf.Views.DefinitionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ListViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- The title names the list, the columns need no header -->
            <Style x:Key="NoColumnHeader" TargetType="GridViewColumnHeader" BasedOn="{StaticResource ThemeGridViewColumnHeader}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="TitleText" Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
        <!-- The rows are read with the ToString of the items (DefinitionListItem), the check box has its own name -->
        <ListView ItemsSource="{Binding Items, ElementName=Root}" SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}" SelectionMode="Single"
                  AutomationProperties.LabeledBy="{Binding ElementName=TitleText}"
                  Style="{StaticResource ThemeListView}" ItemContainerStyle="{StaticResource ThemeListViewItem}" MinHeight="80" MaxHeight="180"
                  Visibility="{Binding HasItems, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource NoColumnHeader}">
                    <!-- On or off, only for a plugin which supports it (DefinitionListItem.WithOnOff); a change applies at once -->
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}" VerticalAlignment="Center"
                                          ToolTip="{Binding OnOffName}" AutomationProperties.Name="{Binding OnOffName, TargetNullValue=''}"
                                          Visibility="{Binding CanTurnOnOff, Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Text="{Binding EmptyText, ElementName=Root}" TextWrapping="Wrap"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>

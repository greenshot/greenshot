<UserControl x:Class="Greenshot.Base.Wpf.Views.ServerAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{wpf:Text Core.SigninAccount}" FontWeight="SemiBold" FontSize="{wpf:FontSize 12}" Margin="0,0,0,4"
                   Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="{wpf:FontSize 12}" Margin="0,0,0,8" wpf:LiveRegion.Mode="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ErrorBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <WrapPanel>
            <Button Content="{wpf:Text Core.SigninAccountSignIn}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                    IsEnabled="{Binding IsIdle}" Click="SignIn_Click"/>
            <Button Content="{wpf:Text Core.SigninAccountTest}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                    IsEnabled="{Binding IsIdle}" Click="Test_Click"/>
            <Button Content="{wpf:Text Core.SigninAccountSignOut}" Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding CanSignOut}" Click="SignOut_Click"/>
        </WrapPanel>
    </StackPanel>
</UserControl>

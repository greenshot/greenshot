<Window x:Class="Greenshot.Base.Wpf.Views.DefinitionApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BackgroundBrush}"
        Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}" BorderThickness="1">
        <DockPanel>
            <wpf:ThemedTitleBar DockPanel.Dock="Top"/>

            <!-- The buttons come from the caller, the last one cancels and is the default -->
            <StackPanel x:Name="ButtonPanel" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" Focusable="False">
                <StackPanel Margin="16,10,16,12">
                    <!-- Icon, name and type: what the user decides about -->
                    <DockPanel Margin="0,0,0,10">
                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasIcon, Converter={StaticResource VisibleWhenTrue}}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" FontSize="{wpf:FontSize 15}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Kind}" TextWrapping="Wrap"
                                       Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding Question}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- What it does: read-only text boxes, so it can be selected and copied, and a screen reader reads label and value -->
                    <ItemsControl ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True" Focusable="False" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,2,12,0" VerticalAlignment="Top"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                             Background="Transparent" Padding="0" Margin="0,2,0,0"
                                             Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"
                                             AutomationProperties.Name="{Binding Label, FallbackValue=''}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>

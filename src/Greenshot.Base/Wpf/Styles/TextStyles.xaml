<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:Greenshot.Base.Wpf">
    <!-- The title of a card or a section -->
    <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{Binding Path=(wpf:ThemeScope.Theme).ForegroundBrush, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Margin" Value="0,4,0,6"/>
    </Style>

    <!-- Explaining text, less prominent than the content -->
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Path=(wpf:ThemeScope.Theme).MutedBrush, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- The current value right of a slider -->
    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>

<!--
    The keyboard focus of Greenshot's WPF controls: a solid 2px frame in the text color of the theme, visible on dark,
    light and high contrast backgrounds. WPF's own focus visual is a dotted black line, which disappears on dark backgrounds.
    The other style dictionaries merge this one, use it with FocusVisualStyle="{StaticResource GreenshotFocusVisual}".
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:Greenshot.Base.Wpf">
    <Style x:Key="GreenshotFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="4" RadiusY="4" StrokeThickness="2" SnapsToDevicePixels="True"
                               Stroke="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

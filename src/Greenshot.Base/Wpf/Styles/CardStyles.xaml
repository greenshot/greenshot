<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:Greenshot.Base.Wpf">
    <!-- A card: a framed block of content on the window background, the same in every window -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{Binding Path=(wpf:ThemeScope.Theme).CardBackground, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="BorderBrush" Value="{Binding Path=(wpf:ThemeScope.Theme).CardBorder, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
</ResourceDictionary>

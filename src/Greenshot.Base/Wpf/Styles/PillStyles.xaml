<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:Greenshot.Base.Wpf">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/FocusStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Lists of short entries shown as pills, each with an "x" to remove it, e.g. the excluded processes or the fixed capture sizes -->

    <!-- A pill: put the text and a RemoveEntryButtonStyle button in a horizontal StackPanel inside it -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,3,4,3"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <!-- A small round "x" to remove an entry; turns red on hover to signal removal. -->
    <Style x:Key="RemoveEntryButtonStyle" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{wpf:Text Core.AccessibleRemove}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GreenshotFocusVisual}"/>
        <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Width="18" Height="18">
                        <TextBlock Text="✕" FontSize="{wpf:FontSize 10}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ErrorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small round "+" in a pill which takes the entry into another list, e.g. a recent capture size into your own sizes;
         set AutomationProperties.Name and ToolTip to what it does. -->
    <Style x:Key="TakeEntryButtonStyle" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{wpf:Text Core.AccessibleAdd}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GreenshotFocusVisual}"/>
        <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Width="18" Height="18">
                        <TextBlock Text="+" FontSize="{wpf:FontSize 12}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A pill with a "+" at the end of the list, which adds an entry. -->
    <Style x:Key="AddPillButtonStyle" TargetType="Button">
        <Setter Property="AutomationProperties.Name" Value="{wpf:Text Core.AccessibleAdd}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GreenshotFocusVisual}"/>
        <Setter Property="Foreground" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ForegroundBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="10,3" MinHeight="26"
                            BorderThickness="1" BorderBrush="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=BorderBrush}">
                        <TextBlock Text="+" FontSize="{wpf:FontSize 14}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=ButtonBackgroundBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Source={x:Static wpf:ThemeManager.Instance}, Path=AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>


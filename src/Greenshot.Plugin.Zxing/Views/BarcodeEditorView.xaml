<!--
    The fields of a barcode: format, the content for the kind of QR code, colors and margin, the hint or error and a preview.
    The same view in the Barcode panel (with Insert), the Barcode section of the Selection panel (no preview, the barcode is in the
    capture) and the window for the options of a recipe step. The shared styles follow ThemeScope.Theme (the editor theme in the panel).
-->
<UserControl x:Class="Greenshot.Plugin.Zxing.Views.BarcodeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
             Foreground="{Binding Path=(wpf:ThemeScope.Theme).ForegroundBrush, RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/GreenshotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style TargetType="Label" BasedOn="{StaticResource GreenshotLabelStyle}">
                <Setter Property="Padding" Value="0,6,0,2"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,2,0,4">
        <Label Content="{wpf:Text Zxing.BarcodeFormat}" Target="{Binding ElementName=FormatBox}"/>
        <ComboBox x:Name="FormatBox" ItemsSource="{Binding Formats}" SelectedIndex="{Binding FormatIndex}"/>

        <StackPanel Visibility="{Binding IsQrCode, Converter={StaticResource BoolToVisibility}}">
            <Label Content="{wpf:Text Zxing.QrType}" Target="{Binding ElementName=QrCategoryBox}"/>
            <ComboBox x:Name="QrCategoryBox" ItemsSource="{Binding QrCategories}" SelectedIndex="{Binding QrCategoryIndex}"/>
        </StackPanel>

        <!-- The fields for the kind of QR code, the value for the other formats -->
        <TextBlock Text="{Binding InputsHeader}" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <StackPanel>
            <StackPanel Visibility="{Binding ShowsText, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{wpf:Text Zxing.RawText}" Target="{Binding ElementName=RawTextBox}"/>
                <TextBox x:Name="RawTextBox" Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="100"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsWifi, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{wpf:Text Zxing.WifiSsid}" Target="{Binding ElementName=WifiSsidBox}"/>
                <TextBox x:Name="WifiSsidBox" Text="{Binding WifiSsid, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.WifiPassword}" Target="{Binding ElementName=WifiPasswordBox}"/>
                <TextBox x:Name="WifiPasswordBox" Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.WifiEncryption}" Target="{Binding ElementName=WifiEncryptionBox}"/>
                <ComboBox x:Name="WifiEncryptionBox" ItemsSource="{Binding WifiEncryptions}" SelectedIndex="{Binding WifiEncryptionIndex}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsVcard, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{wpf:Text Zxing.VcardFirstName}" Target="{Binding ElementName=VcardFirstNameBox}"/>
                <TextBox x:Name="VcardFirstNameBox" Text="{Binding VcardFirstName, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.VcardLastName}" Target="{Binding ElementName=VcardLastNameBox}"/>
                <TextBox x:Name="VcardLastNameBox" Text="{Binding VcardLastName, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.VcardPhone}" Target="{Binding ElementName=VcardPhoneBox}"/>
                <TextBox x:Name="VcardPhoneBox" Text="{Binding VcardPhone, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.VcardEmail}" Target="{Binding ElementName=VcardEmailBox}"/>
                <TextBox x:Name="VcardEmailBox" Text="{Binding VcardEmail, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.VcardCompany}" Target="{Binding ElementName=VcardCompanyBox}"/>
                <TextBox x:Name="VcardCompanyBox" Text="{Binding VcardCompany, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.VcardUrl}" Target="{Binding ElementName=VcardUrlBox}"/>
                <TextBox x:Name="VcardUrlBox" Text="{Binding VcardUrl, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsEpc, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{wpf:Text Zxing.EpcRecipient}" Target="{Binding ElementName=EpcNameBox}"/>
                <TextBox x:Name="EpcNameBox" Text="{Binding EpcName, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EpcIban}" Target="{Binding ElementName=EpcIbanBox}"/>
                <TextBox x:Name="EpcIbanBox" Text="{Binding EpcIban, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EpcBic}" Target="{Binding ElementName=EpcBicBox}"/>
                <TextBox x:Name="EpcBicBox" Text="{Binding EpcBic, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EpcAmount}" Target="{Binding ElementName=EpcAmountBox}"/>
                <TextBox x:Name="EpcAmountBox" Text="{Binding EpcAmount, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EpcReference}" Target="{Binding ElementName=EpcReferenceBox}"/>
                <TextBox x:Name="EpcReferenceBox" Text="{Binding EpcReference, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.Message}" Target="{Binding ElementName=EpcMessageBox}"/>
                <TextBox x:Name="EpcMessageBox" Text="{Binding EpcMessage, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsEmail, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{wpf:Text Zxing.EmailTo}" Target="{Binding ElementName=EmailToBox}"/>
                <TextBox x:Name="EmailToBox" Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EmailSubject}" Target="{Binding ElementName=EmailSubjectBox}"/>
                <TextBox x:Name="EmailSubjectBox" Text="{Binding EmailSubject, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EmailBody}" Target="{Binding ElementName=EmailBodyBox}"/>
                <TextBox x:Name="EmailBodyBox" Text="{Binding EmailBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="100"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsCalendar, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{wpf:Text Zxing.EventTitle}" Target="{Binding ElementName=EventTitleBox}"/>
                <TextBox x:Name="EventTitleBox" Text="{Binding EventTitle, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EventLocation}" Target="{Binding ElementName=EventLocationBox}"/>
                <TextBox x:Name="EventLocationBox" Text="{Binding EventLocation, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EventStart}" Target="{Binding ElementName=EventStartBox}"/>
                <TextBox x:Name="EventStartBox" Text="{Binding EventStart, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EventEnd}" Target="{Binding ElementName=EventEndBox}"/>
                <TextBox x:Name="EventEndBox" Text="{Binding EventEnd, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.EventDescription}" Target="{Binding ElementName=EventDescriptionBox}"/>
                <TextBox x:Name="EventDescriptionBox" Text="{Binding EventDescription, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsPhone, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{wpf:Text Zxing.PhoneNumber}" Target="{Binding ElementName=PhoneNumberBox}"/>
                <TextBox x:Name="PhoneNumberBox" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsSms, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{wpf:Text Zxing.SmsNumber}" Target="{Binding ElementName=SmsNumberBox}"/>
                <TextBox x:Name="SmsNumberBox" Text="{Binding SmsNumber, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.Message}" Target="{Binding ElementName=SmsMessageBox}"/>
                <TextBox x:Name="SmsMessageBox" Text="{Binding SmsMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="48" MaxHeight="100"/>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowsGeo, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{wpf:Text Zxing.GeoLatitude}" Target="{Binding ElementName=LatitudeBox}"/>
                <TextBox x:Name="LatitudeBox" Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="{wpf:Text Zxing.GeoLongitude}" Target="{Binding ElementName=LongitudeBox}"/>
                <TextBox x:Name="LongitudeBox" Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <!-- The look -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Border x:Name="ForeColorSwatch" Width="22" Height="22" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                    BorderBrush="{Binding Path=(wpf:ThemeScope.Theme).ControlBorderBrush, RelativeSource={RelativeSource Self}}"/>
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{wpf:Text Zxing.Foreground}" Margin="6,0,12,0" Padding="10,4"
                    Click="ForeColor_Click"/>
            <Border x:Name="BackColorSwatch" Width="22" Height="22" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                    BorderBrush="{Binding Path=(wpf:ThemeScope.Theme).ControlBorderBrush, RelativeSource={RelativeSource Self}}"/>
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{wpf:Text Zxing.Background}" Margin="6,0,0,0" Padding="10,4"
                    Click="BackColor_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox Content="{wpf:Text Zxing.RoundedDots}" IsChecked="{Binding RoundedDots}" VerticalAlignment="Center" Margin="0,0,12,0"
                      Visibility="{Binding Is2D, Converter={StaticResource BoolToVisibility}}"/>
            <Label Content="{wpf:Text Zxing.Margin}" Target="{Binding ElementName=MarginBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="MarginBox" Width="60" ItemsSource="{Binding Margins}" SelectedIndex="{Binding Margin}"/>
        </StackPanel>

        <!-- Hints and errors of the input, announced when they change -->
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="{wpf:FontSize 11}" Margin="0,8,0,0" wpf:LiveRegion.Mode="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Path=(wpf:ThemeScope.Theme).MutedBrush, RelativeSource={RelativeSource Self}}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{Binding Path=(wpf:ThemeScope.Theme).ErrorBrush, RelativeSource={RelativeSource Self}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True"
                Background="{Binding Path=(wpf:ThemeScope.Theme).TextBoxBackgroundBrush, RelativeSource={RelativeSource Self}}"
                BorderBrush="{Binding Path=(wpf:ThemeScope.Theme).ControlBorderBrush, RelativeSource={RelativeSource Self}}"
                Visibility="{Binding ShowsPreview, Converter={StaticResource BoolToVisibility}}">
            <Image x:Name="PreviewImage" AutomationProperties.Name="{wpf:Text Zxing.Preview}" Stretch="Uniform" MaxHeight="180" Margin="8"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <!-- Only in the Barcode panel -->
        <Button x:Name="InsertButton" Style="{StaticResource PrimaryButtonStyle}" Content="{wpf:Text Zxing.Insert}"
                HorizontalAlignment="Right" MinWidth="100" Margin="0,10,0,0" Visibility="Collapsed"
                IsEnabled="{Binding CanInsert}" Click="Insert_Click"/>
    </StackPanel>
</UserControl>

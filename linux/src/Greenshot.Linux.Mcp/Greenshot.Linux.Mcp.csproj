<Project Sdk="Microsoft.NET.Sdk">
  <!--
    greenshot-mcp: an MCP server (stdio) for AI tools, it talks to the running Greenshot over its socket.
    It is installed next to greenshot: Greenshot only accepts greenshot-mcp from its own folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>greenshot-mcp</AssemblyName>
    <RootNamespace>Greenshot.Mcp</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where Greenshot's socket is -->
    <ProjectReference Include="..\Greenshot.Linux.Core\Greenshot.Linux.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recipe schema and some examples, for AI tools which write recipes -->
    <EmbeddedResource Include="..\..\..\docs\vNext\recipe.schema.json" LogicalName="recipe.schema.json" />
    <EmbeddedResource Include="..\..\..\docs\vNext\examples\region_blue_border.gsrecipe.json" LogicalName="region_blue_border.gsrecipe.json" />
    <EmbeddedResource Include="..\..\..\docs\vNext\examples\window_regex_redact.gsrecipe.json" LogicalName="window_regex_redact.gsrecipe.json" />
    <EmbeddedResource Include="..\..\..\docs\vNext\examples\cli_ocr_extract.gsrecipe.json" LogicalName="cli_ocr_extract.gsrecipe.json" />
  </ItemGroup>

</Project>

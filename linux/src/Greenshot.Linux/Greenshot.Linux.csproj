<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Greenshot.Linux</RootNamespace>
    <AssemblyName>greenshot</AssemblyName>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Greenshot.Linux.Core\Greenshot.Linux.Core.csproj" />
    <ProjectReference Include="..\Greenshot.Linux.Editor\Greenshot.Linux.Editor.csproj" />
    <ProjectReference Include="..\Greenshot.Linux.Plugins\Greenshot.Linux.Plugins.csproj" />
    <ProjectReference Include="..\Greenshot.Linux.Recipes\Greenshot.Linux.Recipes.csproj" />
    <ProjectReference Include="..\Greenshot.Linux.RecipeEditor\Greenshot.Linux.RecipeEditor.csproj" />
    <!-- greenshot-mcp next to greenshot: Greenshot only accepts it from its own folder -->
    <ProjectReference Include="..\Greenshot.Linux.Mcp\Greenshot.Linux.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The emoji font for the emoji picker, the same one draws the emoji elements -->
    <AvaloniaResource Include="..\..\..\src\Greenshot.Editor\Drawing\Emoji\Twemoji.Mozilla.ttf" Link="Assets\Fonts\Twemoji.Mozilla.ttf" />
  </ItemGroup>
  <ItemGroup>
    <!-- The language packs are shared with the Windows version -->
    <None Include="..\..\..\src\Greenshot\Languages\greenshot.*.ini" Link="Languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Languages\greenshot-linux.*.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\src\Greenshot.Plugin.*\Languages\greenshot.*.ini" Link="Languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

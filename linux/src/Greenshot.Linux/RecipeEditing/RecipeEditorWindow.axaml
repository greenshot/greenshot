<!--
  The recipe editor: the toolbox of steps on the left, the canvas with the steps and their arrows in the middle,
  the inspector of the selected step, the recipe and its triggers on the right. Ported from the RecipeEditorWindow
  of the Windows plugin, the canvas (Nodify there) is RecipeGraphCanvas.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="using:Greenshot.Linux.RecipeEditing"
        xmlns:re="using:Greenshot.Linux.RecipeEditing"
        xmlns:vm="using:Greenshot.Linux.RecipeEditor.ViewModels"
        xmlns:recipes="using:Greenshot.Linux.Recipes"
        x:Class="Greenshot.Linux.RecipeEditing.RecipeEditorWindow"
        x:DataType="vm:RecipeEditorViewModel"
        Title="{Binding WindowTitle}"
        Height="800" Width="1240"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RE.WindowBackground}">

    <Window.Styles>
        <StyleInclude Source="avares://greenshot/RecipeEditing/RecipeEditorStyles.axaml"/>
        <Style Selector="TabControl.inspector TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <!-- The inputs of the inspector as compact as its labels -->
        <Style Selector="TextBox, ComboBox, NumericUpDown, CheckBox, RadioButton, ToggleButton">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveRecipeCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenRecipeCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewRecipeCommand}"/>
        <KeyBinding Gesture="Ctrl+L" Command="{Binding AutoLayoutCommand}"/>
        <KeyBinding Gesture="Ctrl+M" Command="{Binding OpenRecipeManagerCommand}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <!-- A step on the canvas: header with icon, title and start badge, the summary, the pins (in on top, out at the bottom,
             one per branch or choice for decisions) -->
        <DataTemplate x:Key="StepNodeTemplate" x:DataType="vm:StepNodeViewModel">
            <Panel Width="220">
                <Border Name="Card" Background="{DynamicResource RE.NodeCardBackground}"
                        BorderBrush="{DynamicResource RE.NodeCardBorder}"
                        BorderThickness="1.5" CornerRadius="8" Margin="0,9,0,9"
                        BoxShadow="0 3 12 0 #59000000"
                        Classes.selected="{Binding IsSelected}">
                    <Border.Styles>
                        <Style Selector="Border#Card.selected">
                            <Setter Property="BorderBrush" Value="{DynamicResource RE.Accent}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Style>
                    </Border.Styles>
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Header -->
                        <Border Grid.Row="0" Background="{Binding StepType, Converter={x:Static re:StepTypeToColorConverter.Instance}}"
                                CornerRadius="7,7,0,0" Padding="10,5">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="{Binding StepType, Converter={x:Static re:StepTypeToIconConverter.Instance}}"
                                           FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="White"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" Background="{DynamicResource RE.BadgeBackground}" CornerRadius="3"
                                        BorderBrush="{DynamicResource RE.Success}" BorderThickness="1" Padding="4,1" Margin="4,0,0,0"
                                        IsVisible="{Binding IsStartNode}">
                                    <TextBlock Text="{r:Text RecipeEditor.badge_start}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource RE.Success}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Content -->
                        <Border Grid.Row="1" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" FontFamily="monospace" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource RE.TextPrimary}" TextWrapping="Wrap"
                                           IsVisible="{Binding !HasDynamicOutputPorts}"/>

                                <!-- Slot: the automatic steps which plug in, greyed out (they are not part of the recipe) -->
                                <StackPanel IsVisible="{Binding IsSlot}" Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding SlotExtensions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding StringFormat='⤷ {0}'}" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource RE.TextSecondary}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{r:Text RecipeEditor.slot_no_extensions}" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource RE.TextSecondary}"
                                               IsVisible="{Binding HasNoSlotExtensions}"/>
                                </StackPanel>

                                <!-- The branches of a decision -->
                                <StackPanel IsVisible="{Binding IsConditional}">
                                    <TextBlock Text="{r:Text RecipeEditor.branches}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding ConditionBranches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ConditionBranchViewModel">
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,1,0,2">
                                                    <Border Classes="badge" Margin="0,0,6,0" Padding="4,1">
                                                        <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource RE.Accent}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Expression}" FontSize="10" FontFamily="monospace" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource RE.TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Expression}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- The choices of a question to the user -->
                                <StackPanel IsVisible="{Binding IsUserPrompt}">
                                    <TextBlock Text="{Binding UserPromptMessage}" FontSize="10" Foreground="{DynamicResource RE.TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding PromptChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PromptChoiceViewModel">
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,1,0,2">
                                                    <Border Classes="badge" Margin="0,0,6,0" Padding="4,1">
                                                        <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource RE.Accent}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="10" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource RE.TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- One pin per branch of a decision -->
                        <Border Grid.Row="2" Background="{DynamicResource RE.BadgeBackground}" BorderBrush="{DynamicResource RE.CardBorder}"
                                BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="2,3,2,0" IsVisible="{Binding IsConditional}">
                            <ItemsControl ItemsSource="{Binding ConditionBranches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConditionBranchViewModel">
                                        <Grid Height="30" RowDefinitions="Auto,*" ToolTip.Tip="{Binding Expression}">
                                            <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,1,0,0" Background="{DynamicResource RE.CardBackground}"
                                                    BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="3" Padding="6,1">
                                                <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource RE.Accent}"/>
                                            </Border>
                                            <re:PortPin Grid.Row="1" Port="{Binding Port}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-9" ZIndex="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- One pin per choice of a question -->
                        <Border Grid.Row="2" Background="{DynamicResource RE.BadgeBackground}" BorderBrush="{DynamicResource RE.CardBorder}"
                                BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="2,3,2,0" IsVisible="{Binding IsUserPrompt}">
                            <ItemsControl ItemsSource="{Binding PromptChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PromptChoiceViewModel">
                                        <Grid Height="30" RowDefinitions="Auto,*" ToolTip.Tip="{Binding Label}">
                                            <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,1,0,0" Background="{DynamicResource RE.CardBackground}"
                                                    BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="3" Padding="6,1">
                                                <TextBlock Text="{Binding Key}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource RE.Accent}"/>
                                            </Border>
                                            <re:PortPin Grid.Row="1" Port="{Binding Port}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-9" ZIndex="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Border>

                <!-- The input pin on the top edge, the output pin on the bottom edge (decisions and questions have one per branch) -->
                <re:PortPin Port="{Binding InputPort}" HorizontalAlignment="Center" VerticalAlignment="Top" ZIndex="10"/>
                <re:PortPin Port="{Binding OutputPort}" HorizontalAlignment="Center" VerticalAlignment="Bottom" ZIndex="10"
                            IsVisible="{Binding !HasDynamicOutputPorts}"/>
            </Panel>
        </DataTemplate>
    </Window.Resources>

    <Border BorderThickness="0" Background="{DynamicResource RE.WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Main Toolbar -->
                <RowDefinition Height="*"/>    <!-- Canvas & Sidebars -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Main Toolbar -->
            <Border Grid.Row="1" Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="0,0,0,1" Padding="10,6">
                <DockPanel LastChildFill="True">
                    <!-- What is pending for the approval of the current recipe -->
                    <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="10,5" CornerRadius="4"
                            Background="{DynamicResource RE.WarningBackground}" BorderBrush="{DynamicResource RE.WarningBorder}" BorderThickness="1"
                            IsVisible="{Binding HasApprovalNotice}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ApprovalNotice}" FontSize="11" Foreground="{DynamicResource RE.TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Content="{r:Text RecipeEditor.review_approval}" Classes="secondary" Command="{Binding ReviewApprovalCommand}" Margin="10,0,0,0" Padding="8,2"
                                    IsVisible="{Binding CanReviewApproval}" ToolTip.Tip="{r:Text RecipeEditor.tip_review_approval}"/>
                        </StackPanel>
                    </Border>
                    <!-- The groups wrap when the window is narrow -->
                    <WrapPanel>

                        <!-- Recipe Selector & Manager -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"><Run Text="{r:Text RecipeEditor.recipe}"/><Run Text=":"/></TextBlock>
                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.recipe}" ItemsSource="{Binding AvailableRecipes}"
                                      SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                                     
                                      Width="200" Height="28" Margin="0,0,6,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="recipes:CaptureRecipe">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding IsEnabled, Converter={x:Static re:BoolToStatusBrushConverter.Instance}}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <TextBlock FontStyle="Italic" FontSize="10"
                                                       Foreground="{DynamicResource RE.TextSecondary}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsEnabled}"><Run Text=" "/><Run Text="{r:Text RecipeEditor.deactivated}"/></TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Quick Active / Deactivate Toggle for Selected Recipe -->
                            <Button Classes="secondary" Command="{Binding ToggleActiveRecipeEnabledCommand}" AutomationProperties.Name="{Binding ActiveRecipeStatusText, TargetNullValue=''}"
                                    ToolTip.Tip="{r:Text RecipeEditor.tip_toggle_recipe_active}" Margin="0,0,6,0" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Fill="{Binding IsActiveRecipeEnabled, Converter={x:Static re:BoolToStatusBrushConverter.Instance}}"/>
                                    <TextBlock Text="{Binding ActiveRecipeStatusText}" FontWeight="SemiBold" FontSize="10"/>
                                </StackPanel>
                            </Button>

                            <!-- Quick Unload button if custom or overridden -->
                            <Button Classes="secondary" Command="{Binding UnloadActiveRecipeCommand}" AutomationProperties.Name="{Binding UnloadActiveRecipeText, TargetNullValue=''}"
                                    IsVisible="{Binding CanUnloadActiveRecipe}"
                                    ToolTip.Tip="{Binding UnloadActiveRecipeToolTip}" Margin="0,0,6,0" Padding="8,4">
                                <TextBlock Text="{Binding UnloadActiveRecipeText}" FontSize="10"/>
                            </Button>

                            <!-- Visual Recipe Manager Button -->
                            <Button Classes="secondary" Command="{Binding OpenRecipeManagerCommand}" AutomationProperties.Name="{r:Text RecipeEditor.manage_recipes}"
                                    ToolTip.Tip="{r:Text RecipeEditor.tip_manage_recipes}" Margin="0,0,6,0" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="{r:Text RecipeEditor.manage_recipes}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Actions Toolbar -->
                        <StackPanel Orientation="Horizontal" Margin="9,2,9,2" Spacing="4">
                            <Button Content="{r:Text RecipeEditor.btn_new}" Classes="secondary" Command="{Binding NewRecipeCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_new_recipe}"/>
                            <Button Content="{r:Text RecipeEditor.btn_new_extension}" Classes="secondary" Command="{Binding NewExtensionCommand}"
                                    ToolTip.Tip="{r:Text RecipeEditor.tip_new_extension}"/>
                            <Button Content="{r:Text RecipeEditor.btn_open}" Classes="secondary" Command="{Binding OpenRecipeCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_open_recipe}"/>
                            <Button Content="{r:Text RecipeEditor.btn_save}" Classes="secondary" Command="{Binding SaveRecipeCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_save_recipe}"/>
                            <Button Content="{r:Text RecipeEditor.btn_save_as}" Classes="secondary" Command="{Binding SaveAsCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_save_recipe_as}"/>
                            <Border Width="1" Background="{DynamicResource RE.CardBorder}" Margin="6,2"/>
                            <Button Content="{r:Text RecipeEditor.btn_undo}" Classes="secondary" Command="{Binding UndoCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_undo}"/>
                            <Button Content="{r:Text RecipeEditor.btn_redo}" Classes="secondary" Command="{Binding RedoCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_redo}"/>
                            <Border Width="1" Background="{DynamicResource RE.CardBorder}" Margin="6,2"/>
                            <Button Content="{r:Text RecipeEditor.btn_auto_layout}" Classes="secondary" Command="{Binding AutoLayoutCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_auto_layout}"/>
                            <Button Content="{}{ } JSON" Classes="secondary" Command="{Binding ToggleJsonViewCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_edit_json}"/>
                            <Button Content="🧜 Mermaid" Classes="secondary" Command="{Binding ToggleMermaidViewCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_mermaid}"/>
                        </StackPanel>

                        <!-- Right Action: Test Run -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                            <Button Content="{Binding ThemeToggleIcon}" Classes="secondary" Command="{Binding ToggleThemeCommand}"
                                    ToolTip.Tip="{Binding ThemeToggleToolTip}" AutomationProperties.Name="{Binding ThemeToggleText}"/>
                            <Button Content="{r:Text RecipeEditor.btn_test_run}" Classes="primary" Command="{Binding TestRunCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_test_run}"/>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Main Workspace -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="180" MaxWidth="300"/> <!-- Left Toolbox -->
                    <ColumnDefinition Width="*"/>                                 <!-- Nodify DAG Canvas -->
                    <ColumnDefinition Width="320" MinWidth="260" MaxWidth="440"/> <!-- Right Properties Inspector -->
                </Grid.ColumnDefinitions>

                <!-- Left Toolbox -->
                <Border Grid.Column="0" Background="{DynamicResource RE.WindowBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="0,0,1,0" Padding="8">
                    <ScrollViewer
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{r:Text RecipeEditor.header_step_toolbox}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="4,4,0,2"/>
                            <TextBlock Text="{r:Text RecipeEditor.hint_toolbox}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource RE.TextSecondary}" Margin="4,0,0,8"/>

                            <!-- 1. Acquisition -->
                            <TextBlock Text="{r:Text RecipeEditor.header_acquisition}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="4,8,0,4"/>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_source}" Command="{Binding AddStepCommand}" CommandParameter="Source">
                                <TextBlock><Run Text="📷 "/><Run Text="{r:Text RecipeEditor.step_source}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_interactive_selection}" Command="{Binding AddStepCommand}" CommandParameter="InteractiveSelection">
                                <TextBlock><Run Text="🔲 "/><Run Text="{r:Text RecipeEditor.step_interactive_selection}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_record_video}" Command="{Binding AddStepCommand}" CommandParameter="RecordVideo">
                                <TextBlock><Run Text="🎥 "/><Run Text="{r:Text RecipeEditor.step_record_video}"/></TextBlock>
                            </Button>

                            <!-- 2. Filters & Effects -->
                            <TextBlock Text="{r:Text RecipeEditor.header_filters_effects}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="4,12,0,4"/>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_effect}" Command="{Binding AddStepCommand}" CommandParameter="Effect">
                                <TextBlock><Run Text="✨ "/><Run Text="{r:Text RecipeEditor.step_effect}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_text_effect}" Command="{Binding AddStepCommand}" CommandParameter="TextEffect">
                                <TextBlock><Run Text="🛡️ "/><Run Text="{r:Text RecipeEditor.step_text_effect}"/></TextBlock>
                            </Button>

                            <!-- 3. Annotations & Variables -->
                            <TextBlock Text="{r:Text RecipeEditor.header_annotations_data}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="4,12,0,4"/>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_annotation}" Command="{Binding AddStepCommand}" CommandParameter="Annotation">
                                <TextBlock><Run Text="🎨 "/><Run Text="{r:Text RecipeEditor.step_annotation}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_set_variable}" Command="{Binding AddStepCommand}" CommandParameter="SetVariable">
                                <TextBlock><Run Text="💲 "/><Run Text="{r:Text RecipeEditor.step_set_variable}"/></TextBlock>
                            </Button>

                            <!-- 4. Execution & Logic -->
                            <TextBlock Text="{r:Text RecipeEditor.header_flow_feedback}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="4,12,0,4"/>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.summary_prompt_none}" Command="{Binding AddStepCommand}" CommandParameter="UserPrompt">
                                <TextBlock><Run Text="❓ "/><Run Text="{r:Text RecipeEditor.summary_prompt_none}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_conditional}" Command="{Binding AddStepCommand}" CommandParameter="Conditional">
                                <TextBlock><Run Text="🔀 "/><Run Text="{r:Text RecipeEditor.step_conditional}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_slot}" Command="{Binding AddStepCommand}" CommandParameter="Slot"
                                    ToolTip.Tip="{r:Text RecipeEditor.tip_step_slot}">
                                <TextBlock><Run Text="🧩 "/><Run Text="{r:Text RecipeEditor.step_slot}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_shutter_sound}" Command="{Binding AddStepCommand}" CommandParameter="ImmediateFeedback">
                                <TextBlock><Run Text="🔊 "/><Run Text="{r:Text RecipeEditor.step_shutter_sound}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_notification}" Command="{Binding AddStepCommand}" CommandParameter="Notification">
                                <TextBlock><Run Text="🔔 "/><Run Text="{r:Text RecipeEditor.step_notification}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_ocr}" Command="{Binding AddStepCommand}" CommandParameter="Ocr">
                                <TextBlock><Run Text="🔤 "/><Run Text="{r:Text RecipeEditor.step_ocr}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_stdout}" Command="{Binding AddStepCommand}" CommandParameter="Stdout">
                                <TextBlock><Run Text="📤 "/><Run Text="{r:Text RecipeEditor.step_stdout}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_stderr}" Command="{Binding AddStepCommand}" CommandParameter="Stderr">
                                <TextBlock><Run Text="⛔ "/><Run Text="{r:Text RecipeEditor.step_stderr}"/></TextBlock>
                            </Button>

                            <!-- 5. Destinations & Output -->
                            <TextBlock Text="{r:Text RecipeEditor.header_output_destinations}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="4,12,0,4"/>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_dynamic_destination}" Command="{Binding AddStepCommand}" CommandParameter="DynamicDestination">
                                <TextBlock><Run Text="🎯 "/><Run Text="{r:Text RecipeEditor.step_dynamic_destination}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_save_file}" Command="{Binding AddStepCommand}" CommandParameter="SaveFile">
                                <TextBlock><Run Text="💾 "/><Run Text="{r:Text RecipeEditor.step_save_file}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_clipboard}" Command="{Binding AddStepCommand}" CommandParameter="Clipboard">
                                <TextBlock><Run Text="📋 "/><Run Text="{r:Text RecipeEditor.step_clipboard}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.import_source_image_editor}" Command="{Binding AddStepCommand}" CommandParameter="Editor">
                                <TextBlock><Run Text="🎨 "/><Run Text="{r:Text RecipeEditor.import_source_image_editor}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_printer}" Command="{Binding AddStepCommand}" CommandParameter="Printer">
                                <TextBlock><Run Text="🖨️ "/><Run Text="{r:Text RecipeEditor.step_printer}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_email}" Command="{Binding AddStepCommand}" CommandParameter="Email">
                                <TextBlock><Run Text="📧 "/><Run Text="{r:Text RecipeEditor.step_email}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.summary_custom_destination}" Command="{Binding AddStepCommand}" CommandParameter="CustomDestination">
                                <TextBlock><Run Text="↗️ "/><Run Text="{r:Text RecipeEditor.summary_custom_destination}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_destinations}" Command="{Binding AddStepCommand}" CommandParameter="Destinations">
                                <TextBlock><Run Text="↗️ "/><Run Text="{r:Text RecipeEditor.step_destinations}"/></TextBlock>
                            </Button>

                            <!-- 6. Extensions & Plugins -->
                            <TextBlock Text="{r:Text RecipeEditor.header_plugins}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="4,12,0,4"/>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_external_command}" Command="{Binding AddStepCommand}" CommandParameter="ExternalCommand">
                                <TextBlock><Run Text="⚡ "/><Run Text="{r:Text RecipeEditor.step_external_command}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="Atlassian Jira" Command="{Binding AddStepCommand}" CommandParameter="Jira">
                                <TextBlock Text="🎯 Atlassian Jira"/>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_confluence}" Command="{Binding AddStepCommand}" CommandParameter="Confluence">
                                <TextBlock><Run Text="📄 "/><Run Text="{r:Text RecipeEditor.step_confluence}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text Pdf.destination}" Command="{Binding AddStepCommand}" CommandParameter="Pdf">
                                <TextBlock><Run Text="💾 "/><Run Text="{r:Text Pdf.destination}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_zxing}" Command="{Binding AddStepCommand}" CommandParameter="BarcodeScan">
                                <TextBlock><Run Text="🔍 "/><Run Text="{r:Text RecipeEditor.step_zxing}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="{r:Text RecipeEditor.step_box}" Command="{Binding AddStepCommand}" CommandParameter="Box">
                                <TextBlock><Run Text="📦 "/><Run Text="{r:Text RecipeEditor.step_box}"/></TextBlock>
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="Dropbox" Command="{Binding AddStepCommand}" CommandParameter="Dropbox">
                                <TextBlock Text="📦 Dropbox"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Center Nodify DAG Canvas -->
                <Grid Grid.Column="1" Background="{DynamicResource RE.WindowBackground}">
                    <re:RecipeGraphCanvas x:Name="EditorCanvas" NodeTemplate="{StaticResource StepNodeTemplate}"/>


                    <!-- In-Canvas JSON Editor Overlay -->
                    <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="6"
                            Margin="30" Padding="15"
                            IsVisible="{Binding IsJsonViewVisible}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{r:Text RecipeEditor.recipe_json}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource RE.TextPrimary}" Margin="0,0,0,10"/>
                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.recipe_json}" Grid.Row="1" Text="{Binding RawJsonText, Mode=TwoWay}"
                                     FontFamily="monospace" FontSize="12"
                                    
                                     AcceptsReturn="True" AcceptsTab="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="{r:Text RecipeEditor.btn_apply_changes}" Classes="primary" Command="{Binding ApplyJsonCommand}"/>
                                <Button Content="{r:Text Core.accessible_close}" Classes="secondary" Command="{Binding ToggleJsonViewCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- In-Canvas Mermaid Editor Overlay -->
                    <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="6"
                            Margin="30" Padding="15"
                            IsVisible="{Binding IsMermaidViewVisible}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{r:Text RecipeEditor.mermaid_dsl}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource RE.TextPrimary}"/>
                                    <TextBlock Text="{r:Text RecipeEditor.hint_mermaid}"
                                               FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.mermaid_dsl}" Grid.Row="1" Text="{Binding MermaidText, Mode=OneWay}"
                                     FontFamily="monospace" FontSize="12"
                                    
                                     IsReadOnly="True"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="{r:Text RecipeEditor.btn_copy_mermaid}" Classes="primary" Command="{Binding CopyMermaidCommand}" Margin="0,0,8,0"/>
                                <Button Content="{r:Text Core.accessible_close}" Classes="secondary" Command="{Binding ToggleMermaidViewCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Sidebar: Properties & Step Inspector / Recipe & Triggers Tabs -->
                <Border Grid.Column="2" Background="{DynamicResource RE.WindowBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1,0,0,0">
                    <TabControl Classes="inspector" SelectedIndex="{Binding SelectedInspectorTabIndex, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Margin="4,4,4,4">
                        <!-- Tab 1: Step Inspector -->
                        <TabItem Header="{r:Text RecipeEditor.tab_step_inspector}">
                            <ScrollViewer
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          Padding="6,8,6,8">
                                <StackPanel>
                                    <!-- When a connection is selected -->
                                    <StackPanel IsVisible="{Binding HasSelectedConnection}">
                                        <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{r:Text RecipeEditor.header_connection_selected}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RE.Accent}" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource RE.BadgeBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                        <StackPanel>
                                                            <TextBlock Text="{r:Text RecipeEditor.connection_from}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBlock Text="{Binding SelectedConnection.SourceNode.DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource RE.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SelectedConnection.Source.Title}" FontSize="10" Foreground="{DynamicResource RE.Accent}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="➔" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center" Margin="6,0"/>
                                                    <Border Grid.Column="2" Background="{DynamicResource RE.BadgeBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                        <StackPanel>
                                                            <TextBlock Text="{r:Text RecipeEditor.connection_to}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBlock Text="{Binding SelectedConnection.TargetNode.DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource RE.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SelectedConnection.Target.Title}" FontSize="10" Foreground="{DynamicResource RE.Accent}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Button Content="{r:Text RecipeEditor.delete_connection}" Classes="error small"
                                                        Command="{Binding SelectedConnection.DisconnectCommand}"
                                                        ToolTip.Tip="{r:Text RecipeEditor.tip_delete_connection}"/>
                                                <TextBlock Text="{r:Text RecipeEditor.hint_delete_connection}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- When a node is selected -->
                                    <StackPanel IsVisible="{Binding HasSelectedNode}">
                                        <!-- Start Step Status / Toggle -->
                                        <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="{r:Text RecipeEditor.flow_entry_point}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource RE.TextPrimary}"/>
                                                        <TextBlock Text="{r:Text RecipeEditor.hint_flow_entry_point}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource RE.BadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                            BorderBrush="{DynamicResource RE.Success}" BorderThickness="1"
                                                            IsVisible="{Binding SelectedNode.IsStartNode}">
                                                        <TextBlock Text="{r:Text RecipeEditor.badge_start_step}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource RE.Success}"/>
                                                    </Border>
                                                </Grid>
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Content="{r:Text RecipeEditor.btn_mark_start}" Classes="secondary" Margin="0,0,6,0"
                                                            Command="{Binding SelectedNode.ToggleStartNodeCommand}"
                                                            IsVisible="{Binding !SelectedNode.IsStartNode}"
                                                            ToolTip.Tip="{r:Text RecipeEditor.tip_mark_start}"/>
                                                    <Button Content="{r:Text RecipeEditor.btn_remove_start}" Classes="secondary" Margin="0,0,6,0"
                                                            Command="{Binding SelectedNode.ToggleStartNodeCommand}"
                                                            IsVisible="{Binding SelectedNode.IsStartNode}"
                                                            ToolTip.Tip="{r:Text RecipeEditor.tip_remove_start}"/>
                                                    <Button Content="{r:Text RecipeEditor.delete_step}" Classes="error small"
                                                            Command="{Binding DeleteSelectedCommand}"
                                                            ToolTip.Tip="{r:Text RecipeEditor.tip_delete_step}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Node Metadata -->
                                        <TextBlock Text="{r:Text RecipeEditor.node_id}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.node_id}" Text="{Binding SelectedNode.Id, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 FontFamily="monospace"
                                                 Padding="6,4" Margin="0,2,0,8" ToolTip.Tip="{r:Text RecipeEditor.tip_node_id}"/>

                                        <TextBlock Text="{r:Text RecipeEditor.step_type}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.step_type}" Text="{Binding SelectedNode.StepType, Mode=OneWay}" IsReadOnly="True"
                                                
                                                 Padding="6,4" Margin="0,2,0,8"/>

                                        <TextBlock Text="{r:Text RecipeEditor.display_name}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.display_name}" Text="{Binding SelectedNode.Name, Mode=TwoWay}"
                                                
                                                 Padding="6,4" Margin="0,2,0,12"/>

                                        <Separator Background="{DynamicResource RE.CardBorder}" Margin="0,4,0,12"/>
                                        <TextBlock Text="{r:Text RecipeEditor.header_step_parameters}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,8"/>

                                        <!-- 1. Source Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Source}">
                                            <TextBlock Text="{r:Text RecipeEditor.source_type}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.source_type}" SelectedValue="{Binding SelectedNode.SourceType, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_region}" Tag="Region"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_window}" Tag="Window"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_active_window}" Tag="ActiveWindow"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_fullscreen}" Tag="FullScreen"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_last_region}" Tag="LastRegion"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_clipboard}" Tag="Clipboard"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_file}" Tag="File"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_text_ocr}" Tag="TextOcr"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_current_editor}" Tag="CurrentEditor"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.source_browser_extension}" Tag="Extension"/>
                                            </ComboBox>

                                            <StackPanel IsVisible="{Binding SelectedNode.IsFileSource}">
                                                <TextBlock Text="{r:Text RecipeEditor.source_file_path}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.source_file_path}" Text="{Binding SelectedNode.SourceFilename, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <StackPanel IsVisible="{Binding SelectedNode.IsWindowSource}">
                                                <TextBlock Text="{r:Text RecipeEditor.window_title_pattern}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.window_title_pattern}" Text="{Binding SelectedNode.WindowTitlePattern, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{r:Text RecipeEditor.process_name}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.process_name}" Text="{Binding SelectedNode.ProcessName, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="{r:Text RecipeEditor.match_case}" IsChecked="{Binding SelectedNode.WindowMatchCase, Mode=TwoWay}"
                                                          Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <TextBlock Text="{r:Text RecipeEditor.capture_mouse_cursor}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.capture_mouse_cursor}" SelectedValue="{Binding SelectedNode.CaptureMouseCursorMode, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.always_true}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.always_false}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.screen_capture_mode}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.screen_capture_mode}" SelectedValue="{Binding SelectedNode.ScreenCaptureMode, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.screen_auto}" Tag="Auto"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.screen_all}" Tag="FullScreen"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.screen_fixed}" Tag="Fixed"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.align_dpi}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.align_dpi}" SelectedValue="{Binding SelectedNode.AlignDpiMode, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.align_dpi_enabled}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.disabled}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.delay_ms}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.delay_ms}" Text="{Binding SelectedNode.DelayMs, Mode=TwoWay}"
                                                    
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 2. InteractiveSelection Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=InteractiveSelection}">
                                            <TextBlock Text="{r:Text RecipeEditor.selection_mode}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.selection_mode}" SelectedValue="{Binding SelectedNode.SelectionMode, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.selection_region}" Tag="Region"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.selection_window}" Tag="Window"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.selection_text}" Tag="Text"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.window_snapping}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.window_snapping}" SelectedValue="{Binding SelectedNode.AllowWindowSnappingMode, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.window_snapping_enabled}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.disabled}" Tag="false"/>
                                            </ComboBox>
                                        </StackPanel>
 
                                        <!-- RecordVideo Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=RecordVideo}">
                                            <TextBlock Text="{r:Text RecipeEditor.source_target_type}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.source_target_type}" SelectedValue="{Binding SelectedNode.VideoSourceType, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.target_active_window}" Tag="ActiveWindow"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.target_window}" Tag="Window"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.target_monitor}" Tag="Monitor"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.target_region}" Tag="Region"/>
                                            </ComboBox>

                                            <!-- Window targeting options -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsVideoWindowSource}">
                                                <TextBlock Text="{r:Text RecipeEditor.window_title_pattern}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.window_title_pattern}" Text="{Binding SelectedNode.WindowTitlePattern, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{r:Text RecipeEditor.process_name_example}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.process_name_example}" Text="{Binding SelectedNode.ProcessName, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="{r:Text RecipeEditor.record_until_window_closes}" IsChecked="{Binding SelectedNode.VideoUntilWindowCloses, Mode=TwoWay}"
                                                          Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- Region targeting options -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsVideoRegionSource}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{r:Text RecipeEditor.region_x}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.region_x}" Text="{Binding SelectedNode.VideoRegionX, Mode=TwoWay}"
                                                                 FontFamily="monospace" Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{r:Text RecipeEditor.region_y}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.region_y}" Text="{Binding SelectedNode.VideoRegionY, Mode=TwoWay}"
                                                                 FontFamily="monospace" Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{r:Text RecipeEditor.region_width}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.region_width}" Text="{Binding SelectedNode.VideoRegionWidth, Mode=TwoWay}"
                                                                 FontFamily="monospace" Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{r:Text RecipeEditor.region_height}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.region_height}" Text="{Binding SelectedNode.VideoRegionHeight, Mode=TwoWay}"
                                                                 FontFamily="monospace" Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Monitor targeting options -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsVideoMonitorSource}">
                                                <TextBlock Text="{r:Text RecipeEditor.monitor_index}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.monitor_index}" Text="{Binding SelectedNode.VideoMonitorIndex, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- Timing & Duration -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{r:Text RecipeEditor.duration}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.duration}" Text="{Binding SelectedNode.VideoDurationSeconds, Mode=TwoWay}"
                                                             FontFamily="monospace" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{r:Text RecipeEditor.countdown_delay_ms}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.countdown_delay_ms}" Text="{Binding SelectedNode.DelayMs, Mode=TwoWay}"
                                                             FontFamily="monospace" Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Output Path -->
                                            <TextBlock Text="{r:Text RecipeEditor.save_directory}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.save_directory}" Text="{Binding SelectedNode.VideoOutputDirectory, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="{r:Text RecipeEditor.filename_pattern}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.filename_pattern}" Text="{Binding SelectedNode.VideoFilenamePattern, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <!-- Encoding Preset & Format -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{r:Text RecipeEditor.preset}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.preset}" SelectedValue="{Binding SelectedNode.VideoPreset, Mode=TwoWay}" SelectedValueBinding="{ReflectionBinding Tag}">
                                                        <ComboBoxItem Content="{r:Text RecipeEditor.preset_balanced}" Tag="Balanced"/>
                                                        <ComboBoxItem Content="{r:Text RecipeEditor.preset_small}" Tag="SmallSize"/>
                                                        <ComboBoxItem Content="{r:Text RecipeEditor.preset_high_quality}" Tag="HighQuality"/>
                                                        <ComboBoxItem Content="{r:Text RecipeEditor.preset_gaming}" Tag="HighFrameRateGaming"/>
                                                        <ComboBoxItem Content="{r:Text RecipeEditor.preset_custom}" Tag="Custom"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{r:Text RecipeEditor.format_codec}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.format_codec}" SelectedValue="{Binding SelectedNode.VideoFormat, Mode=TwoWay}" SelectedValueBinding="{ReflectionBinding Tag}">
                                                        <ComboBoxItem Content="MP4 (H.264 / AVC)" Tag="Mp4_H264"/>
                                                        <ComboBoxItem Content="MP4 (HEVC / H.265)" Tag="Mp4_Hevc"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Framerate & Bitrate -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{r:Text RecipeEditor.frame_rate}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.frame_rate}" Text="{Binding SelectedNode.VideoFrameRate, Mode=TwoWay}"
                                                             FontFamily="monospace" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{r:Text RecipeEditor.bitrate}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.bitrate}" Text="{Binding SelectedNode.VideoBitrate, Mode=TwoWay}"
                                                             FontFamily="monospace" Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Dimensions & Scaling -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{r:Text RecipeEditor.video_width}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.video_width}" Text="{Binding SelectedNode.VideoTargetWidth, Mode=TwoWay}"
                                                             FontFamily="monospace" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{r:Text RecipeEditor.video_height}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.video_height}" Text="{Binding SelectedNode.VideoTargetHeight, Mode=TwoWay}"
                                                             FontFamily="monospace" Padding="6,4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="{r:Text RecipeEditor.scale_factor}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.scale_factor}" Text="{Binding SelectedNode.VideoScaleFactor, Mode=TwoWay}"
                                                             FontFamily="monospace" Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Audio Source -->
                                            <TextBlock Text="{r:Text RecipeEditor.audio_source}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.audio_source}" SelectedValue="{Binding SelectedNode.VideoAudioSource, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.audio_none}" Tag="None"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.audio_microphone}" Tag="Microphone"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.audio_system}" Tag="SystemAudioLoopback"/>
                                            </ComboBox>

                                            <!-- Canvas & Appearance -->
                                            <TextBlock Text="{r:Text RecipeEditor.window_resize_behavior}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.window_resize_behavior}" SelectedValue="{Binding SelectedNode.VideoResizeBehavior, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.resize_letterbox}" Tag="LetterboxFixedCanvas"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.resize_crop}" Tag="CropToCanvas"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.resize_scale}" Tag="ScaleContent"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.color_mode}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.color_mode}" SelectedValue="{Binding SelectedNode.VideoColorMode, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.color_full_32bit}" Tag="FullColor"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.color_grayscale_mono}" Tag="Grayscale"/>
                                            </ComboBox>

                                            <CheckBox Content="{r:Text RecipeEditor.capture_mouse_cursor}" IsChecked="{Binding SelectedNode.VideoCaptureCursor, Mode=TwoWay}"
                                                      Margin="0,0,0,6"/>

                                            <CheckBox Content="{r:Text RecipeEditor.show_wgc_border}" IsChecked="{Binding SelectedNode.VideoShowCaptureBorder, Mode=TwoWay}"
                                                      Margin="0,0,0,6"/>

                                            <CheckBox Content="{r:Text RecipeEditor.prevent_sleep}" IsChecked="{Binding SelectedNode.VideoPreventSleep, Mode=TwoWay}"
                                                      Margin="0,0,0,6"/>

                                            <CheckBox Content="{r:Text RecipeEditor.auto_pause_locked}" IsChecked="{Binding SelectedNode.VideoAutoPauseOnLock, Mode=TwoWay}"
                                                      Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 4. Effect Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Effect}">
                                            <TextBlock Text="{r:Text RecipeEditor.effect_type}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.effect_type}" SelectedValue="{Binding SelectedNode.EffectType, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.effect_border}" Tag="Border"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.effect_drop_shadow}" Tag="DropShadow"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.effect_torn_edge}" Tag="TornEdge"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.summary_invert}" Tag="Invert"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.summary_grayscale}" Tag="Grayscale"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.effect_monochrome}" Tag="Monochrome"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.effect_adjust}" Tag="Adjust"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.effect_rotate}" Tag="Rotate"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.effect_resize_image}" Tag="Resize"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.effect_resize_canvas}" Tag="ResizeCanvas"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.effect_reduce_colors}" Tag="ReduceColors"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.summary_remove_transparency}" Tag="RemoveTransparency"/>
                                            </ComboBox>

                                            <!-- 4a. Border Effect -->
                                             <StackPanel IsVisible="{Binding SelectedNode.IsBorderEffect}">
                                                 <TextBlock Text="{r:Text RecipeEditor.border_width}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                 <TextBox AutomationProperties.Name="{r:Text RecipeEditor.border_width}" Text="{Binding SelectedNode.EffectBorderWidth, Mode=TwoWay}"
                                                          FontFamily="monospace"
                                                          Padding="6,4" Margin="0,0,0,8"/>

                                                 <TextBlock Text="{r:Text RecipeEditor.border_color}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                 <Grid Margin="0,0,0,8">
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="26"/>
                                                         <ColumnDefinition Width="6"/>
                                                         <ColumnDefinition Width="*"/>
                                                     </Grid.ColumnDefinitions>
                                                     <Button Classes="swatch" Grid.Column="0" Width="26" Height="26"
                                                             BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1"
                                                             Background="{Binding SelectedNode.EffectBorderColor, Converter={x:Static re:StringToBrushConverter.Instance}}" ToolTip.Tip="{r:Text RecipeEditor.click_pick_color}"
                                                             Command="{Binding SelectedNode.PickBorderColorCommand}" AutomationProperties.Name="{r:Text RecipeEditor.pick_color}"/>
                                                     <TextBox AutomationProperties.Name="{r:Text RecipeEditor.border_color}" Grid.Column="2" Text="{Binding SelectedNode.EffectBorderColor, Mode=TwoWay}"
                                                              FontFamily="monospace"
                                                              VerticalContentAlignment="Center" Padding="6,4"/>
                                                 </Grid>
                                             </StackPanel>

                                            <!-- 4b. DropShadow Effect -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsDropShadowEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.shadow_size}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.shadow_size}" Text="{Binding SelectedNode.ShadowSize, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{r:Text RecipeEditor.shadow_darkness}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.shadow_darkness}" Text="{Binding SelectedNode.ShadowDarkness, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{r:Text RecipeEditor.offset_x_px}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.offset_x_px}" Text="{Binding SelectedNode.ShadowOffsetX, Mode=TwoWay}"
                                                                 FontFamily="monospace"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{r:Text RecipeEditor.offset_y_px}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.offset_y_px}" Text="{Binding SelectedNode.ShadowOffsetY, Mode=TwoWay}"
                                                                 FontFamily="monospace"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4c. TornEdge Effect -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsTornEdgeEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.tooth_height}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.tooth_height}" Text="{Binding SelectedNode.ToothHeight, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{r:Text RecipeEditor.h_tooth_range}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.h_tooth_range}" Text="{Binding SelectedNode.HorizontalToothRange, Mode=TwoWay}"
                                                                 FontFamily="monospace"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{r:Text RecipeEditor.v_tooth_range}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.v_tooth_range}" Text="{Binding SelectedNode.VerticalToothRange, Mode=TwoWay}"
                                                                 FontFamily="monospace"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{r:Text RecipeEditor.active_edges}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.active_edges}" Text="{Binding SelectedNode.TornEdges, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="{r:Text RecipeEditor.generate_drop_shadow}" IsChecked="{Binding SelectedNode.TornEdgeShadow, Mode=TwoWay}"
                                                          Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4d. Monochrome Effect -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsMonochromeEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.bw_threshold}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.bw_threshold}" Text="{Binding SelectedNode.MonochromeThreshold, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4e. Adjust Colors Effect -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsAdjustEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.brightness}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.brightness}" Text="{Binding SelectedNode.AdjustBrightness, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{r:Text RecipeEditor.contrast}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.contrast}" Text="{Binding SelectedNode.AdjustContrast, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{r:Text RecipeEditor.gamma}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.gamma}" Text="{Binding SelectedNode.AdjustGamma, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4f. Rotate Effect -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsRotateEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.rotation_angle}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.rotation_angle}" Text="{Binding SelectedNode.RotateAngle, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4g. Resize Effect -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsResizeEffect}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{r:Text RecipeEditor.target_width}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.target_width}" Text="{Binding SelectedNode.ResizeWidth, Mode=TwoWay}"
                                                                 FontFamily="monospace"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{r:Text RecipeEditor.target_height}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.target_height}" Text="{Binding SelectedNode.ResizeHeight, Mode=TwoWay}"
                                                                 FontFamily="monospace"
                                                                 Padding="6,4"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="{r:Text RecipeEditor.scale_percentage}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.scale_percentage}" Text="{Binding SelectedNode.ResizePercentage, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <CheckBox Content="{r:Text RecipeEditor.maintain_aspect_ratio}" IsChecked="{Binding SelectedNode.ResizeMaintainAspectRatio, Mode=TwoWay}"
                                                          Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4h. Resize Canvas / Padding Effect -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsResizeCanvasEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.canvas_left}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.canvas_left}" Text="{Binding SelectedNode.CanvasLeft, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                                <TextBlock Text="{r:Text RecipeEditor.canvas_top}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.canvas_top}" Text="{Binding SelectedNode.CanvasTop, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                                <TextBlock Text="{r:Text RecipeEditor.canvas_right}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.canvas_right}" Text="{Binding SelectedNode.CanvasRight, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                                <TextBlock Text="{r:Text RecipeEditor.canvas_bottom}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.canvas_bottom}" Text="{Binding SelectedNode.CanvasBottom, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>

                                                <TextBlock Text="{r:Text RecipeEditor.background_color}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4"
                                                            BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1"
                                                            Background="{Binding SelectedNode.CanvasBackgroundColor, Converter={x:Static re:StringToBrushConverter.Instance}}"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.background_color}" Grid.Column="2" Text="{Binding SelectedNode.CanvasBackgroundColor, Mode=TwoWay}"
                                                             FontFamily="monospace"
                                                             VerticalContentAlignment="Center" Padding="6,4"/>
                                                    <Button AutomationProperties.Name="{r:Text RecipeEditor.pick_color}" Grid.Column="4" Content="🎨" Classes="secondary" Margin="0" Height="26"
                                                            Command="{Binding SelectedNode.PickCanvasBackgroundColorCommand}" ToolTip.Tip="{r:Text RecipeEditor.click_pick_color}"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4i. Reduce Colors Effect -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsReduceColorsEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.target_colors}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.target_colors}" Text="{Binding SelectedNode.ReduceColorsCount, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            </StackPanel>

                                            <!-- 4j. Remove Transparency Effect -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsRemoveTransparencyEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.matte_color}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Classes="swatch" Grid.Column="0" Width="26" Height="26"
                                                            BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1"
                                                            Background="{Binding SelectedNode.TransparencyBackgroundColor, Converter={x:Static re:StringToBrushConverter.Instance}}" ToolTip.Tip="{r:Text RecipeEditor.click_pick_color}"
                                                            Command="{Binding SelectedNode.PickTransparencyBackgroundColorCommand}" AutomationProperties.Name="{r:Text RecipeEditor.pick_color}"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.matte_color}" Grid.Column="2" Text="{Binding SelectedNode.TransparencyBackgroundColor, Mode=TwoWay}"
                                                             FontFamily="monospace"
                                                             VerticalContentAlignment="Center" Padding="6,4"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4k. Invert / Grayscale Info -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsInvertEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.hint_invert}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding SelectedNode.IsGrayscaleEffect}">
                                                <TextBlock Text="{r:Text RecipeEditor.hint_grayscale}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,4,0,8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 5. TextEffect / DLP Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=TextEffect}">
                                            <TextBlock Text="{r:Text RecipeEditor.dlp_action}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.dlp_action}" SelectedValue="{Binding SelectedNode.TextEffectAction, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.dlp_redact}" Tag="Redact"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.dlp_pixelize}" Tag="Pixelize"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.dlp_blur}" Tag="Blur"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.dlp_highlight}" Tag="Highlight"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.dlp_magnify}" Tag="Magnify"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.patterns_regex}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.patterns_regex}" Text="{Binding SelectedNode.TextEffectPatterns, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="44" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{r:Text RecipeEditor.fill_color}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Classes="swatch" Grid.Column="0" Width="26" Height="26"
                                                        BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1"
                                                        Background="{Binding SelectedNode.TextEffectFillColor, Converter={x:Static re:StringToBrushConverter.Instance}}" ToolTip.Tip="{r:Text RecipeEditor.click_pick_color}"
                                                        Command="{Binding SelectedNode.PickTextEffectColorCommand}" AutomationProperties.Name="{r:Text RecipeEditor.pick_color}"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.fill_color}" Grid.Column="2" Text="{Binding SelectedNode.TextEffectFillColor, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         VerticalContentAlignment="Center" Padding="6,4"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 7. SetVariable Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=SetVariable}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{r:Text RecipeEditor.variables}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{r:Text RecipeEditor.btn_add_variable}" Classes="primary" Padding="6,2" Command="{Binding SelectedNode.AddVariableCommand}"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.Variables}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:VariableItemViewModel">
                                                        <Border Background="{DynamicResource RE.CardBackground}"
                                                                BorderBrush="{DynamicResource RE.CardBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.variable_key}" Text="{Binding Key, Mode=TwoWay}"
                                                                         FontFamily="monospace" FontSize="11"
                                                                        
                                                                        
                                                                         Padding="4,2"/>
                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.variable_value}" Grid.Column="2" Text="{Binding Value, Mode=TwoWay}"
                                                                         FontFamily="monospace" FontSize="11"
                                                                        
                                                                        
                                                                         Padding="4,2"/>
                                                                <Button AutomationProperties.Name="{r:Text RecipeEditor.delete_variable}" Grid.Column="3" Content="✕"
                                                                        Classes="error small"
                                                                        Command="{Binding RemoveCommand}" ToolTip.Tip="{r:Text RecipeEditor.delete_variable}" Margin="4,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{r:Text RecipeEditor.hint_variable_scopes}"
                                                       FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                        </StackPanel>

                                        <!-- 8. Annotation Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Annotation}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{r:Text RecipeEditor.annotations}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.annotation_type_to_add}" x:Name="AnnotationTypeSelector" Width="95" Height="24" Margin="0,0,4,0" SelectedIndex="0">
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_arrow}" Tag="Arrow"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_barcode}" Tag="Barcode"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_blur}" Tag="Blur"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_cursor}" Tag="Cursor"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_ellipse}" Tag="Ellipse"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_emoji}" Tag="Emoji"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_highlight}" Tag="Highlight"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_image}" Tag="Image"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_line}" Tag="Line"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_magnify}" Tag="Magnify"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_pixelize}" Tag="Pixelize"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_qr_code}" Tag="QRCode"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_rectangle}" Tag="Rectangle"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_speech_bubble}" Tag="Speechbubble"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_step_label}" Tag="StepLabel"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_text}" Tag="Text"/>
                                                        </ComboBox>
                                                        <Button Content="{r:Text RecipeEditor.btn_add_annotation}" Classes="primary" Padding="6,2"
                                                                Command="{Binding SelectedNode.AddAnnotationCommand}"
                                                                CommandParameter="{Binding #AnnotationTypeSelector.((ComboBoxItem)SelectedItem).Tag}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Template / Import Row -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,2">
                                                    <TextBlock Text="{r:Text RecipeEditor.template}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Button Content="{r:Text RecipeEditor.btn_from_editor}" Classes="secondary" Padding="6,2" Margin="0,0,4,0"
                                                            Command="{Binding SelectedNode.ImportFromEditorCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_from_editor}"/>
                                                    <Button Content="{r:Text RecipeEditor.btn_from_file}" Classes="secondary" Padding="6,2" Margin="0"
                                                            Command="{Binding SelectedNode.ImportFromGreenshotFileCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_from_file}"/>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.Annotations}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DrawableItemViewModel">
                                                        <Border Background="{DynamicResource RE.CardBackground}"
                                                                BorderBrush="{DynamicResource RE.CardBorder}"
                                                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <!-- Header: Type Picker & Delete -->
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.annotation_type}" Grid.Column="0" SelectedValue="{Binding Type, Mode=TwoWay}" SelectedValueBinding="{ReflectionBinding Tag}" Width="110" HorizontalAlignment="Left">
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_arrow}" Tag="Arrow"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_barcode}" Tag="Barcode"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_blur}" Tag="Blur"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_cursor}" Tag="Cursor"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_ellipse}" Tag="Ellipse"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_emoji}" Tag="Emoji"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_highlight}" Tag="Highlight"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_image}" Tag="Image"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_line}" Tag="Line"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_magnify}" Tag="Magnify"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_pixelize}" Tag="Pixelize"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_qr_code}" Tag="QRCode"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_rectangle}" Tag="Rectangle"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_speech_bubble}" Tag="Speechbubble"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_step_label}" Tag="StepLabel"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.annotation_type_text}" Tag="Text"/>
                                                                    </ComboBox>
                                                                    <TextBlock Grid.Column="1" Text="{Binding SourceSummaryBadge}"
                                                                               FontSize="10" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource RE.Accent}"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                                    <Button AutomationProperties.Name="{r:Text RecipeEditor.delete_annotation}" Grid.Column="2" Content="✕"
                                                                            Classes="error small"
                                                                            Command="{Binding RemoveCommand}" ToolTip.Tip="{r:Text RecipeEditor.delete_annotation}"/>
                                                                </Grid>

                                                                <!-- Text Field (for Text, Speechbubble) -->
                                                                <StackPanel IsVisible="{Binding IsTextType}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{r:Text RecipeEditor.annotation_content}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.annotation_content}" Text="{Binding Text, Mode=TwoWay}"
                                                                             FontFamily="monospace" FontSize="11"
                                                                            
                                                                            
                                                                             Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- Step Label Counter / Number -->
                                                                <StackPanel IsVisible="{Binding IsStepLabelType}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{r:Text RecipeEditor.step_number}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.step_number}" Text="{Binding StepNumber, Mode=TwoWay}"
                                                                             FontFamily="monospace" FontSize="11"
                                                                            
                                                                            
                                                                             Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- QR / Barcode Payload / Text -->
                                                                <StackPanel IsVisible="{Binding IsQrCodeType}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{r:Text RecipeEditor.payload_text}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.payload_text}" Text="{Binding Text, Mode=TwoWay}"
                                                                             FontFamily="monospace" FontSize="11"
                                                                            
                                                                            
                                                                             Padding="4,2"/>
                                                                </StackPanel>

                                                                <!-- Custom / Extension Drawable Configuration Panel -->
                                                                <Border IsVisible="{Binding CanConfigure}" 
                                                                        Background="{DynamicResource RE.CardBackground}"
                                                                        BorderBrush="{DynamicResource RE.CardBorder}"
                                                                        BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2,0,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{r:Text RecipeEditor.plugin_configuration}" FontSize="10" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                            <TextBlock Text="{Binding ConfigurationSummary}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{DynamicResource RE.TextPrimary}"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1" Content="{r:Text RecipeEditor.btn_configure}" Classes="secondary" Padding="8,3" Margin="6,0,0,0"
                                                                                Command="{Binding ConfigureCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_configure}"
                                                                                VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Font Settings (for Text, Speechbubble) -->
                                                                <StackPanel IsVisible="{Binding HasFontSettings}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{r:Text RecipeEditor.font_text_style}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <Grid Margin="0,2,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="4"/>
                                                                            <ColumnDefinition Width="46"/>
                                                                            <ColumnDefinition Width="4"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="2"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="4"/>
                                                                            <ColumnDefinition Width="68"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.font_family}" Grid.Column="0" ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding FontFamily, Mode=TwoWay}"
                                                                                  IsEditable="True" Height="24" FontSize="11" ToolTip.Tip="{r:Text RecipeEditor.font_family}"/>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.font_size}" Grid.Column="2" Text="{Binding FontSize, Mode=TwoWay}"
                                                                                 FontFamily="monospace" FontSize="11" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                                                
                                                                                
                                                                                 ToolTip.Tip="{r:Text RecipeEditor.font_size}"/>
                                                                        <ToggleButton AutomationProperties.Name="{r:Text Editor.bold}" Grid.Column="4" Width="24" Height="24" Content="B" FontWeight="Bold" FontSize="11"
                                                                                      IsChecked="{Binding FontBold, Mode=TwoWay}" ToolTip.Tip="{r:Text Editor.bold}"/>
                                                                        <ToggleButton AutomationProperties.Name="{r:Text Editor.italic}" Grid.Column="6" Width="24" Height="24" Content="I" FontStyle="Italic" FontSize="11"
                                                                                      IsChecked="{Binding FontItalic, Mode=TwoWay}" ToolTip.Tip="{r:Text Editor.italic}"/>
                                                                        <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.text_alignment}" Grid.Column="8" ItemsSource="{Binding AvailableTextAlignments}" SelectedItem="{Binding TextAlignment, Mode=TwoWay}"
                                                                                  Height="24" FontSize="11" ToolTip.Tip="{r:Text RecipeEditor.text_alignment}"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Arrow Heads (for Arrow) -->
                                                                <StackPanel IsVisible="{Binding IsArrowType}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{r:Text Editor.arrowheads}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <ComboBox AutomationProperties.Name="{r:Text Editor.arrowheads}" ItemsSource="{Binding AvailableArrowHeads}" SelectedItem="{Binding ArrowHeads, Mode=TwoWay}"
                                                                              Height="24" FontSize="11" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Speechbubble Tail Controls -->
                                                                <StackPanel IsVisible="{Binding IsSpeechbubbleType}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{r:Text RecipeEditor.tail_direction}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.tail_direction}" SelectedValue="{Binding TailDirection, Mode=TwoWay}" SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,4">
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.position_bottom_left_default}" Tag="BottomLeft"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.position_bottom_right}" Tag="BottomRight"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.position_bottom_center}" Tag="BottomCenter"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.position_top_left}" Tag="TopLeft"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.position_top_right}" Tag="TopRight"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.position_top_center}" Tag="TopCenter"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.position_left}" Tag="Left"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.position_right}" Tag="Right"/>
                                                                    </ComboBox>
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="{r:Text RecipeEditor.tail_offset_x}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.tail_offset_x}" Text="{Binding TailOffsetX, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                    
                                                                                     Padding="4,2"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                            <TextBlock Text="{r:Text RecipeEditor.tail_offset_y}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.tail_offset_y}" Text="{Binding TailOffsetY, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                    
                                                                                     Padding="4,2"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Emoji Field with Picker -->
                                                                <StackPanel IsVisible="{Binding IsEmojiType}" Margin="0,0,0,4">
                                                                    <TextBlock Text="{r:Text RecipeEditor.emoji_icon}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <Grid Margin="0,2,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" BorderBrush="{DynamicResource RE.CardBorder}"
                                                                                BorderThickness="1" CornerRadius="3"
                                                                                Background="{DynamicResource RE.WindowBackground}"
                                                                                Padding="2" VerticalAlignment="Center">
                                                                            <re:EmojiPickerButton AutomationProperties.Name="{r:Text RecipeEditor.pick_emoji}" Selection="{Binding Emoji, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.emoji_icon}" Grid.Column="2" Text="{Binding Emoji, Mode=TwoWay}"
                                                                                 FontSize="13" VerticalContentAlignment="Center"
                                                                                
                                                                                
                                                                                 Padding="4,2"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Obfuscate Settings (Blur / Pixelize) -->
                                                                <StackPanel IsVisible="{Binding IsBlurType}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{r:Text RecipeEditor.blur_radius}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.blur_radius}" Text="{Binding BlurRadius, Mode=TwoWay}"
                                                                             FontFamily="monospace" FontSize="11"
                                                                            
                                                                            
                                                                             Padding="4,2" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <StackPanel IsVisible="{Binding IsPixelizeType}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{r:Text RecipeEditor.pixel_size}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.pixel_size}" Text="{Binding PixelSize, Mode=TwoWay}"
                                                                             FontFamily="monospace" FontSize="11"
                                                                            
                                                                            
                                                                             Padding="4,2" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Magnification Factor (Magnify) -->
                                                                <StackPanel IsVisible="{Binding IsMagnifyType}" Margin="0,2,0,4">
                                                                    <TextBlock Text="{r:Text RecipeEditor.magnification}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.magnification}" Text="{Binding MagnificationFactor, Mode=TwoWay}"
                                                                             FontFamily="monospace" FontSize="11"
                                                                            
                                                                            
                                                                             Padding="4,2" Margin="0,2,0,0"/>
                                                                </StackPanel>

                                                                <!-- Image Controls -->
                                                                <StackPanel IsVisible="{Binding IsImageType}" Margin="0,0,0,4">
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{r:Text RecipeEditor.annotation_image_source}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <RadioButton Content="{r:Text RecipeEditor.embed_base64}" IsChecked="{Binding IsEmbedMode, Mode=TwoWay}" FontSize="10" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="{r:Text RecipeEditor.link_file}" IsChecked="{Binding IsLinkMode, Mode=TwoWay}" FontSize="10"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,1,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.image_file}" Grid.Column="0" Text="{Binding FilePath, Mode=TwoWay}"
                                                                                 FontFamily="monospace" FontSize="11"
                                                                                
                                                                                
                                                                                 Padding="4,2"/>
                                                                        <Button Grid.Column="2" Content="{r:Text RecipeEditor.import_btn_browse}" Classes="secondary" Padding="6,2"
                                                                                Command="{Binding BrowseFileCommand}"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Cursor Controls -->
                                                                <StackPanel IsVisible="{Binding IsCursorType}" Margin="0,0,0,4">
                                                                    <Grid Margin="0,0,0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{r:Text RecipeEditor.cursor_source}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <RadioButton Content="{r:Text RecipeEditor.preset}" IsChecked="{Binding IsCursorPresetMode, Mode=TwoWay}" FontSize="10" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="{r:Text RecipeEditor.embed_base64}" IsChecked="{Binding IsCursorEmbedMode, Mode=TwoWay}" FontSize="10" Margin="0,0,8,0"/>
                                                                            <RadioButton Content="{r:Text RecipeEditor.link_file}" IsChecked="{Binding IsCursorLinkMode, Mode=TwoWay}" FontSize="10"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- Preset Mode -->
                                                                    <StackPanel IsVisible="{Binding IsCursorPresetMode}" Margin="0,1,0,3">
                                                                        <TextBlock Text="{r:Text RecipeEditor.cursor_preset}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.cursor_preset}" ItemsSource="{Binding AvailableCursors}" SelectedItem="{Binding CursorName, Mode=TwoWay}"
                                                                                  Height="24" Margin="0,2,0,0"/>
                                                                    </StackPanel>

                                                                    <!-- Embed Mode (Base64) -->
                                                                    <StackPanel IsVisible="{Binding IsCursorEmbedMode}" Margin="0,1,0,3">
                                                                        <Border Background="{DynamicResource RE.BadgeBackground}"
                                                                                BorderBrush="{DynamicResource RE.CardBorder}"
                                                                                BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="{r:Text RecipeEditor.embedded_cursor}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource RE.TextPrimary}"/>
                                                                                    <TextBlock Text="{r:Text RecipeEditor.hint_embedded_cursor}" FontSize="9" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                                </StackPanel>
                                                                                <Button Grid.Column="1" Content="{r:Text RecipeEditor.btn_load_file}" Classes="secondary" Padding="6,2" Margin="4,0,0,0"
                                                                                        Command="{Binding BrowseFileCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_load_file}"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <!-- Link File Mode -->
                                                                    <Grid IsVisible="{Binding IsCursorLinkMode}" Margin="0,1,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.cursor_file}" Grid.Column="0" Text="{Binding FilePath, Mode=TwoWay}"
                                                                                 FontFamily="monospace" FontSize="11"
                                                                                
                                                                                
                                                                                 Padding="4,2"/>
                                                                        <Button Grid.Column="2" Content="{r:Text RecipeEditor.import_btn_browse}" Classes="secondary" Padding="6,2"
                                                                                Command="{Binding BrowseFileCommand}"/>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Anchors: H-Anchor & V-Anchor -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{r:Text RecipeEditor.h_anchor}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.h_anchor}" SelectedValue="{Binding HorizontalAnchor, Mode=TwoWay}" SelectedValueBinding="{ReflectionBinding Tag}">
                                                                            <ComboBoxItem Content="{r:Text RecipeEditor.anchor_none}" Tag="None"/>
                                                                            <ComboBoxItem Content="{r:Text RecipeEditor.position_left}" Tag="Left"/>
                                                                            <ComboBoxItem Content="{r:Text RecipeEditor.position_center}" Tag="Center"/>
                                                                            <ComboBoxItem Content="{r:Text RecipeEditor.position_right}" Tag="Right"/>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="{r:Text RecipeEditor.v_anchor}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.v_anchor}" SelectedValue="{Binding VerticalAnchor, Mode=TwoWay}" SelectedValueBinding="{ReflectionBinding Tag}">
                                                                            <ComboBoxItem Content="{r:Text RecipeEditor.anchor_none}" Tag="None"/>
                                                                            <ComboBoxItem Content="{r:Text RecipeEditor.position_top}" Tag="Top"/>
                                                                            <ComboBoxItem Content="{r:Text RecipeEditor.position_center}" Tag="Center"/>
                                                                            <ComboBoxItem Content="{r:Text RecipeEditor.position_bottom}" Tag="Bottom"/>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Width & Height -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{r:Text RecipeEditor.width}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.width}" Text="{Binding Width, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                
                                                                                 Padding="4,2"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="{r:Text RecipeEditor.height}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.height}" Text="{Binding Height, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                
                                                                                 Padding="4,2"/>
                                                                    </StackPanel>
                                                                    <CheckBox Grid.Column="3" Content="{r:Text RecipeEditor.lock_ratio}" IsChecked="{Binding LockAspectRatio, Mode=TwoWay}"
                                                                              ToolTip.Tip="{r:Text RecipeEditor.tip_lock_ratio}"
                                                                              FontSize="10" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                                                                </Grid>

                                                                <!-- Offset X & Offset Y -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{r:Text RecipeEditor.offset_x_left}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.offset_x_left}" Text="{Binding OffsetX, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                
                                                                                 Padding="4,2"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="{r:Text RecipeEditor.offset_y_top}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.offset_y_top}" Text="{Binding OffsetY, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                
                                                                                 Padding="4,2"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Line Thickness & Shadow -->
                                                                <Grid Margin="0,2,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" IsVisible="{Binding HasLineThickness}">
                                                                        <TextBlock Text="{r:Text RecipeEditor.line_thickness}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.line_thickness}" Text="{Binding LineThickness, Mode=TwoWay}"
                                                                                 FontFamily="monospace" FontSize="11"
                                                                                
                                                                                
                                                                                 Padding="4,2" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <CheckBox Grid.Column="1" Content="{r:Text RecipeEditor.shadow}" IsChecked="{Binding Shadow, Mode=TwoWay}"
                                                                              IsVisible="{Binding HasShadow}"
                                                                              ToolTip.Tip="{r:Text RecipeEditor.tip_shadow}"
                                                                              FontSize="10" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                                                                </Grid>

                                                                <!-- Standard Colors (Fill & Line Color) -->
                                                                <Grid IsVisible="{Binding HasAnyStandardColor}" Margin="0,2,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" IsVisible="{Binding HasFillColor}">
                                                                        <TextBlock Text="{Binding FillColorLabel}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <Grid Margin="0,2,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="20"/>
                                                                                <ColumnDefinition Width="4"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Button Classes="swatch" Grid.Column="0" Width="20" Height="20"
                                                                                    BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1"
                                                                                    Background="{Binding FillColor, Converter={x:Static re:StringToBrushConverter.Instance}}" ToolTip.Tip="{r:Text RecipeEditor.click_pick_color}"
                                                                                    Command="{Binding PickFillColorCommand}" AutomationProperties.Name="{r:Text RecipeEditor.pick_color}"/>
                                                                            <TextBox AutomationProperties.Name="{Binding FillColorLabel, TargetNullValue=''}" Grid.Column="2" Text="{Binding FillColor, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                    
                                                                                    
                                                                                     VerticalContentAlignment="Center" Padding="4,2"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" IsVisible="{Binding HasLineColor}">
                                                                        <TextBlock Text="{Binding LineColorLabel}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                        <Grid Margin="0,2,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="20"/>
                                                                                <ColumnDefinition Width="4"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Button Classes="swatch" Grid.Column="0" Width="20" Height="20"
                                                                                    BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1"
                                                                                    Background="{Binding LineColor, Converter={x:Static re:StringToBrushConverter.Instance}}" ToolTip.Tip="{r:Text RecipeEditor.click_pick_color}"
                                                                                    Command="{Binding PickLineColorCommand}" AutomationProperties.Name="{r:Text RecipeEditor.pick_color}"/>
                                                                            <TextBox AutomationProperties.Name="{Binding LineColorLabel, TargetNullValue=''}" Grid.Column="2" Text="{Binding LineColor, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                    
                                                                                    
                                                                                     VerticalContentAlignment="Center" Padding="4,2"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- QR / Barcode Specific Colors & Options -->
                                                                <StackPanel IsVisible="{Binding IsQrCodeType}" Margin="0,2,0,0">
                                                                    <Grid Margin="0,2,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="6"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="{r:Text RecipeEditor.code_color}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                            <Grid Margin="0,2,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="20"/>
                                                                                    <ColumnDefinition Width="4"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button Classes="swatch" Grid.Column="0" Width="20" Height="20"
                                                                                        BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1"
                                                                                        Background="{Binding ForeColor, Converter={x:Static re:StringToBrushConverter.Instance}}" ToolTip.Tip="{r:Text RecipeEditor.click_pick_foreground}"
                                                                                        Command="{Binding PickForeColorCommand}" AutomationProperties.Name="{r:Text RecipeEditor.pick_foreground}"/>
                                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.code_color}" Grid.Column="2" Text="{Binding ForeColor, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                        
                                                                                        
                                                                                         VerticalContentAlignment="Center" Padding="4,2"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2">
                                                                            <TextBlock Text="{r:Text RecipeEditor.background_back}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                            <Grid Margin="0,2,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="20"/>
                                                                                    <ColumnDefinition Width="4"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button Classes="swatch" Grid.Column="0" Width="20" Height="20"
                                                                                        BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1"
                                                                                        Background="{Binding BackColor, Converter={x:Static re:StringToBrushConverter.Instance}}" ToolTip.Tip="{r:Text RecipeEditor.click_pick_background}"
                                                                                        Command="{Binding PickBackColorCommand}" AutomationProperties.Name="{r:Text RecipeEditor.pick_background}"/>
                                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.background_back}" Grid.Column="2" Text="{Binding BackColor, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                        
                                                                                        
                                                                                         VerticalContentAlignment="Center" Padding="4,2"/>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <Grid Margin="0,2,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="{r:Text RecipeEditor.quiet_zone}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.quiet_zone}" Text="{Binding QuietZone, Mode=TwoWay}" FontFamily="monospace" FontSize="11"
                                                                                    
                                                                                    
                                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                        <CheckBox Grid.Column="1" Content="{r:Text RecipeEditor.qr_rounded_dots}" IsChecked="{Binding RoundedDots, Mode=TwoWay}"
                                                                                  ToolTip.Tip="{r:Text RecipeEditor.tip_rounded_dots}"
                                                                                  FontSize="10" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 9. Conditional Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Conditional}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{r:Text RecipeEditor.condition_branches}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RE.TextPrimary}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{r:Text RecipeEditor.btn_add_branch}" Classes="secondary"
                                                        Command="{Binding SelectedNode.AddConditionBranchCommand}" Padding="8,2" FontSize="10"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.ConditionBranches}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ConditionBranchViewModel">
                                                        <Border Background="{DynamicResource RE.CardBackground}"
                                                                BorderBrush="{DynamicResource RE.CardBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{DynamicResource RE.BadgeBackground}"
                                                                            BorderBrush="{DynamicResource RE.CardBorder}"
                                                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Key, StringFormat='Pin {0}'}" FontWeight="Bold" FontSize="10"
                                                                                   Foreground="{DynamicResource RE.Accent}"/>
                                                                    </Border>
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.branch_id}" Grid.Column="1" Text="{Binding Key, Mode=TwoWay}"
                                                                            
                                                                            
                                                                             FontFamily="monospace" FontSize="10" Padding="4,2" MaxLength="10"
                                                                             ToolTip.Tip="{r:Text RecipeEditor.branch_id}"/>
                                                                    <Button AutomationProperties.Name="{r:Text RecipeEditor.delete_branch}" Grid.Column="2"  Content="✕" Classes="error small" Command="{Binding RemoveCommand}"
                                                                            ToolTip.Tip="{r:Text RecipeEditor.delete_branch}" Margin="4,0,0,0"/>
                                                                </Grid>
                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.branch_condition}" Grid.Row="1" Text="{Binding Expression, Mode=TwoWay}"
                                                                        
                                                                        
                                                                         FontFamily="monospace" FontSize="11" Padding="6,4"
                                                                         ToolTip.Tip="{r:Text RecipeEditor.tip_branch_condition}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{r:Text RecipeEditor.branch_logic_title}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RE.TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap"><Run Text="• "/><Run Text="{r:Text RecipeEditor.hint_branch_pins}"/><LineBreak/><Run Text="• "/><Run Text="{r:Text RecipeEditor.hint_branch_connect}"/><LineBreak/><Run Text="• "/><Run Text="{r:Text RecipeEditor.hint_branch_else}"/></TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 9b. UserPrompt Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=UserPrompt}">
                                            <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{r:Text RecipeEditor.prompt_interaction_title}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RE.TextPrimary}" Margin="0,0,0,4"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap"><Run Text="• "/><Run Text="{r:Text RecipeEditor.hint_prompt_dialog}"/><LineBreak/><Run Text="• "/><Run Text="{r:Text RecipeEditor.hint_prompt_branches}"/></TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{r:Text RecipeEditor.prompt_title}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.prompt_title}" Text="{Binding SelectedNode.UserPromptTitle, Mode=TwoWay}"
                                                    
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{r:Text RecipeEditor.prompt_message}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.prompt_message}" Text="{Binding SelectedNode.UserPromptMessage, Mode=TwoWay}"
                                                    
                                                     TextWrapping="Wrap" AcceptsReturn="True" Height="50"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <CheckBox Content="{r:Text RecipeEditor.show_capture_preview}"
                                                      IsChecked="{Binding SelectedNode.UserPromptShowPreview, Mode=TwoWay}"
                                                      Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{r:Text RecipeEditor.prompt_timeout}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.prompt_timeout}" Text="{Binding SelectedNode.UserPromptTimeoutSeconds, Mode=TwoWay}"
                                                            
                                                             Padding="6,4"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,4,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{r:Text RecipeEditor.decision_choices}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RE.TextPrimary}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{r:Text RecipeEditor.btn_add_choice}" Classes="secondary"
                                                        Command="{Binding SelectedNode.AddPromptChoiceCommand}" Padding="8,2" FontSize="10"/>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding SelectedNode.PromptChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PromptChoiceViewModel">
                                                        <Border Background="{DynamicResource RE.CardBackground}"
                                                                BorderBrush="{DynamicResource RE.CardBorder}"
                                                                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Background="{DynamicResource RE.BadgeBackground}"
                                                                            BorderBrush="{DynamicResource RE.CardBorder}"
                                                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Key, StringFormat='Pin {0}'}" FontWeight="Bold" FontSize="10"
                                                                                   Foreground="{DynamicResource RE.Accent}"/>
                                                                    </Border>
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.choice_key}" Grid.Column="1" Text="{Binding Key, Mode=TwoWay}"
                                                                            
                                                                            
                                                                             FontFamily="monospace" FontSize="10" Padding="4,2" MaxLength="15"
                                                                             ToolTip.Tip="{r:Text RecipeEditor.choice_key}"/>
                                                                    <Button AutomationProperties.Name="{r:Text RecipeEditor.delete_choice}" Grid.Column="2"  Content="✕" Classes="error small" Command="{Binding RemoveCommand}"
                                                                            ToolTip.Tip="{r:Text RecipeEditor.delete_choice}" Margin="4,0,0,0"/>
                                                                </Grid>

                                                                <TextBlock Text="{r:Text RecipeEditor.button_label}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,2,0,1"/>
                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.button_label}" Text="{Binding Label, Mode=TwoWay}"
                                                                        
                                                                        
                                                                         FontSize="11" Padding="4,2" Margin="0,0,0,4"/>

                                                                <Grid Margin="0,2,0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.button_style}" SelectedValue="{Binding Style, Mode=TwoWay}"
                                                                              SelectedValueBinding="{ReflectionBinding Tag}" Height="22" FontSize="10">
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.style_primary}" Tag="Primary"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.style_secondary}" Tag="Secondary"/>
                                                                        <ComboBoxItem Content="{r:Text RecipeEditor.style_danger}" Tag="Danger"/>
                                                                    </ComboBox>
                                                                    <CheckBox Grid.Column="1" Content="{r:Text RecipeEditor.choice_default}" IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                                                             
                                                                              FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                    <CheckBox Grid.Column="2" Content="{r:Text RecipeEditor.choice_cancel}" IsChecked="{Binding IsCancel, Mode=TwoWay}"
                                                                             
                                                                              FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 10. ImmediateFeedback Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=ImmediateFeedback}">
                                            <CheckBox Content="{r:Text RecipeEditor.play_shutter_sound}"
                                                      IsChecked="{Binding SelectedNode.PlaySound, Mode=TwoWay}"
                                                      Margin="0,4,0,8"/>

                                            <TextBlock Text="{r:Text RecipeEditor.custom_sound_file}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.custom_sound_file}" Grid.Column="0" Text="{Binding SelectedNode.SoundFilePath, Mode=TwoWay}"
                                                        
                                                         Padding="6,4" ToolTip.Tip="{r:Text RecipeEditor.tip_custom_sound}"/>
                                                <Button AutomationProperties.Name="{r:Text RecipeEditor.browse_sound}" Grid.Column="1" Content="..." Classes="secondary"
                                                        Command="{Binding SelectedNode.BrowseSoundFileCommand}"
                                                        ToolTip.Tip="{r:Text RecipeEditor.browse_sound}" Margin="4,0,0,0" Padding="8,4"/>
                                                <Button AutomationProperties.Name="{r:Text RecipeEditor.play_preview_sound}" Grid.Column="2" Content="▶️" Classes="secondary"
                                                        Command="{Binding SelectedNode.PlaySoundPreviewCommand}"
                                                        ToolTip.Tip="{r:Text RecipeEditor.play_preview_sound}" Margin="4,0,0,0" Padding="8,4"/>
                                            </Grid>
                                            <TextBlock Text="{r:Text RecipeEditor.hint_default_sound}"
                                                       FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- Slot Inspector: which slot, which extensions -->
                                        <StackPanel IsVisible="{Binding SelectedNode.IsSlot}">
                                            <TextBlock Text="{r:Text RecipeEditor.slot}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.slot}" ItemsSource="{Binding SelectedNode.SlotNames}" SelectedItem="{Binding SelectedNode.SlotName, Mode=TwoWay}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedNode.SlotDescription}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="{r:Text RecipeEditor.slot_accept}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.slot_accept}" Text="{Binding SelectedNode.SlotAccept, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="{r:Text RecipeEditor.slot_extensions_now}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ItemsControl ItemsSource="{Binding SelectedNode.SlotExtensions}" Margin="8,0,0,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" FontStyle="Italic" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 11. Notification Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Notification}">
                                            <CheckBox Content="{r:Text RecipeEditor.show_on_completion}" IsChecked="{Binding SelectedNode.NotificationShow, Mode=TwoWay}"
                                                      Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 11a. Stdout / Stderr Step Inspectors -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Stdout}">
                                                <TextBlock Text="{r:Text RecipeEditor.stdout_text}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.stdout_text}" Text="{Binding SelectedNode.OutputText, Mode=TwoWay}"
                                                         FontFamily="monospace" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Stderr}">
                                                <TextBlock Text="{r:Text RecipeEditor.stderr_text}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.stderr_text}" Text="{Binding SelectedNode.OutputText, Mode=TwoWay}"
                                                         FontFamily="monospace" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                                <TextBlock Text="{r:Text RecipeEditor.exit_code}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.exit_code}" Text="{Binding SelectedNode.StderrExitCode, Mode=TwoWay}"
                                                        
                                                         Padding="6,4" Margin="0,0,0,8"/>
                                            <CheckBox Content="{r:Text RecipeEditor.stderr_end_recipe}" IsChecked="{Binding SelectedNode.StderrAbort, Mode=TwoWay}"
                                                      Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- PDF Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Pdf}">
                                            <TextBlock Text="{r:Text Pdf.label_page_size}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text Pdf.label_page_size}" SelectedValue="{Binding SelectedNode.PdfPageSize, Mode=TwoWay}" SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text Pdf.page_image}" Tag="Image"/>
                                                <ComboBoxItem Content="{r:Text Pdf.page_custom}" Tag="Custom"/>
                                                <ComboBoxItem Content="{r:Text Pdf.page_a3}" Tag="A3"/>
                                                <ComboBoxItem Content="{r:Text Pdf.page_a4}" Tag="A4"/>
                                                <ComboBoxItem Content="{r:Text Pdf.page_a5}" Tag="A5"/>
                                                <ComboBoxItem Content="{r:Text Pdf.page_a6}" Tag="A6"/>
                                                <ComboBoxItem Content="{r:Text Pdf.page_letter}" Tag="Letter"/>
                                            </ComboBox>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"><Run Text="{r:Text Pdf.label_page_width}"/><Run Text=" (mm)"/></TextBlock>
                                            <TextBox AutomationProperties.Name="{r:Text Pdf.label_page_width}" Text="{Binding SelectedNode.PdfPageWidthMm, Mode=TwoWay}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"><Run Text="{r:Text Pdf.label_page_height}"/><Run Text=" (mm)"/></TextBlock>
                                            <TextBox AutomationProperties.Name="{r:Text Pdf.label_page_height}" Text="{Binding SelectedNode.PdfPageHeightMm, Mode=TwoWay}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="{r:Text Pdf.label_margins}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,8"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"><Run Text="{r:Text Pdf.label_top}"/><Run Text=" (mm)"/></TextBlock>
                                            <TextBox AutomationProperties.Name="{r:Text Pdf.label_top}" Text="{Binding SelectedNode.PdfMarginTopMm, Mode=TwoWay}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"><Run Text="{r:Text Pdf.label_bottom}"/><Run Text=" (mm)"/></TextBlock>
                                            <TextBox AutomationProperties.Name="{r:Text Pdf.label_bottom}" Text="{Binding SelectedNode.PdfMarginBottomMm, Mode=TwoWay}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"><Run Text="{r:Text Pdf.label_left}"/><Run Text=" (mm)"/></TextBlock>
                                            <TextBox AutomationProperties.Name="{r:Text Pdf.label_left}" Text="{Binding SelectedNode.PdfMarginLeftMm, Mode=TwoWay}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"><Run Text="{r:Text Pdf.label_right}"/><Run Text=" (mm)"/></TextBlock>
                                            <TextBox AutomationProperties.Name="{r:Text Pdf.label_right}" Text="{Binding SelectedNode.PdfMarginRightMm, Mode=TwoWay}"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="{r:Text Pdf.label_scaling}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text Pdf.label_scaling}" SelectedValue="{Binding SelectedNode.PdfScalingMode, Mode=TwoWay}" SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text Pdf.scale_shrink}" Tag="OnlyShrinkToFit"/>
                                                <ComboBoxItem Content="{r:Text Pdf.scale_fit}" Tag="FitToPage"/>
                                            </ComboBox>
                                            <CheckBox IsChecked="{Binding SelectedNode.PdfShowSaveDialog, Mode=TwoWay}"
                                                      Content="{r:Text Pdf.destination_option_fileas}" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 12. Save to File Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=SaveFile}">
                                            <TextBlock Text="{r:Text RecipeEditor.save_directory}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.save_directory}" Text="{Binding SelectedNode.SaveDirectory, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4"/>
                                                <Button Grid.Column="1"  Classes="secondary" Margin="6,0,0,0"
                                                        Command="{Binding SelectedNode.BrowseSaveDirectoryCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_browse_folder}"><TextBlock><Run Text="📁 "/><Run Text="{r:Text RecipeEditor.import_btn_browse}"/></TextBlock></Button>
                                            </Grid>

                                            <TextBlock Text="{r:Text RecipeEditor.filename_pattern}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.filename_pattern}" Text="{Binding SelectedNode.FilenamePattern, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{r:Text RecipeEditor.image_format}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.image_format}" ItemsSource="{Binding $parent[Window].((vm:RecipeEditorViewModel)DataContext).OutputFormatOptions}"
                                                      DisplayMemberBinding="{ReflectionBinding DisplayNameWithPreferredExtension}" SelectedValueBinding="{ReflectionBinding Id}"
                                                      SelectedValue="{Binding SelectedNode.OutputFileFormat, Mode=TwoWay}"
                                                      Margin="0,0,0,8">
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.allow_overwrite}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.allow_overwrite}" SelectedValue="{Binding SelectedNode.OutputFileAllowOverwrite, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.overwrite_enabled}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.overwrite_disabled}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.quality_prompt}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.quality_prompt}" SelectedValue="{Binding SelectedNode.OutputFilePromptQuality, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.prompt_when_saving}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.never_prompt}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.copy_path}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.copy_path}" SelectedValue="{Binding SelectedNode.OutputFileCopyPath, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.copy_path_enabled}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.disabled}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.jpeg_quality_config}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.jpeg_quality_config}" Text="{Binding SelectedNode.OutputFileJpegQuality, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 13. System Clipboard Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Clipboard}">
                                            <TextBlock Text="{r:Text RecipeEditor.clipboard_content}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.clipboard_content}" SelectedValue="{Binding SelectedNode.ClipboardMode, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.clipboard_image_only}" Tag="ImageOnly"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.clipboard_ocr_only}" Tag="TextOnly"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.clipboard_image_and_ocr}" Tag="ImageAndText"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.clipboard_formats}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,4"/>
                                            <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <CheckBox Content="{r:Text RecipeEditor.format_png}" IsChecked="{Binding SelectedNode.ClipboardFormatPNG, Mode=TwoWay}"
                                                              Margin="0,2,0,4"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.format_dib}" IsChecked="{Binding SelectedNode.ClipboardFormatDIB, Mode=TwoWay}"
                                                              Margin="0,2,0,4"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.format_dibv5}" IsChecked="{Binding SelectedNode.ClipboardFormatDIBV5, Mode=TwoWay}"
                                                              Margin="0,2,0,4"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.format_bitmap}" IsChecked="{Binding SelectedNode.ClipboardFormatBitmap, Mode=TwoWay}"
                                                              Margin="0,2,0,4"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.format_html_file}" IsChecked="{Binding SelectedNode.ClipboardFormatHTML, Mode=TwoWay}"
                                                              Margin="0,2,0,4"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.format_html_inline}" IsChecked="{Binding SelectedNode.ClipboardFormatHTMLDataUrl, Mode=TwoWay}"
                                                              Margin="0,2,0,4"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.format_text}" IsChecked="{Binding SelectedNode.ClipboardFormatText, Mode=TwoWay}"
                                                              Margin="0,2,0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Text / OCR settings when Text format or TextOnly is active -->
                                            <StackPanel IsVisible="{Binding SelectedNode.IsClipboardTextEnabled}">
                                                <TextBlock Text="{r:Text RecipeEditor.ocr_template}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.ocr_template}" Text="{Binding SelectedNode.ClipboardCustomText, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,4"/>
                                                <TextBlock Text="{r:Text RecipeEditor.hint_ocr_template}"
                                                           FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 14. Image Editor Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Editor}">
                                            <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                                <TextBlock Text="{r:Text RecipeEditor.hint_editor}"
                                                           FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap"/>
                                            </Border>

                                            <TextBlock Text="{r:Text RecipeEditor.match_editor_size}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.match_editor_size}" SelectedValue="{Binding SelectedNode.EditorMatchSizeToCapture, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.match_editor_size_yes}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.match_editor_size_no}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.target_editor}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.target_editor}" SelectedValue="{Binding SelectedNode.EditorTargetEditor, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.editor_new}" Tag="NewEditor"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.editor_available}" Tag="AvailableEditor"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.editor_current}" Tag="CurrentEditor"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 15. Printer Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Printer}">
                                            <TextBlock Text="{r:Text RecipeEditor.printer_name}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.printer_name}" Text="{Binding SelectedNode.PrinterName, Mode=TwoWay}"
                                                    
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{r:Text RecipeEditor.show_print_dialog}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.show_print_dialog}" SelectedValue="{Binding SelectedNode.PrinterShowPrintDialog, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.print_dialog_always}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.print_dialog_silent}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.auto_rotate}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.auto_rotate}" SelectedValue="{Binding SelectedNode.PrinterAllowRotate, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.auto_rotate_yes}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.auto_rotate_no}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.allow_enlarge}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.allow_enlarge}" SelectedValue="{Binding SelectedNode.PrinterAllowEnlarge, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.allow_enlarge_yes}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.no}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.allow_shrink}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.allow_shrink}" SelectedValue="{Binding SelectedNode.PrinterAllowShrink, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.allow_shrink_yes}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.no}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.center_on_page}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.center_on_page}" SelectedValue="{Binding SelectedNode.PrinterCenter, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.yes}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.no}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.color_mode}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.color_mode}" SelectedValue="{Binding SelectedNode.PrinterColorMode, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.full_color}" Tag="Color"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.summary_grayscale}" Tag="Grayscale"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.monochrome_bw}" Tag="Monochrome"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.print_footer}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.print_footer}" SelectedValue="{Binding SelectedNode.PrinterPrintFooter, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,8">
                                                <ComboBoxItem Content="{r:Text RecipeEditor.output_format_from_configuration}" Tag=""/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.print_footer_yes}" Tag="true"/>
                                                <ComboBoxItem Content="{r:Text RecipeEditor.no}" Tag="false"/>
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.footer_pattern}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.footer_pattern}" Text="{Binding SelectedNode.PrinterFooterPattern, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 17. Custom Destination Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=CustomDestination}">
                                            <TextBlock Text="{r:Text RecipeEditor.destination_id}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.destination_id}" Text="{Binding SelectedNode.CustomDestinationId, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="{r:Text RecipeEditor.hint_destination_id}"
                                                       FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 18. Generic Multi-Destinations Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=Destinations}">
                                            <TextBlock Text="{r:Text RecipeEditor.export_destinations}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,4"/>
                                            <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <CheckBox Content="{r:Text RecipeEditor.destination_editor}" IsChecked="{Binding SelectedNode.DestinationEditor, Mode=TwoWay}" Margin="0,2"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.step_clipboard}" IsChecked="{Binding SelectedNode.DestinationClipboard, Mode=TwoWay}" Margin="0,2"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.step_save_file}" IsChecked="{Binding SelectedNode.DestinationFile, Mode=TwoWay}" Margin="0,2"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.summary_printer}" IsChecked="{Binding SelectedNode.DestinationPrinter, Mode=TwoWay}" Margin="0,2"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.summary_email}" IsChecked="{Binding SelectedNode.DestinationEmail, Mode=TwoWay}" Margin="0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- File Save Settings (Visible when Save to File is checked) -->
                                            <StackPanel IsVisible="{Binding SelectedNode.DestinationFile}" Margin="0,4,0,8">
                                                <TextBlock Text="{r:Text RecipeEditor.save_directory}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.save_directory}" Text="{Binding SelectedNode.SaveDirectory, Mode=TwoWay}"
                                                             FontFamily="monospace"
                                                             Padding="6,4"/>
                                                    <Button Grid.Column="1"  Classes="secondary" Margin="6,0,0,0"
                                                            Command="{Binding SelectedNode.BrowseSaveDirectoryCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_browse_folder}"><TextBlock><Run Text="📁 "/><Run Text="{r:Text RecipeEditor.import_btn_browse}"/></TextBlock></Button>
                                                </Grid>

                                                <TextBlock Text="{r:Text RecipeEditor.filename_pattern}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.filename_pattern}" Text="{Binding SelectedNode.FilenamePattern, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4" Margin="0,0,0,6"/>
                                            </StackPanel>
                                            <!-- Custom Destinations -->
                                            <TextBlock Text="{r:Text RecipeEditor.custom_destinations}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.custom_destinations}" Text="{Binding SelectedNode.CustomDestinationsText, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,4"/>
                                            <TextBlock Text="{r:Text RecipeEditor.hint_custom_destinations}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                        </StackPanel>

                                        <!-- 18b. WPF Dynamic Destination Step Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.StepType, Converter={x:Static re:StringEqualsConverter.Instance}, ConverterParameter=DynamicDestination}">
                                            <TextBlock Text="{r:Text RecipeEditor.picker_window_title}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.picker_window_title}" Text="{Binding SelectedNode.DynamicDestinationTitle, Mode=TwoWay}"
                                                    
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <CheckBox Content="{r:Text RecipeEditor.show_thumbnail}" IsChecked="{Binding SelectedNode.DynamicDestinationShowPreview, Mode=TwoWay}" Margin="0,2"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.allow_forwarding}" IsChecked="{Binding SelectedNode.DynamicDestinationAllowRecipeForwarding, Mode=TwoWay}" Margin="0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{r:Text RecipeEditor.auto_dismiss_timeout}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.auto_dismiss_timeout}" Text="{Binding SelectedNode.DynamicDestinationTimeoutSeconds, Mode=TwoWay}"
                                                    
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <TextBlock Text="{r:Text RecipeEditor.destinations_filter}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.destinations_filter}" Text="{Binding SelectedNode.DynamicDestinationSpecificDestinations, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,4"/>
                                            <TextBlock Text="{r:Text RecipeEditor.hint_destinations_filter}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                            <Border Background="{DynamicResource RE.BadgeBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8">
                                                <StackPanel>
                                                    <TextBlock Text="{r:Text RecipeEditor.dynamic_destination_title}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource RE.Accent}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{r:Text RecipeEditor.hint_dynamic_destination}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 19. External Command Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.IsExternalCommand}">
                                            <TextBlock Text="{r:Text RecipeEditor.configured_command}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.configured_command}" Text="{Binding SelectedNode.ExternalCommandCommand, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                            <TextBlock Text="{r:Text RecipeEditor.hint_configured_command}"
                                                       FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <TextBlock Text="{r:Text RecipeEditor.executable_path}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.executable_path}" Text="{Binding SelectedNode.ExternalCommandLine, Mode=TwoWay}"
                                                         FontFamily="monospace"
                                                         Padding="6,4"/>
                                                <Button Grid.Column="1"  Classes="secondary" Margin="6,0,0,0"
                                                        Command="{Binding SelectedNode.BrowseExternalExecutableCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_browse_executable}"><TextBlock><Run Text="📁 "/><Run Text="{r:Text RecipeEditor.import_btn_browse}"/></TextBlock></Button>
                                            </Grid>

                                            <TextBlock Text="{r:Text RecipeEditor.arguments}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.arguments}" Text="{Binding SelectedNode.ExternalCommandArguments, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <TextBlock Text="{r:Text RecipeEditor.temp_image_format}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.temp_image_format}" ItemsSource="{Binding $parent[Window].((vm:RecipeEditorViewModel)DataContext).OutputFormatOptions}"
                                                      DisplayMemberBinding="{ReflectionBinding DisplayNameWithPreferredExtension}" SelectedValueBinding="{ReflectionBinding Id}"
                                                      SelectedValue="{Binding SelectedNode.ExternalCommandFormat, Mode=TwoWay}"
                                                      Margin="0,0,0,6">
                                            </ComboBox>

                                            <TextBlock Text="{r:Text RecipeEditor.shell_verb}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.shell_verb}" Text="{Binding SelectedNode.ExternalCommandVerb, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{r:Text RecipeEditor.working_directory}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.working_directory}" Text="{Binding SelectedNode.ExternalCommandWorkingDirectory, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,6"/>

                                            <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <CheckBox Content="{r:Text RecipeEditor.run_async}" IsChecked="{Binding SelectedNode.ExternalCommandRunInBackground, Mode=TwoWay}" Margin="0,2"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.copy_stdout}" IsChecked="{Binding SelectedNode.ExternalCommandOutputToClipboard, Mode=TwoWay}" Margin="0,2"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.copy_detected_url}" IsChecked="{Binding SelectedNode.ExternalCommandUriToClipboard, Mode=TwoWay}" Margin="0,2"/>
                                                    <CheckBox Content="{r:Text RecipeEditor.reload_image}" IsChecked="{Binding SelectedNode.ExternalCommandReloadAfterExecution, Mode=TwoWay}" Margin="0,2"/>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{r:Text RecipeEditor.store_output_variable}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.store_output_variable}" Text="{Binding SelectedNode.ExternalCommandSetOutputVariable, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>

                                            <TextBlock Text="{r:Text RecipeEditor.store_exit_code_variable}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.store_exit_code_variable}" Text="{Binding SelectedNode.ExternalCommandSetExitCodeVariable, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 21. Jira Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.IsJira}">
                                            <TextBlock Text="{r:Text RecipeEditor.jira_issue_key}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.jira_issue_key}" Text="{Binding SelectedNode.JiraIssueKey, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,6"/>
                                            <TextBlock Text="{r:Text RecipeEditor.upload_format}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.upload_format}" ItemsSource="{Binding $parent[Window].((vm:RecipeEditorViewModel)DataContext).OutputFormatOptions}"
                                                      DisplayMemberBinding="{ReflectionBinding DisplayNameWithPreferredExtension}" SelectedValueBinding="{ReflectionBinding Id}"
                                                      SelectedValue="{Binding SelectedNode.JiraFormat, Mode=TwoWay}"
                                                      Margin="0,0,0,6">
                                            </ComboBox>
                                            <TextBlock Text="{r:Text RecipeEditor.jpeg_quality}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.jpeg_quality}" Text="{Binding SelectedNode.JiraJpegQuality, Mode=TwoWay}"
                                                    
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 22. Confluence Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.IsConfluence}">
                                            <TextBlock Text="{r:Text RecipeEditor.confluence_page_id}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.confluence_page_id}" Text="{Binding SelectedNode.ConfluencePageId, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,6"/>
                                            <TextBlock Text="{r:Text RecipeEditor.upload_format}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.upload_format}" ItemsSource="{Binding $parent[Window].((vm:RecipeEditorViewModel)DataContext).OutputFormatOptions}"
                                                      DisplayMemberBinding="{ReflectionBinding DisplayNameWithPreferredExtension}" SelectedValueBinding="{ReflectionBinding Id}"
                                                      SelectedValue="{Binding SelectedNode.ConfluenceFormat, Mode=TwoWay}"
                                                      Margin="0,0,0,6">
                                            </ComboBox>
                                            <TextBlock Text="{r:Text RecipeEditor.jpeg_quality}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.jpeg_quality}" Text="{Binding SelectedNode.ConfluenceJpegQuality, Mode=TwoWay}"
                                                    
                                                     Padding="6,4" Margin="0,0,0,8"/>
                                        </StackPanel>

                                        <!-- 23. Office Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.IsOffice}">
                                            <TextBlock Text="{r:Text RecipeEditor.target_office_app}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.target_office_app}" SelectedValue="{Binding SelectedNode.OfficeApplication, Mode=TwoWay}"
                                                      SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,6">
                                                <ComboBoxItem Content="Microsoft Word" Tag="Word"/>
                                                <ComboBoxItem Content="Microsoft Excel" Tag="Excel"/>
                                                <ComboBoxItem Content="Microsoft PowerPoint" Tag="PowerPoint"/>
                                                <ComboBoxItem Content="Microsoft OneNote" Tag="OneNote"/>
                                                <ComboBoxItem Content="Microsoft Outlook" Tag="Outlook"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 24. ZXing Barcode / QR Code Inspector -->
                                        <StackPanel IsVisible="{Binding SelectedNode.IsZxing}">
                                            <TextBlock Text="{r:Text RecipeEditor.ocr_variable_name}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.ocr_variable_name}" Text="{Binding SelectedNode.ZxingSetVariable, Mode=TwoWay}"
                                                     FontFamily="monospace"
                                                     Padding="6,4" Margin="0,0,0,6"/>
                                            <CheckBox Content="{r:Text RecipeEditor.copy_decoded_text}" IsChecked="{Binding SelectedNode.ZxingCopyToClipboard, Mode=TwoWay}" Margin="0,2,0,6"/>
                                        </StackPanel>

                                        <!-- 25. Cloud Storage Inspector (Box / Dropbox) -->
                                        <StackPanel IsVisible="{Binding SelectedNode.IsCloudStorage}">
                                            <TextBlock Text="{r:Text RecipeEditor.cloud_destination}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{r:Text RecipeEditor.hint_cloud_destination}"
                                                       FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        </StackPanel>

                                        <Separator Background="{DynamicResource RE.CardBorder}" Margin="0,12,0,10"/>

                                        <!-- Step Error Handling & Fallback -->
                                        <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{r:Text RecipeEditor.header_step_error_handling}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                        <TextBlock Text="{r:Text RecipeEditor.hint_step_error_handling}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource RE.BadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedNode.OnErrorAction}" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource RE.Accent}"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{r:Text RecipeEditor.on_error}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.on_error}" SelectedValue="{Binding SelectedNode.OnErrorAction, Mode=TwoWay}"
                                                          SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,6">
                                                    <ComboBoxItem Content="{r:Text RecipeEditor.on_error_default}" Tag="Default"/>
                                                    <ComboBoxItem Content="{r:Text RecipeEditor.on_error_route_step}" Tag="Step"/>
                                                    <ComboBoxItem Content="{r:Text RecipeEditor.on_error_forward_recipe}" Tag="Recipe"/>
                                                </ComboBox>

                                                <!-- Target Step Selector -->
                                                <StackPanel IsVisible="{Binding SelectedNode.IsOnErrorStep}" Margin="0,0,0,6">
                                                    <TextBlock Text="{r:Text RecipeEditor.fallback_step}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.fallback_step}" ItemsSource="{Binding SelectedNode.AvailableTargetSteps}"
                                                              SelectedValue="{Binding SelectedNode.OnErrorNodeId, Mode=TwoWay}"
                                                              SelectedValueBinding="{ReflectionBinding Id}"
                                                              DisplayMemberBinding="{ReflectionBinding DisplayName}"/>
                                                </StackPanel>

                                                <!-- Target Recipe Selector -->
                                                <StackPanel IsVisible="{Binding SelectedNode.IsOnErrorRecipe}" Margin="0,0,0,6">
                                                    <TextBlock Text="{r:Text RecipeEditor.fallback_recipe}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                    <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.fallback_recipe}" ItemsSource="{Binding SelectedNode.AvailableTargetRecipes}"
                                                              SelectedValue="{Binding SelectedNode.OnErrorRecipeId, Mode=TwoWay}"
                                                              SelectedValueBinding="{ReflectionBinding Id}"
                                                              DisplayMemberBinding="{ReflectionBinding Name}"
                                                             />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- When nothing is selected -->
                                    <StackPanel IsVisible="{Binding !HasSelection}"
                                                VerticalAlignment="Center" Margin="0,40,0,0">
                                        <TextBlock Text="{r:Text RecipeEditor.no_element_selected}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource RE.TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{r:Text RecipeEditor.hint_no_element_selected}"
                                                   FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="10,6,10,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: Recipe & Triggers -->
                        <TabItem Header="{r:Text RecipeEditor.tab_recipe_triggers}">
                            <ScrollViewer
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          Padding="6,8,6,8">
                                <StackPanel>
                                    <TextBlock Text="{r:Text RecipeEditor.header_recipe_configuration}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,10"/>

                                    <TextBlock Text="{r:Text RecipeEditor.recipe_id}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.recipe_id}" Text="{Binding RecipeId, Mode=TwoWay}"
                                                
                                                 FontFamily="monospace" Padding="6,4"/>
                                        <Button Grid.Column="1" Content="{r:Text RecipeEditor.btn_copy}" Classes="secondary"
                                                Command="{Binding CopyRecipeIdCommand}" Margin="4,0,0,0" ToolTip.Tip="{r:Text RecipeEditor.tip_copy_recipe_id}"/>
                                    </Grid>

                                    <TextBlock Text="{r:Text RecipeEditor.recipe_name}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.recipe_name}" Text="{Binding RecipeTitle, Mode=TwoWay}"
                                            
                                             Padding="6,4" Margin="0,2,0,8"/>

                                    <TextBlock Text="{r:Text RecipeEditor.description}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.description}" Text="{Binding RecipeDescription, Mode=TwoWay}"
                                            
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="48"
                                             Padding="6,4" Margin="0,2,0,8"/>

                                    <TextBlock Text="{r:Text RecipeEditor.version}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.version}" Text="{Binding RecipeVersion, Mode=TwoWay}"
                                            
                                             Padding="6,4" Margin="0,2,0,10"/>

                                    <!-- Automatic step: where it goes -->
                                    <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.Accent}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                            IsVisible="{Binding IsExtensionMode}">
                                        <StackPanel>
                                            <TextBlock Text="{r:Text RecipeEditor.header_automatic_step}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{r:Text RecipeEditor.hint_automatic_step}"
                                                       FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="{r:Text RecipeEditor.extension_recipes}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.extension_recipes}" Text="{Binding ExtensionTargets, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontFamily="monospace"
                                                     Padding="6,4" Margin="0,2,0,8"/>
                                            <TextBlock Text="{r:Text RecipeEditor.extension_slot}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.extension_slot}" ItemsSource="{Binding ExtensionSlotNames}" SelectedItem="{Binding ExtensionSlot, Mode=TwoWay}" Margin="0,2,0,8"/>
                                            <TextBlock Text="{r:Text RecipeEditor.extension_order}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.extension_order}" Text="{Binding ExtensionOrder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     Padding="6,4" Margin="0,2,0,8"/>
                                            <TextBlock Text="{r:Text RecipeEditor.extension_when}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}"/>
                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.extension_when}" Text="{Binding ExtensionWhen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontFamily="monospace"
                                                     Padding="6,4" Margin="0,2,0,8"/>
                                            <TextBlock Text="{Binding ExtensionReachText}" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" Foreground="{DynamicResource RE.TextSecondary}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Options: values the user sets once in Settings > Recipes, read by the steps with ${option.key} -->
                                    <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{r:Text RecipeEditor.header_options}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{r:Text RecipeEditor.btn_add_option}" Classes="secondary" Command="{Binding AddOptionCommand}"/>
                                            </Grid>
                                            <TextBlock Text="{r:Text RecipeEditor.hint_options}"
                                                       FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding RecipeOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RecipeOptionItemViewModel">
                                                        <Border BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="0,1,0,0" Padding="0,6,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.Styles>
                                                                    <Style Selector="TextBlock">
                                                                        <Setter Property="FontSize" Value="11"/>
                                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource RE.TextSecondary}"/>
                                                                    </Style>
                                                                    <Style Selector="TextBox">
                                                                        <Setter Property="Margin" Value="0,1"/>
                                                                        <Setter Property="Padding" Value="4,2"/>
                                                                        <Setter Property="Background" Value="{DynamicResource RE.CardBackground}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource RE.TextPrimary}"/>
                                                                    </Style>
                                                                </Grid.Styles>
                                                                <TextBlock Grid.Row="0" Text="{r:Text RecipeEditor.option_key}"/>
                                                                <DockPanel Grid.Row="0" Grid.Column="1">
                                                                    <Button AutomationProperties.Name="{r:Text RecipeEditor.tip_remove_option}" DockPanel.Dock="Right" Content="🗑" Classes="secondary" Command="{Binding RemoveCommand}" ToolTip.Tip="{r:Text RecipeEditor.tip_remove_option}" Margin="4,0,0,0"/>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsageText}" FontFamily="monospace" FontSize="10" Margin="6,0,0,0"/>
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.option_key}" Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontFamily="monospace"/>
                                                                </DockPanel>
                                                                <TextBlock Grid.Row="1" Text="{r:Text RecipeEditor.option_type}"/>
                                                                <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.option_type}" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TypeNames}" SelectedItem="{Binding Type, Mode=TwoWay}" Margin="0,1"/>
                                                                <TextBlock Grid.Row="2" Text="{r:Text RecipeEditor.option_label}"/>
                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.option_label}" Grid.Row="2" Grid.Column="1" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                                <TextBlock Grid.Row="3" Text="{r:Text RecipeEditor.option_default}"/>
                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.option_default}" Grid.Row="3" Grid.Column="1" Text="{Binding DefaultText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                                <TextBlock Grid.Row="4" Text="{r:Text RecipeEditor.option_range}" IsVisible="{Binding IsNumber}"/>
                                                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsNumber}">
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.tip_option_min}" Width="60" Text="{Binding MinText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="{r:Text RecipeEditor.tip_option_min}"/>
                                                                    <TextBlock Text=" – " />
                                                                    <TextBox AutomationProperties.Name="{r:Text RecipeEditor.tip_option_max}" Width="60" Text="{Binding MaxText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="{r:Text RecipeEditor.tip_option_max}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Row="5" Text="{r:Text RecipeEditor.option_choices}" VerticalAlignment="Top" Margin="0,3,0,0" IsVisible="{Binding IsEnum}"/>
                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.option_choices}" Grid.Row="5" Grid.Column="1" Text="{Binding ChoicesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="40"
                                                                         ToolTip.Tip="{r:Text RecipeEditor.tip_option_choices}" IsVisible="{Binding IsEnum}"/>
                                                                <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,2,0,0">
                                                                    <CheckBox Content="{r:Text RecipeEditor.option_quick_settings}" IsChecked="{Binding QuickSettings, Mode=TwoWay}" Margin="0,0,10,0"
                                                                              IsEnabled="{Binding CanBeQuickSetting}"/>
                                                                    <CheckBox Content="{r:Text RecipeEditor.option_expand_placeholders}" IsChecked="{Binding IsTemplate, Mode=TwoWay}" Margin="0,0,10,0"
                                                                              ToolTip.Tip="{r:Text RecipeEditor.tip_option_expand_placeholders}"
                                                                             />
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock><Run Text="{r:Text RecipeEditor.option_enabled_when}"/><Run Text=" "/></TextBlock>
                                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.option_enabled_when}" Width="90" Text="{Binding EnabledWhen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" FontFamily="monospace"
                                                                                 ToolTip.Tip="{r:Text RecipeEditor.tip_option_enabled_when}"/>
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Start Steps / Entry Points -->
                                    <Border Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                                            IsVisible="{Binding IsRecipeMode}">
                                        <StackPanel>
                                            <TextBlock Text="{r:Text RecipeEditor.header_start_steps}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{r:Text RecipeEditor.hint_start_steps}"
                                                       FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Nodes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StepNodeViewModel">
                                                        <CheckBox IsChecked="{Binding IsStartNode, Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName, TargetNullValue=''}" Margin="0,3">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding StepType, Converter={x:Static re:StepTypeToIconConverter.Instance}}" FontSize="11" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding Id, StringFormat=' ({0})'}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Separator Background="{DynamicResource RE.CardBorder}" Margin="0,6,0,12" IsVisible="{Binding IsRecipeMode}"/>

                                    <!-- Triggers Header & Action Bar -->
                                    <Grid Margin="0,0,0,8" IsVisible="{Binding IsRecipeMode}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{r:Text RecipeEditor.header_triggers}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Triggers.Count, StringFormat='{}{0} configured'}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Quick Add Buttons -->
                                    <WrapPanel Margin="0,0,0,10" IsVisible="{Binding IsRecipeMode}">
                                        <Button Content="{r:Text RecipeEditor.trigger_add_hotkey}" Classes="secondary" Command="{Binding AddTriggerCommand}" CommandParameter="Hotkey" Margin="0,0,4,4"/>
                                        <Button Content="{r:Text RecipeEditor.trigger_add_context_menu}" Classes="secondary" Command="{Binding AddTriggerCommand}" CommandParameter="ContextMenu" Margin="0,0,4,4"/>
                                        <Button Content="{r:Text RecipeEditor.trigger_add_editor}" Classes="secondary" Command="{Binding AddTriggerCommand}" CommandParameter="Editor" Margin="0,0,4,4"/>
                                        <Button Content="{r:Text RecipeEditor.trigger_add_clipboard}" Classes="secondary" Command="{Binding AddTriggerCommand}" CommandParameter="Clipboard" Margin="0,0,4,4"/>
                                        <Button Content="{r:Text RecipeEditor.trigger_add_cli}" Classes="secondary" Command="{Binding AddTriggerCommand}" CommandParameter="Commandline" Margin="0,0,4,4" ToolTip.Tip="{r:Text RecipeEditor.tip_trigger_add_cli}"/>
                                        <Button Content="{r:Text RecipeEditor.trigger_add_open_with}" Classes="secondary" Command="{Binding AddTriggerCommand}" CommandParameter="OpenFile" Margin="0,0,4,4" ToolTip.Tip="{r:Text RecipeEditor.tip_trigger_add_open_with}"/>
                                        <Button Content="{r:Text RecipeEditor.trigger_add_browser_extension}" Classes="secondary" Command="{Binding AddTriggerCommand}" CommandParameter="Extension" Margin="0,0,4,4" ToolTip.Tip="{r:Text RecipeEditor.tip_trigger_add_browser_extension}"/>
                                        <Button Content="{r:Text RecipeEditor.trigger_add_ai_tool}" Classes="secondary" Command="{Binding AddTriggerCommand}" CommandParameter="AiTool" Margin="0,0,4,4" ToolTip.Tip="{r:Text RecipeEditor.tip_trigger_add_ai_tool}"/>
                                        <Button Content="{r:Text RecipeEditor.trigger_add_manual}" Classes="secondary" Command="{Binding AddTriggerCommand}" CommandParameter="Manual" Margin="0,0,0,4"/>
                                    </WrapPanel>

                                    <!-- Triggers List -->
                                    <ItemsControl ItemsSource="{Binding Triggers}" IsVisible="{Binding IsRecipeMode}">
                                        <ItemsControl.ItemTemplate>
                                           <DataTemplate x:DataType="vm:TriggerItemViewModel">
                                                <Border Background="{DynamicResource RE.CardBackground}"
                                                        BorderBrush="{DynamicResource RE.CardBorder}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <!-- Card Header -->
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="11"
                                                                       Foreground="{DynamicResource RE.TextPrimary}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <CheckBox Grid.Column="1" Content="{r:Text RecipeEditor.enabled}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                     
                                                                      FontSize="10" VerticalAlignment="Center" Margin="6,0"/>
                                                            <Button AutomationProperties.Name="{r:Text RecipeEditor.delete_trigger}" Grid.Column="2" Content="✕" Classes="error small"
                                                                    Command="{Binding $parent[Window].((vm:RecipeEditorViewModel)DataContext).RemoveTriggerCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{r:Text RecipeEditor.delete_trigger}"/>
                                                        </Grid>

                                                        <!-- Trigger specific fields -->
                                                        <!-- 1. Hotkey -->
                                                        <StackPanel IsVisible="{Binding IsHotkey}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.hotkey_trigger}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <re:HotkeyBox AutomationProperties.Name="{r:Text RecipeEditor.hotkey_trigger}" Margin="0,4,0,4"
                                                                                      Hotkey="{Binding Hotkey, Mode=TwoWay}"/>
                                                        </StackPanel>

                                                        <!-- 2. Context Menu -->
                                                        <StackPanel IsVisible="{Binding IsContextMenu}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.menu_item_label}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.menu_item_label}" Text="{Binding MenuItemText, Mode=TwoWay}"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{r:Text RecipeEditor.menu_group}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.menu_group}" Text="{Binding Group, Mode=TwoWay}"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{r:Text RecipeEditor.menu_item_order}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,4,0,0"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.menu_item_order}" Text="{Binding Order, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 3. Editor Menu -->
                                                        <StackPanel IsVisible="{Binding IsEditor}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.editor_menu_item_label}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.editor_menu_item_label}" Text="{Binding MenuItemText, Mode=TwoWay}"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{r:Text RecipeEditor.editor_menu_group}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.editor_menu_group}" Text="{Binding Group, Mode=TwoWay}"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{r:Text RecipeEditor.editor_menu_item_order}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,4,0,0"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.editor_menu_item_order}" Text="{Binding Order, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 4. Clipboard -->
                                                        <StackPanel IsVisible="{Binding IsClipboard}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.format_filter}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.format_filter}" Text="{Binding FormatFilter, Mode=TwoWay}"
                                                                     FontFamily="monospace" FontSize="11"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 5. Manual -->
                                                        <StackPanel IsVisible="{Binding IsManual}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.trigger_name}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.trigger_name}" Text="{Binding Name, Mode=TwoWay}"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 6. Commandline (CLI) -->
                                                        <StackPanel IsVisible="{Binding IsCommandline}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.cli_command_name}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.cli_command_name}" Text="{Binding Command, Mode=TwoWay}"
                                                                     FontFamily="monospace"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{r:Text RecipeEditor.cli_description}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.cli_description}" Text="{Binding Description, Mode=TwoWay}"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <CheckBox Content="{r:Text RecipeEditor.fire_and_forget_wait}"
                                                                      IsChecked="{Binding FireAndForget, Mode=TwoWay}"
                                                                     
                                                                      FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 7. Open With File -->
                                                        <StackPanel IsVisible="{Binding IsOpenFile}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.file_extensions}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.file_extensions}" Text="{Binding Filter, Mode=TwoWay}"
                                                                     FontFamily="monospace"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <CheckBox Content="{r:Text RecipeEditor.fire_and_forget}"
                                                                      IsChecked="{Binding FireAndForget, Mode=TwoWay}"
                                                                     
                                                                      FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- AI tool (greenshot-mcp) -->
                                                        <StackPanel IsVisible="{Binding IsAiTool}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.ai_tool_name}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.ai_tool_name}" Text="{Binding ToolName, Mode=TwoWay}"
                                                                     FontFamily="monospace"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{r:Text RecipeEditor.ai_tool_title}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.ai_tool_title}" Text="{Binding ToolTitle, Mode=TwoWay}"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <TextBlock Text="{r:Text RecipeEditor.ai_tool_description}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.ai_tool_description}" Text="{Binding Description, Mode=TwoWay}"
                                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <CheckBox Content="{r:Text RecipeEditor.ai_tool_read_only}"
                                                                      IsChecked="{Binding ReadOnly, Mode=TwoWay}"
                                                                     
                                                                      FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- 8. Browser Extension -->
                                                        <StackPanel IsVisible="{Binding IsExtension}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.browser_filter}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <TextBox AutomationProperties.Name="{r:Text RecipeEditor.browser_filter}" Text="{Binding Browser, Mode=TwoWay}"
                                                                     FontFamily="monospace"
                                                                    
                                                                    
                                                                     Padding="4,2" Margin="0,2,0,4"/>
                                                            <CheckBox Content="{r:Text RecipeEditor.fire_and_forget}"
                                                                      IsChecked="{Binding FireAndForget, Mode=TwoWay}"
                                                                     
                                                                      FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Background="{DynamicResource RE.CardBorder}" Margin="0,10,0,12"/>

                                    <!-- Error Handling & Fallback Routes Header -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{r:Text RecipeEditor.header_error_handling}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ErrorTransitions.Count, StringFormat='{}{0} configured'}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{r:Text RecipeEditor.hint_error_handling}"
                                               FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <Button Content="{r:Text RecipeEditor.btn_add_error_route}" Classes="secondary" Command="{Binding AddErrorTransitionCommand}" Margin="0,0,0,10" HorizontalAlignment="Left"/>

                                    <!-- Error Transitions List -->
                                    <ItemsControl ItemsSource="{Binding ErrorTransitions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ErrorTransitionItemViewModel">
                                                <Border Background="{DynamicResource RE.CardBackground}"
                                                        BorderBrush="{DynamicResource RE.CardBorder}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource RE.TextPrimary}" Margin="0,0,4,0"><Run Text="⚠️ "/><Run Text="{r:Text RecipeEditor.error_route_from}"/><Run Text=":"/></TextBlock>
                                                                <TextBox AutomationProperties.Name="{r:Text RecipeEditor.error_route_from}" Text="{Binding FromNodeId, Mode=TwoWay}"
                                                                         Width="100" FontFamily="monospace" FontSize="10"
                                                                        
                                                                        
                                                                         Padding="3,1" ToolTip.Tip="{r:Text RecipeEditor.tip_error_route_from}"/>
                                                            </StackPanel>
                                                            <Button AutomationProperties.Name="{r:Text RecipeEditor.remove_error_route}" Grid.Column="1" Content="🗑️" Classes="error small"
                                                                    Command="{Binding DeleteCommand}" Padding="4,1" FontSize="10" ToolTip.Tip="{r:Text RecipeEditor.remove_error_route}"/>
                                                        </Grid>

                                                        <TextBlock Text="{r:Text RecipeEditor.error_filter}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <TextBox AutomationProperties.Name="{r:Text RecipeEditor.error_filter}" Text="{Binding ErrorType, Mode=TwoWay}"
                                                                 FontFamily="monospace" FontSize="10"
                                                                
                                                                
                                                                 Padding="4,2" Margin="0,0,0,6"/>

                                                        <TextBlock Text="{r:Text RecipeEditor.route_to}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}" Margin="0,0,0,2"/>
                                                        <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.route_to}" SelectedValue="{Binding TargetType, Mode=TwoWay}"
                                                                  SelectedValueBinding="{ReflectionBinding Tag}" Margin="0,0,0,4">
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.route_step}" Tag="Step"/>
                                                            <ComboBoxItem Content="{r:Text RecipeEditor.route_recipe}" Tag="Recipe"/>
                                                        </ComboBox>

                                                        <!-- Target Step -->
                                                        <StackPanel IsVisible="{Binding IsTargetStep}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.fallback_step}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.fallback_step}" ItemsSource="{Binding AvailableNodes}"
                                                                      SelectedValue="{Binding ToNodeId, Mode=TwoWay}"
                                                                      SelectedValueBinding="{ReflectionBinding Id}"
                                                                      DisplayMemberBinding="{ReflectionBinding DisplayName}"/>
                                                        </StackPanel>

                                                        <!-- Target Recipe -->
                                                        <StackPanel IsVisible="{Binding IsTargetRecipe}" Margin="0,2,0,0">
                                                            <TextBlock Text="{r:Text RecipeEditor.fallback_recipe}" FontSize="10" Foreground="{DynamicResource RE.TextSecondary}"/>
                                                            <ComboBox AutomationProperties.Name="{r:Text RecipeEditor.fallback_recipe}" ItemsSource="{Binding AvailableRecipes}"
                                                                      SelectedValue="{Binding TargetRecipeId, Mode=TwoWay}"
                                                                      SelectedValueBinding="{ReflectionBinding Id}"
                                                                      DisplayMemberBinding="{ReflectionBinding Name}"
                                                                     />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{DynamicResource RE.CardBackground}" BorderBrush="{DynamicResource RE.CardBorder}" BorderThickness="0,1,0,0" Padding="10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{r:Text RecipeEditor.pipeline_engine}" FontSize="11" Foreground="{DynamicResource RE.TextSecondary}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

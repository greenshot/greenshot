<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Greenshot.Linux.Helpers"
        x:Class="Greenshot.Linux.Editing.EditorWindow"
        Title="{l:Text Editor.title}"
        Width="1000" Height="700" MinWidth="640" MinHeight="400">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{l:Text Editor.file}">
        <MenuItem Header="{l:Text Editor.save}" InputGesture="Ctrl+S" Click="OnSave" />
        <MenuItem Header="{l:Text Editor.saveas}" InputGesture="Ctrl+Shift+S" Click="OnSaveAs" />
        <MenuItem Header="{l:Text Editor.copyimagetoclipboard}" InputGesture="Ctrl+Shift+C" Click="OnCopyImage" />
        <MenuItem x:Name="ExportMenu" Header="{l:Text Linux.export_to}" />
        <Separator />
        <MenuItem Header="{l:Text Core.contextmenu_openfile}" InputGesture="Ctrl+O" Click="OnOpen" />
        <Separator />
        <MenuItem Header="{l:Text Editor.close}" InputGesture="Ctrl+W" Click="OnClose" />
      </MenuItem>
      <MenuItem Header="{l:Text Editor.edit}">
        <MenuItem x:Name="UndoMenu" Header="{l:Text Editor.undo}" InputGesture="Ctrl+Z" Click="OnUndo" />
        <MenuItem x:Name="RedoMenu" Header="{l:Text Editor.redo}" InputGesture="Ctrl+Y" Click="OnRedo" />
        <Separator />
        <MenuItem Header="{l:Text Editor.cuttoclipboard}" InputGesture="Ctrl+X" Click="OnCut" />
        <MenuItem Header="{l:Text Editor.copytoclipboard}" InputGesture="Ctrl+C" Click="OnCopy" />
        <MenuItem Header="{l:Text Editor.pastefromclipboard}" InputGesture="Ctrl+V" Click="OnPaste" />
        <MenuItem Header="{l:Text Linux.paste_image}" InputGesture="Ctrl+Shift+V" Click="OnPasteImage" />
        <MenuItem Header="{l:Text Editor.duplicate}" InputGesture="Ctrl+D" Click="OnDuplicate" />
        <MenuItem Header="{l:Text Editor.deleteelement}" InputGesture="Delete" Click="OnDelete" />
        <Separator />
        <MenuItem Header="{l:Text Editor.selectall}" InputGesture="Ctrl+A" Click="OnSelectAll" />
      </MenuItem>
      <MenuItem Header="{l:Text Editor.object}">
        <MenuItem Header="{l:Text Editor.uptotop}" InputGesture="Home" Click="OnBringToFront" />
        <MenuItem Header="{l:Text Editor.uponelevel}" InputGesture="PageUp" Click="OnBringForward" />
        <MenuItem Header="{l:Text Editor.downonelevel}" InputGesture="PageDown" Click="OnSendBackward" />
        <MenuItem Header="{l:Text Editor.downtobottom}" InputGesture="End" Click="OnSendToBack" />
        <Separator />
        <MenuItem Header="{l:Text Editor.counter_startvalue}" Click="OnCounterStart" />
        <Separator />
        <MenuItem Header="{l:Text Editor.obfuscate_text}" Click="OnRedactText" />
        <MenuItem Header="{l:Text Linux.insert_qr}" Click="OnInsertQrCode" />
      </MenuItem>
      <MenuItem Header="{l:Text Linux.image}">
        <MenuItem Header="{l:Text Editor.crop}" InputGesture="C" Click="OnCropTool" />
        <MenuItem Header="{l:Text Editor.autocrop}" Click="OnAutoCrop" />
        <MenuItem Header="{l:Text Editor.resize}" InputGesture="Z" Click="OnResize" />
        <MenuItem Header="{l:Text Editor.rotatecw}" InputGesture="Ctrl+OemPeriod" Click="OnRotateClockwise" />
        <MenuItem Header="{l:Text Editor.rotateccw}" InputGesture="Ctrl+OemComma" Click="OnRotateCounterClockwise" />
        <MenuItem Header="{l:Text Linux.enlarge_canvas}" InputGesture="Ctrl+Shift+OemPlus" Click="OnEnlargeCanvas" />
        <MenuItem Header="{l:Text Linux.shrink_canvas}" InputGesture="Ctrl+Shift+OemMinus" Click="OnShrinkCanvas" />
        <Separator />
        <MenuItem Header="{l:Text Editor.border}" InputGesture="Ctrl+B" Click="OnBorder" />
        <MenuItem Header="{l:Text Editor.image_shadow}" InputGesture="Ctrl+Q" Click="OnDropShadow" />
        <MenuItem Header="{l:Text Editor.torn_edge}" InputGesture="Ctrl+T" Click="OnTornEdge" />
        <MenuItem Header="{l:Text Editor.dropshadow_settings}" Click="OnDropShadowSettings" />
        <MenuItem Header="{l:Text Editor.tornedge_settings}" Click="OnTornEdgeSettings" />
        <MenuItem Header="{l:Text Editor.grayscale}" InputGesture="Ctrl+G" Click="OnGrayscale" />
        <MenuItem Header="{l:Text Editor.invert}" InputGesture="Ctrl+I" Click="OnInvert" />
        <Separator />
        <MenuItem Header="{l:Text Linux.clear_image}" InputGesture="Ctrl+Delete" Click="OnClear" />
      </MenuItem>
      <MenuItem Header="{l:Text Linux.view}">
        <MenuItem Header="{l:Text Linux.zoom_in}" InputGesture="Ctrl+OemPlus" Click="OnZoomIn" />
        <MenuItem Header="{l:Text Linux.zoom_out}" InputGesture="Ctrl+OemMinus" Click="OnZoomOut" />
        <MenuItem Header="{l:Text Linux.zoom_actual}" InputGesture="Ctrl+D0" Click="OnZoomActual" />
        <MenuItem Header="{l:Text Linux.zoom_fit}" InputGesture="Ctrl+D9" Click="OnZoomFit" />
      </MenuItem>
      <MenuItem x:Name="RecipesMenu" Header="{l:Text Linux.recipes}" />
    </Menu>

    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <ScrollViewer x:Name="PropertyBarHost" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" />
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="8,3">
      <DockPanel>
        <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Margin="12,0,0,0" />
        <TextBlock x:Name="SizeText" DockPanel.Dock="Right" Margin="12,0,0,0" />
        <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
      <StackPanel x:Name="ToolPanel" Margin="3" Spacing="2" />
    </Border>

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <Grid x:Name="CanvasHost" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Canvas x:Name="TextOverlay" />
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>

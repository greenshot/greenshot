<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Only to write .greenshot files like the Windows editor does, for the tests of reading them -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <NoWarn>$(NoWarn);SYSLIB0011;SYSLIB0050;SYSLIB0051</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.14" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Greenshot.Linux.Core\Greenshot.Linux.Core.csproj" />
    <ProjectReference Include="..\..\src\Greenshot.Linux.Editor\Greenshot.Linux.Editor.csproj" />
    <ProjectReference Include="..\..\src\Greenshot.Linux.Plugins\Greenshot.Linux.Plugins.csproj" />
    <ProjectReference Include="..\..\src\Greenshot.Linux.Recipes\Greenshot.Linux.Recipes.csproj" />
    <ProjectReference Include="..\..\src\Greenshot.Linux.RecipeEditor\Greenshot.Linux.RecipeEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
